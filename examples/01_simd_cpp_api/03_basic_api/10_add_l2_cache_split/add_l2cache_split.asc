/* !
 * \file add_l2cache_split.asc
 * \brief Positive example: finish every round of an L2 batch before moving to the next L2 batch.
 */

#include "l2_cache_kernel.h"
#include "l2_cache_runner.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

extern "C" __global__ __vector__ void l2_cache_split(__gm__ uint8_t* data)
{
    AscendC::InitSocState();
    AddL2Cache::KernelAdd op;
    op.Init(data);
    for (uint32_t l2BatchIdx = 0; l2BatchIdx < AddL2Cache::l2BatchCount; ++l2BatchIdx) {
        for (uint32_t roundIdx = 0; roundIdx < AddL2Cache::computeRoundCount; ++roundIdx) {
            op.ProcessL2Batch(l2BatchIdx);
            op.SyncAllCores();
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

namespace {

void LaunchKernel(aclrtStream stream, uint8_t* data)
{
    l2_cache_split<<<AddL2Cache::vectorCoreCount, 0, stream>>>(data);
}

} // namespace

int32_t main(int32_t argc, char* argv[])
{
    return AddL2Cache::RunSample(argc, argv, "l2_split", "./output/output.bin", LaunchKernel, true);
}
