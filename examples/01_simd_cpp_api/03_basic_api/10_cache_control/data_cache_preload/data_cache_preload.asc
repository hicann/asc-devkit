/* !
 * \file data_cache_preload.asc
 * \brief 演示DataCachePreload的使用场景：间接索引下通过Scalar访问GM，手动preload即将访问的数据到DCache以隐藏访存延迟。
 *
 * 场景说明：
 *   data_gm是一个大块数据缓冲区（uint8_t数组），indices存储了一系列随机偏移量。
 *   核函数通过indices[i]间接索引，用Scalar读取data_gm[indices[i]]并累加求和。
 *   由于indices指向GM中分散的各处，硬件prefetch无法预测下一个访问地址，
 *   导致绝大多数Scalar读都会触发DCache miss。
 *
 * 解决方案：
 *   在处理当前data_gm[indices[i]]的同时，调用DataCachePreload将
 *   data_gm[indices[i+1]]所在Cache Line（64B）提前加载到DCache，
 *   使得下一轮Scalar读时DCache命中，将访存延迟与计算重叠。
 */
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

// ====== 配置参数 ======
constexpr uint32_t count = 256;          // 索引数量
constexpr uint32_t dataLen = 65536;      // data_gm大小 = 64KB（1024个Cache Line）
constexpr uint32_t indicesCount = count; // 索引数组长度
constexpr uint32_t resultCount = 1;      // 单个结果
/**
 * \brief 不使用DataCachePreload的核函数（对照版本）
 *
 * 每次Scalar读取data_gm[indices[i]]时，由于indices随机分散，DCache大概率冷启动miss。
 */
extern "C" __global__ __vector__ void kernel_no_preload(
    __gm__ uint8_t* data_gm, __gm__ uint32_t* indices, __gm__ uint32_t* result, uint32_t count)
{
    AscendC::InitSocState();
    // 将raw GM指针包装为GlobalTensor，DataCachePreload要求GlobalTensor<uint64_t>
    AscendC::GlobalTensor<uint64_t> dataGlobal;
    // totalBytes由host侧传入（已知data_gm大小），这里取count的最大偏移覆盖范围
    // 为简化，直接使用足够大的bufferSize
    constexpr uint32_t bufferSize = 256 * 1024; // 256KB
    dataGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(data_gm), bufferSize / sizeof(uint64_t));
    // GM搬到UB
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<uint64_t> xLocal = ubAllocator.Alloc<uint64_t, dataLen / 8>();
    AscendC::DataCopy(xLocal, dataGlobal, dataLen / 8);

    uint32_t sum = 0;
    for (uint32_t i = 0; i < count; i++) {
        uint32_t idx = indices[i];
        sum += data_gm[idx];
    }
    *result = sum;
    AscendC::PipeBarrier<PIPE_ALL>();
}

/**
 * \brief 使用DataCachePreload的核函数
 *
 * 策略：
 *   1. 创建GlobalTensor<uint64_t>绑定data_gm，DataCachePreload需要通过GlobalTensor指定源地址。
 *   2. 首轮先preload indices[0]所在的Cache Line。
 *   3. 循环中：读取当前轮数据 → preload下一轮所在的Cache Line，
 *      利用preload异步执行特性，隐藏下一轮Scalar读的DCache miss延迟。
 *
 * \note DataCachePreload每次加载1个Cache Line（64B），连续调用建议不超过4次。
 */
extern "C" __global__ __vector__ void kernel_with_preload(
    __gm__ uint8_t* data_gm, __gm__ uint32_t* indices, __gm__ uint32_t* result, uint32_t count)
{
    AscendC::InitSocState();

    // 将raw GM指针包装为GlobalTensor，DataCachePreload要求GlobalTensor<uint64_t>
    AscendC::GlobalTensor<uint64_t> dataGlobal;
    // totalBytes由host侧传入（已知data_gm大小），这里取count的最大偏移覆盖范围
    // 为简化，直接使用足够大的bufferSize
    constexpr uint32_t bufferSize = 256 * 1024; // 256KB
    dataGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ uint64_t*>(data_gm), bufferSize / sizeof(uint64_t));

    // GM搬到UB
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
    AscendC::LocalTensor<uint64_t> xLocal = ubAllocator.Alloc<uint64_t, dataLen / 8>();
    AscendC::DataCopy(xLocal, dataGlobal, dataLen / 8);
    uint32_t sum = 0;

    if (count == 0) {
        *result = 0;
        return;
    }

    // 首轮：preload第一个索引所在的Cache Line
    // DataCachePreload以64B（Cache Line大小）为粒度加载，要求偏移对齐到64B边界
    // 低6位清零：idxCurr & ~63ULL 将地址对齐到64B
    uint32_t idxCurr = indices[0];
    int64_t cacheOffset = (int64_t)(idxCurr & ~63ULL);
    /*
    详细解释：
    63ULL = 二进制 0b111111（低6位全1）
    ~63ULL = 二进制取反，低6位全0，高位全1
    idxCurr & ~63ULL = 保留 idxCurr 的高位不变，低6位强制清零
    */
    AscendC::DataCachePreload(dataGlobal, cacheOffset);

    for (uint32_t i = 0; i < count; i++) {
        // 读取当前轮数据（上一轮已preload，DCache大概率命中）
        uint8_t val = data_gm[idxCurr];
        sum += val;

        // 预取下一轮：在当前轮计算的同时，异步将下一轮要访问的Cache Line加载到DCache
        // 下一轮Scalar读取时数据已在DCache中命中，无需等待GM访存，实现访存延迟隐藏
        if (i + 1 < count) {
            uint32_t idxNext = indices[i + 1];
            int64_t offsetNext = (int64_t)(idxNext & ~63ULL);
            AscendC::DataCachePreload(dataGlobal, offsetNext);
            idxCurr = idxNext;
        }
    }

    *result = sum;
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    // SCENARIO_NUM: 1 = 无preload, 2 = 有preload
    uint32_t scenarioNum = (argc >= 2) ? static_cast<uint32_t>(atoi(argv[1])) : 1;

    size_t dataByteSize = dataLen * sizeof(uint8_t);          // 64KB
    size_t indicesByteSize = indicesCount * sizeof(uint32_t); // 1KB
    size_t resultByteSize = resultCount * sizeof(uint32_t);   // 4B

    // Host/Device内存分配
    uint8_t* dataHost = nullptr;
    uint32_t* indicesHost = nullptr;
    uint32_t* resultHost = nullptr;
    uint8_t* dataDevice = nullptr;
    uint32_t* indicesDevice = nullptr;
    uint32_t* resultDevice = nullptr;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    aclrtMallocHost((void**)(&dataHost), dataByteSize);
    aclrtMallocHost((void**)(&indicesHost), indicesByteSize);
    aclrtMallocHost((void**)(&resultHost), resultByteSize);

    aclrtMalloc((void**)&dataDevice, dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&indicesDevice, indicesByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&resultDevice, resultByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t fileSize = 0;
    ReadFile("./input/data.bin", fileSize, dataHost, dataByteSize);
    ReadFile("./input/indices.bin", fileSize, indicesHost, indicesByteSize);

    aclrtMemcpy(dataDevice, dataByteSize, dataHost, dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(indicesDevice, indicesByteSize, indicesHost, indicesByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    if (scenarioNum == 2) {
        // 有preload版本
        kernel_with_preload<<<1, 0, stream>>>(dataDevice, indicesDevice, resultDevice, count);
    } else {
        // 无preload版本（默认）
        kernel_no_preload<<<1, 0, stream>>>(dataDevice, indicesDevice, resultDevice, count);
    }
    aclrtSynchronizeStream(stream);

    // 结果拷贝回Host
    aclrtMemcpy(resultHost, resultByteSize, resultDevice, resultByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", resultHost, resultByteSize);

    // 释放资源
    aclrtFree(dataDevice);
    aclrtFree(indicesDevice);
    aclrtFree(resultDevice);
    aclrtFreeHost(dataHost);
    aclrtFreeHost(indicesHost);
    aclrtFreeHost(resultHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
