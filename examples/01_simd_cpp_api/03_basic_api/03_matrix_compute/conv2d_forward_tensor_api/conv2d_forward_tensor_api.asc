/* !
 * \file conv2d_forward_tensor_api.asc
 * \brief 使用 Tensor API 实现的极简 Conv2D Forward 样例：
 *        GM(NCHW/NHWC/NC1HWC0) -> L1(NC1HWC0) -> L0A(img2col NZ) / L0B(NZ) -> L0C(NZ) -> GM(NCHW/NHWC/NC1HWC0)。
 *        输入输出的 GM 格式由 SCENARIO_NUM 控制（编译时传入，见 CMakeLists.txt）：
 *          0 - NC1HWC0 输入输出
 *          1 - NCHW 输入输出
 *          2 - NHWC 输入输出
 *        L1 fmap 统一为 NC1HWC0，由 GM->L1 按源格式路由（NCHW->NC1HWC0 走 dn2nz、
 *        NHWC->NC1HWC0 走 nd2nz、NC1HWC0->NC1HWC0 直搬）；输出同理由 L0C->GM 按目的格式路由。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"
#include "data_utils.h"

constexpr uint32_t BLOCK_DIM = 4;
constexpr uint32_t N = 4;
constexpr uint32_t C1 = 2;
constexpr uint32_t C0 = 16;
constexpr uint32_t CIN = C1 * C0; // 32
constexpr uint32_t COUT = 16;
constexpr uint32_t H = 9;
constexpr uint32_t W = 9;
constexpr uint32_t KH = 3;
constexpr uint32_t KW = 3;
constexpr uint32_t STRIDE_H = 2;
constexpr uint32_t STRIDE_W = 2;
constexpr uint32_t DILATION_H = 2;
constexpr uint32_t DILATION_W = 2;
constexpr uint32_t PAD_LEFT = 2;
constexpr uint32_t PAD_RIGHT = 2;
constexpr uint32_t PAD_TOP = 2;
constexpr uint32_t PAD_BOTTOM = 2;
constexpr uint32_t PAD_VALUE = 1;

constexpr uint32_t HOUT = (H + PAD_TOP + PAD_BOTTOM - DILATION_H * (KH - 1) - 1) / STRIDE_H + 1; // 5
constexpr uint32_t WOUT = (W + PAD_LEFT + PAD_RIGHT - DILATION_W * (KW - 1) - 1) / STRIDE_W + 1; // 5

constexpr uint32_t M = HOUT * WOUT;     // img2col 输出行数：25
constexpr uint32_t K = CIN * KH * KW;   // img2col 输出列数：288
constexpr uint32_t COUT_N = COUT;       // GEMM 的 N：16
constexpr uint32_t COUT_C1 = COUT / C0; // 输出 NC1HWC0 的 C1：1
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t M_ALIGN = (M + CUBE_BLOCK - 1) / CUBE_BLOCK * CUBE_BLOCK; // 32

constexpr uint32_t FMAP_BATCH_SIZE = H * W * CIN;       // 单 batch fmap 元素数
constexpr uint32_t WEIGHT_SIZE = K * COUT_N;            // weight 元素数（[K, Cout]）
constexpr uint32_t OUT_BATCH_SIZE = HOUT * WOUT * COUT; // 单 batch 输出元素数

extern "C" __global__ __cube__ void conv2d_forward_tensor_api_custom(
    __gm__ half* fmap, __gm__ half* weight, __gm__ half* out)
{
    AscendC::InitSocState();
    using namespace AscendC::Te;

    // 场景编号：0=NC1HWC0, 1=NCHW, 2=NHWC（编译时由 SCENARIO_NUM 传入）。
    constexpr uint32_t scenarioNum = SCENARIO_NUM;

    // 每个 cube 核处理一个 batch（N=4，BLOCK_DIM=4）。
    uint32_t batchIdx = AscendC::GetBlockIdx();
    if (batchIdx >= N) {
        return;
    }

    __cbuf__ half l1FmapBuf[FMAP_BATCH_SIZE];
    __cbuf__ half l1WeightBuf[WEIGHT_SIZE];
    __ca__ half l0ABuf[M_ALIGN * K];
    __cb__ half l0BBuf[K * COUT_N];
    __cc__ float l0CBuf[M_ALIGN * COUT_N];

    // GM fmap 按 SCENARIO_NUM 构造：NCHW(1,C,H,W) / NHWC(1,H,W,C) / NC1HWC0(1,C1,H,W,C0)。
    // CopyGM2L1 按源 pattern 路由（NCHW->NC1HWC0 走 dn2nz、NHWC->NC1HWC0 走 nd2nz、NC1HWC0 直搬）。
    // 每个核取本 batch 对应的 GM 偏移。L1 fmap 统一为 NC1HWC0。
    auto l1FmapTensor = MakeTensor(
        MakeMemPtr(l1FmapBuf),
        MakeFrameLayout<NC1HWC0LayoutPtn>(
            1, static_cast<int32_t>(C1), static_cast<int32_t>(H), static_cast<int32_t>(W), static_cast<int32_t>(C0)));

    // weight GM 已按 [K, Cout] 行优先摆放（K 序 = (C1, KH, KW, C0)），用 NDExtLayoutPtn(行优先)与之一致。
    auto gmWeightTensor = MakeTensor(MakeMemPtr(weight), MakeFrameLayout<NDExtLayoutPtn>(K, COUT_N));
    auto l1WeightTensor = MakeTensor(MakeMemPtr(l1WeightBuf), MakeFrameLayout<ZNLayoutPtn, half>(K, COUT_N));

    // L0A/L0C 容量按 M_ALIGN 对齐，但 Mmad 的 m 用实际 M（硬件按实际 m 计算有效行）。
    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), MakeFrameLayout<NZLayoutPtn, half>(M_ALIGN, K));
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), MakeFrameLayout<ZNLayoutPtn, half>(K, COUT_N));
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), MakeFrameLayout<NZLayoutPtn>(M_ALIGN, COUT_N));

    auto copyGM2L1Atom = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyImg2ColAtom = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0BAtom = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GMAtom = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    // Mutex 槽位锁 ID（单缓冲：L1=0, L0=1, L0C=2）。
    constexpr uint32_t L1_Index = 0;
    constexpr uint32_t L0_Index = 1;
    constexpr uint32_t L0C_Index = 2;

    // GM fmap -> L1(NC1HWC0)：按 SCENARIO_NUM 构造 GM fmap layout 并搬运。
    AscendC::Mutex::Lock<PIPE_MTE2>(L1_Index);
    auto gmFmapMem = MakeMemPtr(fmap + batchIdx * FMAP_BATCH_SIZE);
    if constexpr (scenarioNum == 1) {
        auto gmFmapTensor = MakeTensor(
            gmFmapMem, MakeFrameLayout<NCHWLayoutPtn>(
                           1, static_cast<int32_t>(CIN), static_cast<int32_t>(H), static_cast<int32_t>(W)));
        Copy(copyGM2L1Atom, l1FmapTensor, gmFmapTensor);
    } else if constexpr (scenarioNum == 2) {
        auto gmFmapTensor = MakeTensor(
            gmFmapMem, MakeFrameLayout<NHWCLayoutPtn>(
                           1, static_cast<int32_t>(H), static_cast<int32_t>(W), static_cast<int32_t>(CIN)));
        Copy(copyGM2L1Atom, l1FmapTensor, gmFmapTensor);
    } else {
        auto gmFmapTensor = MakeTensor(
            gmFmapMem, MakeFrameLayout<NC1HWC0LayoutPtn>(
                           1, static_cast<int32_t>(C1), static_cast<int32_t>(H), static_cast<int32_t>(W),
                           static_cast<int32_t>(C0)));
        Copy(copyGM2L1Atom, l1FmapTensor, gmFmapTensor);
    }

    // weight: GM(ND) -> L1(ZN)
    Copy(copyGM2L1Atom, l1WeightTensor, gmWeightTensor);

    AscendC::Mutex::Unlock<PIPE_MTE2>(L1_Index);
    AscendC::Mutex::Lock<PIPE_MTE1>(L1_Index);

    Img2ColParams<half> img2colParams;
    img2colParams.filterW = KW;
    img2colParams.filterH = KH;
    img2colParams.mExtension = M;
    img2colParams.kExtension = K;
    img2colParams.strideW = STRIDE_W;
    img2colParams.strideH = STRIDE_H;
    img2colParams.dilationFilterW = DILATION_W;
    img2colParams.dilationFilterH = DILATION_H;
    img2colParams.padList[0] = PAD_LEFT;   // left
    img2colParams.padList[1] = PAD_RIGHT;  // right
    img2colParams.padList[2] = PAD_TOP;    // top
    img2colParams.padList[3] = PAD_BOTTOM; // bottom
    img2colParams.padValue = PAD_VALUE;
    // L1(NC1HWC0) -> L0A(NZ, img2col 展开)
    AscendC::Mutex::Lock<PIPE_MTE1>(L0_Index);
    Copy(copyImg2ColAtom.with(img2colParams), l0ATensor, l1FmapTensor);
    // L1(NZ) -> L0B(ZN)
    Copy(copyL12L0BAtom, l0BTensor, l1WeightTensor);
    AscendC::Mutex::Unlock<PIPE_MTE1>(L0_Index);
    AscendC::Mutex::Unlock<PIPE_MTE1>(L1_Index);

    AscendC::Mutex::Lock<PIPE_M>(L0_Index);
    // Mmad：L0A(NZ,M,K) x L0B(ZN,K,Cout) -> L0C(NZ,M,Cout)
    MmadParams mmadParams;
    mmadParams.m = M;
    mmadParams.n = COUT_N;
    mmadParams.k = K;
    mmadParams.cmatrixInitVal = true;
    Mmad(mmadAtom.with(mmadParams), l0CTensor, l0ATensor, l0BTensor);
    AscendC::Mutex::Unlock<PIPE_M>(L0_Index);

    // L0C(NZ) -> GM：输出逻辑 (1, C, HOUT, WOUT)，C=COUT。按 SCENARIO_NUM 构造 GM out layout，
    // CopyL0C2GM 按目的 pattern 路由（NCHW 走 nz2dn、NHWC 走 nz2nd、NC1HWC0 直搬 NZ->NC1HWC0）。
    AscendC::Mutex::Lock<PIPE_M>(L0C_Index);
    AscendC::Mutex::Lock<PIPE_FIX>(L0C_Index);
    auto gmOutMem = MakeMemPtr(out + batchIdx * OUT_BATCH_SIZE);
    if constexpr (scenarioNum == 1) {
        auto gmOutTensor = MakeTensor(
            gmOutMem, MakeFrameLayout<NCHWLayoutPtn>(
                          1, static_cast<int32_t>(COUT), static_cast<int32_t>(HOUT), static_cast<int32_t>(WOUT)));
        Copy(copyL0C2GMAtom, gmOutTensor, l0CTensor);
    } else if constexpr (scenarioNum == 2) {
        auto gmOutTensor = MakeTensor(
            gmOutMem, MakeFrameLayout<NHWCLayoutPtn>(
                          1, static_cast<int32_t>(HOUT), static_cast<int32_t>(WOUT), static_cast<int32_t>(COUT)));
        Copy(copyL0C2GMAtom, gmOutTensor, l0CTensor);
    } else {
        auto gmOutTensor = MakeTensor(
            gmOutMem, MakeFrameLayout<NC1HWC0LayoutPtn>(
                          1, static_cast<int32_t>(COUT_C1), static_cast<int32_t>(HOUT), static_cast<int32_t>(WOUT),
                          static_cast<int32_t>(C0)));
        Copy(copyL0C2GMAtom, gmOutTensor, l0CTensor);
    }
    AscendC::Mutex::Unlock<PIPE_FIX>(L0C_Index);
    AscendC::Mutex::Unlock<PIPE_M>(L0C_Index);

    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmapFileSize = N * FMAP_BATCH_SIZE * sizeof(half);
    size_t weightFileSize = WEIGHT_SIZE * sizeof(half);
    size_t outFileSize = N * OUT_BATCH_SIZE * sizeof(half);
    uint32_t numBlocks = BLOCK_DIM;

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmapHost;
    half* fmapDevice;
    aclrtMallocHost((void**)(&fmapHost), fmapFileSize);
    aclrtMalloc((void**)&fmapDevice, fmapFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmapFileSize, fmapHost, fmapFileSize);
    aclrtMemcpy(fmapDevice, fmapFileSize, fmapHost, fmapFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weightHost;
    half* weightDevice;
    aclrtMallocHost((void**)(&weightHost), weightFileSize);
    aclrtMalloc((void**)&weightDevice, weightFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weightFileSize, weightHost, weightFileSize);
    aclrtMemcpy(weightDevice, weightFileSize, weightHost, weightFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outHost;
    half* outDevice;
    aclrtMallocHost((void**)(&outHost), outFileSize);
    aclrtMalloc((void**)&outDevice, outFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_tensor_api_custom<<<numBlocks, nullptr, stream>>>(fmapDevice, weightDevice, outDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(outHost, outFileSize, outDevice, outFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outHost, outFileSize);

    aclrtFree(fmapDevice);
    aclrtFreeHost(fmapHost);
    aclrtFree(weightDevice);
    aclrtFreeHost(weightHost);
    aclrtFree(outDevice);
    aclrtFreeHost(outHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
