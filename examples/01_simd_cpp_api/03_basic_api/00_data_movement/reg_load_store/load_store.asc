/* !
 * \file load_store.asc
 * \brief 演示Load和Store易用性接口对RegTraitNumOne和RegTraitNumTwo的支持
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "data_utils.h"

__aicore__ __inline__ constexpr uint32_t DivCeil(uint32_t a, uint32_t b) { return (a + b - 1) / b; }

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t bufferCount = 68;
constexpr uint32_t totalLength = 64;

template <typename T, uint32_t count>
class KernelLoadStore {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* y)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(x), count);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(y), count);
    }

    __simd_vf__ static inline void CopyTraitOneWithoutCountVF(
        __ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint16_t repeatTimes, uint16_t oneRepeatSize)
    {
        AscendC::Reg::RegTensor<T, AscendC::Reg::RegTraitNumOne> srcReg;
        for (uint16_t i = 0; i < repeatTimes; ++i) {
            AscendC::Reg::Load(srcReg, srcAddr + i * oneRepeatSize);
            AscendC::Reg::Store(dstAddr + i * oneRepeatSize, srcReg);
        }
    }

    __simd_vf__ static inline void CopyTraitOneWithCountVF(
        __ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint16_t repeatTimes, uint16_t oneRepeatSize)
    {
        AscendC::Reg::RegTensor<T, AscendC::Reg::RegTraitNumOne> srcReg;
        for (uint16_t i = 0; i < repeatTimes; ++i) {
            AscendC::Reg::Load(srcReg, srcAddr + i * oneRepeatSize);
            AscendC::Reg::Store(dstAddr + i * oneRepeatSize, srcReg, oneRepeatSize);
        }
    }

    __simd_vf__ static inline void CopyTraitTwoWithoutCountVF(__ubuf__ T* dstAddr, __ubuf__ T* srcAddr)
    {
        AscendC::Reg::RegTensor<T, AscendC::Reg::RegTraitNumTwo> srcReg;
        AscendC::Reg::Load(srcReg, srcAddr);
        AscendC::Reg::Store(dstAddr, srcReg);
    }

    __simd_vf__ static inline void CopyTraitTwoWithCountVF(
        __ubuf__ T* dstAddr, __ubuf__ T* srcAddr, uint32_t totalLength)
    {
        AscendC::Reg::RegTensor<T, AscendC::Reg::RegTraitNumTwo> srcReg;
        AscendC::Reg::Load(srcReg, srcAddr);
        AscendC::Reg::Store(dstAddr, srcReg, totalLength);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<T> xLocal = ubAllocator.Alloc<T>(count);
        AscendC::LocalTensor<T> yLocal = ubAllocator.Alloc<T>(count);

        AscendC::DataCopy(xLocal, xGm, count);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        AscendC::Duplicate(yLocal, static_cast<T>(0), count);

        __ubuf__ T* srcAddr = reinterpret_cast<__ubuf__ T*>(xLocal.GetPhyAddr()) + 1;
        __ubuf__ T* dstAddr = reinterpret_cast<__ubuf__ T*>(yLocal.GetPhyAddr()) + 1;

        constexpr uint16_t oneRepeatSize = AscendC::GetVecLen() / sizeof(T);
        constexpr uint16_t repeatTimes = DivCeil(totalLength, oneRepeatSize);
        if constexpr (scenarioNum == 1) {
            asc_vf_call<CopyTraitOneWithoutCountVF>(dstAddr, srcAddr, repeatTimes, oneRepeatSize);
        } else if constexpr (scenarioNum == 2) {
            asc_vf_call<CopyTraitOneWithCountVF>(dstAddr, srcAddr, repeatTimes, oneRepeatSize);
        } else if constexpr (scenarioNum == 3) {
            asc_vf_call<CopyTraitTwoWithoutCountVF>(dstAddr, srcAddr);
        } else if constexpr (scenarioNum == 4) {
            asc_vf_call<CopyTraitTwoWithCountVF>(dstAddr, srcAddr, totalLength);
        }

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(yGm, yLocal, count);
    }

private:
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
};

__global__ __vector__ void load_store_kernel(__gm__ uint8_t* x, __gm__ uint8_t* y)
{
    AscendC::InitSocState();
    KernelLoadStore<uint64_t, bufferCount> kernel;
    kernel.Init(x, y);
    kernel.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData = nullptr;
    aclrtMallocHost(&goldenData, outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!ret) {
        printf("ReadFile golden.bin failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }

    const uint64_t* output = reinterpret_cast<const uint64_t*>(outputData);
    const uint64_t* golden = reinterpret_cast<const uint64_t*>(goldenData);
    uint32_t totalCount = outSize / sizeof(uint64_t);
    int64_t wrongNum = 0;
    for (uint32_t i = 0; i < totalCount; ++i) {
        if (output[i] != golden[i]) {
            if (wrongNum < 5) {
                printf(
                    "Mismatch at index %u: output=%llu, golden=%llu\n", i, static_cast<unsigned long long>(output[i]),
                    static_cast<unsigned long long>(golden[i]));
            }
            ++wrongNum;
        }
    }

    aclrtFreeHost(goldenData);
    if (wrongNum == 0) {
        printf("test pass!\n");
        return true;
    }
    printf("test fail! wrong count: %ld\n", wrongNum);
    return false;
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    constexpr size_t dataByteSize = bufferCount * sizeof(uint64_t);
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), dataByteSize);
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), dataByteSize);
    aclrtMalloc(reinterpret_cast<void**>(&xDevice), dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDevice), dataByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t inputByteSize = dataByteSize;
    ReadFile("./input/input_x.bin", inputByteSize, xHost, dataByteSize);
    aclrtMemcpy(xDevice, dataByteSize, xHost, dataByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    load_store_kernel<<<1, 0, stream>>>(xDevice, yDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(yHost, dataByteSize, yDevice, dataByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, dataByteSize);

    bool result = CompareResult(yHost, dataByteSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return result ? 0 : 1;
}
