/*!
 * \file truncate_reg_api.asc
 * \brief Use the experimental register Tensor API to truncate floating-point values toward zero.
 */

#include <cstdint>
#include <cstring>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t scenario = SCENARIO_NUM;
constexpr uint32_t row = 16;
constexpr uint32_t col = 16;
constexpr uint32_t total_length = row * col;
constexpr uint8_t copy_mutex_id = 0;

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void truncate_reg_loop(
    const SrcTensor src, DstTensor dst, uint32_t data_size, uint32_t column_count)
{
    using T = typename SrcTensor::data_type;
    using RegT = typename asc::te::experimental::reg_tensor<T>::reg_type;
    static_assert(std::is_same_v<T, typename DstTensor::data_type>,
        "truncate requires matching source and destination data types");

    constexpr uint32_t one_repeat = sizeof(RegT) / sizeof(T);
    const uint16_t repeat = static_cast<uint16_t>(data_size / one_repeat);
    const auto full_mask = asc::te::experimental::all_mask<T>();

    for (uint16_t i = 0; i < repeat; ++i) {
        const uint32_t offset = i * one_repeat;
        const auto coord = asc::te::make_coord(offset / column_count, offset % column_count);
        auto srcReg = asc::te::experimental::load(src, coord);
        srcReg.with_mask(full_mask);

        auto dstReg = asc::te::experimental::trunc(srcReg);
        asc::te::experimental::store(dst, coord, dstReg);
    }
}

template <typename T>
class KernelTruncateReg {
public:
    __aicore__ inline void process(__gm__ T* src, __gm__ T* dst, uint32_t row, uint32_t col)
    {
        auto srcGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto dstGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        constexpr uint32_t src_offset = 0;
        const uint32_t dst_offset = row * col * sizeof(T);
        auto srcUb = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(src_offset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto dstUb = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(dst_offset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), srcUb, srcGm);
        asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        truncate_reg_loop(srcUb, dstUb, row * col, col);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), dstGm, dstUb);
        asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    }
};

template <typename T>
__global__ __vector__ void truncate_reg_api(__gm__ uint8_t* src, __gm__ uint8_t* dst,
    uint32_t row, uint32_t col)
{
    KernelTruncateReg<T> kernel;
    kernel.process(reinterpret_cast<__gm__ T*>(src), reinterpret_cast<__gm__ T*>(dst), row, col);
}

static bool CheckAcl(aclError result, const char* apiName)
{
    if (result != ACL_SUCCESS) {
        ERROR_LOG("%s failed, error code = %d", apiName, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

static bool CompareResult(const void* outputData, size_t outputSize)
{
    void* goldenData = nullptr;
    if (!CheckAcl(aclrtMallocHost(&goldenData, outputSize), "aclrtMallocHost goldenData")) {
        return false;
    }

    size_t goldenSize = outputSize;
    const bool read_success = ReadFile("./output/golden.bin", goldenSize, goldenData, outputSize);
    const bool matched = read_success && goldenSize == outputSize &&
        std::memcmp(outputData, goldenData, outputSize) == 0;
    (void)CheckAcl(aclrtFreeHost(goldenData), "aclrtFreeHost goldenData");
    return matched;
}

template <typename T>
static bool RunScenario(aclrtStream stream)
{
    constexpr size_t data_size = total_length * sizeof(T);
    uint8_t* srcHost = nullptr;
    uint8_t* dstHost = nullptr;
    uint8_t* srcDevice = nullptr;
    uint8_t* dstDevice = nullptr;
    size_t readSize = data_size;
    bool success = false;

    if (!CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&srcHost), data_size), "aclrtMallocHost src") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&dstHost), data_size), "aclrtMallocHost dst") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&srcDevice), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc src") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&dstDevice), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc dst")) {
        goto cleanup;
    }

    if (!ReadFile("./input/input_x.bin", readSize, srcHost, data_size) || readSize != data_size ||
        !CheckAcl(aclrtMemcpy(srcDevice, data_size, srcHost, data_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device")) {
        goto cleanup;
    }

    truncate_reg_api<T><<<1, 0, stream>>>(srcDevice, dstDevice, row, col);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !CheckAcl(aclrtMemcpy(dstHost, data_size, dstDevice, data_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host") ||
        !WriteFile("./output/output.bin", dstHost, data_size)) {
        goto cleanup;
    }
    success = CompareResult(dstHost, data_size);

cleanup:
    if (srcDevice != nullptr) {
        (void)aclrtFree(srcDevice);
    }
    if (dstDevice != nullptr) {
        (void)aclrtFree(dstDevice);
    }
    if (srcHost != nullptr) {
        (void)aclrtFreeHost(srcHost);
    }
    if (dstHost != nullptr) {
        (void)aclrtFreeHost(dstHost);
    }
    return success;
}

int32_t main()
{
    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }

    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    bool success = CheckAcl(aclrtSetDevice(device_id), "aclrtSetDevice") &&
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    if (success) {
        if constexpr (scenario == 1) {
            success = RunScenario<half>(stream);
        } else if constexpr (scenario == 2) {
            success = RunScenario<bfloat16_t>(stream);
        } else {
            success = RunScenario<float>(stream);
        }
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return success ? 0 : 1;
}
