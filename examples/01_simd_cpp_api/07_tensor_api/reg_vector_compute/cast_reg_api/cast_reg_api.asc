/*!
 * \file cast_reg_api.asc
 * \brief Use the experimental register Tensor API to convert data types.
 */

#include <cstdint>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

constexpr uint32_t SCENARIO = SCENARIO_NUM;
constexpr uint32_t ROW = 16;
constexpr uint32_t COL = 16;
constexpr uint32_t TOTAL_LENGTH = ROW * COL;
constexpr uint8_t COPY_MUTEX_ID = 0;

constexpr asc::te::cast_options floor_cast_ops = {
    asc::te::cast_layout::zero, asc::te::cast_round_mode::floor, asc::te::cast_sat_mode::not_sat};
constexpr asc::te::cast_options saturating_rint_cast_ops = {
    asc::te::cast_layout::zero, asc::te::cast_round_mode::rint, asc::te::cast_sat_mode::sat};

template <typename DstT, typename SrcT>
__simd_callee__ inline asc::te::reg_tensor<DstT> CastRegister(asc::te::reg_tensor<SrcT> src)
{
    if constexpr (SCENARIO == 1) {
        return asc::te::cast<int32_t, floor_cast_ops>(src);
    } else if constexpr (SCENARIO == 2) {
        return asc::te::cast<int16_t, saturating_rint_cast_ops>(src);
    } else if constexpr (SCENARIO == 3) {
        return asc::te::cast<int32_t>(src);
    } else if constexpr (SCENARIO == 4) {
        return asc::te::cast<uint8_t, saturating_rint_cast_ops>(src);
    } else if constexpr (SCENARIO == 5) {
        return asc::te::cast<float>(src);
    } else {
        return asc::te::cast<bfloat16_t>(src);
    }
}

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void CastRegLoop(
    const SrcTensor src, DstTensor dst, uint32_t dataSize, uint32_t columnCount)
{
    using SrcT = typename SrcTensor::data_type;
    using DstT = typename DstTensor::data_type;
    using WiderT = std::conditional_t<(sizeof(SrcT) > sizeof(DstT)), SrcT, DstT>;
    using WiderRegT = typename asc::te::reg_tensor<WiderT>::reg_type;
    constexpr uint32_t ONE_REPEAT = sizeof(WiderRegT) / sizeof(WiderT);
    const uint16_t repeat = static_cast<uint16_t>(dataSize / ONE_REPEAT);
    uint32_t remain = dataSize;

    for (uint16_t i = 0; i < repeat; ++i) {
        const uint32_t offset = i * ONE_REPEAT;
        const auto coord = asc::te::make_coord(offset / columnCount, offset % columnCount);
        asc::te::reg_tensor<SrcT> srcReg;

        if constexpr (sizeof(DstT) == sizeof(SrcT)) {
            srcReg = src.load(coord);
        } else if constexpr (sizeof(DstT) == 2 * sizeof(SrcT)) {
            srcReg = src.template load<asc::te::load_sideband_mode::unpack>(coord);
        } else if constexpr (sizeof(DstT) == 4 * sizeof(SrcT)) {
            srcReg = src.template load<asc::te::load_sideband_mode::unpack4>(coord);
        } else {
            srcReg = src.load(coord);
        }
        srcReg = srcReg.with_mask(asc::te::update_mask<WiderT>(remain));

        auto dstReg = CastRegister<DstT>(srcReg);
        if constexpr (sizeof(DstT) == sizeof(SrcT) || sizeof(DstT) > sizeof(SrcT)) {
            dst.store(coord, dstReg);
        } else if constexpr (sizeof(SrcT) == 2 * sizeof(DstT)) {
            dst.template store<asc::te::store_sideband_mode::pack>(coord, dstReg);
        } else {
            dst.template store<asc::te::store_sideband_mode::pack_quarter>(coord, dstReg);
        }
    }
}

template <typename SrcT, typename DstT>
class KernelCastReg {
public:
    __aicore__ inline void Process(__gm__ SrcT* x, __gm__ DstT* y, uint32_t row, uint32_t col)
    {
        auto xGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(x),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto yGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(y),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        constexpr uint32_t xOffset = 0;
        const uint32_t yOffset = row * col * sizeof(SrcT);
        auto xUb = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, SrcT>(xOffset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto yUb = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DstT>(yOffset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        asc_lock(pipe_t::PIPE_MTE2, COPY_MUTEX_ID);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), xUb, xGm);
        asc_unlock(pipe_t::PIPE_MTE2, COPY_MUTEX_ID);

        asc_lock(pipe_t::PIPE_V, COPY_MUTEX_ID);
        CastRegLoop(xUb, yUb, row * col, col);
        asc_unlock(pipe_t::PIPE_V, COPY_MUTEX_ID);

        asc_lock(pipe_t::PIPE_MTE3, COPY_MUTEX_ID);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), yGm, yUb);
        asc_unlock(pipe_t::PIPE_MTE3, COPY_MUTEX_ID);
    }
};

template <typename SrcT, typename DstT>
__global__ __vector__ void cast_reg_api(__gm__ uint8_t* x, __gm__ uint8_t* y,
    uint32_t row, uint32_t col)
{
    KernelCastReg<SrcT, DstT> kernel;
    kernel.Process(reinterpret_cast<__gm__ SrcT*>(x),
        reinterpret_cast<__gm__ DstT*>(y), row, col);
}

template <typename DstT>
static bool CompareResult(const void* outputData, uint32_t outputSize)
{
    void* goldenData = nullptr;
    aclrtMallocHost(&goldenData, outputSize);
    size_t goldenSize = outputSize;
    if (!ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize)) {
        aclrtFreeHost(goldenData);
        return false;
    }

    int64_t wrongNum = 0;
    if constexpr (std::is_same_v<DstT, bfloat16_t>) {
        const auto* output = static_cast<const uint16_t*>(outputData);
        const auto* golden = static_cast<const uint16_t*>(goldenData);
        for (size_t i = 0; i < outputSize / sizeof(uint16_t); ++i) {
            if (output[i] != golden[i]) {
                ++wrongNum;
            }
        }
    } else {
        constexpr float EPS = 1e-4f;
        const auto* output = static_cast<const DstT*>(outputData);
        const auto* golden = static_cast<const DstT*>(goldenData);
        for (size_t i = 0; i < outputSize / sizeof(DstT); ++i) {
            float actual = static_cast<float>(output[i]);
            float expected = static_cast<float>(golden[i]);
            float difference = actual - expected;
            float absError = difference >= 0.0f ? difference : -difference;
            float expectedAbs = expected >= 0.0f ? expected : -expected;
            float relError = expectedAbs > EPS ? absError / expectedAbs : absError;
            if (absError > EPS && relError > EPS) {
                ++wrongNum;
            }
        }
    }
    aclrtFreeHost(goldenData);
    return wrongNum == 0;
}

template <typename SrcT, typename DstT>
static bool RunScenario(aclrtStream stream)
{
    constexpr size_t inputSize = TOTAL_LENGTH * sizeof(SrcT);
    constexpr size_t outputSize = TOTAL_LENGTH * sizeof(DstT);
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&xHost), inputSize);
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), outputSize);
    aclrtMalloc(reinterpret_cast<void**>(&xDevice), inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDevice), outputSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t readSize = inputSize;
    bool success = ReadFile("./input/input_x.bin", readSize, xHost, inputSize);
    if (success) {
        aclrtMemcpy(xDevice, inputSize, xHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);
        cast_reg_api<SrcT, DstT><<<1, 0, stream>>>(xDevice, yDevice, ROW, COL);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(yHost, outputSize, yDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile("./output/output.bin", yHost, outputSize);
        success = CompareResult<DstT>(yHost, outputSize);
    }

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    return success;
}

int32_t main()
{
    aclInit(nullptr);
    constexpr int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool success;
    if constexpr (SCENARIO == 1) {
        success = RunScenario<half, int32_t>(stream);
    } else if constexpr (SCENARIO == 2) {
        success = RunScenario<float, int16_t>(stream);
    } else if constexpr (SCENARIO == 3) {
        success = RunScenario<int8_t, int32_t>(stream);
    } else if constexpr (SCENARIO == 4) {
        success = RunScenario<int32_t, uint8_t>(stream);
    } else if constexpr (SCENARIO == 5) {
        success = RunScenario<bfloat16_t, float>(stream);
    } else {
        success = RunScenario<float, bfloat16_t>(stream);
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return success ? 0 : 1;
}
