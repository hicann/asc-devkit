/* !
 * \file composite_compute_tensor_api.asc
 * \brief composite_compute_tensor_api
 */

#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t vector_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_fma(
    InputTensor input_a, InputTensor input_b, InputTensor input_c, OutputTensor output)
{
    using data_type = typename InputTensor::data_type;

    auto mask = asc::te::experimental::make_mask<
        asc::te::experimental::mask_pattern::vl64, data_type>();
    auto a = asc::te::experimental::load(input_a, asc::te::make_coord(0, 0)).with_mask(mask);
    auto b = asc::te::experimental::load(input_b, asc::te::make_coord(0, 0)).with_mask(mask);
    auto c = asc::te::experimental::load(input_c, asc::te::make_coord(0, 0)).with_mask(mask);
    asc::te::experimental::store(output, asc::te::make_coord(0, 0), asc::te::experimental::fma(a, b, c));
}

__global__ __vector__ void composite_compute_tensor_api(
    __gm__ half* half_input_a, __gm__ half* half_input_b, __gm__ half* half_input_c,
    __gm__ float* float_input_a, __gm__ float* float_input_b, __gm__ float* float_input_c,
    __gm__ half* half_output, __gm__ float* float_output)
{
    constexpr uint32_t half_bytes = vector_length * sizeof(half);
    constexpr uint32_t float_bytes = vector_length * sizeof(float);

    constexpr uint32_t half_input_a_offset = 0;
    constexpr uint32_t half_input_b_offset = half_input_a_offset + half_bytes;
    constexpr uint32_t half_input_c_offset = half_input_b_offset + half_bytes;
    constexpr uint32_t half_output_offset = half_input_c_offset + half_bytes;
    constexpr uint32_t float_input_a_offset = half_output_offset + half_bytes;
    constexpr uint32_t float_input_b_offset = float_input_a_offset + float_bytes;
    constexpr uint32_t float_input_c_offset = float_input_b_offset + float_bytes;
    constexpr uint32_t float_output_offset = float_input_c_offset + float_bytes;

    auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto half_input_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_a), layout);
    auto half_input_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_b), layout);
    auto half_input_c_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_input_c), layout);
    auto float_input_a_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_a), layout);
    auto float_input_b_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_b), layout);
    auto float_input_c_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_input_c), layout);
    auto half_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(half_output), layout);
    auto float_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(float_output), layout);

    auto half_input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_a_offset), layout);
    auto half_input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_b_offset), layout);
    auto half_input_c_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_input_c_offset), layout);
    auto half_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, half>(half_output_offset), layout);
    auto float_input_a_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_a_offset), layout);
    auto float_input_b_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_b_offset), layout);
    auto float_input_c_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_input_c_offset), layout);
    auto float_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, float>(float_output_offset), layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, half_input_a_ub, half_input_a_gm);
    asc::te::copy(copy_in, half_input_b_ub, half_input_b_gm);
    asc::te::copy(copy_in, half_input_c_ub, half_input_c_gm);
    asc::te::copy(copy_in, float_input_a_ub, float_input_a_gm);
    asc::te::copy(copy_in, float_input_b_ub, float_input_b_gm);
    asc::te::copy(copy_in, float_input_c_ub, float_input_c_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_fma(half_input_a_ub, half_input_b_ub, half_input_c_ub, half_output_ub);
    compute_fma(float_input_a_ub, float_input_b_ub, float_input_c_ub, float_output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, half_output_gm, half_output_ub);
    asc::te::copy(copy_out, float_output_gm, float_output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t half_bytes = vector_length * sizeof(half);
    size_t float_bytes = vector_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* half_input_a_host = nullptr;
    half* half_input_b_host = nullptr;
    half* half_input_c_host = nullptr;
    float* float_input_a_host = nullptr;
    float* float_input_b_host = nullptr;
    float* float_input_c_host = nullptr;
    half* half_output_host = nullptr;
    float* float_output_host = nullptr;
    half* half_input_a_device = nullptr;
    half* half_input_b_device = nullptr;
    half* half_input_c_device = nullptr;
    float* float_input_a_device = nullptr;
    float* float_input_b_device = nullptr;
    float* float_input_c_device = nullptr;
    half* half_output_device = nullptr;
    float* float_output_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&half_input_a_host), half_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&half_input_b_host), half_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&half_input_c_host), half_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&float_input_a_host), float_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&float_input_b_host), float_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&float_input_c_host), float_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&half_output_host), half_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&float_output_host), float_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&half_input_a_device), half_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&half_input_b_device), half_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&half_input_c_device), half_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&float_input_a_device), float_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&float_input_b_device), float_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&float_input_c_device), float_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&half_output_device), half_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&float_output_device), float_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/half_input_a.bin", file_size, half_input_a_host, half_bytes);
    ReadFile("./input/half_input_b.bin", file_size, half_input_b_host, half_bytes);
    ReadFile("./input/half_input_c.bin", file_size, half_input_c_host, half_bytes);
    ReadFile("./input/float_input_a.bin", file_size, float_input_a_host, float_bytes);
    ReadFile("./input/float_input_b.bin", file_size, float_input_b_host, float_bytes);
    ReadFile("./input/float_input_c.bin", file_size, float_input_c_host, float_bytes);
    aclrtMemcpy(half_input_a_device, half_bytes, half_input_a_host, half_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(half_input_b_device, half_bytes, half_input_b_host, half_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(half_input_c_device, half_bytes, half_input_c_host, half_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(float_input_a_device, float_bytes, float_input_a_host, float_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(float_input_b_device, float_bytes, float_input_b_host, float_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(float_input_c_device, float_bytes, float_input_c_host, float_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    composite_compute_tensor_api<<<1, nullptr, stream>>>(
        half_input_a_device, half_input_b_device, half_input_c_device,
        float_input_a_device, float_input_b_device, float_input_c_device,
        half_output_device, float_output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(half_output_host, half_bytes, half_output_device, half_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(float_output_host, float_bytes, float_output_device, float_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/half_output.bin", half_output_host, half_bytes);
    WriteFile("./output/float_output.bin", float_output_host, float_bytes);

    aclrtFree(half_input_a_device);
    aclrtFree(half_input_b_device);
    aclrtFree(half_input_c_device);
    aclrtFree(float_input_a_device);
    aclrtFree(float_input_b_device);
    aclrtFree(float_input_c_device);
    aclrtFree(half_output_device);
    aclrtFree(float_output_device);
    aclrtFreeHost(half_input_a_host);
    aclrtFreeHost(half_input_b_host);
    aclrtFreeHost(half_input_c_host);
    aclrtFreeHost(float_input_a_host);
    aclrtFreeHost(float_input_b_host);
    aclrtFreeHost(float_input_c_host);
    aclrtFreeHost(half_output_host);
    aclrtFreeHost(float_output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "composite_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
