/* !
 * \file histogram_compute_tensor_api.asc
 * \brief histogram_compute_tensor_api
 */

#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t input_length = 256;
constexpr uint32_t bin_length = 128;
constexpr uint16_t initial_value = 3;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_histogram(InputTensor input, OutputTensor output)
{
    auto src = asc::te::experimental::load(input, asc::te::make_coord(0, 0))
                   .with_mask(asc::te::experimental::all_mask<uint8_t>());
    asc::te::experimental::reg_tensor<uint16_t> initial;
    initial.mask = asc::te::experimental::all_mask<uint16_t>().reg;
    asc_duplicate_scalar(initial.reg, initial_value, initial.mask);
    asc::te::experimental::store(
        output, asc::te::make_coord(0, 0), asc::te::experimental::histograms(initial, src));
}

__global__ __vector__ void histogram_compute_tensor_api(__gm__ uint8_t* input, __gm__ uint16_t* output)
{
    constexpr uint32_t input_offset = 0;
    constexpr uint32_t output_offset = input_length;

    auto input_layout =
        asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, input_length);
    auto output_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, bin_length);
    auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(input), input_layout);
    auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(output), output_layout);
    auto input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(input_offset), input_layout);
    auto output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(output_offset), output_layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), input_ub, input_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_histogram(input_ub, output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), output_gm, output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t input_bytes = input_length * sizeof(uint8_t);
    size_t output_bytes = bin_length * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* input_host = nullptr;
    uint16_t* output_host = nullptr;
    uint8_t* input_device = nullptr;
    uint16_t* output_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), input_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/input.bin", file_size, input_host, input_bytes);
    aclrtMemcpy(input_device, input_bytes, input_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    histogram_compute_tensor_api<<<1, nullptr, stream>>>(input_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", output_host, output_bytes);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "histogram_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
