/* !
 * \file logical_compute_tensor_api.asc
 * \brief logical_compute_tensor_api
 */

#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t vector_length = 64;
constexpr int16_t shift_bits = 1;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_shift_left(InputTensor input, OutputTensor output)
{
    using asc::te::experimental::operator<<;
    using data_type = typename InputTensor::data_type;

    auto value = asc::te::experimental::load(input, asc::te::make_coord(0, 0))
                     .with_mask(asc::te::experimental::make_mask<
                         asc::te::experimental::mask_pattern::vl64, data_type>());
    asc::te::experimental::store(output, asc::te::make_coord(0, 0), value << shift_bits);
}

__global__ __vector__ void logical_compute_tensor_api(
    __gm__ int8_t* int8_input, __gm__ uint8_t* uint8_input, __gm__ int16_t* int16_input,
    __gm__ uint16_t* uint16_input, __gm__ int32_t* int32_input, __gm__ uint32_t* uint32_input,
    __gm__ int8_t* int8_output, __gm__ uint8_t* uint8_output, __gm__ int16_t* int16_output,
    __gm__ uint16_t* uint16_output, __gm__ int32_t* int32_output, __gm__ uint32_t* uint32_output)
{
    constexpr uint32_t int8_bytes = vector_length * sizeof(int8_t);
    constexpr uint32_t uint8_bytes = vector_length * sizeof(uint8_t);
    constexpr uint32_t int16_bytes = vector_length * sizeof(int16_t);
    constexpr uint32_t uint16_bytes = vector_length * sizeof(uint16_t);
    constexpr uint32_t int32_bytes = vector_length * sizeof(int32_t);
    constexpr uint32_t uint32_bytes = vector_length * sizeof(uint32_t);

    constexpr uint32_t int8_input_offset = 0;
    constexpr uint32_t int8_output_offset = int8_input_offset + int8_bytes;
    constexpr uint32_t uint8_input_offset = int8_output_offset + int8_bytes;
    constexpr uint32_t uint8_output_offset = uint8_input_offset + uint8_bytes;
    constexpr uint32_t int16_input_offset = uint8_output_offset + uint8_bytes;
    constexpr uint32_t int16_output_offset = int16_input_offset + int16_bytes;
    constexpr uint32_t uint16_input_offset = int16_output_offset + int16_bytes;
    constexpr uint32_t uint16_output_offset = uint16_input_offset + uint16_bytes;
    constexpr uint32_t int32_input_offset = uint16_output_offset + uint16_bytes;
    constexpr uint32_t int32_output_offset = int32_input_offset + int32_bytes;
    constexpr uint32_t uint32_input_offset = int32_output_offset + int32_bytes;
    constexpr uint32_t uint32_output_offset = uint32_input_offset + uint32_bytes;

    auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(asc::te::_1 {}, asc::te::_64 {});
    auto int8_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int8_input), layout);
    auto uint8_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint8_input), layout);
    auto int16_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int16_input), layout);
    auto uint16_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint16_input), layout);
    auto int32_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int32_input), layout);
    auto uint32_input_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint32_input), layout);
    auto int8_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int8_output), layout);
    auto uint8_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint8_output), layout);
    auto int16_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int16_output), layout);
    auto uint16_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint16_output), layout);
    auto int32_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(int32_output), layout);
    auto uint32_output_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(uint32_output), layout);

    auto int8_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int8_t>(int8_input_offset), layout);
    auto uint8_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(uint8_input_offset), layout);
    auto int16_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int16_t>(int16_input_offset), layout);
    auto uint16_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(uint16_input_offset), layout);
    auto int32_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(int32_input_offset), layout);
    auto uint32_input_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(uint32_input_offset), layout);
    auto int8_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int8_t>(int8_output_offset), layout);
    auto uint8_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint8_t>(uint8_output_offset), layout);
    auto int16_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int16_t>(int16_output_offset), layout);
    auto uint16_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint16_t>(uint16_output_offset), layout);
    auto int32_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(int32_output_offset), layout);
    auto uint32_output_ub = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(uint32_output_offset), layout);

    asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
    auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
    asc::te::copy(copy_in, int8_input_ub, int8_input_gm);
    asc::te::copy(copy_in, uint8_input_ub, uint8_input_gm);
    asc::te::copy(copy_in, int16_input_ub, int16_input_gm);
    asc::te::copy(copy_in, uint16_input_ub, uint16_input_gm);
    asc::te::copy(copy_in, int32_input_ub, int32_input_gm);
    asc::te::copy(copy_in, uint32_input_ub, uint32_input_gm);
    asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
    asc_lock(pipe_t::PIPE_V, buffer_lock_id);

    compute_shift_left(int8_input_ub, int8_output_ub);
    compute_shift_left(uint8_input_ub, uint8_output_ub);
    compute_shift_left(int16_input_ub, int16_output_ub);
    compute_shift_left(uint16_input_ub, uint16_output_ub);
    compute_shift_left(int32_input_ub, int32_output_ub);
    compute_shift_left(uint32_input_ub, uint32_output_ub);

    asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
    asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
    auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm {});
    asc::te::copy(copy_out, int8_output_gm, int8_output_ub);
    asc::te::copy(copy_out, uint8_output_gm, uint8_output_ub);
    asc::te::copy(copy_out, int16_output_gm, int16_output_ub);
    asc::te::copy(copy_out, uint16_output_gm, uint16_output_ub);
    asc::te::copy(copy_out, int32_output_gm, int32_output_ub);
    asc::te::copy(copy_out, uint32_output_gm, uint32_output_ub);
    asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t int8_bytes = vector_length * sizeof(int8_t);
    size_t uint8_bytes = vector_length * sizeof(uint8_t);
    size_t int16_bytes = vector_length * sizeof(int16_t);
    size_t uint16_bytes = vector_length * sizeof(uint16_t);
    size_t int32_bytes = vector_length * sizeof(int32_t);
    size_t uint32_bytes = vector_length * sizeof(uint32_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int8_t* int8_input_host = nullptr;
    uint8_t* uint8_input_host = nullptr;
    int16_t* int16_input_host = nullptr;
    uint16_t* uint16_input_host = nullptr;
    int32_t* int32_input_host = nullptr;
    uint32_t* uint32_input_host = nullptr;
    int8_t* int8_output_host = nullptr;
    uint8_t* uint8_output_host = nullptr;
    int16_t* int16_output_host = nullptr;
    uint16_t* uint16_output_host = nullptr;
    int32_t* int32_output_host = nullptr;
    uint32_t* uint32_output_host = nullptr;
    int8_t* int8_input_device = nullptr;
    uint8_t* uint8_input_device = nullptr;
    int16_t* int16_input_device = nullptr;
    uint16_t* uint16_input_device = nullptr;
    int32_t* int32_input_device = nullptr;
    uint32_t* uint32_input_device = nullptr;
    int8_t* int8_output_device = nullptr;
    uint8_t* uint8_output_device = nullptr;
    int16_t* int16_output_device = nullptr;
    uint16_t* uint16_output_device = nullptr;
    int32_t* int32_output_device = nullptr;
    uint32_t* uint32_output_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&int8_input_host), int8_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint8_input_host), uint8_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&int16_input_host), int16_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint16_input_host), uint16_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&int32_input_host), int32_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint32_input_host), uint32_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&int8_output_host), int8_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint8_output_host), uint8_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&int16_output_host), int16_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint16_output_host), uint16_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&int32_output_host), int32_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&uint32_output_host), uint32_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&int8_input_device), int8_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint8_input_device), uint8_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&int16_input_device), int16_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint16_input_device), uint16_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&int32_input_device), int32_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint32_input_device), uint32_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&int8_output_device), int8_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint8_output_device), uint8_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&int16_output_device), int16_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint16_output_device), uint16_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&int32_output_device), int32_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&uint32_output_device), uint32_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/int8_input.bin", file_size, int8_input_host, int8_bytes);
    ReadFile("./input/uint8_input.bin", file_size, uint8_input_host, uint8_bytes);
    ReadFile("./input/int16_input.bin", file_size, int16_input_host, int16_bytes);
    ReadFile("./input/uint16_input.bin", file_size, uint16_input_host, uint16_bytes);
    ReadFile("./input/int32_input.bin", file_size, int32_input_host, int32_bytes);
    ReadFile("./input/uint32_input.bin", file_size, uint32_input_host, uint32_bytes);
    aclrtMemcpy(int8_input_device, int8_bytes, int8_input_host, int8_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(uint8_input_device, uint8_bytes, uint8_input_host, uint8_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(int16_input_device, int16_bytes, int16_input_host, int16_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(uint16_input_device, uint16_bytes, uint16_input_host, uint16_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(int32_input_device, int32_bytes, int32_input_host, int32_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(uint32_input_device, uint32_bytes, uint32_input_host, uint32_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    logical_compute_tensor_api<<<1, nullptr, stream>>>(
        int8_input_device, uint8_input_device, int16_input_device, uint16_input_device,
        int32_input_device, uint32_input_device, int8_output_device, uint8_output_device,
        int16_output_device, uint16_output_device, int32_output_device, uint32_output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(int8_output_host, int8_bytes, int8_output_device, int8_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(uint8_output_host, uint8_bytes, uint8_output_device, uint8_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(int16_output_host, int16_bytes, int16_output_device, int16_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(uint16_output_host, uint16_bytes, uint16_output_device, uint16_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(int32_output_host, int32_bytes, int32_output_device, int32_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(uint32_output_host, uint32_bytes, uint32_output_device, uint32_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/int8_output.bin", int8_output_host, int8_bytes);
    WriteFile("./output/uint8_output.bin", uint8_output_host, uint8_bytes);
    WriteFile("./output/int16_output.bin", int16_output_host, int16_bytes);
    WriteFile("./output/uint16_output.bin", uint16_output_host, uint16_bytes);
    WriteFile("./output/int32_output.bin", int32_output_host, int32_bytes);
    WriteFile("./output/uint32_output.bin", uint32_output_host, uint32_bytes);

    aclrtFree(int8_input_device);
    aclrtFree(uint8_input_device);
    aclrtFree(int16_input_device);
    aclrtFree(uint16_input_device);
    aclrtFree(int32_input_device);
    aclrtFree(uint32_input_device);
    aclrtFree(int8_output_device);
    aclrtFree(uint8_output_device);
    aclrtFree(int16_output_device);
    aclrtFree(uint16_output_device);
    aclrtFree(int32_output_device);
    aclrtFree(uint32_output_device);
    aclrtFreeHost(int8_input_host);
    aclrtFreeHost(uint8_input_host);
    aclrtFreeHost(int16_input_host);
    aclrtFreeHost(uint16_input_host);
    aclrtFreeHost(int32_input_host);
    aclrtFreeHost(uint32_input_host);
    aclrtFreeHost(int8_output_host);
    aclrtFreeHost(uint8_output_host);
    aclrtFreeHost(int16_output_host);
    aclrtFreeHost(uint16_output_host);
    aclrtFreeHost(int32_output_host);
    aclrtFreeHost(uint32_output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "logical_compute_tensor_api executed successfully." << std::endl;
    return 0;
}
