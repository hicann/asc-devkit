#include <cmath>
#include <cstdint>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint32_t row = 16;
constexpr uint32_t col = 16;
constexpr uint32_t total_length = row * col;
constexpr uint8_t buffer_lock_id = 0;

template <typename T, typename U, typename V>
__simd_vf__ inline void compare_vf(T x_tensor, U y_tensor, V z_tensor,
    uint32_t repeat_times, uint32_t one_repeat_size)
{
    uint32_t count = total_length;
    using data_type = typename T::data_type;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        auto mask = asc::te::experimental::update_mask<data_type>(count);
        uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset / col, offset % col);
        auto x_reg = asc::te::experimental::load(x_tensor, coord).with_mask(mask);
        auto y_reg = asc::te::experimental::load(y_tensor, coord).with_mask(mask);
        auto z_reg = asc::te::experimental::select((x_reg > y_reg), x_reg, y_reg);
        asc::te::experimental::store(z_tensor, coord, z_reg);
    }
}

template <typename T, typename U, typename V, typename S>
__simd_vf__ inline void compares_vf(T x_tensor, U y_tensor, V z_tensor, S scalar,
    uint32_t repeat_times, uint32_t one_repeat_size)
{
    uint32_t count = total_length;
    using data_type = typename T::data_type;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        auto mask = asc::te::experimental::update_mask<data_type>(count);
        uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset / col, offset % col);
        auto x_reg = asc::te::experimental::load(x_tensor, coord).with_mask(mask);
        auto y_reg = asc::te::experimental::load(y_tensor, coord);
        auto z_reg = asc::te::experimental::select((x_reg > scalar), x_reg, y_reg);
        asc::te::experimental::store(z_tensor, coord, z_reg);
    }
}

template <typename T>
class Kernel {
public:
    __aicore__ inline void process(__gm__ T* x, __gm__ T* y, __gm__ T* z, T scalar = 0)
    {
        auto layer_out = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col);
 	    auto x_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(x), layer_out);
 	    auto y_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(y), layer_out);
        auto z_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(z), layer_out);

        constexpr uint32_t x_offset = 0;
        const uint32_t y_offset = total_length * sizeof(T);

        const uint32_t z_offset = y_offset + total_length * sizeof(T);
        auto x_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(x_offset),
            layer_out);
        auto y_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(y_offset),
            layer_out);
        auto z_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, T>(z_offset),
            layer_out);
        
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub {});
        asc::te::copy(copy_in, x_ub, x_gm);
        asc::te::copy(copy_in, y_ub, y_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        
        // 一次repeat计算的数据个数
        constexpr uint32_t one_repeat_size = asc_get_vf_len() / sizeof(T);
        // 总迭代次数
        uint16_t repeat_times = static_cast<uint16_t>(
            AscendC::Std::ceil_align(total_length, one_repeat_size) / one_repeat_size);
        if constexpr (scenario_num == 1) {
            compare_vf(x_ub, y_ub, z_ub, repeat_times, one_repeat_size);
        } else {
            compares_vf(x_ub, y_ub, z_ub, scalar, repeat_times, one_repeat_size);
        }

        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), z_gm, z_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

template <typename T>
__global__ __vector__ void compare(__gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* z)
{
    constexpr uint32_t total_length = 256;
    float scalar = 0;
    Kernel<T> kernel;
    kernel.process(reinterpret_cast<__gm__ T*>(x), reinterpret_cast<__gm__ T*>(y),
        reinterpret_cast<__gm__ T*>(z), scalar);
}

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData;
    aclrtMallocHost((void**)(&goldenData), outSize);
    size_t goldenSize = outSize;
    bool ret = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (ret) {
        printf("ReadFile golden.bin success!\n");
    } else {
        printf("test failed!\n");
        aclrtFreeHost(goldenData);
        return false;
    }
    constexpr float eps = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > eps && re > eps) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    aclrtFreeHost(goldenData);
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult golden.bin success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t numBlocks = 1;
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    size_t inputByteSize = static_cast<size_t>(1) * total_length * sizeof(float);
    size_t outputByteSize = static_cast<size_t>(1) * total_length * sizeof(float);
    uint8_t *xHost, *yHost, *zHost;
    uint8_t *xDevice, *yDevice, *zDevice;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&yHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input_x.bin", inputByteSize, xHost, inputByteSize);
    ReadFile("./input/input_y.bin", inputByteSize, yHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, inputByteSize, yHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    compare<float><<<numBlocks, nullptr, stream>>>(xDevice, yDevice, zDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);
    bool goldenResult = true;
    goldenResult = CompareResult(zHost, outputByteSize);
    if (goldenResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
