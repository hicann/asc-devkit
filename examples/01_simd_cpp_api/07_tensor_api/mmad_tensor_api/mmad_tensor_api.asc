/* !
 * \file mmad_tensor_api.asc
 * \brief
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

template <
    typename A_TYPE, typename B_TYPE, typename L0C_TYPE, typename C_TYPE, int32_t baseM, int32_t baseN, int32_t baseK,
    int32_t stepM, int32_t stepN, int32_t stepK, bool ENABLE_UNITFLAG>
__cube__ __global__ void mmad_quant_custom(
    __gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ C_TYPE* z, __gm__ uint64_t* quant, int32_t m, int32_t n, int32_t k,
    int32_t singleCoreM, int32_t singleCoreN, int32_t singleCoreK)
{
    asc_init();
    using namespace asc::te;
    // Copy tiling info from GM to local
    uint32_t mIter = (m + singleCoreM - 1) / singleCoreM;
    uint32_t mIterIdx = block_idx % mIter;
    uint32_t nIterIdx = block_idx / mIter;
    int32_t actualSingleCoreM = m - mIterIdx * singleCoreM;
    int32_t actualSingleCoreN = n - nIterIdx * singleCoreN;
    actualSingleCoreM = actualSingleCoreM < singleCoreM ? actualSingleCoreM : singleCoreM;
    actualSingleCoreN = actualSingleCoreN < singleCoreN ? actualSingleCoreN : singleCoreN;

    auto gmATensor = make_tensor(make_mem_ptr(x), make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gmBTensor = make_tensor(make_mem_ptr(y), make_frame_layout<dn_ext_layout_ptn>(k, n));
    auto gmCTensor = make_tensor(make_mem_ptr(z), make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto gmQuantTensor = make_tensor(make_mem_ptr(quant), make_frame_layout<nd_ext_layout_ptn>(1, n));

    auto gmASingleTensor =
        gmATensor.slice(make_coord(mIterIdx * singleCoreM, 0), make_shape(actualSingleCoreM, singleCoreK));
    auto gmBSingleTensor =
        gmBTensor.slice(make_coord(0, nIterIdx * singleCoreN), make_shape(singleCoreK, actualSingleCoreN));
    auto gmCSingleTensor = gmCTensor.slice(
        make_coord(mIterIdx * singleCoreM, nIterIdx * singleCoreN), make_shape(actualSingleCoreM, actualSingleCoreN));
    auto gmQuantSingleTensor =
        gmQuantTensor.slice(make_coord(0, nIterIdx * singleCoreN), make_shape(1, actualSingleCoreN));

    __cbuf__ A_TYPE l1ABuf[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBuf[baseK * stepK * baseN * stepN];
    __cbuf__ uint64_t l1QuantBuf[baseN * stepN];
    __ca__ A_TYPE l0ABuf[baseM * baseK];
    __cb__ B_TYPE l0BBuf[baseK * baseN];
    __cc__ L0C_TYPE l0CBuf[baseM * baseN];

    auto l1QuantPtr = make_mem_ptr(l1QuantBuf);
    auto l0APtr = make_mem_ptr(l0ABuf);
    auto l0BPtr = make_mem_ptr(l0BBuf);
    auto l0CPtr = make_mem_ptr(l0CBuf);

    auto copyGM2L1Atom = make_copy(copy_gm_to_l1{}, copy_gm_to_l1_trait_default{});
    auto copyL12L0AAtom = make_copy(copy_l1_to_l0a{}, copy_l1_to_l0a_trait_default{});
    auto copyL12L0BAtom = make_copy(copy_l1_to_l0b{}, copy_l1_to_l0b_trait_default{});
    auto copyL0C2GMAtom = make_copy(copy_l0c_to_gm{}, copy_l0c_to_gm_trait_default{});
    auto mmadAtom = make_mmad(mmad_operation{}, mmad_trait_default{});

    auto l1ATensor = make_tensor(make_mem_ptr(l1ABuf), make_frame_layout<nz_layout_ptn, A_TYPE>(baseM * stepM, baseK * stepK));
    auto l1BTensor = make_tensor(make_mem_ptr(l1BBuf), make_frame_layout<zn_layout_ptn, B_TYPE>(baseK * stepK, baseN * stepN));

    uint32_t mLoop = (actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (actualSingleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;

    static constexpr uint32_t L1_Index = 0;
    static constexpr uint32_t L0_Index = 1;
    static constexpr uint32_t L0C_Index = 2;
    static constexpr uint32_t QUANT_Index = 3;
    uint16_t tileM = (actualSingleCoreM % baseM != 0) ? actualSingleCoreM % baseM : baseM;
    uint16_t tileN = (actualSingleCoreN % baseN != 0) ? actualSingleCoreN % baseN : baseN;
    uint16_t tileK = (singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;

    for (uint32_t i = 0; i < mLoop; i++) {
        uint16_t curM = (i + 1 == mLoop) ? tileM : baseM;
        for (uint32_t j = 0; j < nLoop; j++) {
            uint16_t curN = (j + 1 == nLoop) ? tileN : baseN;
            auto l0CTensor = make_tensor(l0CPtr, make_frame_layout<nz_layout_ptn>(curM, curN));
            for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                uint16_t curK = (kIter + 1 == kLoop) ? tileK : baseK;
                auto l0ATensor = make_tensor(l0APtr, make_frame_layout<nz_layout_ptn, A_TYPE>(curM, curK));
                auto l0BTensor = make_tensor(l0BPtr, make_frame_layout<zn_layout_ptn, B_TYPE>(curK, curN));
                if (kIter % stepK == 0) {
                    uint16_t curStepK = static_cast<uint16_t>(singleCoreK - kIter * baseK);
                    curStepK = curStepK < baseK * stepK ? curStepK : baseK * stepK;
                    asc_lock(PIPE_MTE2, L1_Index);
                    // GM -> L1A
                    copy(
                        copyGM2L1Atom, l1ATensor,
                        gmASingleTensor.slice(make_coord(i * baseM, kIter * baseK), make_shape(curM, curStepK)));
                    // GM -> L1B
                    copy(
                        copyGM2L1Atom, l1BTensor,
                        gmBSingleTensor.slice(make_coord(kIter * baseK, j * baseN), make_shape(curStepK, curN)));
                    asc_unlock(PIPE_MTE2, L1_Index);
                    asc_lock(PIPE_MTE1, L1_Index);
                }
                asc_lock(PIPE_MTE1, L0_Index);
                // L1A -> L0A
                copy(
                    copyL12L0AAtom, l0ATensor,
                    l1ATensor.slice(make_coord(0, kIter % stepK * baseK), make_shape(curM, curK)));
                // L1B -> L0B
                copy(
                    copyL12L0BAtom, l0BTensor,
                    l1BTensor.slice(make_coord(kIter % stepK * baseK, 0), make_shape(curK, curN)));
                if ((kIter + 1) % stepK == 0 || kIter + 1 == kLoop) {
                    asc_unlock(PIPE_MTE1, L1_Index);
                }
                asc_unlock(PIPE_MTE1, L0_Index);
                asc_lock(PIPE_M, L0_Index);

                // Mmad
                if (kIter == 0) {
                    asc_lock(PIPE_M, L0C_Index);
                }

                mmad_params para;
                para.m = curM;
                para.n = curN;
                para.k = curK;
                para.cmatrix_init_val = (kIter == 0) ? true : false;
                if constexpr (ENABLE_UNITFLAG) {
                    para.unit_flag = (kIter == kLoop - 1) ? 3 : 2;
                }
                mmad(mmadAtom.with(para), l0CTensor, l0ATensor, l0BTensor);
                if (kIter == kLoop - 1) {
                    asc_unlock(PIPE_M, L0C_Index);
                }

                asc_unlock(PIPE_M, L0_Index);
            }
            // L0C -> GM
            asc_lock(PIPE_MTE2, QUANT_Index);
            auto gmCSlice = gmCSingleTensor.slice(make_coord(i * baseM, j * baseN), make_shape(curM, curN));
            auto l1QuantTensor = make_tensor(l1QuantPtr, make_frame_layout<nd_ext_layout_ptn>(1, curN));
            copy(copyGM2L1Atom, l1QuantTensor, gmQuantSingleTensor.slice(make_coord(0, j * baseN), make_shape(1, curN)));
            asc_unlock(PIPE_MTE2, QUANT_Index);
            asc_lock(PIPE_FIX, QUANT_Index);

            asc_lock(PIPE_FIX, L0C_Index);
            if constexpr (ENABLE_UNITFLAG) {
                fixpipe_params params;
                params.unit_flag = 3;
                copy(copyL0C2GMAtom.with(params), gmCSlice, l0CTensor, l1QuantTensor);
            } else {
                copy(copyL0C2GMAtom, gmCSlice, l0CTensor, l1QuantTensor);
            }
            asc_unlock(PIPE_FIX, L0C_Index);
            asc_unlock(PIPE_FIX, QUANT_Index);
        }
    }

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = int8_t;
    using B_TYPE = int8_t;
    using L0C_TYPE = int32_t;
    using C_TYPE = half;

    int32_t m = 1024;
    int32_t n = 1024;
    int32_t k = 256;
    int32_t singleCoreM = 256;
    int32_t singleCoreN = 128;
    int32_t singleCoreK = 256;

    constexpr int32_t BASE_M = 256;
    constexpr int32_t BASE_N = 256;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr bool ENABLE_UNITFLAG = true;
    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = m * k * sizeof(A_TYPE);
    size_t param2FileSize = n * k * sizeof(B_TYPE);
    size_t param3FileSize = m * n * sizeof(C_TYPE);
    size_t param4FileSize = n * sizeof(uint64_t);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost, *quantHost;
    A_TYPE* xDevice;
    B_TYPE* yDevice;
    C_TYPE* zDevice;
    uint64_t* quantDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMallocHost((void**)(&quantHost), param4FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&quantDevice, param4FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);
    ReadFile("./input/quant.bin", param4FileSize, quantHost, param4FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(quantDevice, param4FileSize, quantHost, param4FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    mmad_quant_custom<A_TYPE, B_TYPE, L0C_TYPE, C_TYPE, BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K, ENABLE_UNITFLAG>
        <<<NUM_BLOCKS, 0, stream>>>(
            xDevice, yDevice, zDevice, quantDevice, m, n, k, singleCoreM, singleCoreN, singleCoreK);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(quantDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(quantHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
