#include <cmath>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 2;
constexpr uint32_t column_count = 48;
constexpr uint32_t total_length = row_count * column_count;
constexpr uint8_t copy_mutex_id = 0;
constexpr uint32_t scenario_num = SCENARIO_NUM;

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor>
__simd_vf__ inline void abs_diff_vf(
    const Src0Tensor src0, const Src1Tensor src1, DstTensor dst, uint16_t repeat_times, uint32_t total,
    uint32_t one_repeat_size)
{
    using data_type = typename Src0Tensor::data_type;
    uint32_t remain = total;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        const uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset);
        auto mask = asc::te::experimental::update_mask<data_type>(remain);
        auto src0_reg = asc::te::experimental::load(src0, coord).with_mask(mask);
        auto src1_reg = asc::te::experimental::load(src1, coord).with_mask(mask);
        auto dst_reg = asc::te::experimental::abs_diff(src0_reg, src1_reg);
        asc::te::experimental::store(dst, coord, dst_reg);
    }
}

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor>
__simd_vf__ inline void abs_diff_2d_vf(
    const Src0Tensor src0, const Src1Tensor src1, DstTensor dst, uint16_t repeat_times, uint32_t one_repeat_size)
{
    using data_type = typename Src0Tensor::data_type;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        uint32_t remain = one_repeat_size;
        const auto coord = asc::te::make_coord(i, 0);
        auto mask = asc::te::experimental::update_mask<data_type>(remain);
        auto src0_reg = asc::te::experimental::load(src0, coord).with_mask(mask);
        auto src1_reg = asc::te::experimental::load(src1, coord).with_mask(mask);
        auto dst_reg = asc::te::experimental::abs_diff(src0_reg, src1_reg);
        asc::te::experimental::store(dst, coord, dst_reg);
    }
}

template <uint32_t total_length, typename T>
__global__ __vector__ void abs_diff(__gm__ T* src0, __gm__ T* src1, __gm__ T* dst)
{
    asc_init();
    __ubuf__ T src0_buf[total_length];
    __ubuf__ T src1_buf[total_length];
    __ubuf__ T dst_buf[total_length];

    if constexpr (scenario_num == 1) {
        auto layout = asc::te::make_layout(asc::te::make_shape(total_length));
        auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src0), layout);
        auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src1), layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr(dst), layout);
        auto src0_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src0_buf), layout);
        auto src1_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src1_buf), layout);
        auto dst_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), layout);

        asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src0_ub, src0_gm);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src1_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        using reg_type = typename asc::te::experimental::reg_tensor<T>::reg_type;
        // 一次repeat计算的数据个数
        constexpr uint32_t one_repeat_size = sizeof(reg_type) / sizeof(T);
        // 总迭代次数
        uint16_t repeat_times = AscendC::Std::ceil_division(total_length, one_repeat_size);
        abs_diff_vf(src0_ub, src1_ub, dst_ub, repeat_times, total_length, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm{}), dst_gm, dst_ub);
        asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    } else {
        auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, asc::te::layout_trait_default<T>>(
            row_count, column_count);
        auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src0), layout);
        auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src1), layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr(dst), layout);
        auto src0_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src0_buf), layout);
        auto src1_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src1_buf), layout);
        auto dst_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), layout);

        asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src0_ub, src0_gm);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src1_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        // 一次repeat计算的数据个数
        constexpr uint32_t one_repeat_size = column_count;
        // 总迭代次数
        constexpr uint16_t repeat_times = row_count;
        abs_diff_2d_vf(src0_ub, src1_ub, dst_ub, repeat_times, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm{}), dst_gm, dst_ub);
        asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    }
    asc_sync();
}

static bool compare_result(const float* output, const float* src0, const float* src1)
{
    constexpr float eps = 1e-4f;
    for (uint32_t i = 0; i < total_length; ++i) {
        float expected = std::fabs(src0[i] - src1[i]);
        if (std::fabs(output[i] - expected) > eps) {
            printf("test failed at index %u: output is %f, expected is %f\n", i, output[i], expected);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

int32_t main()
{
    constexpr size_t tensor_bytes = total_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* src0_host = nullptr;
    float* src1_host = nullptr;
    float* dst_host = nullptr;
    float* src0_device = nullptr;
    float* src1_device = nullptr;
    float* dst_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < total_length; ++i) {
        src0_host[i] = static_cast<float>(i) / 32.0f - 1.0f;
        src1_host[i] = static_cast<float>(i) / 64.0f + 0.25f;
    }
    aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    abs_diff<total_length, float><<<1, 0, stream>>>(src0_device, src1_device, dst_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst_host, tensor_bytes, dst_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(dst_host, src0_host, src1_host);

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(dst_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
