#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t total_length = 256;
constexpr uint8_t buffer_lock_id = 0;

template <typename Src0TensorType, typename Src1TensorType, typename Dst0TensorType, typename Dst1TensorType>
__simd_vf__ inline void data_reorder_vf(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, Dst0TensorType dst0_tensor, Dst1TensorType dst1_tensor,
    uint32_t repeat_times, uint32_t one_repeat_size)
{
    for (uint16_t i = 0; i < repeat_times; ++i) {
        uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset);
        auto src0_reg = asc::te::experimental::load(src0_tensor, coord);
        auto src1_reg = asc::te::experimental::load(src1_tensor, coord);
        auto result = asc::te::experimental::deinterleave(src0_reg, src1_reg);
        asc::te::experimental::store(dst0_tensor, coord, result.first);
        asc::te::experimental::store(dst1_tensor, coord, result.second);
    }
}

template <typename DataType>
class Kernel {
public:
    __aicore__ inline void process(
        __gm__ DataType* src0, __gm__ DataType* src1, __gm__ DataType* dst0, __gm__ DataType* dst1)
    {
        auto layout = asc::te::make_layout(asc::te::make_shape(total_length), asc::te::make_stride(1));
        auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), layout);
        auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), layout);
        auto dst0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst0), layout);
        auto dst1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst1), layout);

        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = total_length * sizeof(DataType);
        constexpr uint32_t dst0_offset = src1_offset + total_length * sizeof(DataType);
        constexpr uint32_t dst1_offset = dst0_offset + total_length * sizeof(DataType);
        auto src0_ub =
            asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DataType>(src0_offset), layout);
        auto src1_ub =
            asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DataType>(src1_offset), layout);
        auto dst0_ub =
            asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DataType>(dst0_offset), layout);
        auto dst1_ub =
            asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DataType>(dst1_offset), layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        asc::te::copy(copy_in, src0_ub, src0_gm);
        asc::te::copy(copy_in, src1_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        constexpr uint32_t one_repeat_size = asc_get_vf_len() / sizeof(DataType);
        uint16_t repeat_times =
            static_cast<uint16_t>(AscendC::Std::ceil_align(total_length, one_repeat_size) / one_repeat_size);
        data_reorder_vf(src0_ub, src1_ub, dst0_ub, dst1_ub, repeat_times, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});
        asc::te::copy(copy_out, dst0_gm, dst0_ub);
        asc::te::copy(copy_out, dst1_gm, dst1_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

template <typename DataType>
__global__ __vector__ void data_reorder(
    __gm__ uint8_t* src0, __gm__ uint8_t* src1, __gm__ uint8_t* dst0, __gm__ uint8_t* dst1)
{
    Kernel<DataType> kernel;
    kernel.process(
        reinterpret_cast<__gm__ DataType*>(src0), reinterpret_cast<__gm__ DataType*>(src1),
        reinterpret_cast<__gm__ DataType*>(dst0), reinterpret_cast<__gm__ DataType*>(dst1));
}

static bool CompareResult(const void* outputData, const void* goldenData, uint32_t outSize)
{
    constexpr float eps = 1e-4;
    int64_t wrongNum = 0;

    for (size_t i = 0; i < outSize / sizeof(float); i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        float ae = std::abs(a - b);
        float re = ae / std::abs(b);
        if (ae > eps && re > eps) {
            printf("CompareResult golden.bin failed at index %zu: output is %lf, golden is %lf\n", i, a, b);
            wrongNum++;
        }
    }
    if (wrongNum != 0) {
        return false;
    } else {
        printf("CompareResult success!\n");
        return true;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint32_t numBlocks = 1;
    size_t byteSize = total_length * sizeof(float);
    uint8_t *src0Host, *src1Host, *dst0Host, *dst1Host;
    uint8_t *src0Device, *src1Device, *dst0Device, *dst1Device;
    aclrtMallocHost((void**)(&src0Host), byteSize);
    aclrtMallocHost((void**)(&src1Host), byteSize);
    aclrtMallocHost((void**)(&dst0Host), byteSize);
    aclrtMallocHost((void**)(&dst1Host), byteSize);
    aclrtMalloc((void**)&src0Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst0Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst1Device, byteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    size_t fileSize = byteSize;
    ReadFile("./input/input_src0.bin", fileSize, src0Host, byteSize);
    ReadFile("./input/input_src1.bin", fileSize, src1Host, byteSize);
    aclrtMemcpy(src0Device, byteSize, src0Host, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1Device, byteSize, src1Host, byteSize, ACL_MEMCPY_HOST_TO_DEVICE);
    data_reorder<float><<<numBlocks, 0, stream>>>(src0Device, src1Device, dst0Device, dst1Device);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(dst0Host, byteSize, dst0Device, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dst1Host, byteSize, dst1Device, byteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output_dst0.bin", dst0Host, byteSize);
    WriteFile("./output/output_dst1.bin", dst1Host, byteSize);
    void* g0;
    aclrtMallocHost((void**)(&g0), byteSize);
    size_t gs0 = byteSize;
    ReadFile("./output/golden_dst0.bin", gs0, g0, byteSize);
    bool r0 = CompareResult(dst0Host, g0, byteSize);
    aclrtFreeHost(g0);
    void* g1;
    aclrtMallocHost((void**)(&g1), byteSize);
    size_t gs1 = byteSize;
    ReadFile("./output/golden_dst1.bin", gs1, g1, byteSize);
    bool r1 = CompareResult(dst1Host, g1, byteSize);
    aclrtFreeHost(g1);
    if (r0 && r1) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
    aclrtFree(src0Device);
    aclrtFree(src1Device);
    aclrtFree(dst0Device);
    aclrtFree(dst1Device);
    aclrtFreeHost(src0Host);
    aclrtFreeHost(src1Host);
    aclrtFreeHost(dst0Host);
    aclrtFreeHost(dst1Host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
