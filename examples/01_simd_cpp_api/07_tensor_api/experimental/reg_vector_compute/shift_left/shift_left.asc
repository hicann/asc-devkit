#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 2;
constexpr uint32_t column_count = 64;
constexpr uint32_t total_length = row_count * column_count;
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint8_t buffer_lock_id = 0;

template <typename SrcTensorType, typename ShiftTensorType, typename DstTensorType>
__simd_vf__ inline void compute_shift_left_1d(
    SrcTensorType src_tensor, ShiftTensorType shift_tensor, DstTensorType dst_tensor)
{
    constexpr uint32_t vector_length = asc_get_vf_len() / sizeof(uint32_t);
    constexpr uint32_t repeat_times = total_length / vector_length;
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    for (uint32_t repeat = 0; repeat < repeat_times; ++repeat) {
        const auto coord = asc::te::make_coord(repeat * vector_length);
        auto src = asc::te::experimental::load(src_tensor, coord).with_mask(mask);
        auto shift = asc::te::experimental::load(shift_tensor, coord).with_mask(mask);
        auto dst = src << shift;
        asc::te::experimental::store(dst_tensor, coord, dst);
    }
}

template <typename SrcTensorType, typename ShiftTensorType, typename DstTensorType>
__simd_vf__ inline void compute_shift_left_2d(
    SrcTensorType src_tensor, ShiftTensorType shift_tensor, DstTensorType dst_tensor)
{
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    for (uint32_t row = 0; row < row_count; ++row) {
        const auto coord = asc::te::make_coord(row, 0);
        auto src = asc::te::experimental::load(src_tensor, coord).with_mask(mask);
        auto shift = asc::te::experimental::load(shift_tensor, coord).with_mask(mask);
        auto dst = src << shift;
        asc::te::experimental::store(dst_tensor, coord, dst);
    }
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ uint32_t* src, __gm__ int32_t* shift, __gm__ uint32_t* dst)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(uint32_t);
        constexpr uint32_t input_offset = 0;
        constexpr uint32_t shifts_offset = input_offset + tensor_bytes;
        constexpr uint32_t output_offset = shifts_offset + tensor_bytes;

        auto input_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(input_offset);
        auto shifts_mem = asc::te::make_mem_ptr<asc::te::location::ub, int32_t>(shifts_offset);
        auto output_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(output_offset);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});

        if constexpr (scenario_num == 1) {
            auto layout = asc::te::make_layout(asc::te::make_shape(total_length), asc::te::make_stride(1));
            auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
            auto shifts_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(shift), layout);
            auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
            auto input_ub = asc::te::make_tensor(input_mem, layout);
            auto shifts_ub = asc::te::make_tensor(shifts_mem, layout);
            auto output_ub = asc::te::make_tensor(output_mem, layout);

            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc::te::copy(copy_in, input_ub, input_gm);
            asc::te::copy(copy_in, shifts_ub, shifts_gm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_shift_left_1d(input_ub, shifts_ub, output_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            asc::te::copy(copy_out, output_gm, output_ub);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
        } else {
            auto layout = asc::te::make_layout(
                asc::te::make_shape(row_count, column_count), asc::te::make_stride(column_count, 1));
            auto copy_shape = asc::te::make_shape(1, column_count);
            auto input_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
            auto shifts_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(shift), layout);
            auto output_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
            auto input_ub = asc::te::make_tensor(input_mem, layout);
            auto shifts_ub = asc::te::make_tensor(shifts_mem, layout);
            auto output_ub = asc::te::make_tensor(output_mem, layout);

            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
                asc::te::copy(copy_in, input_ub, input_gm, coord, coord, copy_shape);
                asc::te::copy(copy_in, shifts_ub, shifts_gm, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            }
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_shift_left_2d(input_ub, shifts_ub, output_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
                asc::te::copy(copy_out, output_gm, output_ub, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
            }
        }
    }
};

__global__ __vector__ void shift_left(__gm__ uint32_t* src, __gm__ int32_t* shift, __gm__ uint32_t* dst)
{
    Kernel kernel;
    kernel.process(src, shift, dst);
}

static bool compare_result(const uint32_t* output, const uint32_t* input, const int32_t* shifts)
{
    for (uint32_t i = 0; i < total_length; ++i) {
        uint32_t expected = input[i] << shifts[i];
        if (output[i] != expected) {
            printf("test failed at index %u: output is %u, expected is %u\n", i, output[i], expected);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

static bool check_acl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    printf("[ERROR] %s failed: %d\n", operation, status);
    return false;
}

static bool check_pointer(const void* pointer, const char* name)
{
    if (pointer != nullptr) {
        return true;
    }
    printf("[ERROR] %s is null\n", name);
    return false;
}

int32_t main()
{
    constexpr size_t tensor_bytes = total_length * sizeof(uint32_t);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint32_t* input_host = nullptr;
    int32_t* shifts_host = nullptr;
    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    int32_t* shifts_device = nullptr;
    uint32_t* output_device = nullptr;
    bool initialized = false;
    bool device_set = false;
    bool success = false;
    aclError status = aclInit(nullptr);
    if (!check_acl(status, "aclInit")) {
        goto cleanup;
    }
    initialized = true;
    status = aclrtSetDevice(device_id);
    if (!check_acl(status, "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    status = aclrtCreateStream(&stream);
    if (!check_acl(status, "aclrtCreateStream") || !check_pointer(stream, "stream")) {
        goto cleanup;
    }

    status = aclrtMallocHost(reinterpret_cast<void**>(&input_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost input_host") || !check_pointer(input_host, "input_host")) {
        goto cleanup;
    }
    status = aclrtMallocHost(reinterpret_cast<void**>(&shifts_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost shifts_host") || !check_pointer(shifts_host, "shifts_host")) {
        goto cleanup;
    }
    status = aclrtMallocHost(reinterpret_cast<void**>(&output_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost output_host") || !check_pointer(output_host, "output_host")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&input_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc input_device") || !check_pointer(input_device, "input_device")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&shifts_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc shifts_device") || !check_pointer(shifts_device, "shifts_device")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&output_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc output_device") || !check_pointer(output_device, "output_device")) {
        goto cleanup;
    }

    for (uint32_t i = 0; i < total_length; ++i) {
        input_host[i] = i * 0x01020305U + 0x12345678U;
        shifts_host[i] = static_cast<int32_t>(i % 8U);
    }
    status = aclrtMemcpy(input_device, tensor_bytes, input_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (!check_acl(status, "aclrtMemcpy input")) {
        goto cleanup;
    }
    status = aclrtMemcpy(shifts_device, tensor_bytes, shifts_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (!check_acl(status, "aclrtMemcpy shifts")) {
        goto cleanup;
    }

    shift_left<<<1, 0, stream>>>(input_device, shifts_device, output_device);
    status = aclrtSynchronizeStream(stream);
    if (!check_acl(status, "aclrtSynchronizeStream")) {
        goto cleanup;
    }

    status = aclrtMemcpy(output_host, tensor_bytes, output_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!check_acl(status, "aclrtMemcpy output")) {
        goto cleanup;
    }
    success = compare_result(output_host, input_host, shifts_host);

cleanup:
    if (input_device != nullptr && !check_acl(aclrtFree(input_device), "aclrtFree input_device"))
        success = false;
    if (shifts_device != nullptr && !check_acl(aclrtFree(shifts_device), "aclrtFree shifts_device"))
        success = false;
    if (output_device != nullptr && !check_acl(aclrtFree(output_device), "aclrtFree output_device"))
        success = false;
    if (input_host != nullptr && !check_acl(aclrtFreeHost(input_host), "aclrtFreeHost input_host"))
        success = false;
    if (shifts_host != nullptr && !check_acl(aclrtFreeHost(shifts_host), "aclrtFreeHost shifts_host"))
        success = false;
    if (output_host != nullptr && !check_acl(aclrtFreeHost(output_host), "aclrtFreeHost output_host"))
        success = false;
    if (stream != nullptr && !check_acl(aclrtDestroyStream(stream), "aclrtDestroyStream"))
        success = false;
    if (device_set && !check_acl(aclrtResetDevice(device_id), "aclrtResetDevice"))
        success = false;
    if (initialized && !check_acl(aclFinalize(), "aclFinalize"))
        success = false;

    return success ? 0 : 1;
}
