/*!
 * \file trunc.asc
 * \brief Use the experimental register Tensor API to truncate floating-point values toward zero.
 */

#include <cstdint>
#include <cstring>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t scenario = SCENARIO_NUM;
constexpr uint32_t row = 16;
constexpr uint32_t col = 16;
constexpr uint32_t total_length = row * col;
constexpr uint8_t copy_mutex_id = 0;

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void trunc_reg_loop(const SrcTensor src, DstTensor dst, uint32_t data_size, uint32_t column_count)
{
    using data_type = typename SrcTensor::data_type;
    using reg_type = typename asc::te::experimental::reg_tensor<data_type>::reg_type;
    static_assert(
        std::is_same_v<data_type, typename DstTensor::data_type>,
        "trunc requires matching source and destination data types");

    constexpr uint32_t one_repeat = sizeof(reg_type) / sizeof(data_type);
    const uint16_t repeat = static_cast<uint16_t>(data_size / one_repeat);
    const auto full_mask = asc::te::experimental::all_mask<data_type>();

    for (uint16_t i = 0; i < repeat; ++i) {
        const uint32_t offset = i * one_repeat;
        const auto coord = asc::te::make_coord(offset / column_count, offset % column_count);
        auto src_reg = asc::te::experimental::load(src, coord);
        src_reg.with_mask(full_mask);

        auto dst_reg = asc::te::experimental::trunc(src_reg);
        asc::te::experimental::store(dst, coord, dst_reg);
    }
}

template <typename T>
class KernelTruncReg {
public:
    __aicore__ inline void process(__gm__ T* src, __gm__ T* dst, uint32_t row, uint32_t col)
    {
        auto src_gm = asc::te::make_tensor(
            asc::te::make_mem_ptr<asc::te::location::gm>(src),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto dst_gm = asc::te::make_tensor(
            asc::te::make_mem_ptr<asc::te::location::gm>(dst),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        constexpr uint32_t src_offset = 0;
        const uint32_t dst_offset = row * col * sizeof(T);
        auto src_ub = asc::te::make_tensor(
            asc::te::make_mem_ptr<asc::te::location::ub, T>(src_offset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));
        auto dst_ub = asc::te::make_tensor(
            asc::te::make_mem_ptr<asc::te::location::ub, T>(dst_offset),
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(row, col));

        asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        trunc_reg_loop(src_ub, dst_ub, row * col, col);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm{}), dst_gm, dst_ub);
        asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    }
};

template <typename T>
__global__ __vector__ void trunc(__gm__ uint8_t* src, __gm__ uint8_t* dst, uint32_t row, uint32_t col)
{
    KernelTruncReg<T> kernel;
    kernel.process(reinterpret_cast<__gm__ T*>(src), reinterpret_cast<__gm__ T*>(dst), row, col);
}

static bool check_acl(aclError result, const char* api_name)
{
    if (result != ACL_SUCCESS) {
        ERROR_LOG("%s failed, error code = %d", api_name, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

static bool compare_result(const void* output_data, size_t output_size)
{
    void* golden_data = nullptr;
    if (!check_acl(aclrtMallocHost(&golden_data, output_size), "aclrtMallocHost golden_data")) {
        return false;
    }

    size_t golden_size = output_size;
    const bool read_success = read_file("./output/golden.bin", golden_size, golden_data, output_size);
    const bool matched =
        read_success && golden_size == output_size && std::memcmp(output_data, golden_data, output_size) == 0;
    (void)check_acl(aclrtFreeHost(golden_data), "aclrtFreeHost golden_data");
    return matched;
}

template <typename T>
static bool run_scenario(aclrtStream stream)
{
    constexpr size_t data_size = total_length * sizeof(T);
    uint8_t* src_host = nullptr;
    uint8_t* dst_host = nullptr;
    uint8_t* src_device = nullptr;
    uint8_t* dst_device = nullptr;
    size_t read_size = data_size;
    bool success = false;

    if (!check_acl(aclrtMallocHost(reinterpret_cast<void**>(&src_host), data_size), "aclrtMallocHost src") ||
        !check_acl(aclrtMallocHost(reinterpret_cast<void**>(&dst_host), data_size), "aclrtMallocHost dst") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&src_device), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc src") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc dst")) {
        goto cleanup;
    }

    if (!read_file("./input/input_x.bin", read_size, src_host, data_size) || read_size != data_size ||
        !check_acl(
            aclrtMemcpy(src_device, data_size, src_host, data_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device")) {
        goto cleanup;
    }

    trunc<T><<<1, 0, stream>>>(src_device, dst_device, row, col);
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl(
            aclrtMemcpy(dst_host, data_size, dst_device, data_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host") ||
        !write_file("./output/output.bin", dst_host, data_size)) {
        goto cleanup;
    }
    success = compare_result(dst_host, data_size);

cleanup:
    if (src_device != nullptr) {
        (void)aclrtFree(src_device);
    }
    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    if (src_host != nullptr) {
        (void)aclrtFreeHost(src_host);
    }
    if (dst_host != nullptr) {
        (void)aclrtFreeHost(dst_host);
    }
    return success;
}

int32_t main()
{
    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }

    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    bool success = check_acl(aclrtSetDevice(device_id), "aclrtSetDevice") &&
                   check_acl(aclrtCreateStream(&stream), "aclrtCreateStream");

    if (success) {
        if constexpr (scenario == 1) {
            success = run_scenario<half>(stream);
        } else if constexpr (scenario == 2) {
            success = run_scenario<bfloat16_t>(stream);
        } else {
            success = run_scenario<float>(stream);
        }
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return success ? 0 : 1;
}
