#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 2;
constexpr uint32_t column_count = 64;
constexpr uint32_t total_length = row_count * column_count;
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint8_t buffer_lock_id = 0;

template <typename Src0TensorType, typename Src1TensorType, typename LowTensorType, typename HighTensorType>
__simd_vf__ inline void compute_mull_1d(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, LowTensorType low_tensor, HighTensorType high_tensor)
{
    constexpr uint32_t vector_length = asc_get_vf_len() / sizeof(uint32_t);
    constexpr uint32_t repeat_times = total_length / vector_length;
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    for (uint32_t repeat = 0; repeat < repeat_times; ++repeat) {
        const auto coord = asc::te::make_coord(repeat * vector_length);
        auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
        auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
        auto result = asc::te::experimental::mull(src0, src1);
        asc::te::experimental::store(low_tensor, coord, result.first);
        asc::te::experimental::store(high_tensor, coord, result.second);
    }
}

template <typename Src0TensorType, typename Src1TensorType, typename LowTensorType, typename HighTensorType>
__simd_vf__ inline void compute_mull_2d(
    Src0TensorType src0_tensor, Src1TensorType src1_tensor, LowTensorType low_tensor, HighTensorType high_tensor)
{
    auto mask = asc::te::experimental::all_mask<uint32_t>();
    for (uint32_t row = 0; row < row_count; ++row) {
        const auto coord = asc::te::make_coord(row, 0);
        auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
        auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
        auto result = asc::te::experimental::mull(src0, src1);
        asc::te::experimental::store(low_tensor, coord, result.first);
        asc::te::experimental::store(high_tensor, coord, result.second);
    }
}

class Kernel {
public:
    __aicore__ inline void process(
        __gm__ uint32_t* src0, __gm__ uint32_t* src1, __gm__ uint32_t* low, __gm__ uint32_t* high)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(uint32_t);
        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = src0_offset + tensor_bytes;
        constexpr uint32_t low_offset = src1_offset + tensor_bytes;
        constexpr uint32_t high_offset = low_offset + tensor_bytes;

        auto src0_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(src0_offset);
        auto src1_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(src1_offset);
        auto low_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(low_offset);
        auto high_mem = asc::te::make_mem_ptr<asc::te::location::ub, uint32_t>(high_offset);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});

        if constexpr (scenario_num == 1) {
            auto layout = asc::te::make_layout(asc::te::make_shape(total_length), asc::te::make_stride(1));
            auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), layout);
            auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), layout);
            auto low_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(low), layout);
            auto high_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(high), layout);
            auto src0_ub = asc::te::make_tensor(src0_mem, layout);
            auto src1_ub = asc::te::make_tensor(src1_mem, layout);
            auto low_ub = asc::te::make_tensor(low_mem, layout);
            auto high_ub = asc::te::make_tensor(high_mem, layout);

            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc::te::copy(copy_in, src0_ub, src0_gm);
            asc::te::copy(copy_in, src1_ub, src1_gm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_mull_1d(src0_ub, src1_ub, low_ub, high_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            asc::te::copy(copy_out, low_gm, low_ub);
            asc::te::copy(copy_out, high_gm, high_ub);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
        } else {
            auto layout = asc::te::make_layout(
                asc::te::make_shape(row_count, column_count), asc::te::make_stride(column_count, 1));
            auto copy_shape = asc::te::make_shape(1, column_count);
            auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), layout);
            auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), layout);
            auto low_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(low), layout);
            auto high_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(high), layout);
            auto src0_ub = asc::te::make_tensor(src0_mem, layout);
            auto src1_ub = asc::te::make_tensor(src1_mem, layout);
            auto low_ub = asc::te::make_tensor(low_mem, layout);
            auto high_ub = asc::te::make_tensor(high_mem, layout);

            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
                asc::te::copy(copy_in, src0_ub, src0_gm, coord, coord, copy_shape);
                asc::te::copy(copy_in, src1_ub, src1_gm, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            }
            asc_lock(pipe_t::PIPE_V, buffer_lock_id);
            compute_mull_2d(src0_ub, src1_ub, low_ub, high_ub);
            asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
            for (uint32_t row = 0; row < row_count; ++row) {
                const auto coord = asc::te::make_coord(row, 0);
                asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
                asc::te::copy(copy_out, low_gm, low_ub, coord, coord, copy_shape);
                asc::te::copy(copy_out, high_gm, high_ub, coord, coord, copy_shape);
                asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
            }
        }
    }
};

__global__ __vector__ void mull(
    __gm__ uint32_t* src0, __gm__ uint32_t* src1, __gm__ uint32_t* low, __gm__ uint32_t* high)
{
    Kernel kernel;
    kernel.process(src0, src1, low, high);
}

static bool compare_result(const uint32_t* low, const uint32_t* high, const uint32_t* src0, const uint32_t* src1)
{
    for (uint32_t i = 0; i < total_length; ++i) {
        uint64_t product = static_cast<uint64_t>(src0[i]) * static_cast<uint64_t>(src1[i]);
        uint32_t expected_low = static_cast<uint32_t>(product);
        uint32_t expected_high = static_cast<uint32_t>(product >> 32);
        if (low[i] != expected_low || high[i] != expected_high) {
            printf(
                "test failed at index %u: low is %u, high is %u, expected low is %u, expected high is %u\n", i, low[i],
                high[i], expected_low, expected_high);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

static bool check_acl(aclError status, const char* operation)
{
    if (status == ACL_SUCCESS) {
        return true;
    }
    printf("[ERROR] %s failed: %d\n", operation, status);
    return false;
}

static bool check_pointer(const void* pointer, const char* name)
{
    if (pointer != nullptr) {
        return true;
    }
    printf("[ERROR] %s is null\n", name);
    return false;
}

int32_t main()
{
    constexpr size_t tensor_bytes = total_length * sizeof(uint32_t);
    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint32_t* src0_host = nullptr;
    uint32_t* src1_host = nullptr;
    uint32_t* low_host = nullptr;
    uint32_t* high_host = nullptr;
    uint32_t* src0_device = nullptr;
    uint32_t* src1_device = nullptr;
    uint32_t* low_device = nullptr;
    uint32_t* high_device = nullptr;
    bool initialized = false;
    bool device_set = false;
    bool success = false;
    aclError status = aclInit(nullptr);
    if (!check_acl(status, "aclInit")) {
        goto cleanup;
    }
    initialized = true;
    status = aclrtSetDevice(device_id);
    if (!check_acl(status, "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    status = aclrtCreateStream(&stream);
    if (!check_acl(status, "aclrtCreateStream") || !check_pointer(stream, "stream")) {
        goto cleanup;
    }

    status = aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost src0_host") || !check_pointer(src0_host, "src0_host")) {
        goto cleanup;
    }
    status = aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost src1_host") || !check_pointer(src1_host, "src1_host")) {
        goto cleanup;
    }
    status = aclrtMallocHost(reinterpret_cast<void**>(&low_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost low_host") || !check_pointer(low_host, "low_host")) {
        goto cleanup;
    }
    status = aclrtMallocHost(reinterpret_cast<void**>(&high_host), tensor_bytes);
    if (!check_acl(status, "aclrtMallocHost high_host") || !check_pointer(high_host, "high_host")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc src0_device") || !check_pointer(src0_device, "src0_device")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc src1_device") || !check_pointer(src1_device, "src1_device")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&low_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc low_device") || !check_pointer(low_device, "low_device")) {
        goto cleanup;
    }
    status = aclrtMalloc(reinterpret_cast<void**>(&high_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    if (!check_acl(status, "aclrtMalloc high_device") || !check_pointer(high_device, "high_device")) {
        goto cleanup;
    }

    for (uint32_t i = 0; i < total_length; ++i) {
        src0_host[i] = 0xf0000000U + i * 0x01020304U;
        src1_host[i] = 0x00010001U + i * 0x00100011U;
    }
    status = aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (!check_acl(status, "aclrtMemcpy src0")) {
        goto cleanup;
    }
    status = aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (!check_acl(status, "aclrtMemcpy src1")) {
        goto cleanup;
    }

    mull<<<1, 0, stream>>>(src0_device, src1_device, low_device, high_device);
    status = aclrtSynchronizeStream(stream);
    if (!check_acl(status, "aclrtSynchronizeStream")) {
        goto cleanup;
    }

    status = aclrtMemcpy(low_host, tensor_bytes, low_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!check_acl(status, "aclrtMemcpy low")) {
        goto cleanup;
    }
    status = aclrtMemcpy(high_host, tensor_bytes, high_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!check_acl(status, "aclrtMemcpy high")) {
        goto cleanup;
    }
    success = compare_result(low_host, high_host, src0_host, src1_host);

cleanup:
    if (src0_device != nullptr && !check_acl(aclrtFree(src0_device), "aclrtFree src0_device"))
        success = false;
    if (src1_device != nullptr && !check_acl(aclrtFree(src1_device), "aclrtFree src1_device"))
        success = false;
    if (low_device != nullptr && !check_acl(aclrtFree(low_device), "aclrtFree low_device"))
        success = false;
    if (high_device != nullptr && !check_acl(aclrtFree(high_device), "aclrtFree high_device"))
        success = false;
    if (src0_host != nullptr && !check_acl(aclrtFreeHost(src0_host), "aclrtFreeHost src0_host"))
        success = false;
    if (src1_host != nullptr && !check_acl(aclrtFreeHost(src1_host), "aclrtFreeHost src1_host"))
        success = false;
    if (low_host != nullptr && !check_acl(aclrtFreeHost(low_host), "aclrtFreeHost low_host"))
        success = false;
    if (high_host != nullptr && !check_acl(aclrtFreeHost(high_host), "aclrtFreeHost high_host"))
        success = false;
    if (stream != nullptr && !check_acl(aclrtDestroyStream(stream), "aclrtDestroyStream"))
        success = false;
    if (device_set && !check_acl(aclrtResetDevice(device_id), "aclrtResetDevice"))
        success = false;
    if (initialized && !check_acl(aclFinalize(), "aclFinalize"))
        success = false;

    return success ? 0 : 1;
}
