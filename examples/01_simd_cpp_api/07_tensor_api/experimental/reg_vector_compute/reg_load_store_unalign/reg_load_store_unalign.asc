#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_ops.h"

constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint8_t buffer_lock_id = 0;
constexpr uint32_t copy_length = 1024;
constexpr uint32_t copy_elements = 128;
constexpr uint32_t total_rows = 14;
constexpr uint32_t rows_per_core = 4;
constexpr uint32_t input_columns = 255;
constexpr uint32_t output_columns = 16;
constexpr uint32_t datablock_elements = 16;

template <typename Tensor, typename Stream>
__simd_vf__ inline void copy_unalign_vf(Tensor dst_tensor, Stream src_stream, Stream dst_stream, uint16_t repeat_time)
{
    constexpr uint32_t elements_per_register = asc::te::get_vf_len() / sizeof(float);
    uint32_t remaining = copy_length;
    for (uint32_t offset = 0; offset < copy_length; offset += elements_per_register) {
        auto mask = asc::te::experimental::update_mask<float>(remaining);
        auto zeros = asc::te::experimental::fill(0.0f, mask);
        asc::te::experimental::store(dst_tensor, asc::te::make_coord(offset), zeros);
    }

    asc::te::experimental::unalign_load loader;
    asc::te::experimental::unalign_store storer;
    loader.prepare(src_stream);
    for (uint32_t repeat = 0; repeat < repeat_time; ++repeat) {
        auto coord = asc::te::make_coord(repeat * elements_per_register);
        auto src = loader.load(src_stream, coord);
        storer.store(dst_stream, coord, src, elements_per_register);
    }
    storer.flush(dst_stream, static_cast<int32_t>(repeat_time * elements_per_register));
}

__global__ __vector__ void copy_unalign(__gm__ float* src, __gm__ float* dst)
{
    asc::te::mutex<pipe_t::PIPE_MTE2> copy_in_mutex(buffer_lock_id);
    asc::te::mutex<pipe_t::PIPE_V> compute_mutex(buffer_lock_id);
    asc::te::mutex<pipe_t::PIPE_MTE3> copy_out_mutex(buffer_lock_id);
    auto layout = asc::te::make_layout(asc::te::make_shape(copy_length), asc::te::make_stride(1));
    __ubuf__ float src_buf[copy_length];
    __ubuf__ float dst_buf[copy_length];
    auto src_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
    auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
    auto src_copy_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src_buf), layout);
    auto dst_copy_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), layout);

    copy_in_mutex.lock();
    asc::te::copy(src_copy_ub, src_gm);
    copy_in_mutex.unlock();

    compute_mutex.lock();
    auto src_stream = src_copy_ub.slice(asc::te::make_coord(1), asc::te::make_shape(copy_length - 1));
    auto dst_stream = dst_copy_ub.slice(asc::te::make_coord(1), asc::te::make_shape(copy_length - 1));
    uint32_t elements_per_register = asc::te::get_vf_len() / sizeof(float);
    uint16_t repeat_time = static_cast<uint16_t>((copy_elements + elements_per_register - 1) / elements_per_register);
    copy_unalign_vf(dst_copy_ub, src_stream, dst_stream, repeat_time);
    compute_mutex.unlock();

    copy_out_mutex.lock();
    asc::te::copy(dst_gm, dst_copy_ub);
    copy_out_mutex.unlock();
}

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void reduce_unalign_vf(SrcTensor src_row, DstTensor dst_row, uint16_t repeat_time)
{
    constexpr uint32_t elements_per_register = asc::te::get_vf_len() / sizeof(uint16_t);
    constexpr uint32_t results_per_register = asc::te::get_vf_len() / 32;
    asc::te::experimental::unalign_load loader;
    asc::te::experimental::unalign_store storer;
    loader.prepare(src_row);
    uint32_t remaining = input_columns;
    for (uint32_t repeat = 0; repeat < repeat_time; ++repeat) {
        auto mask = asc::te::experimental::update_mask<uint16_t>(remaining);
        auto src = loader.load(src_row, asc::te::make_coord(repeat * elements_per_register)).with_mask(mask);
        auto dst = asc::te::experimental::reduce_max<asc::te::experimental::reduce_scope::datablock>(src);
        storer.store(dst_row, asc::te::make_coord(repeat * results_per_register), dst, results_per_register);
    }
    storer.flush(dst_row, static_cast<int32_t>(repeat_time * results_per_register));
}

__global__ __vector__ void reduce_unalign(__gm__ uint16_t* src, __gm__ uint16_t* dst)
{
    asc::te::mutex<pipe_t::PIPE_MTE2> copy_in_mutex(buffer_lock_id);
    asc::te::mutex<pipe_t::PIPE_V> compute_mutex(buffer_lock_id);
    asc::te::mutex<pipe_t::PIPE_MTE3> copy_out_mutex(buffer_lock_id);
    uint32_t first_row = static_cast<uint32_t>(block_idx) * rows_per_core;
    uint32_t row_count = total_rows - first_row;
    if (row_count > rows_per_core) {
        row_count = rows_per_core;
    }
    constexpr uint32_t src_capacity = rows_per_core * input_columns + asc::te::get_vf_len() / sizeof(uint16_t);
    auto src_copy_layout = asc::te::make_layout(asc::te::make_shape(row_count * input_columns));
    auto dst_copy_layout = asc::te::make_layout(asc::te::make_shape(row_count * output_columns));
    __ubuf__ uint16_t src_buf[src_capacity];
    __ubuf__ uint16_t dst_buf[rows_per_core * output_columns];
    auto src_gm = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::gm>(src + first_row * input_columns), src_copy_layout);
    auto dst_gm = asc::te::make_tensor(
        asc::te::make_mem_ptr<asc::te::location::gm>(dst + first_row * output_columns), dst_copy_layout);
    auto src_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src_buf), src_copy_layout);
    auto dst_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), dst_copy_layout);

    copy_in_mutex.lock();
    asc::te::copy(src_ub, src_gm);
    copy_in_mutex.unlock();
    compute_mutex.lock();
    constexpr uint32_t elements_per_register = asc::te::get_vf_len() / sizeof(uint16_t);
    uint16_t repeat_time = static_cast<uint16_t>((input_columns + elements_per_register - 1) / elements_per_register);
    for (uint32_t row = 0; row < row_count; ++row) {
        auto src_row = src_ub.slice(asc::te::make_coord(row * input_columns), asc::te::make_shape(input_columns));
        auto dst_row = dst_ub.slice(asc::te::make_coord(row * output_columns), asc::te::make_shape(output_columns));
        reduce_unalign_vf(src_row, dst_row, repeat_time);
    }
    compute_mutex.unlock();
    copy_out_mutex.lock();
    asc::te::copy(dst_gm, dst_ub);
    copy_out_mutex.unlock();
}

static bool check_acl(aclError result, const char* api_name)
{
    if (result != ACL_SUCCESS) {
        printf("%s failed, error code = %d\n", api_name, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

template <typename DataType>
static bool run_scenario(aclrtStream stream)
{
    constexpr uint32_t input_length = scenario_num == 1 ? copy_length : total_rows * input_columns;
    constexpr uint32_t output_length = scenario_num == 1 ? copy_length : total_rows * output_columns;
    constexpr size_t input_bytes = input_length * sizeof(DataType);
    constexpr size_t output_bytes = output_length * sizeof(DataType);
    std::vector<DataType> input(input_length);
    std::vector<DataType> output(output_length);
    std::vector<DataType> golden(output_length, static_cast<DataType>(0));
    for (uint32_t index = 0; index < input_length; ++index) {
        if constexpr (scenario_num == 1) {
            input[index] = static_cast<DataType>(static_cast<int32_t>(index) * 0.25f - 128.0f);
        } else {
            input[index] = static_cast<DataType>((index * 7919 + 12345) % 65536);
        }
    }
    if constexpr (scenario_num == 1) {
        for (uint32_t index = 1; index <= copy_elements; ++index) {
            golden[index] = input[index];
        }
    } else {
        for (uint32_t row = 0; row < total_rows; ++row) {
            for (uint32_t column = 0; column < input_columns; ++column) {
                uint32_t index = row * output_columns + column / datablock_elements;
                golden[index] = std::max(golden[index], input[row * input_columns + column]);
            }
        }
    }

    DataType* src_device = nullptr;
    DataType* dst_device = nullptr;
    bool success = false;
    if (!check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&src_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc src") ||
        !check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc dst") ||
        !check_acl(
            aclrtMemcpy(src_device, input_bytes, input.data(), input_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device")) {
        goto cleanup;
    }
    if constexpr (scenario_num == 1) {
        copy_unalign<<<1, 0, stream>>>(src_device, dst_device);
    } else {
        constexpr uint32_t block_count = (total_rows + rows_per_core - 1) / rows_per_core;
        reduce_unalign<<<block_count, 0, stream>>>(src_device, dst_device);
    }
    if (!check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl(
            aclrtMemcpy(output.data(), output_bytes, dst_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host")) {
        goto cleanup;
    }
    success = true;
    for (uint32_t index = 0; index < output_length; ++index) {
        if (output[index] != golden[index]) {
            printf(
                "test failed at index %u: output=%g, expected=%g\n", index, static_cast<double>(output[index]),
                static_cast<double>(golden[index]));
            success = false;
            break;
        }
    }

cleanup:
    if (src_device != nullptr) {
        (void)aclrtFree(src_device);
    }
    if (dst_device != nullptr) {
        (void)aclrtFree(dst_device);
    }
    return success;
}

int32_t main()
{
    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    bool success = check_acl(aclrtSetDevice(device_id), "aclrtSetDevice") &&
                   check_acl(aclrtCreateStream(&stream), "aclrtCreateStream");
    if (success) {
        if constexpr (scenario_num == 1) {
            success = run_scenario<float>(stream);
        } else {
            success = run_scenario<uint16_t>(stream);
        }
    }
    printf("scenario %u: %s\n", scenario_num, success ? "test pass!" : "test failed!");
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return success ? 0 : 1;
}
