/*!
 * \file cast.asc
 * \brief Use the experimental register Tensor API to convert data types.
 */

#include <cstdint>
#include <iostream>
#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t scenario = SCENARIO_NUM;
constexpr uint32_t total_length = 256;
constexpr uint8_t copy_mutex_id = 0;

constexpr asc::te::experimental::cast_options floor_cast_ops = {
    asc::te::experimental::cast_layout::zero, asc::te::experimental::cast_round_mode::floor,
    asc::te::experimental::cast_sat_mode::not_sat};
constexpr asc::te::experimental::cast_options saturating_rint_cast_ops = {
    asc::te::experimental::cast_layout::zero, asc::te::experimental::cast_round_mode::rint,
    asc::te::experimental::cast_sat_mode::sat};

template <typename DstT, typename SrcT>
__simd_callee__ inline asc::te::experimental::reg_tensor<DstT> cast_register(
    asc::te::experimental::reg_tensor<SrcT> src)
{
    if constexpr (scenario == 1) {
        return asc::te::experimental::cast<int32_t, floor_cast_ops>(src);
    } else if constexpr (scenario == 2) {
        return asc::te::experimental::cast<int16_t, saturating_rint_cast_ops>(src);
    } else if constexpr (scenario == 3) {
        return asc::te::experimental::cast<int32_t>(src);
    } else if constexpr (scenario == 4) {
        return asc::te::experimental::cast<uint8_t, saturating_rint_cast_ops>(src);
    } else if constexpr (scenario == 5) {
        return asc::te::experimental::cast<float>(src);
    } else {
        return asc::te::experimental::cast<bfloat16_t>(src);
    }
}

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void cast_reg_loop(const SrcTensor src, DstTensor dst, uint32_t data_size)
{
    using src_type = typename SrcTensor::data_type;
    using dst_type = typename DstTensor::data_type;
    using wider_type = std::conditional_t<(sizeof(src_type) > sizeof(dst_type)), src_type, dst_type>;
    using wider_reg_type = typename asc::te::experimental::reg_tensor<wider_type>::reg_type;
    constexpr uint32_t one_repeat = sizeof(wider_reg_type) / sizeof(wider_type);
    const uint16_t repeat = static_cast<uint16_t>(data_size / one_repeat);
    uint32_t remain = data_size;

    for (uint16_t i = 0; i < repeat; ++i) {
        const uint32_t offset = i * one_repeat;
        const auto coord = asc::te::make_coord(offset);
        asc::te::experimental::reg_tensor<src_type> src_reg;

        if constexpr (sizeof(dst_type) == sizeof(src_type)) {
            src_reg = asc::te::experimental::load(src, coord);
        } else if constexpr (sizeof(dst_type) == 2 * sizeof(src_type)) {
            src_reg = asc::te::experimental::load<asc::te::experimental::load_sideband_mode::unpack>(src, coord);
        } else if constexpr (sizeof(dst_type) == 4 * sizeof(src_type)) {
            src_reg = asc::te::experimental::load<asc::te::experimental::load_sideband_mode::unpack4>(src, coord);
        } else {
            src_reg = asc::te::experimental::load(src, coord);
        }
        src_reg = src_reg.with_mask(asc::te::experimental::update_mask<wider_type>(remain));

        auto dst_reg = cast_register<dst_type>(src_reg);
        if constexpr (sizeof(dst_type) == sizeof(src_type) || sizeof(dst_type) > sizeof(src_type)) {
            asc::te::experimental::store(dst, coord, dst_reg);
        } else if constexpr (sizeof(src_type) == 2 * sizeof(dst_type)) {
            auto compact = asc::te::experimental::deinterleave(dst_reg, dst_reg).first;
            uint32_t store_remain = one_repeat;
            compact = compact.with_mask(asc::te::experimental::update_mask<dst_type>(store_remain));
            asc::te::experimental::store(dst, coord, compact);
        } else {
            auto compact_2 = asc::te::experimental::deinterleave(dst_reg, dst_reg).first;
            auto compact_4 = asc::te::experimental::deinterleave(compact_2, compact_2).first;
            uint32_t store_remain = one_repeat;
            compact_4 = compact_4.with_mask(asc::te::experimental::update_mask<dst_type>(store_remain));
            asc::te::experimental::store(dst, coord, compact_4);
        }
    }
}

template <typename SrcT, typename DstT>
class KernelCastReg {
public:
    __aicore__ inline void process(__gm__ SrcT* x, __gm__ DstT* y, uint32_t data_size)
    {
        auto layout = asc::te::make_layout(asc::te::make_shape(data_size), asc::te::make_stride(1));
        auto x_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(x), layout);
        auto y_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(y), layout);

        constexpr uint32_t x_offset = 0;
        const uint32_t y_offset = data_size * sizeof(SrcT);
        auto x_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, SrcT>(x_offset), layout);
        auto y_ub = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::ub, DstT>(y_offset), layout);

        asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), x_ub, x_gm);
        asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        cast_reg_loop(x_ub, y_ub, data_size);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm{}), y_gm, y_ub);
        asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
    }
};

template <typename SrcT, typename DstT>
__global__ __vector__ void cast(__gm__ uint8_t* x, __gm__ uint8_t* y, uint32_t data_size)
{
    KernelCastReg<SrcT, DstT> kernel;
    kernel.process(reinterpret_cast<__gm__ SrcT*>(x), reinterpret_cast<__gm__ DstT*>(y), data_size);
}

template <typename DstT>
static bool compare_result(const void* output_data, uint32_t output_size)
{
    void* golden_data = nullptr;
    aclrtMallocHost(&golden_data, output_size);
    size_t golden_size = output_size;
    if (!read_file("./output/golden.bin", golden_size, golden_data, golden_size)) {
        aclrtFreeHost(golden_data);
        return false;
    }

    int64_t wrong_num = 0;
    if constexpr (std::is_same_v<DstT, bfloat16_t>) {
        const auto* output = static_cast<const uint16_t*>(output_data);
        const auto* golden = static_cast<const uint16_t*>(golden_data);
        for (size_t i = 0; i < output_size / sizeof(uint16_t); ++i) {
            if (output[i] != golden[i]) {
                ++wrong_num;
            }
        }
    } else {
        constexpr float epsilon = 1e-4f;
        const auto* output = static_cast<const DstT*>(output_data);
        const auto* golden = static_cast<const DstT*>(golden_data);
        for (size_t i = 0; i < output_size / sizeof(DstT); ++i) {
            float actual = static_cast<float>(output[i]);
            float expected = static_cast<float>(golden[i]);
            float difference = actual - expected;
            float abs_error = difference >= 0.0f ? difference : -difference;
            float expected_abs = expected >= 0.0f ? expected : -expected;
            float rel_error = expected_abs > epsilon ? abs_error / expected_abs : abs_error;
            if (abs_error > epsilon && rel_error > epsilon) {
                ++wrong_num;
            }
        }
    }
    aclrtFreeHost(golden_data);
    return wrong_num == 0;
}

template <typename SrcT, typename DstT>
static bool run_scenario(aclrtStream stream)
{
    constexpr size_t input_size = total_length * sizeof(SrcT);
    constexpr size_t output_size = total_length * sizeof(DstT);
    uint8_t* x_host = nullptr;
    uint8_t* y_host = nullptr;
    uint8_t* x_device = nullptr;
    uint8_t* y_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&x_host), input_size);
    aclrtMallocHost(reinterpret_cast<void**>(&y_host), output_size);
    aclrtMalloc(reinterpret_cast<void**>(&x_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&y_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t read_size = input_size;
    bool success = read_file("./input/input_x.bin", read_size, x_host, input_size);
    if (success) {
        aclrtMemcpy(x_device, input_size, x_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE);
        cast<SrcT, DstT><<<1, 0, stream>>>(x_device, y_device, total_length);
        aclrtSynchronizeStream(stream);
        aclrtMemcpy(y_host, output_size, y_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST);
        write_file("./output/output.bin", y_host, output_size);
        success = compare_result<DstT>(y_host, output_size);
    }

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    return success;
}

int32_t main()
{
    aclInit(nullptr);
    constexpr int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool success;
    if constexpr (scenario == 1) {
        success = run_scenario<half, int32_t>(stream);
    } else if constexpr (scenario == 2) {
        success = run_scenario<float, int16_t>(stream);
    } else if constexpr (scenario == 3) {
        success = run_scenario<int8_t, int32_t>(stream);
    } else if constexpr (scenario == 4) {
        success = run_scenario<int32_t, uint8_t>(stream);
    } else if constexpr (scenario == 5) {
        success = run_scenario<bfloat16_t, float>(stream);
    } else {
        success = run_scenario<float, bfloat16_t>(stream);
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return success ? 0 : 1;
}
