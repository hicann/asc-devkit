#include <cmath>
#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t input_length = 64;
constexpr uint32_t output_count = 3;
constexpr uint32_t output_length = input_length * output_count;
constexpr uint32_t golden_length = output_count;
constexpr uint32_t sum_output_index = 0;
constexpr uint32_t max_output_index = input_length;
constexpr uint32_t min_output_index = input_length * 2;
constexpr uint8_t buffer_lock_id = 0;

template <typename SrcTensorType, typename DstTensorType>
__simd_vf__ inline void compute_reduction(
    SrcTensorType src_tensor, DstTensorType sum_tensor, DstTensorType max_tensor, DstTensorType min_tensor)
{
    const auto coord = asc::te::make_coord(0);
    auto mask = asc::te::experimental::all_mask<float>();
    auto src = asc::te::experimental::load(src_tensor, coord).with_mask(mask);

    auto sum = asc::te::experimental::reduce_sum<asc::te::experimental::reduce_scope::element, float>(src);
    auto max = asc::te::experimental::reduce_max(src);
    auto min = asc::te::experimental::reduce_min(src);

    asc::te::experimental::store(sum_tensor, coord, sum);
    asc::te::experimental::store(max_tensor, coord, max);
    asc::te::experimental::store(min_tensor, coord, min);
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* src, __gm__ float* dst)
    {
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(input_length));
        auto src_gm = asc::te::make_tensor(asc::te::make_mem_ptr((__gm__ float*)src), vector_layout);
        auto sum_gm = asc::te::make_tensor(asc::te::make_mem_ptr((__gm__ float*)dst + sum_output_index), vector_layout);
        auto max_gm = asc::te::make_tensor(asc::te::make_mem_ptr((__gm__ float*)dst + max_output_index), vector_layout);
        auto min_gm = asc::te::make_tensor(asc::te::make_mem_ptr((__gm__ float*)dst + min_output_index), vector_layout);

        __ubuf__ float src_buf[input_length];
        __ubuf__ float sum_buf[input_length];
        __ubuf__ float max_buf[input_length];
        __ubuf__ float min_buf[input_length];

        auto src_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src_buf), vector_layout);
        auto sum_ub = asc::te::make_tensor(asc::te::make_mem_ptr(sum_buf), vector_layout);
        auto max_ub = asc::te::make_tensor(asc::te::make_mem_ptr(max_buf), vector_layout);
        auto min_ub = asc::te::make_tensor(asc::te::make_mem_ptr(min_buf), vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        asc::te::copy(copy_in, src_ub, src_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        compute_reduction(src_ub, sum_ub, max_ub, min_ub);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);

        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});
        asc::te::copy(copy_out, sum_gm, sum_ub);
        asc::te::copy(copy_out, max_gm, max_ub);
        asc::te::copy(copy_out, min_gm, min_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void reduction_compute(__gm__ float* src, __gm__ float* dst)
{
    Kernel kernel;
    kernel.process(src, dst);
}

template <typename T>
static bool compare_value(const char* name, T actual_value, T expected_value)
{
    constexpr float eps = 1e-4f;
    float actual = static_cast<float>(actual_value);
    float expected = static_cast<float>(expected_value);
    float abs_error = std::fabs(actual - expected);
    float rel_error = std::fabs(expected) > eps ? abs_error / std::fabs(expected) : abs_error;
    if (abs_error > eps && rel_error > eps) {
        std::cout << name << " test failed: output is " << actual << ", expected is " << expected << std::endl;
        return false;
    }
    return true;
}

template <typename T>
static bool compare_result(const void* output_data)
{
    constexpr size_t golden_bytes = golden_length * sizeof(T);
    void* golden_data = nullptr;
    aclrtMallocHost(&golden_data, golden_bytes);
    size_t golden_size = golden_bytes;
    if (!read_file("./output/golden.bin", golden_size, golden_data, golden_bytes) || golden_size != golden_bytes) {
        aclrtFreeHost(golden_data);
        return false;
    }

    const auto* output = static_cast<const T*>(output_data);
    const auto* golden = static_cast<const T*>(golden_data);
    bool success = true;
    success = compare_value("reduce_sum", output[sum_output_index], golden[0]) && success;
    success = compare_value("reduce_max", output[max_output_index], golden[1]) && success;
    success = compare_value("reduce_min", output[min_output_index], golden[2]) && success;
    aclrtFreeHost(golden_data);
    return success;
}

template <typename T>
static bool run_reduction(aclrtStream stream)
{
    constexpr size_t input_bytes = input_length * sizeof(T);
    constexpr size_t output_bytes = output_length * sizeof(T);

    T* src_host = nullptr;
    T* dst_host = nullptr;
    T* src_device = nullptr;
    T* dst_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&src_host), input_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t read_size = input_bytes;
    bool success = read_file("./input/input.bin", read_size, src_host, input_bytes) && read_size == input_bytes;
    if (success) {
        aclrtMemcpy(src_device, input_bytes, src_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

        reduction_compute<<<1, 0, stream>>>(src_device, dst_device);
        aclrtSynchronizeStream(stream);

        aclrtMemcpy(dst_host, output_bytes, dst_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
        success = write_file("./output/output.bin", dst_host, output_bytes) && compare_result<T>(dst_host);
    }

    aclrtFree(src_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src_host);
    aclrtFreeHost(dst_host);
    return success;
}

int32_t main()
{
    aclInit(nullptr);
    constexpr int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool success = run_reduction<float>(stream);

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
