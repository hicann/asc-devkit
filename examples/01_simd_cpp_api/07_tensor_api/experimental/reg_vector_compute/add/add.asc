#include <cstdint>
#include <iostream>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

constexpr uint32_t total_length = 64;
constexpr uint8_t buffer_lock_id = 0;

template <typename InputTensor, typename OutputTensor>
__simd_vf__ inline void compute_add(InputTensor src0_tensor, InputTensor src1_tensor, OutputTensor dst_tensor)
{
    using asc::te::experimental::operator+;

    constexpr uint32_t offset = 0;
    const auto coord = asc::te::make_coord(offset);
    auto mask = asc::te::experimental::all_mask<float>();
    auto src0 = asc::te::experimental::load(src0_tensor, coord).with_mask(mask);
    auto src1 = asc::te::experimental::load(src1_tensor, coord).with_mask(mask);
    auto dst = src0 + src1;
    asc::te::experimental::store(dst_tensor, coord, dst);
}

class Kernel {
public:
    __aicore__ inline void process(__gm__ float* src0, __gm__ float* src1, __gm__ float* dst)
    {
        constexpr uint32_t tensor_bytes = total_length * sizeof(float);
        constexpr uint32_t src0_offset = 0;
        constexpr uint32_t src1_offset = src0_offset + tensor_bytes;
        constexpr uint32_t dst_offset = src1_offset + tensor_bytes;

        auto copy_layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn>(1, total_length);
        auto vector_layout = asc::te::make_layout(asc::te::make_shape(total_length));
        auto src0_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src0), copy_layout);
        auto src1_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src1), copy_layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), copy_layout);

        auto src0_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src0_offset);
        auto src1_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(src1_offset);
        auto dst_mem = asc::te::make_mem_ptr<asc::te::location::ub, float>(dst_offset);
        auto src0_copy_ub = asc::te::make_tensor(src0_mem, copy_layout);
        auto src1_copy_ub = asc::te::make_tensor(src1_mem, copy_layout);
        auto dst_copy_ub = asc::te::make_tensor(dst_mem, copy_layout);
        auto src0_ub = asc::te::make_tensor(src0_mem, vector_layout);
        auto src1_ub = asc::te::make_tensor(src1_mem, vector_layout);
        auto dst_ub = asc::te::make_tensor(dst_mem, vector_layout);

        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        auto copy_in = asc::te::make_copy(asc::te::copy_gm_to_ub{});
        asc::te::copy(copy_in, src0_copy_ub, src0_gm);
        asc::te::copy(copy_in, src1_copy_ub, src1_gm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        compute_add(src0_ub, src1_ub, dst_ub);
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);

        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        auto copy_out = asc::te::make_copy(asc::te::copy_ub_to_gm{});
        asc::te::copy(copy_out, dst_gm, dst_copy_ub);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
};

__global__ __vector__ void add(__gm__ float* src0, __gm__ float* src1, __gm__ float* dst)
{
    Kernel kernel;
    kernel.process(src0, src1, dst);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t tensor_bytes = total_length * sizeof(float);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* src0_host = nullptr;
    float* src1_host = nullptr;
    float* dst_host = nullptr;
    float* src0_device = nullptr;
    float* src1_device = nullptr;
    float* dst_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&src0_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&src1_host), tensor_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&dst_host), tensor_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&src0_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&src1_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dst_device), tensor_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t file_size = 0;
    ReadFile("./input/src0_input.bin", file_size, src0_host, tensor_bytes);
    ReadFile("./input/src1_input.bin", file_size, src1_host, tensor_bytes);
    aclrtMemcpy(src0_device, tensor_bytes, src0_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(src1_device, tensor_bytes, src1_host, tensor_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    add<<<1, nullptr, stream>>>(src0_device, src1_device, dst_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(dst_host, tensor_bytes, dst_device, tensor_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/dst_output.bin", dst_host, tensor_bytes);

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst_device);
    aclrtFreeHost(src0_host);
    aclrtFreeHost(src1_host);
    aclrtFreeHost(dst_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    std::cout << "add executed successfully." << std::endl;
    return 0;
}
