#include <cstdint>
#include <cstdio>
#include <fstream>
#include <vector>

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_ops.h"

constexpr uint32_t total_length = 128;
constexpr uint8_t copy_mutex_id = 0;

template <typename SrcTensor, typename IndexTensor, typename DstTensor>
__simd_vf__ inline void gather_vf(SrcTensor source, IndexTensor indexes, DstTensor destination)
{
    const auto coord = asc::te::make_coord(0);
    auto source_reg = asc::te::experimental::load(source, coord);
    auto index_reg = asc::te::experimental::load(indexes, coord);
    auto destination_reg = asc::te::experimental::gather(source_reg, index_reg);
    asc::te::experimental::store(destination, coord, destination_reg);
}

__global__ __vector__ void gather(__gm__ uint8_t* source, __gm__ uint8_t* indexes, __gm__ uint8_t* destination)
{
    asc::te::mutex<pipe_t::PIPE_MTE2> copy_in_mutex(copy_mutex_id);
    asc::te::mutex<pipe_t::PIPE_V> compute_mutex(copy_mutex_id);
    asc::te::mutex<pipe_t::PIPE_MTE3> copy_out_mutex(copy_mutex_id);
    const auto layout = asc::te::make_layout(asc::te::make_shape(total_length));
    auto source_gm = asc::te::make_tensor(asc::te::make_mem_ptr(reinterpret_cast<__gm__ half*>(source)), layout);
    auto index_gm = asc::te::make_tensor(asc::te::make_mem_ptr(reinterpret_cast<__gm__ uint16_t*>(indexes)), layout);
    auto destination_gm =
        asc::te::make_tensor(asc::te::make_mem_ptr(reinterpret_cast<__gm__ half*>(destination)), layout);
    __ubuf__ half source_buffer[total_length];
    __ubuf__ uint16_t index_buffer[total_length];
    __ubuf__ half destination_buffer[total_length];
    auto source_ub = asc::te::make_tensor(asc::te::make_mem_ptr(source_buffer), layout);
    auto index_ub = asc::te::make_tensor(asc::te::make_mem_ptr(index_buffer), layout);
    auto destination_ub = asc::te::make_tensor(asc::te::make_mem_ptr(destination_buffer), layout);

    copy_in_mutex.lock();
    asc::te::copy(source_ub, source_gm);
    asc::te::copy(index_ub, index_gm);
    copy_in_mutex.unlock();

    compute_mutex.lock();
    gather_vf(source_ub, index_ub, destination_ub);
    compute_mutex.unlock();

    copy_out_mutex.lock();
    asc::te::copy(destination_gm, destination_ub);
    copy_out_mutex.unlock();
    asc::te::sync_pipe(pipe_t::PIPE_ALL);
}

static bool ReadData(const char* filename, std::vector<uint16_t>& data)
{
    std::ifstream input(filename, std::ios::binary | std::ios::ate);
    const auto bytes = static_cast<std::streamsize>(data.size() * sizeof(uint16_t));
    if (!input || input.tellg() != bytes) {
        std::printf("Invalid input file: %s (expected %ld bytes)\n", filename, static_cast<long>(bytes));
        return false;
    }
    input.seekg(0);
    return static_cast<bool>(input.read(reinterpret_cast<char*>(data.data()), bytes));
}

struct RuntimeResources {
    bool initialized = false;
    bool device_selected = false;
    aclrtStream stream = nullptr;
    uint8_t* source = nullptr;
    uint8_t* indexes = nullptr;
    uint8_t* destination = nullptr;

    ~RuntimeResources()
    {
        if (stream != nullptr) {
            aclrtSynchronizeStream(stream);
        }
        if (source != nullptr) {
            aclrtFree(source);
        }
        if (indexes != nullptr) {
            aclrtFree(indexes);
        }
        if (destination != nullptr) {
            aclrtFree(destination);
        }
        if (stream != nullptr) {
            aclrtDestroyStream(stream);
        }
        if (device_selected) {
            aclrtResetDevice(0);
        }
        if (initialized) {
            aclFinalize();
        }
    }
};

#define CHECK_ACL(expression)                                                      \
    do {                                                                           \
        const aclError status = (expression);                                      \
        if (status != ACL_SUCCESS) {                                               \
            std::printf("%s failed: %d\n", #expression, static_cast<int>(status)); \
            return 1;                                                              \
        }                                                                          \
    } while (false)

int main()
{
    std::vector<uint16_t> source(total_length), indexes(total_length), output(total_length), golden(total_length);
    if (!ReadData("input/input_x.bin", source) || !ReadData("input/input_y.bin", indexes) ||
        !ReadData("output/golden.bin", golden)) {
        return 1;
    }
    for (const auto index : indexes) {
        if (index >= total_length) {
            std::printf("Gather index out of range: %u\n", index);
            return 1;
        }
    }
    RuntimeResources runtime;
    CHECK_ACL(aclInit(nullptr));
    runtime.initialized = true;
    CHECK_ACL(aclrtSetDevice(0));
    runtime.device_selected = true;
    CHECK_ACL(aclrtCreateStream(&runtime.stream));
    constexpr size_t bytes = total_length * sizeof(uint16_t);
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&runtime.source), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&runtime.indexes), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&runtime.destination), bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(runtime.source, bytes, source.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(runtime.indexes, bytes, indexes.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    gather<<<1, nullptr, runtime.stream>>>(runtime.source, runtime.indexes, runtime.destination);
    CHECK_ACL(aclrtSynchronizeStream(runtime.stream));
    CHECK_ACL(aclrtMemcpy(output.data(), bytes, runtime.destination, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    std::ofstream output_file("output/output.bin", std::ios::binary);
    if (!output_file.write(reinterpret_cast<const char*>(output.data()), bytes)) {
        std::printf("Failed to write output/output.bin\n");
        return 1;
    }
    size_t mismatches = 0;
    for (size_t element = 0; element < total_length; ++element) {
        if (output[element] != golden[element]) {
            std::printf("Mismatch at %zu: output=0x%04x, golden=0x%04x\n", element, output[element], golden[element]);
            ++mismatches;
        }
    }
    std::printf(
        "%s: %zu/128 elements match golden bit-for-bit\n", mismatches == 0 ? "PASS" : "FAIL",
        total_length - mismatches);
    return mismatches == 0 ? 0 : 1;
}
