#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_compute.h"

constexpr uint32_t row_count = 1;
constexpr uint32_t column_count = 256;
constexpr uint32_t input_length = row_count * column_count;
constexpr uint32_t bin_length = 128;
constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint16_t initial_value = 3;
constexpr uint8_t copy_mutex_id = 0;
constexpr asc::te::experimental::histogram_options histogram_config{
    asc::te::experimental::histogram_half::high,
    asc::te::experimental::histogram_mode::cumulative,
};

template <typename SrcUbTensor, typename SrcGmTensor>
__aicore__ inline void copy_input_to_ub(SrcUbTensor src_ub, SrcGmTensor src_gm)
{
    asc_lock(pipe_t::PIPE_MTE2, copy_mutex_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub{}), src_ub, src_gm);
    asc_unlock(pipe_t::PIPE_MTE2, copy_mutex_id);
}

template <typename DstGmTensor, typename DstUbTensor>
__aicore__ inline void copy_output_to_gm(DstGmTensor dst_gm, DstUbTensor dst_ub)
{
    asc_lock(pipe_t::PIPE_MTE3, copy_mutex_id);
    asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm{}), dst_gm, dst_ub);
    asc_unlock(pipe_t::PIPE_MTE3, copy_mutex_id);
}

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void histograms_vf(
    const SrcTensor src, DstTensor dst, uint16_t repeat_times, uint32_t total, uint32_t one_repeat_size)
{
    uint32_t remain = total;
    asc::te::experimental::reg_tensor<uint16_t> dst_reg;
    auto dst_mask = asc::te::experimental::make_mask<asc::te::experimental::mask_pattern::all, uint16_t>();
    dst_reg.mask = dst_mask.reg;
    asc_duplicate_scalar(dst_reg.reg, initial_value, dst_reg.mask);
    for (uint16_t i = 0; i < repeat_times; ++i) {
        const uint32_t offset = i * one_repeat_size;
        const auto coord = asc::te::make_coord(offset);
        auto mask = asc::te::experimental::update_mask<uint8_t>(remain);
        auto src_reg = asc::te::experimental::load(src, coord).with_mask(mask);
        dst_reg = asc::te::experimental::histograms<histogram_config>(dst_reg, src_reg);
    }
    asc::te::experimental::store(dst, asc::te::make_coord(0), dst_reg);
}

template <typename SrcTensor, typename DstTensor>
__simd_vf__ inline void histograms_2d_vf(
    const SrcTensor src, DstTensor dst, uint16_t repeat_times, uint32_t one_repeat_size)
{
    asc::te::experimental::reg_tensor<uint16_t> dst_reg;
    auto dst_mask = asc::te::experimental::make_mask<asc::te::experimental::mask_pattern::all, uint16_t>();
    dst_reg.mask = dst_mask.reg;
    asc_duplicate_scalar(dst_reg.reg, initial_value, dst_reg.mask);
    for (uint16_t i = 0; i < repeat_times; ++i) {
        uint32_t remain = one_repeat_size;
        const auto coord = asc::te::make_coord(i, 0);
        auto mask = asc::te::experimental::update_mask<uint8_t>(remain);
        auto src_reg = asc::te::experimental::load(src, coord).with_mask(mask);
        dst_reg = asc::te::experimental::histograms<histogram_config>(dst_reg, src_reg);
    }
    asc::te::experimental::store(dst, asc::te::make_coord(0, 0), dst_reg);
}

__global__ __vector__ void histograms(__gm__ uint8_t* src, __gm__ uint16_t* dst)
{
    asc_init();
    __ubuf__ uint8_t src_buf[input_length];
    __ubuf__ uint16_t dst_buf[bin_length];

    if constexpr (scenario_num == 1) {
        auto src_layout = asc::te::make_layout(asc::te::make_shape(input_length));
        auto dst_layout = asc::te::make_layout(asc::te::make_shape(bin_length));
        auto src_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src), src_layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr(dst), dst_layout);
        auto src_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src_buf), src_layout);
        auto dst_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), dst_layout);

        copy_input_to_ub(src_ub, src_gm);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        using reg_type = typename asc::te::experimental::reg_tensor<uint8_t>::reg_type;
        // 一次repeat计算的数据个数
        constexpr uint32_t one_repeat_size = sizeof(reg_type) / sizeof(uint8_t);
        // 总迭代次数
        uint16_t repeat_times = AscendC::Std::ceil_division(input_length, one_repeat_size);
        histograms_vf(src_ub, dst_ub, repeat_times, input_length, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        copy_output_to_gm(dst_gm, dst_ub);
    } else {
        auto src_layout =
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, asc::te::layout_trait_default<uint8_t>>(
                row_count, column_count);
        auto dst_layout =
            asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn, asc::te::layout_trait_default<uint16_t>>(
                row_count, bin_length);
        auto src_gm = asc::te::make_tensor(asc::te::make_mem_ptr(src), src_layout);
        auto dst_gm = asc::te::make_tensor(asc::te::make_mem_ptr(dst), dst_layout);
        auto src_ub = asc::te::make_tensor(asc::te::make_mem_ptr(src_buf), src_layout);
        auto dst_ub = asc::te::make_tensor(asc::te::make_mem_ptr(dst_buf), dst_layout);

        copy_input_to_ub(src_ub, src_gm);

        asc_lock(pipe_t::PIPE_V, copy_mutex_id);
        // 一次repeat计算的数据个数
        constexpr uint32_t one_repeat_size = column_count;
        // 总迭代次数
        constexpr uint16_t repeat_times = row_count;
        histograms_2d_vf(src_ub, dst_ub, repeat_times, one_repeat_size);
        asc_unlock(pipe_t::PIPE_V, copy_mutex_id);

        copy_output_to_gm(dst_gm, dst_ub);
    }
    asc_sync();
}

static bool compare_result(const uint16_t* output, const uint8_t* input)
{
    uint16_t frequency[256] = {};
    for (uint32_t i = 0; i < input_length; ++i) {
        ++frequency[input[i]];
    }
    uint16_t cumulative = initial_value;
    for (uint32_t i = 0; i < bin_length; ++i) {
        cumulative += frequency[i];
    }
    for (uint32_t i = 0; i < bin_length; ++i) {
        cumulative += frequency[i + bin_length];
        if (output[i] != cumulative) {
            printf("test failed at index %u: output is %u, expected is %u\n", i, output[i], cumulative);
            return false;
        }
    }
    printf("test pass!\n");
    return true;
}

int32_t main()
{
    constexpr size_t input_bytes = input_length * sizeof(uint8_t);
    constexpr size_t output_bytes = bin_length * sizeof(uint16_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* input_host = nullptr;
    uint16_t* output_host = nullptr;
    uint8_t* input_device = nullptr;
    uint16_t* output_device = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&input_host), input_bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    for (uint32_t i = 0; i < input_length; ++i) {
        input_host[i] = static_cast<uint8_t>(i * 37U + i % 11U);
    }
    aclrtMemcpy(input_device, input_bytes, input_host, input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    histograms<<<1, 0, stream>>>(input_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    bool success = compare_result(output_host, input_host);

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return success ? 0 : 1;
}
