/* !
 * \file flash_attention_tensor_api.asc
 * \brief A1 decode FlashAttention implemented with the Tensor API.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"
#include "tensor_api/experimental/vector_ops.h"

constexpr uint32_t query_heads = 32;
constexpr uint32_t kv_heads = 4;
constexpr uint32_t kv_length = 4160;
constexpr uint32_t head_dim = 128;
constexpr uint32_t tile_rows = 64;
constexpr uint32_t splits = 13;
constexpr uint32_t head_group = 2;
constexpr uint32_t tiles_per_split = 5;
constexpr uint32_t partial_size = 256;
constexpr uint32_t range_count = 4;
constexpr uint32_t decode_blocks = query_heads / head_group * range_count;
constexpr uint32_t merge_blocks = query_heads;
constexpr uint32_t range_splits[range_count] = {4, 3, 3, 3};
constexpr uint32_t range_first_split[range_count] = {0, 4, 7, 10};
constexpr float softmax_scale = 0.08838834764831845F;
constexpr uint8_t buffer_lock_id = 0;

// The bfloat16_t input is expanded to float before vector computation. The zero layout keeps
// each converted element in a register lane for the following float operations.
constexpr asc::te::experimental::cast_options to_float_ops = {
    asc::te::experimental::cast_layout::zero, asc::te::experimental::cast_round_mode::unknown,
    asc::te::experimental::cast_sat_mode::unknown};
constexpr asc::te::experimental::cast_options to_bf16_ops = {
    asc::te::experimental::cast_layout::zero, asc::te::experimental::cast_round_mode::rint,
    asc::te::experimental::cast_sat_mode::not_sat};

template <typename QTensor, typename KTensor, typename VTensor, typename ScoreTensor, typename StateTensor>
__simd_vf__ inline void compute_decode_pair_tile(
    QTensor q_tensor, KTensor k_tensor, VTensor v_tensor, ScoreTensor score_tensor, StateTensor state_tensor,
    bool first)
{
    using namespace asc::te;
    // Load the two Query rows handled by this block. Each 128-element row is split into two
    // 64-element register tensors, and softmax_scale is folded into Query before QK.
    auto q0 = experimental::cast<float, to_float_ops>(
        experimental::load<experimental::load_sideband_mode::unpack>(q_tensor, make_coord(0, 0)));
    auto q1 = experimental::cast<float, to_float_ops>(
        experimental::load<experimental::load_sideband_mode::unpack>(q_tensor, make_coord(0, 64)));
    auto q2 = experimental::cast<float, to_float_ops>(
        experimental::load<experimental::load_sideband_mode::unpack>(q_tensor, make_coord(1, 0)));
    auto q3 = experimental::cast<float, to_float_ops>(
        experimental::load<experimental::load_sideband_mode::unpack>(q_tensor, make_coord(1, 64)));
    q0 = q0 * softmax_scale;
    q1 = q1 * softmax_scale;
    q2 = q2 * softmax_scale;
    q3 = q3 * softmax_scale;

    // Compute one score for every Key row. fma accumulates the two 64-element halves of the
    // dot product, reduce_sum collapses the result to one lane, and UB keeps all tile scores.
    auto maximum0 = experimental::fill(-3.4028234663852886e38F);
    auto maximum1 = experimental::fill(-3.4028234663852886e38F);
    for (uint32_t row = 0; row < tile_rows; ++row) {
        auto k0 = experimental::cast<float, to_float_ops>(
            experimental::load<experimental::load_sideband_mode::unpack>(k_tensor, make_coord(row, 0)));
        auto k1 = experimental::cast<float, to_float_ops>(
            experimental::load<experimental::load_sideband_mode::unpack>(k_tensor, make_coord(row, 64)));
        auto dot0 = q0 * k0;
        auto dot1 = q2 * k0;
        dot0 = experimental::fma(q1, k1, dot0);
        dot1 = experimental::fma(q3, k1, dot1);
        dot0 = experimental::reduce_sum<experimental::reduce_scope::element, float>(dot0);
        dot1 = experimental::reduce_sum<experimental::reduce_scope::element, float>(dot1);
        maximum0 = experimental::max(maximum0, dot0);
        maximum1 = experimental::max(maximum1, dot1);
        experimental::store<experimental::store_sideband_mode::store_1st>(score_tensor, make_coord(row), dot0);
        experimental::store<experimental::store_sideband_mode::store_1st>(
            score_tensor, make_coord(tile_rows + row), dot1);
    }

    // Reduction results place the answer in lane 0. Broadcast that lane before
    // using it as the row maximum.
    maximum0 = experimental::fill(maximum0);
    maximum1 = experimental::fill(maximum1);
    auto new_max0 = maximum0;
    auto new_max1 = maximum1;
    auto total0 = experimental::fill(0.0F);
    auto total1 = experimental::fill(0.0F);
    auto out00 = total0;
    auto out01 = total0;
    auto out10 = total1;
    auto out11 = total1;

    // Merge the local state saved by the previous tile. alpha rescales the old denominator
    // and old unnormalized output from the old maximum reference to the new maximum.
    if (!first) {
        auto old_max0 = experimental::load_broadcast(state_tensor, make_coord(128));
        auto old_sum0 = experimental::load_broadcast(state_tensor, make_coord(192));
        auto old00 = experimental::load(state_tensor, make_coord(0));
        auto old01 = experimental::load(state_tensor, make_coord(64));
        auto old_max1 = experimental::load_broadcast(state_tensor, make_coord(384));
        auto old_sum1 = experimental::load_broadcast(state_tensor, make_coord(448));
        auto old10 = experimental::load(state_tensor, make_coord(256));
        auto old11 = experimental::load(state_tensor, make_coord(320));
        new_max0 = experimental::max(old_max0, new_max0);
        new_max1 = experimental::max(old_max1, new_max1);
        auto alpha0 = experimental::exp_diff<float>(old_max0, new_max0);
        auto alpha1 = experimental::exp_diff<float>(old_max1, new_max1);
        total0 = old_sum0 * alpha0;
        total1 = old_sum1 * alpha1;
        out00 = old00 * alpha0;
        out01 = old01 * alpha0;
        out10 = old10 * alpha1;
        out11 = old11 * alpha1;
    }

    experimental::mem_bar<experimental::mem_type::vec_store, experimental::mem_type::vec_load>();
    // Apply online softmax to this tile: exp_diff computes each score's weight relative to
    // new_max, the denominator accumulates weights, and fma accumulates weighted Value rows.
    for (uint32_t row = 0; row < tile_rows; ++row) {
        auto value0 = experimental::cast<float, to_float_ops>(
            experimental::load<experimental::load_sideband_mode::unpack>(v_tensor, make_coord(row, 0)));
        auto value1 = experimental::cast<float, to_float_ops>(
            experimental::load<experimental::load_sideband_mode::unpack>(v_tensor, make_coord(row, 64)));
        auto score0 = experimental::load_broadcast(score_tensor, make_coord(row));
        auto score1 = experimental::load_broadcast(score_tensor, make_coord(tile_rows + row));
        auto weight0 = experimental::exp_diff<float>(score0, new_max0);
        auto weight1 = experimental::exp_diff<float>(score1, new_max1);
        total0 = total0 + weight0;
        total1 = total1 + weight1;
        out00 = experimental::fma(value0, weight0, out00);
        out01 = experimental::fma(value1, weight0, out01);
        out10 = experimental::fma(value0, weight1, out10);
        out11 = experimental::fma(value1, weight1, out11);
    }

    // Persist the two heads' local state. Each 256-float state contains a 128-element output,
    // one maximum at offset 128, and one denominator at offset 192.
    experimental::store(state_tensor, make_coord(0), out00);
    experimental::store(state_tensor, make_coord(64), out01);
    experimental::store(state_tensor, make_coord(128), new_max0);
    experimental::store(state_tensor, make_coord(192), total0);
    experimental::store(state_tensor, make_coord(256), out10);
    experimental::store(state_tensor, make_coord(320), out11);
    experimental::store(state_tensor, make_coord(384), new_max1);
    experimental::store(state_tensor, make_coord(448), total1);
}

template <typename PartialTensor, typename OutputTensor>
__simd_vf__ inline void compute_merge_decode(PartialTensor partial_tensor, OutputTensor output_tensor)
{
    using namespace asc::te;
    // typename is required because data_type is a dependent type of a template parameter.
    using data_type = typename OutputTensor::data_type;
    constexpr uint32_t one_repeat = sizeof(experimental::reg_tensor<float>::reg_type) / sizeof(float);
    static_assert(head_dim == 2U * one_repeat, "merge output must fit in two float registers");
    // The global maximum must be known before any split-local denominator can be finalized.
    auto maximum = experimental::fill(-3.4028234663852886e38F);
    for (uint32_t range = 0; range < range_count; ++range) {
        auto local_max = experimental::load_broadcast(partial_tensor, make_coord(range * partial_size + 128));
        maximum = experimental::max(maximum, local_max);
    }

    // Rescale every split-local denominator and output to the global maximum, then accumulate
    // the global denominator and global unnormalized output for this Query head.
    auto sum = experimental::fill(0.0F);
    auto out0 = experimental::fill(0.0F);
    auto out1 = experimental::fill(0.0F);
    for (uint32_t range = 0; range < range_count; ++range) {
        auto local_max = experimental::load_broadcast(partial_tensor, make_coord(range * partial_size + 128));
        auto local_sum = experimental::load_broadcast(partial_tensor, make_coord(range * partial_size + 192));
        auto value0 = experimental::load(partial_tensor, make_coord(range * partial_size));
        auto value1 = experimental::load(partial_tensor, make_coord(range * partial_size + 64));
        auto alpha = experimental::exp_diff<float>(local_max, maximum);
        local_sum = local_sum * alpha;
        sum = sum + local_sum;
        value0 = value0 * alpha;
        value1 = value1 * alpha;
        out0 = out0 + value0;
        out1 = out1 + value1;
    }
    // Normalize the accumulated output and narrow the float result back to bfloat16_t.
    out0 = out0 / sum;
    out1 = out1 / sum;
    auto result0 = experimental::cast<data_type, to_bf16_ops>(out0);
    auto result1 = experimental::cast<data_type, to_bf16_ops>(out1);
    // cast_layout::zero leaves valid bfloat16_t values at even register positions. deinterleave
    // extracts them so store writes one compact 128-element output row to UB.
    auto compact0 = experimental::deinterleave(result0, result0).first;
    auto compact1 = experimental::deinterleave(result1, result1).first;
    compact0.with_mask(experimental::all_mask<data_type>());
    compact1.with_mask(experimental::all_mask<data_type>());
    experimental::store(output_tensor, make_coord(0), compact0);
    experimental::store(output_tensor, make_coord(one_repeat), compact1);
}

__global__ __vector__ __aicore__ void flash_attention(
    __gm__ bfloat16_t* query, __gm__ bfloat16_t* key, __gm__ bfloat16_t* value, __gm__ float* partial,
    __gm__ uint32_t* completed, __gm__ bfloat16_t* output)
{
    using namespace asc::te;
    init_soc_state();

    // One persistent block owns two adjacent Query heads and one balanced KV range. Under this
    // GQA mapping, every eight Query heads share one KV head, so both heads use the same KV head.
    const uint32_t block = static_cast<uint32_t>(block_idx);
    const uint32_t head_pair = block / range_count;
    const uint32_t range = block % range_count;
    const uint32_t head = head_pair * head_group;
    const uint32_t kv_head = head / (query_heads / kv_heads);

    __ubuf__ bfloat16_t q_buffer[head_group * head_dim];
    __ubuf__ bfloat16_t kv_buffer[2][tile_rows * head_dim];
    __ubuf__ float score_buffer[head_group * tile_rows];
    __ubuf__ float state_buffer[head_group * partial_size];

    // Create Tensor views for the fixed Query, score, and state buffers. K/V views move with
    // the current tile, so they are constructed inside the tile loop.
    auto q_layout = make_layout(make_shape(head_group, head_dim));
    auto tile_layout = make_layout(make_shape(tile_rows, head_dim));
    auto state_layout = make_layout(make_shape(partial_size));
    auto q_gm = make_tensor(make_mem_ptr(query + head * head_dim), q_layout);
    auto q_ub = make_tensor(make_mem_ptr(q_buffer), q_layout);
    auto state_ub = make_tensor(make_mem_ptr(state_buffer), state_layout);
    auto score_ub = make_tensor(make_mem_ptr(score_buffer), make_layout(make_shape(head_group * tile_rows)));

    mutex<pipe_t::PIPE_MTE2> in_mutex(buffer_lock_id);
    mutex<pipe_t::PIPE_V> vector_mutex(buffer_lock_id);
    mutex<pipe_t::PIPE_MTE3> out_mutex(buffer_lock_id);

    // Copy the two Query rows from GM to UB once; all tiles in this range reuse them.
    in_mutex.lock();
    copy(make_copy(copy_gm_to_ub{}), q_ub, q_gm);
    in_mutex.unlock();
    sync_pipe(pipe_t::PIPE_ALL);

    // Stream one 64-row K/V tile at a time. The online softmax state stays in UB across the
    // whole range, so the full 4160-row score matrix is never materialized.
    const uint32_t first_split = range_first_split[range];
    const uint32_t range_tile_count = range_splits[range] * tiles_per_split;
    for (uint32_t tile = 0; tile < range_tile_count; ++tile) {
        const uint32_t global_tile = first_split * tiles_per_split + tile;
        const uint32_t row = global_tile * tile_rows;
        const uint32_t offset = (row * kv_heads + kv_head) * head_dim;
        auto k_gm = make_tensor(make_mem_ptr(key + offset), tile_layout);
        auto v_gm = make_tensor(make_mem_ptr(value + offset), tile_layout);
        auto k_ub = make_tensor(make_mem_ptr(kv_buffer[0]), tile_layout);
        auto v_ub = make_tensor(make_mem_ptr(kv_buffer[1]), tile_layout);
        in_mutex.lock();
        copy(make_copy(copy_gm_to_ub{}), k_ub, k_gm);
        copy(make_copy(copy_gm_to_ub{}), v_ub, v_gm);
        in_mutex.unlock();
        sync_pipe(pipe_t::PIPE_ALL);
        vector_mutex.lock();
        compute_decode_pair_tile(q_ub, k_ub, v_ub, score_ub, state_ub, tile == 0);
        vector_mutex.unlock();
        sync_pipe(pipe_t::PIPE_ALL);
    }

    // Write each head's range-local m/l/o state to GM. Each finished block increments the device
    // counter and exits unless it is the last one. The last block is the only merger: at that
    // point every decode result is already in GM, so this kernel remains safe under multi-wave
    // scheduling and does not require all blocks to be resident.
    out_mutex.lock();
    auto copy_out = make_copy(copy_ub_to_gm{});
    for (uint32_t h = 0; h < head_group; ++h) {
        auto state_part_ub = make_tensor(make_mem_ptr(state_buffer + h * partial_size), state_layout);
        const uint32_t partial_offset = ((head_pair * range_count + range) * head_group + h) * partial_size;
        auto state_part_gm = make_tensor(make_mem_ptr(partial + partial_offset), state_layout);
        copy(copy_out, state_part_gm, state_part_ub);
    }
    out_mutex.unlock();
    sync_pipe(pipe_t::PIPE_ALL);
    sync_data_barrier(mem_dsb_t::DSB_DDR);
    const uint32_t previous_count = atomic_add(completed, 1U);

    if (previous_count == decode_blocks - 1U) {
        auto copy_out = make_copy(copy_ub_to_gm{});
        for (uint32_t merge_head = 0; merge_head < merge_blocks; ++merge_head) {
            const uint32_t merge_head_pair = merge_head / head_group;
            const uint32_t merge_head_in_pair = merge_head % head_group;
            __ubuf__ float partial_buffer[range_count * partial_size];
            __ubuf__ bfloat16_t output_buffer[head_dim];
            auto partial_layout = make_layout(make_shape(range_count * partial_size));
            auto output_layout = make_layout(make_shape(head_dim));
            auto partial_ub = make_tensor(make_mem_ptr(partial_buffer), partial_layout);
            auto output_gm = make_tensor(make_mem_ptr(output + merge_head * head_dim), output_layout);
            auto output_ub = make_tensor(make_mem_ptr(output_buffer), output_layout);

            in_mutex.lock();
            for (uint32_t merge_range = 0; merge_range < range_count; ++merge_range) {
                auto state_part_ub =
                    make_tensor(make_mem_ptr(partial_buffer + merge_range * partial_size), state_layout);
                const uint32_t partial_offset =
                    ((merge_head_pair * range_count + merge_range) * head_group + merge_head_in_pair) * partial_size;
                auto state_part_gm = make_tensor(make_mem_ptr(partial + partial_offset), state_layout);
                copy(make_copy(copy_gm_to_ub{}), state_part_ub, state_part_gm);
            }
            in_mutex.unlock();
            sync_pipe(pipe_t::PIPE_ALL);
            vector_mutex.lock();
            compute_merge_decode(partial_ub, output_ub);
            vector_mutex.unlock();
            sync_pipe(pipe_t::PIPE_ALL);
            out_mutex.lock();
            copy(copy_out, output_gm, output_ub);
            out_mutex.unlock();
            sync_pipe(pipe_t::PIPE_ALL);
        }
    }
}

static bool CheckAcl(aclError result, const char* name)
{
    if (result != ACL_SUCCESS) {
        std::fprintf(stderr, "[ERROR] %s failed, error code: %d\n", name, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

int32_t main()
{
    constexpr size_t input_size = static_cast<size_t>(query_heads) * head_dim * sizeof(bfloat16_t);
    constexpr size_t kv_size = static_cast<size_t>(kv_heads) * kv_length * head_dim * sizeof(bfloat16_t);
    constexpr size_t output_size = input_size;
    constexpr size_t workspace_size = static_cast<size_t>(query_heads) * range_count * partial_size * sizeof(float);
    constexpr size_t completed_size = sizeof(uint32_t);

    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    if (!CheckAcl(aclrtSetDevice(0), "aclrtSetDevice")) {
        (void)aclFinalize();
        return 1;
    }
    aclrtStream stream = nullptr;
    (void)CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    bfloat16_t* query_host = nullptr;
    bfloat16_t* key_host = nullptr;
    bfloat16_t* value_host = nullptr;
    bfloat16_t* output_host = nullptr;
    bfloat16_t* query_device = nullptr;
    bfloat16_t* key_device = nullptr;
    bfloat16_t* value_device = nullptr;
    bfloat16_t* output_device = nullptr;
    float* workspace_device = nullptr;
    uint32_t* completed_device = nullptr;
    size_t query_size = input_size;
    size_t key_size = kv_size;
    size_t value_size = kv_size;
    // Allocate host and device buffers. The float workspace carries per-head, per-range
    // online softmax state between the decode and merge phases of the persistent kernel.
    bool success = true;

    success = CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&query_host), input_size), "aclrtMallocHost query");
    success = CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&key_host), kv_size), "aclrtMallocHost key") && success;
    success =
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&value_host), kv_size), "aclrtMallocHost value") && success;
    success =
        CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_size), "aclrtMallocHost output") &&
        success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&query_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc query") &&
              success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&key_device), kv_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc key") &&
              success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&value_device), kv_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc value") &&
              success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&output_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc output") &&
              success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&workspace_device), workspace_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc workspace") &&
              success;
    success = CheckAcl(
                  aclrtMalloc(reinterpret_cast<void**>(&completed_device), completed_size, ACL_MEM_MALLOC_HUGE_FIRST),
                  "aclrtMalloc completed") &&
              success;

    if (success) {
        // Read the three input tensors generated by scripts/gen_data.py.
        success = ReadFile("./input/query.bin", query_host, input_size);
        success = ReadFile("./input/key.bin", key_host, kv_size) && success;
        success = ReadFile("./input/value.bin", value_host, kv_size) && success;
    }
    if (success) {
        // Kernels can only access device GM, so all host inputs are copied before launch.
        success = CheckAcl(
            aclrtMemcpy(query_device, input_size, query_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy query");
        success =
            CheckAcl(
                aclrtMemcpy(key_device, kv_size, key_host, kv_size, ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy key") &&
            success;
        success = CheckAcl(
                      aclrtMemcpy(value_device, kv_size, value_host, kv_size, ACL_MEMCPY_HOST_TO_DEVICE),
                      "aclrtMemcpy value") &&
                  success;
    }
    if (success) {
        success = CheckAcl(aclrtMemset(completed_device, completed_size, 0, completed_size), "aclrtMemset completed") &&
                  success;
    }
    if (success) {
        // Decode blocks produce range-local softmax states. The last finished block merges the
        // four states of every Query head, so completed blocks can retire under multi-wave scheduling.
        flash_attention<<<decode_blocks, 0, stream>>>(
            query_device, key_device, value_device, workspace_device, completed_device, output_device);
        success = CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
        success = CheckAcl(
                      aclrtMemcpy(output_host, output_size, output_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST),
                      "aclrtMemcpy output") &&
                  success;
        success = WriteFile("./output/output.bin", output_host, output_size) && success;
    }

    (void)CheckAcl(aclrtFree(query_device), "aclrtFree query");
    (void)CheckAcl(aclrtFree(key_device), "aclrtFree key");
    (void)CheckAcl(aclrtFree(value_device), "aclrtFree value");
    (void)CheckAcl(aclrtFree(output_device), "aclrtFree output");
    (void)CheckAcl(aclrtFree(workspace_device), "aclrtFree workspace");
    (void)CheckAcl(aclrtFree(completed_device), "aclrtFree completed");
    (void)CheckAcl(aclrtFreeHost(query_host), "aclrtFreeHost query");
    (void)CheckAcl(aclrtFreeHost(key_host), "aclrtFreeHost key");
    (void)CheckAcl(aclrtFreeHost(value_host), "aclrtFreeHost value");
    (void)CheckAcl(aclrtFreeHost(output_host), "aclrtFreeHost output");
    (void)CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
    (void)CheckAcl(aclrtResetDevice(0), "aclrtResetDevice");
    (void)aclFinalize();
    return success ? 0 : 1;
}
