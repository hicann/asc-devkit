/*!
 * \file bank_conflict.asc
 * \brief Tensor API ND-to-NZ bank-conflict sample for Ascend 950PR/Ascend 950DT
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

namespace {
constexpr uint32_t TOTAL_M = 8192;
constexpr uint32_t TOTAL_N = 8192;
constexpr uint32_t ROW_SPLITS = 8;
constexpr uint32_t COL_SPLITS = 8;
constexpr uint32_t TILE_H = 144;
constexpr uint32_t TILE_W = 128;
constexpr uint32_t C0_ELEMS = 16;
constexpr uint32_t TILE_C0_COLS = TILE_W / C0_ELEMS;
constexpr uint32_t TOTAL_ROW_TILES = (TOTAL_M + TILE_H - 1) / TILE_H;
constexpr uint32_t TOTAL_COL_TILES = TOTAL_N / TILE_W;
constexpr uint32_t TOTAL_BLOCKS = ROW_SPLITS * COL_SPLITS;

// S1 uses the compact NZ stride. S2 adds one DataBlock to the stride between
// C0 blocks so the eight writes in one store land in different bank groups.
constexpr uint32_t BANK_CONFLICT_OFFSET = 1;
constexpr bool ADD_BANK_OFFSET = SCENARIO_NUM == 2;
constexpr uint32_t LOCAL_COLUMN_STRIDE = ADD_BANK_OFFSET ? TILE_H + BANK_CONFLICT_OFFSET : TILE_H;
constexpr uint32_t ND_BUFFER_ELEMS = TILE_H * TILE_W;
constexpr uint32_t NZ_DATA_BLOCKS = (TILE_C0_COLS - 1) * LOCAL_COLUMN_STRIDE + TILE_H;
constexpr uint32_t NZ_SLOT_DATA_BLOCKS = (NZ_DATA_BLOCKS + 15) / 16 * 16;
constexpr uint32_t NZ_SLOT_ELEMS = NZ_SLOT_DATA_BLOCKS * C0_ELEMS;

// Keep the optimized member of each pair at bank 8, as in the 3510 reference
// sample. The baseline member starts at bank 0.
constexpr uint32_t NZ_BASE_SHIFT_DATA_BLOCKS = ADD_BANK_OFFSET ? 8 : 0;
constexpr uint32_t NZ_PONG_PAD_DATA_BLOCKS = (16 - (NZ_SLOT_DATA_BLOCKS % 16)) % 16;
constexpr uint32_t ND_PING_OFFSET = 0;
constexpr uint32_t ND_PONG_OFFSET = ND_PING_OFFSET + ND_BUFFER_ELEMS;
constexpr uint32_t NZ_PING_OFFSET = ND_PONG_OFFSET + ND_BUFFER_ELEMS + NZ_BASE_SHIFT_DATA_BLOCKS * C0_ELEMS;
constexpr uint32_t NZ_PONG_OFFSET = NZ_PING_OFFSET + NZ_SLOT_ELEMS + NZ_PONG_PAD_DATA_BLOCKS * C0_ELEMS;
constexpr uint32_t UB_STORAGE_ELEMS = NZ_PONG_OFFSET + NZ_SLOT_ELEMS;

static_assert(SCENARIO_NUM >= 1 && SCENARIO_NUM <= 2, "SCENARIO_NUM must be 1 or 2");
static_assert(TOTAL_N % TILE_W == 0, "TOTAL_N must be divisible by TILE_W");
static_assert(TOTAL_COL_TILES % COL_SPLITS == 0, "column tiles must be divisible by COL_SPLITS");
static_assert(TOTAL_ROW_TILES >= ROW_SPLITS, "ROW_SPLITS cannot exceed the number of row tiles");
static_assert(TILE_W % C0_ELEMS == 0, "TILE_W must be C0 aligned");
} // namespace

template <uint32_t dstNzC0Stride>
__simd_vf__ inline void NdToNz(__ubuf__ half* dst, __ubuf__ half* src)
{
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    vector_half value;
    asc_loadalign(value, src);
    asc_storealign(dst, value, dstNzC0Stride, 0, mask);
}

__global__ __vector__ void bank_conflict_kernel(__gm__ half* x, __gm__ half* z)
{
    asc_init();
    using namespace asc::te;

    const uint32_t blockIdx = block_idx;
    if (blockIdx >= TOTAL_BLOCKS) {
        return;
    }

    const uint32_t rowSplit = blockIdx / COL_SPLITS;
    const uint32_t colSplit = blockIdx % COL_SPLITS;
    const uint32_t baseRowTiles = TOTAL_ROW_TILES / ROW_SPLITS;
    const uint32_t extraRowTiles = TOTAL_ROW_TILES % ROW_SPLITS;
    const uint32_t rowTileBegin = rowSplit * baseRowTiles + ((rowSplit < extraRowTiles) ? rowSplit : extraRowTiles);
    const uint32_t rowTileCount = baseRowTiles + ((rowSplit < extraRowTiles) ? 1 : 0);
    const uint32_t colTilesPerSplit = TOTAL_COL_TILES / COL_SPLITS;
    const uint32_t colTileBegin = colSplit * colTilesPerSplit;
    const uint32_t tilesPerBlock = rowTileCount * colTilesPerSplit;

    __ubuf__ half ubStorage[UB_STORAGE_ELEMS];
    auto gmXLayout = make_frame_layout<nd_layout_ptn, layout_trait_default<half>>(TOTAL_M, TOTAL_N);
    auto ndLayout = make_frame_layout<nd_layout_ptn, layout_trait_default<half>>(TILE_H, TILE_W);
    auto gmX = make_tensor(make_mem_ptr(x), gmXLayout);
    auto copyGmToUb = make_copy(copy_gm_to_ub{}, gm_to_ub_trait_default{});
    auto copyUbToGm = make_copy(copy_ub_to_gm{}, ub_to_gm_trait_default{});

    for (uint32_t tileIdx = 0; tileIdx < tilesPerBlock; ++tileIdx) {
        const uint32_t slot = tileIdx & 1;
        const uint32_t tileRow = rowTileBegin + tileIdx / colTilesPerSplit;
        const uint32_t tileCol = colTileBegin + tileIdx % colTilesPerSplit;
        const uint32_t rowStart = tileRow * TILE_H;
        const uint32_t colStart = tileCol * TILE_W;
        const uint32_t remainRows = TOTAL_M - rowStart;
        const uint32_t actualTileH = remainRows < TILE_H ? remainRows : TILE_H;

        __ubuf__ half* ndPtr = ubStorage + (slot == 0 ? ND_PING_OFFSET : ND_PONG_OFFSET);
        __ubuf__ half* nzPtr = ubStorage + (slot == 0 ? NZ_PING_OFFSET : NZ_PONG_OFFSET);
        auto ndTensor = make_tensor(make_mem_ptr(ndPtr), ndLayout);

        asc_lock(PIPE_MTE2, slot);
        copy(copyGmToUb, ndTensor, gmX, zero_coord, make_coord(rowStart, colStart), make_shape(actualTileH, TILE_W));
        asc_unlock(PIPE_MTE2, slot);

        asc_lock(PIPE_V, slot);
        auto srcLayout =
            make_pattern_layout<nd_layout_ptn, half>(make_shape(TILE_H, TILE_W), make_stride(TILE_W, _1{}));
        auto dstLayout =
            make_pattern_layout<nd_layout_ptn, half>(make_shape(TILE_H, C0_ELEMS), make_stride(C0_ELEMS, _1{}));
        auto srcTensor = make_tensor(make_mem_ptr(ndPtr), srcLayout);
        auto dstTensor = make_tensor(make_mem_ptr(nzPtr), dstLayout);
        for (uint32_t row = 0; row < actualTileH; ++row) {
            auto srcRow = srcTensor.slice(make_coord(row, 0), make_shape(1, TILE_W));
            auto dstRow = dstTensor.slice(make_coord(row, 0), make_shape(1, C0_ELEMS));
            if constexpr (SCENARIO_NUM == 1) {
                NdToNz<TILE_H>(dstRow.data().get(), srcRow.data().get());
            } else {
                NdToNz<TILE_H + BANK_CONFLICT_OFFSET>(dstRow.data().get(), srcRow.data().get());
            }
        }
        asc_unlock(PIPE_V, slot);

        const uint32_t dstDataBlockOffset = rowStart + (colStart / C0_ELEMS) * TOTAL_M;
        auto nzLayout = make_pattern_layout<nd_layout_ptn, half>(
            make_shape(TILE_C0_COLS, actualTileH * C0_ELEMS), make_stride(LOCAL_COLUMN_STRIDE * C0_ELEMS, _1{}));
        auto gmZLayout = make_pattern_layout<nd_layout_ptn, half>(
            make_shape(TILE_C0_COLS, actualTileH * C0_ELEMS), make_stride(TOTAL_M * C0_ELEMS, _1{}));
        auto nzTensor = make_tensor(make_mem_ptr(nzPtr), nzLayout);
        auto gmZ = make_tensor(make_mem_ptr(z + dstDataBlockOffset * C0_ELEMS), gmZLayout);

        asc_lock(PIPE_MTE3, slot);
        copy(copyUbToGm, gmZ, nzTensor);
        asc_unlock(PIPE_MTE3, slot);
    }

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t inputByteSize = static_cast<size_t>(TOTAL_M) * TOTAL_N * sizeof(half);
    constexpr size_t outputByteSize = static_cast<size_t>(TOTAL_M) * TOTAL_N * sizeof(half);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* xHost = nullptr;
    half* zHost = nullptr;
    half* xDevice = nullptr;
    half* zDevice = nullptr;
    aclrtMallocHost((void**)(&xHost), inputByteSize);
    aclrtMallocHost((void**)(&zHost), outputByteSize);
    aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input.bin", xHost, inputByteSize);
    aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE);

    bank_conflict_kernel<<<TOTAL_BLOCKS, 0, stream>>>(xDevice, zDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, outputByteSize);

    aclrtFree(xDevice);
    aclrtFree(zDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(zHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
