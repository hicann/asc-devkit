/*!
 * \file copy_out_tensor_api.asc
 * \brief copy_out_tensor_api
 */

#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

struct CoreIterInfo {
    uint32_t mIter;
    uint32_t mIterIdx;
    uint32_t nIterIdx;
    int32_t actualSingleCoreM;
    int32_t actualSingleCoreN;
};

// Custom CopyL0C2UBTrait parameters used only for L0C to UB copies
constexpr asc::te::dual_dst_mode gDualDstMode =
    (SCENARIO_NUM == 3) ? asc::te::dual_dst_mode::split_n : asc::te::dual_dst_mode::split_m;
constexpr asc::te::l0c_to_ub_trait COPY_L0C2UB_TRAIT =
    asc::te::l0c_to_ub_trait{asc::te::round_mode::default_round, false, false, gDualDstMode};
struct CopyL0C2UBTraitCustom {
    using TraitType = asc::te::l0c_to_ub_trait;
    static constexpr const TraitType value = COPY_L0C2UB_TRAIT;
};

// Copy tiling information from GM to a local struct
__aicore__ inline void CopyTilingFromGM(__gm__ MatmulTiling* srcInfo, MatmulTiling& dstInfo)
{
    auto srcPtr = reinterpret_cast<__gm__ int32_t*>(srcInfo);
    auto dstPtr = reinterpret_cast<int32_t*>(&dstInfo);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dstPtr[i] = srcPtr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline CoreIterInfo CalcCoreIterInfo(const MatmulTiling& tiling)
{
    uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    auto blockIdx = block_idx;
    uint32_t mIterIdx = blockIdx % mIter;
    uint32_t nIterIdx = blockIdx / mIter;
    int32_t actualSingleCoreM = tiling.m - mIterIdx * tiling.singleCoreM;
    actualSingleCoreM = actualSingleCoreM < tiling.singleCoreM ? actualSingleCoreM : tiling.singleCoreM;
    int32_t actualSingleCoreN = tiling.n - nIterIdx * tiling.singleCoreN;
    actualSingleCoreN = actualSingleCoreN < tiling.singleCoreN ? actualSingleCoreN : tiling.singleCoreN;
    return {mIter, mIterIdx, nIterIdx, actualSingleCoreM, actualSingleCoreN};
}

template <
    typename A_TYPE, typename B_TYPE, typename C_TYPE, typename BIAS_TYPE, int32_t baseM, int32_t baseN, int32_t baseK,
    int32_t stepM, int32_t stepN, int32_t stepK>
__global__ __mix__(1, 2) void copy_out_tensor_api(
    __gm__ A_TYPE* x, __gm__ B_TYPE* y, __gm__ C_TYPE* z, __gm__ BIAS_TYPE* bias, __gm__ MatmulTiling* tilingInfo)
{
    asc_init();
    using namespace asc::te;

    // 1. Copy tiling information from GM
    MatmulTiling tiling;
    CopyTilingFromGM(tilingInfo, tiling);

    // 2. Get SCENARIO_NUM
    constexpr uint32_t scenarioNum = SCENARIO_NUM;

    // 3. Calculate iteration information for the current core
    CoreIterInfo iterInfo = CalcCoreIterInfo(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t singleCoreM = tiling.singleCoreM;
    int32_t singleCoreN = tiling.singleCoreN;
    int32_t singleCoreK = tiling.singleCoreK;

    // 4. Create GM tensors and slices
    auto gmPtrA = make_mem_ptr(x);
    auto gmPtrB = make_mem_ptr(y);
    auto gmPtrC = make_mem_ptr(z);
    auto gmPtrBias = make_mem_ptr(bias);

    auto gmA = make_tensor(gmPtrA, make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gmB = make_tensor(gmPtrB, make_frame_layout<nd_ext_layout_ptn>(k, n));
    auto gmC = make_tensor(gmPtrC, make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto gmBias = make_tensor(gmPtrBias, make_frame_layout<nd_ext_layout_ptn>(1, n));

    // Slice the current single-core data block from the complete GM tensors.
    auto globalA =
        gmA.slice(make_coord(iterInfo.mIterIdx * singleCoreM, 0), make_shape(iterInfo.actualSingleCoreM, singleCoreK));
    auto globalB =
        gmB.slice(make_coord(0, iterInfo.nIterIdx * singleCoreN), make_shape(singleCoreK, iterInfo.actualSingleCoreN));
    auto globalC = gmC.slice(
        make_coord(iterInfo.mIterIdx * singleCoreM, iterInfo.nIterIdx * singleCoreN),
        make_shape(iterInfo.actualSingleCoreM, iterInfo.actualSingleCoreN));
    auto globalBias =
        gmBias.slice(make_coord(0, iterInfo.nIterIdx * singleCoreN), make_shape(1, iterInfo.actualSingleCoreN));
    // 5. Create L1 tensors
    auto l1ALayout = make_frame_layout<nz_layout_ptn, A_TYPE>(baseM * stepM, baseK * stepK);
    auto l1BLayout = make_frame_layout<nz_layout_ptn, B_TYPE>(baseK * stepK, baseN * stepN);
    auto l1BiasLayout = make_frame_layout<nd_ext_layout_ptn>(1, baseN * stepN);
    auto ubLayout = make_frame_layout<nd_ext_layout_ptn>(iterInfo.actualSingleCoreM, iterInfo.actualSingleCoreN);

    __cbuf__ A_TYPE l1ABuf[baseM * stepM * baseK * stepK];
    __cbuf__ B_TYPE l1BBuf[baseK * stepK * baseN * stepN];
    __cbuf__ BIAS_TYPE l1BiasBuf[baseN * stepN];
    __ca__ A_TYPE l0ABuf[baseM * baseK];
    __cb__ B_TYPE l0BBuf[baseK * baseN];
    __biasbuf__ BIAS_TYPE l0BiasBuf[baseN];
    __cc__ C_TYPE l0CBuf[baseM * baseN];
    __ubuf__ C_TYPE ubBuf[baseM * stepM * baseN * stepN / 2];

    auto l1APtr = make_mem_ptr(l1ABuf);
    auto l1BPtr = make_mem_ptr(l1BBuf);
    auto l1BiasPtr = make_mem_ptr(l1BiasBuf);
    auto l0APtr = make_mem_ptr(l0ABuf);
    auto l0BPtr = make_mem_ptr(l0BBuf);
    auto l0BiasPtr = make_mem_ptr(l0BiasBuf);
    auto l0CPtr = make_mem_ptr(l0CBuf);
    auto ubPtr = make_mem_ptr(ubBuf);

    auto l1ATensor = make_tensor(l1APtr, l1ALayout);
    auto l1BTensor = make_tensor(l1BPtr, l1BLayout);
    auto l1BiasTensor = make_tensor(l1BiasPtr, l1BiasLayout);
    auto ubTensor = make_tensor(ubPtr, ubLayout);
    auto copyGM2L1Atom = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto copyL12BTAtom = make_copy(copy_l1_to_biastable{}, l1_to_biastable_trait_default{});
    auto copyL12L0AAtom = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto copyL12L0BAtom = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto copyL0C2GMAtom = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto copyL0C2UBAtom = make_copy(copy_l0c_to_ub{}, CopyL0C2UBTraitCustom{});
    auto copyUB2GMAtom = make_copy(copy_ub_to_gm{}, ub_to_gm_trait_default{});
    auto mmadAtom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // 6. Calculate loop counts
    uint32_t mLoop = (iterInfo.actualSingleCoreM + baseM - 1) / baseM;
    uint32_t nLoop = (iterInfo.actualSingleCoreN + baseN - 1) / baseN;
    uint32_t kLoop = (singleCoreK + baseK - 1) / baseK;
    uint32_t tileM = (iterInfo.actualSingleCoreM % baseM != 0) ? iterInfo.actualSingleCoreM % baseM : baseM;
    uint32_t tileN = (iterInfo.actualSingleCoreN % baseN != 0) ? iterInfo.actualSingleCoreN % baseN : baseN;
    uint32_t tileK = (singleCoreK % baseK != 0) ? singleCoreK % baseK : baseK;

    if ASCEND_IS_AIC {
        constexpr uint32_t L1_Index = 0;
        constexpr uint32_t L0_Index = 1;
        constexpr uint32_t L0C_Index = 2;
        constexpr uint32_t L1_BIAS_Index = 3;
        constexpr uint32_t L0_BIAS_Index = 4;

        // 7. Main compute loop
        for (uint32_t i = 0; i < mLoop; i++) {
            uint16_t curM = (i + 1 == mLoop) ? tileM : baseM;
            for (uint32_t j = 0; j < nLoop; j++) {
                uint16_t curN = (j + 1 == nLoop) ? tileN : baseN;
                auto l0CLayout = make_frame_layout<nz_layout_ptn>(curM, curN);
                auto l0BiasLayout = make_frame_layout<nd_ext_layout_ptn>(1, curN);
                auto l0CTensor = make_tensor(l0CPtr, l0CLayout);
                auto l0BiasTensor = make_tensor(l0BiasPtr, l0BiasLayout);

                // Move bias along the N dimension to L1 and then L0 for the first Mmad of this N tile
                asc_lock(PIPE_MTE2, L1_BIAS_Index);
                copy(copyGM2L1Atom, l1BiasTensor, globalBias.slice(make_coord(0, j * baseN), make_shape(1, curN)));
                asc_unlock(PIPE_MTE2, L1_BIAS_Index);
                asc_lock(PIPE_MTE1, L1_BIAS_Index);
                asc_lock(PIPE_MTE1, L0_BIAS_Index);
                copy(copyL12BTAtom, l0BiasTensor, l1BiasTensor.slice(make_coord(0, 0), make_shape(1, curN)));
                asc_unlock(PIPE_MTE1, L0_BIAS_Index);
                asc_unlock(PIPE_MTE1, L1_BIAS_Index);

                for (uint32_t kIter = 0; kIter < kLoop; kIter++) {
                    uint16_t curK = (kIter + 1 == kLoop) ? tileK : baseK;
                    auto l0ALayout = make_frame_layout<nz_layout_ptn, A_TYPE>(curM, curK);
                    auto l0BLayout = make_frame_layout<zn_layout_ptn, B_TYPE>(curK, curN);
                    auto l0ATensor = make_tensor(l0APtr, l0ALayout);
                    auto l0BTensor = make_tensor(l0BPtr, l0BLayout);

                    // GM -> L1
                    if (kIter % stepK == 0) {
                        uint16_t curStepK = static_cast<uint16_t>(singleCoreK - kIter * baseK);
                        curStepK = curStepK < baseK * stepK ? curStepK : baseK * stepK;
                        asc_lock(PIPE_MTE2, L1_Index);
                        copy(
                            copyGM2L1Atom, l1ATensor,
                            globalA.slice(make_coord(i * baseM, kIter * baseK), make_shape(curM, curStepK)));
                        copy(
                            copyGM2L1Atom, l1BTensor,
                            globalB.slice(make_coord(kIter * baseK, j * baseN), make_shape(curStepK, curN)));
                        asc_unlock(PIPE_MTE2, L1_Index);
                        asc_lock(PIPE_MTE1, L1_Index);
                    }

                    // L1 -> L0
                    asc_lock(PIPE_MTE1, L0_Index);
                    copy(
                        copyL12L0AAtom, l0ATensor,
                        l1ATensor.slice(make_coord(0, kIter % stepK * baseK), make_shape(curM, curK)));
                    copy(
                        copyL12L0BAtom, l0BTensor,
                        l1BTensor.slice(make_coord(kIter % stepK * baseK, 0), make_shape(curK, curN)));
                    if ((kIter + 1) % stepK == 0 || kIter + 1 == kLoop) {
                        asc_unlock(PIPE_MTE1, L1_Index);
                    }
                    asc_unlock(PIPE_MTE1, L0_Index);
                    asc_lock(PIPE_M, L0_Index);

                    if (kIter == 0) {
                        asc_lock(PIPE_M, L0C_Index);
                    }

                    // Mmad compute
                    if (kIter == 0) {
                        asc_lock(PIPE_M, L0_BIAS_Index);
                        mmad(
                            mmadAtom.with(mmad_params(
                                curM, curN, curK, scenarioNum == 1 ? ((kIter == kLoop - 1) ? unit_flag_mode::enable_update : unit_flag_mode::enable_keep) : unit_flag_mode::disable, true)),
                            l0CTensor, l0ATensor, l0BTensor, l0BiasTensor);
                        asc_unlock(PIPE_M, L0_BIAS_Index);
                    } else {
                        mmad(
                            mmadAtom.with(mmad_params(
                                curM, curN, curK, scenarioNum == 1 ? ((kIter == kLoop - 1) ? unit_flag_mode::enable_update : unit_flag_mode::enable_keep) : unit_flag_mode::disable, false)),
                            l0CTensor, l0ATensor, l0BTensor);
                    }
                    if (kIter == kLoop - 1) {
                        asc_unlock(PIPE_M, L0C_Index);
                    }
                    asc_unlock(PIPE_M, L0_Index);
                }

                asc_lock(PIPE_FIX, L0C_Index);
                if constexpr (scenarioNum < 2) {
                    // L0C -> GM
                    l0c_to_gm_params params;
                    if constexpr (scenarioNum == 1) {
                        params.unit_flag = unit_flag_mode::enable_update;
                    }
                    copy(
                        copyL0C2GMAtom.with(params),
                        globalC.slice(make_coord(i * baseM, j * baseN), make_shape(curM, curN)), l0CTensor);
                } else {
                    // L0C -> UB
                    if constexpr (scenarioNum == 2) {
                        // Split along the M dimension
                        copy(
                            copyL0C2UBAtom, ubTensor.slice(make_coord(i * baseM / 2, j * baseN), make_shape(curM, curN)),
                            l0CTensor);
                    } else if constexpr (scenarioNum == 3) {
                        // Split along the N dimension
                        copy(
                            copyL0C2UBAtom, ubTensor.slice(make_coord(i * baseM, j * baseN / 2), make_shape(curM, curN)),
                            l0CTensor);
                    }
                    asc_sync_block_arrive(PIPE_FIX, 0x8);
                }
                asc_unlock(PIPE_FIX, L0C_Index);
            }
        }
    }

    if ASCEND_IS_AIV {
        if constexpr (scenarioNum > 1) {
            for (uint32_t i = 0; i < mLoop; i++) {
                uint16_t curM = (i + 1 == mLoop) ? tileM : baseM;
                for (uint32_t j = 0; j < nLoop; j++) {
                    uint16_t curN = (j + 1 == nLoop) ? tileN : baseN;
                    asc_sync_block_wait(PIPE_S, 0x8);
                    if constexpr (scenarioNum == 2) {
                        // Split along the M dimension
                        copy(
                            copyUB2GMAtom,
                            globalC.slice(
                                make_coord(i * baseM + asc_get_sub_block_id() * curM / 2, j * baseN),
                                make_shape(curM / 2, curN)),
                            ubTensor.slice(make_coord(i * baseM / 2, j * baseN), make_shape(curM / 2, curN)));
                    } else if constexpr (scenarioNum == 3) {
                        // Split along the N dimension
                        copy(
                            copyUB2GMAtom,
                            globalC.slice(
                                make_coord(i * baseM, j * baseN + asc_get_sub_block_id() * curN / 2),
                                make_shape(curM, curN / 2)),
                            ubTensor.slice(make_coord(i * baseM, j * baseN / 2), make_shape(curM, curN / 2)));
                    }
                }
            }
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = half;
    using B_TYPE = half;
    using C_TYPE = float;
    using BIAS_TYPE = float;

    // Tiling info filled into struct (dynamic at runtime)
    MatmulTiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.singleCoreM = 256;
    tiling.singleCoreN = 128;
    tiling.singleCoreK = 256;

    // Static tiling parameters (compile-time constants)
    constexpr int32_t BASE_M = 128;
    constexpr int32_t BASE_N = 128;
    constexpr int32_t BASE_K = 64;
    constexpr int32_t STEP_M = 1;
    constexpr int32_t STEP_N = 1;
    constexpr int32_t STEP_K = 4;

    constexpr uint32_t NUM_BLOCKS = 32;

    size_t param1FileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t param2FileSize = tiling.n * tiling.k * sizeof(B_TYPE);
    size_t param3FileSize = tiling.m * tiling.n * sizeof(C_TYPE);
    size_t param4FileSize = tiling.n * sizeof(BIAS_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *xHost, *yHost, *zHost, *biasHost;
    A_TYPE* xDevice;
    B_TYPE* yDevice;
    C_TYPE* zDevice;
    BIAS_TYPE* biasDevice;

    aclrtMallocHost((void**)(&xHost), param1FileSize);
    aclrtMallocHost((void**)(&yHost), param2FileSize);
    aclrtMallocHost((void**)(&zHost), param3FileSize);
    aclrtMallocHost((void**)(&biasHost), param4FileSize);
    aclrtMalloc((void**)&xDevice, param1FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, param2FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&zDevice, param3FileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&biasDevice, param4FileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/input_x.bin", param1FileSize, xHost, param1FileSize);
    ReadFile("./input/input_y.bin", param2FileSize, yHost, param2FileSize);
    ReadFile("./input/bias.bin", param4FileSize, biasHost, param4FileSize);

    aclrtMemcpy(xDevice, param1FileSize, xHost, param1FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDevice, param2FileSize, yHost, param2FileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice, param4FileSize, biasHost, param4FileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    MatmulTiling* tilingHost;
    MatmulTiling* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    copy_out_tensor_api<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, BASE_M, BASE_N, BASE_K, STEP_M, STEP_N, STEP_K>
        <<<NUM_BLOCKS, 0, stream>>>(xDevice, yDevice, zDevice, biasDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(zHost, param3FileSize, zDevice, param3FileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", zHost, param3FileSize);

    aclrtFree(xDevice);
    aclrtFree(yDevice);
    aclrtFree(zDevice);
    aclrtFree(biasDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(xHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(zHost);
    aclrtFreeHost(biasHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
