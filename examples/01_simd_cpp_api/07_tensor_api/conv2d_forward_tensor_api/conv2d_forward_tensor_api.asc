/* !
 * \file conv2d_forward_tensor_api.asc
 * \brief 使用 Tensor API 实现的极简 Conv2D Forward 样例：
 *        GM(NCHW/NHWC/NC1HWC0) -> L1(NC1HWC0) -> L0A(img2col NZ) / L0B(NZ) -> L0C(NZ) -> GM(NCHW/NHWC/NC1HWC0)。
 *        输入输出的 GM 格式由 SCENARIO_NUM 控制（编译时传入，见 CMakeLists.txt）：
 *          0 - NC1HWC0 输入输出
 *          1 - NCHW 输入输出
 *          2 - NHWC 输入输出
 *        L1 fmap 统一为 NC1HWC0，由 GM->L1 按源格式路由（NCHW->NC1HWC0 走 dn2nz、
 *        NHWC->NC1HWC0 走 nd2nz、NC1HWC0->NC1HWC0 直搬）；输出同理由 L0C->GM 按目的格式路由。
 */
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t block_dim = 4;
constexpr uint32_t n = 4;
constexpr uint32_t c1 = 2;
constexpr uint32_t c0 = 16;
constexpr uint32_t cin = c1 * c0; // 32
constexpr uint32_t cout = 16;
constexpr uint32_t h = 9;
constexpr uint32_t w = 9;
constexpr uint32_t kh = 3;
constexpr uint32_t kw = 3;
constexpr uint32_t stride_h = 2;
constexpr uint32_t stride_w = 2;
constexpr uint32_t dilation_h = 2;
constexpr uint32_t dilation_w = 2;
constexpr uint32_t pad_left = 2;
constexpr uint32_t pad_right = 2;
constexpr uint32_t pad_top = 2;
constexpr uint32_t pad_bottom = 2;
constexpr uint32_t pad_value = 1;

constexpr uint32_t hout = (h + pad_top + pad_bottom - dilation_h * (kh - 1) - 1) / stride_h + 1; // 5
constexpr uint32_t wout = (w + pad_left + pad_right - dilation_w * (kw - 1) - 1) / stride_w + 1; // 5

constexpr uint32_t m = hout * wout;     // img2col 输出行数：25
constexpr uint32_t k = cin * kh * kw;   // img2col 输出列数：288
constexpr uint32_t cout_n = cout;       // GEMM 的 N：16
constexpr uint32_t cout_c1 = cout / c0; // 输出 NC1HWC0 的 C1：1
constexpr uint32_t cube_block = 16;
constexpr uint32_t m_align = (m + cube_block - 1) / cube_block * cube_block; // 32

constexpr uint32_t fmap_batch_size = h * w * cin;       // 单 batch fmap 元素数
constexpr uint32_t weight_size = k * cout_n;            // weight 元素数（[K, Cout]）
constexpr uint32_t out_batch_size = hout * wout * cout; // 单 batch 输出元素数

extern "C" __global__ __cube__ void conv2d_forward_tensor_api_custom(
    __gm__ half* fmap, __gm__ half* weight, __gm__ half* out)
{
    using namespace asc::te;
    init_soc_state();

    // 场景编号：0=NC1HWC0, 1=NCHW, 2=NHWC（编译时由 SCENARIO_NUM 传入）。
    constexpr uint32_t scenario_num = SCENARIO_NUM;

    // 每个 cube 核处理一个 batch（N=4，block_dim=4）。
    uint32_t batch_idx = block_idx;
    if (batch_idx >= n) {
        return;
    }

    __cbuf__ half l1_fmap_buf[fmap_batch_size];
    __cbuf__ half l1_weight_buf[weight_size];
    __ca__ half l0_a_buf[m_align * k];
    __cb__ half l0_b_buf[k * cout_n];
    __cc__ float l0_c_buf[m_align * cout_n];

    // GM fmap 按 SCENARIO_NUM 构造：NCHW(1,C,H,W) / NHWC(1,H,W,C) / NC1HWC0(1,C1,H,W,C0)。
    // copy_gm_to_l1 按源 pattern 路由（NCHW->NC1HWC0 走 dn2nz、NHWC->NC1HWC0 走 nd2nz、NC1HWC0 直搬）。
    // 每个核取本 batch 对应的 GM 偏移。L1 fmap 统一为 NC1HWC0。
    auto l1_fmap_tensor = make_tensor(
        make_mem_ptr(l1_fmap_buf),
        make_frame_layout<nc1hwc0_layout_ptn>(
            1, static_cast<int32_t>(c1), static_cast<int32_t>(h), static_cast<int32_t>(w), static_cast<int32_t>(c0)));

    // weight GM 已按 [K, Cout] 行优先摆放（K 序 = (C1, KH, KW, C0)），用 nd_ext_layout_ptn(行优先)与之一致。
    auto gm_weight_tensor = make_tensor(make_mem_ptr(weight), make_frame_layout<nd_ext_layout_ptn>(k, cout_n));
    auto l1_weight_tensor = make_tensor(make_mem_ptr(l1_weight_buf), make_frame_layout<zn_layout_ptn, half>(k, cout_n));

    // L0A/L0C 容量按 m_align 对齐，但 Mmad 的 m 用实际 M（硬件按实际 M 计算有效行）。
    auto l0_a_tensor = make_tensor(make_mem_ptr(l0_a_buf), make_frame_layout<nz_layout_ptn, half>(m_align, k));
    auto l0_b_tensor = make_tensor(make_mem_ptr(l0_b_buf), make_frame_layout<zn_layout_ptn, half>(k, cout_n));
    auto l0_c_tensor = make_tensor(make_mem_ptr(l0_c_buf), make_frame_layout<nz_layout_ptn>(m_align, cout_n));

    auto copy_gm2l1_atom = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto copy_img2col_atom = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto copy_l12l0b_atom = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto copy_l0c2gm_atom = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // Mutex 槽位锁 ID（单缓冲：L1=0, L0=1, L0C=2）。
    constexpr uint32_t l1_index = 0;
    mutex<PIPE_MTE2> pipe_mte2_l1_index_mutex(l1_index);
    mutex<PIPE_MTE1> pipe_mte1_l1_index_mutex(l1_index);
    constexpr uint32_t l0_index = 1;
    mutex<PIPE_MTE1> pipe_mte1_l0_index_mutex(l0_index);
    mutex<PIPE_M> pipe_m_l0_index_mutex(l0_index);
    constexpr uint32_t l0c_index = 2;
    mutex<PIPE_M> pipe_m_l0c_index_mutex(l0c_index);
    mutex<PIPE_FIX> pipe_fix_l0c_index_mutex(l0c_index);

    // GM fmap -> L1(NC1HWC0)：按 SCENARIO_NUM 构造 GM fmap layout 并搬运。
    pipe_mte2_l1_index_mutex.lock();
    auto gm_fmap_mem = make_mem_ptr(fmap + batch_idx * fmap_batch_size);
    if constexpr (scenario_num == 1) {
        auto gm_fmap_tensor = make_tensor(
            gm_fmap_mem, make_frame_layout<nchw_layout_ptn>(
                             1, static_cast<int32_t>(cin), static_cast<int32_t>(h), static_cast<int32_t>(w)));
        copy(copy_gm2l1_atom, l1_fmap_tensor, gm_fmap_tensor);
    } else if constexpr (scenario_num == 2) {
        auto gm_fmap_tensor = make_tensor(
            gm_fmap_mem, make_frame_layout<nhwc_layout_ptn>(
                             1, static_cast<int32_t>(h), static_cast<int32_t>(w), static_cast<int32_t>(cin)));
        copy(copy_gm2l1_atom, l1_fmap_tensor, gm_fmap_tensor);
    } else {
        auto gm_fmap_tensor = make_tensor(
            gm_fmap_mem, make_frame_layout<nc1hwc0_layout_ptn>(
                             1, static_cast<int32_t>(c1), static_cast<int32_t>(h), static_cast<int32_t>(w),
                             static_cast<int32_t>(c0)));
        copy(copy_gm2l1_atom, l1_fmap_tensor, gm_fmap_tensor);
    }

    // weight: GM(ND) -> L1(ZN)
    copy(copy_gm2l1_atom, l1_weight_tensor, gm_weight_tensor);

    pipe_mte2_l1_index_mutex.unlock();
    pipe_mte1_l1_index_mutex.lock();

    img2col_params<half> img2col_cfg;
    img2col_cfg.filter_w = kw;
    img2col_cfg.filter_h = kh;
    img2col_cfg.m_extension = m;
    img2col_cfg.k_extension = k;
    img2col_cfg.stride_w = stride_w;
    img2col_cfg.stride_h = stride_h;
    img2col_cfg.dilation_filter_w = dilation_w;
    img2col_cfg.dilation_filter_h = dilation_h;
    img2col_cfg.pad_list[0] = pad_left;   // left
    img2col_cfg.pad_list[1] = pad_right;  // right
    img2col_cfg.pad_list[2] = pad_top;    // top
    img2col_cfg.pad_list[3] = pad_bottom; // bottom
    img2col_cfg.pad_value = pad_value;
    // L1(NC1HWC0) -> L0A(NZ, img2col 展开)
    pipe_mte1_l0_index_mutex.lock();
    copy(copy_img2col_atom.with(img2col_cfg), l0_a_tensor, l1_fmap_tensor);
    // L1(NZ) -> L0B(ZN)
    copy(copy_l12l0b_atom, l0_b_tensor, l1_weight_tensor);
    pipe_mte1_l0_index_mutex.unlock();
    pipe_mte1_l1_index_mutex.unlock();

    pipe_m_l0_index_mutex.lock();
    pipe_m_l0c_index_mutex.lock();
    // Mmad：L0A(NZ,M,K) x L0B(ZN,K,Cout) -> L0C(NZ,M,Cout)
    mmad_params mmad_cfg;
    mmad_cfg.m = m;
    mmad_cfg.n = cout_n;
    mmad_cfg.k = k;
    mmad_cfg.init_with_zero = true;
    mmad(mmad_atom.with(mmad_cfg), l0_c_tensor, l0_a_tensor, l0_b_tensor);
    pipe_m_l0c_index_mutex.unlock();
    pipe_m_l0_index_mutex.unlock();

    // L0C(NZ) -> GM：输出逻辑 (1, C, HOUT, WOUT)，C=COUT。按 SCENARIO_NUM 构造 GM out layout，
    // copy_l0c_to_gm 按目的 pattern 路由（NCHW 走 nz2dn、NHWC 走 nz2nd、NC1HWC0 直搬 NZ->NC1HWC0）。
    pipe_fix_l0c_index_mutex.lock();
    auto gm_out_mem = make_mem_ptr(out + batch_idx * out_batch_size);
    if constexpr (scenario_num == 1) {
        auto gm_out_tensor = make_tensor(
            gm_out_mem, make_frame_layout<nchw_layout_ptn>(
                            1, static_cast<int32_t>(cout), static_cast<int32_t>(hout), static_cast<int32_t>(wout)));
        copy(copy_l0c2gm_atom, gm_out_tensor, l0_c_tensor);
    } else if constexpr (scenario_num == 2) {
        auto gm_out_tensor = make_tensor(
            gm_out_mem, make_frame_layout<nhwc_layout_ptn>(
                            1, static_cast<int32_t>(hout), static_cast<int32_t>(wout), static_cast<int32_t>(cout)));
        copy(copy_l0c2gm_atom, gm_out_tensor, l0_c_tensor);
    } else {
        auto gm_out_tensor = make_tensor(
            gm_out_mem, make_frame_layout<nc1hwc0_layout_ptn>(
                            1, static_cast<int32_t>(cout_c1), static_cast<int32_t>(hout), static_cast<int32_t>(wout),
                            static_cast<int32_t>(c0)));
        copy(copy_l0c2gm_atom, gm_out_tensor, l0_c_tensor);
    }
    pipe_fix_l0c_index_mutex.unlock();

    sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t fmap_file_size = n * fmap_batch_size * sizeof(half);
    size_t weight_file_size = weight_size * sizeof(half);
    size_t out_file_size = n * out_batch_size * sizeof(half);
    uint32_t num_blocks = block_dim;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* fmap_host;
    half* fmap_device;
    aclrtMallocHost((void**)(&fmap_host), fmap_file_size);
    aclrtMalloc((void**)&fmap_device, fmap_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", fmap_file_size, fmap_host, fmap_file_size);
    aclrtMemcpy(fmap_device, fmap_file_size, fmap_host, fmap_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* weight_host;
    half* weight_device;
    aclrtMallocHost((void**)(&weight_host), weight_file_size);
    aclrtMalloc((void**)&weight_device, weight_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", weight_file_size, weight_host, weight_file_size);
    aclrtMemcpy(weight_device, weight_file_size, weight_host, weight_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* out_host;
    half* out_device;
    aclrtMallocHost((void**)(&out_host), out_file_size);
    aclrtMalloc((void**)&out_device, out_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    conv2d_forward_tensor_api_custom<<<num_blocks, nullptr, stream>>>(fmap_device, weight_device, out_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(out_host, out_file_size, out_device, out_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", out_host, out_file_size);

    aclrtFree(fmap_device);
    aclrtFreeHost(fmap_host);
    aclrtFree(weight_device);
    aclrtFreeHost(weight_host);
    aclrtFree(out_device);
    aclrtFreeHost(out_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
