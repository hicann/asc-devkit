/*!
 * \file matmul_bias_fusion.asc
 * \brief Cube matmul with bias fused with Vector residual addition.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "c_api/sync/sync.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_compute.h"
#include "tensor_api/tensor.h"

struct MatmulTiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t singleCoreK;
};

struct CoreIterInfo {
    uint32_t mIter;
    uint32_t mIterIdx;
    uint32_t nIterIdx;
    int32_t actualSingleCoreM;
    int32_t actualSingleCoreN;
};

constexpr uint32_t MATRIX_M = 1024;
constexpr uint32_t MATRIX_N = 1024;
constexpr uint32_t MATRIX_K = 256;
constexpr uint32_t SINGLE_CORE_M = 256;
constexpr uint32_t SINGLE_CORE_N = 128;
constexpr uint32_t BASE_M = 128;
constexpr uint32_t BASE_N = 128;
constexpr uint32_t BASE_K = 64;
constexpr uint32_t STEP_M = 1;
constexpr uint32_t STEP_N = 1;
constexpr uint32_t STEP_K = 4;
constexpr uint32_t VECTOR_LEN = BASE_N < 64 ? BASE_N : 64;
constexpr uint32_t PIPE_DEPTH = 2;
constexpr int64_t AIC_TO_AIV_FLAGS[PIPE_DEPTH] = {8, 9};
constexpr int64_t AIV_TO_AIC_FLAGS[PIPE_DEPTH] = {10, 11};

static_assert(MATRIX_M % SINGLE_CORE_M == 0, "M must be evenly distributed across Cube cores");
static_assert(SINGLE_CORE_M % BASE_M == 0, "singleCoreM must contain complete Cube tiles");
static_assert(BASE_M % 2 == 0, "dual-destination split_m requires an even tile M");

constexpr asc::te::l0c_to_ub_trait COPY_L0C2UB_TRAIT = {
    asc::te::round_mode::default_round, false, false, asc::te::dual_dst_mode::split_m};
struct CopyL0C2UBTraitCustom {
    using TraitType = asc::te::l0c_to_ub_trait;
    static constexpr const TraitType value = COPY_L0C2UB_TRAIT;
};

__aicore__ inline void CopyTilingFromGM(__gm__ MatmulTiling* srcInfo, MatmulTiling& dstInfo)
{
    auto srcPtr = reinterpret_cast<__gm__ int32_t*>(srcInfo);
    auto dstPtr = reinterpret_cast<int32_t*>(&dstInfo);
    for (size_t i = 0; i < sizeof(MatmulTiling) / sizeof(int32_t); ++i) {
        dstPtr[i] = srcPtr[i];
    }
}

__aicore__ inline CoreIterInfo CalcCoreIterInfo(const MatmulTiling& tiling)
{
    const uint32_t mIter = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    const uint32_t mIterIdx = block_idx % mIter;
    const uint32_t nIterIdx = block_idx / mIter;
    int32_t actualSingleCoreM = tiling.m - mIterIdx * tiling.singleCoreM;
    actualSingleCoreM = actualSingleCoreM < tiling.singleCoreM ? actualSingleCoreM : tiling.singleCoreM;
    int32_t actualSingleCoreN = tiling.n - nIterIdx * tiling.singleCoreN;
    actualSingleCoreN = actualSingleCoreN < tiling.singleCoreN ? actualSingleCoreN : tiling.singleCoreN;
    return {mIter, mIterIdx, nIterIdx, actualSingleCoreM, actualSingleCoreN};
}

template <typename Src0Tensor, typename Src1Tensor, typename DstTensor>
__simd_vf__ inline void ComputeAdd(Src0Tensor src0, Src1Tensor src1, DstTensor dst, uint32_t length)
{
    const auto coord = asc::te::make_coord(0);
    auto mask = asc::te::experimental::update_mask<float>(length);
    auto lhs = asc::te::experimental::load(src0, coord).with_mask(mask);
    auto rhs = asc::te::experimental::load(src1, coord).with_mask(mask);
    asc::te::experimental::store(dst, coord, lhs + rhs);
}

template <typename A_TYPE, typename B_TYPE, typename C_TYPE, typename BIAS_TYPE>
__global__ __mix__(1, 2) void matmul_bias_fusion(
    __gm__ A_TYPE* a, __gm__ B_TYPE* b, __gm__ BIAS_TYPE* bias, __gm__ C_TYPE* residual, __gm__ C_TYPE* y,
    __gm__ MatmulTiling* tilingInfo)
{
    asc_init();
    using namespace asc::te;

    MatmulTiling tiling;
    CopyTilingFromGM(tilingInfo, tiling);
    const CoreIterInfo iterInfo = CalcCoreIterInfo(tiling);

    auto gmA = make_tensor(make_mem_ptr(a), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.k));
    auto gmB = make_tensor(make_mem_ptr(b), make_frame_layout<nd_ext_layout_ptn>(tiling.k, tiling.n));
    auto gmBias = make_tensor(make_mem_ptr(bias), make_frame_layout<nd_ext_layout_ptn>(1, tiling.n));
    auto gmResidual = make_tensor(make_mem_ptr(residual), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.n));
    auto gmY = make_tensor(make_mem_ptr(y), make_frame_layout<nd_ext_layout_ptn>(tiling.m, tiling.n));

    auto globalA = gmA.slice(
        make_coord(iterInfo.mIterIdx * tiling.singleCoreM, 0),
        make_shape(iterInfo.actualSingleCoreM, tiling.singleCoreK));
    auto globalB = gmB.slice(
        make_coord(0, iterInfo.nIterIdx * tiling.singleCoreN),
        make_shape(tiling.singleCoreK, iterInfo.actualSingleCoreN));
    auto globalBias =
        gmBias.slice(make_coord(0, iterInfo.nIterIdx * tiling.singleCoreN), make_shape(1, iterInfo.actualSingleCoreN));

    const uint32_t mLoop = (iterInfo.actualSingleCoreM + BASE_M - 1) / BASE_M;
    const uint32_t nLoop = (iterInfo.actualSingleCoreN + BASE_N - 1) / BASE_N;
    const uint32_t kLoop = (tiling.singleCoreK + BASE_K - 1) / BASE_K;
    const uint32_t tileM = (iterInfo.actualSingleCoreM % BASE_M != 0) ? iterInfo.actualSingleCoreM % BASE_M : BASE_M;
    const uint32_t tileN = (iterInfo.actualSingleCoreN % BASE_N != 0) ? iterInfo.actualSingleCoreN % BASE_N : BASE_N;
    const uint32_t tileK = (tiling.singleCoreK % BASE_K != 0) ? tiling.singleCoreK % BASE_K : BASE_K;

    // The split-m copy writes half of each tile into the local UB of each AIV.
    // Two fixed regions are used so Cube can hand off the next tile while Vector consumes the previous one.
    __ubuf__ C_TYPE ubBuf[PIPE_DEPTH * BASE_M * BASE_N / 2];
    auto ubTensor = make_tensor(make_mem_ptr(ubBuf), make_frame_layout<nd_ext_layout_ptn>(PIPE_DEPTH * BASE_M, BASE_N));

    if ASCEND_IS_AIC {
        constexpr uint32_t L1_INDEX = 0;
        constexpr uint32_t L0_INDEX = 1;
        constexpr uint32_t L0C_INDEX = 2;
        constexpr uint32_t L1_BIAS_INDEX = 3;
        constexpr uint32_t L0_BIAS_INDEX = 4;

        __cbuf__ A_TYPE l1ABuf[BASE_M * STEP_M * BASE_K * STEP_K];
        __cbuf__ B_TYPE l1BBuf[BASE_K * STEP_K * BASE_N * STEP_N];
        __cbuf__ BIAS_TYPE l1BiasBuf[BASE_N * STEP_N];
        __ca__ A_TYPE l0ABuf[BASE_M * BASE_K];
        __cb__ B_TYPE l0BBuf[BASE_K * BASE_N];
        __biasbuf__ BIAS_TYPE l0BiasBuf[BASE_N];
        __cc__ C_TYPE l0CBuf[BASE_M * BASE_N];

        auto l1A = make_tensor(
            make_mem_ptr(l1ABuf), make_frame_layout<nz_layout_ptn, A_TYPE>(BASE_M * STEP_M, BASE_K * STEP_K));
        auto l1B = make_tensor(
            make_mem_ptr(l1BBuf), make_frame_layout<nz_layout_ptn, B_TYPE>(BASE_K * STEP_K, BASE_N * STEP_N));
        auto l1Bias = make_tensor(make_mem_ptr(l1BiasBuf), make_frame_layout<nd_ext_layout_ptn>(1, BASE_N * STEP_N));
        auto l0APtr = make_mem_ptr(l0ABuf);
        auto l0BPtr = make_mem_ptr(l0BBuf);
        auto l0BiasPtr = make_mem_ptr(l0BiasBuf);
        auto l0CPtr = make_mem_ptr(l0CBuf);
        auto gm2l1 = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
        auto l1tol0a = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
        auto l1tol0b = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
        auto l1tobt = make_copy(copy_l1_to_biastable{}, l1_to_biastable_trait_default{});
        auto l0c2ub = make_copy(copy_l0c_to_ub{}, CopyL0C2UBTraitCustom{});
        auto mm = make_mmad(mmad_operation{}, asc::te::mmad_trait_default{});

        for (uint32_t i = 0; i < mLoop; ++i) {
            const uint16_t curM = (i + 1 == mLoop) ? tileM : BASE_M;
            for (uint32_t j = 0; j < nLoop; ++j) {
                const uint16_t curN = (j + 1 == nLoop) ? tileN : BASE_N;
                const uint32_t sequence = i * nLoop + j;
                const uint32_t slot = sequence % PIPE_DEPTH;
                if (sequence >= PIPE_DEPTH) {
                    asc_sync_block_wait(PIPE_MTE2, AIV_TO_AIC_FLAGS[slot]);
                }

                auto l0C = make_tensor(l0CPtr, make_frame_layout<nz_layout_ptn>(curM, curN));
                auto l0Bias = make_tensor(l0BiasPtr, make_frame_layout<nd_ext_layout_ptn>(1, curN));

                asc_lock(PIPE_MTE2, L1_BIAS_INDEX);
                copy(gm2l1, l1Bias, globalBias.slice(make_coord(0, j * BASE_N), make_shape(1, curN)));
                asc_unlock(PIPE_MTE2, L1_BIAS_INDEX);
                asc_lock(PIPE_MTE1, L1_BIAS_INDEX);
                asc_lock(PIPE_MTE1, L0_BIAS_INDEX);
                copy(l1tobt, l0Bias, l1Bias.slice(make_coord(0, 0), make_shape(1, curN)));
                asc_unlock(PIPE_MTE1, L0_BIAS_INDEX);
                asc_unlock(PIPE_MTE1, L1_BIAS_INDEX);

                for (uint32_t kIter = 0; kIter < kLoop; ++kIter) {
                    const uint16_t curK = (kIter + 1 == kLoop) ? tileK : BASE_K;
                    auto l0A = make_tensor(l0APtr, make_frame_layout<nz_layout_ptn, A_TYPE>(curM, curK));
                    auto l0B = make_tensor(l0BPtr, make_frame_layout<zn_layout_ptn, B_TYPE>(curK, curN));

                    if (kIter % STEP_K == 0) {
                        uint16_t curStepK = static_cast<uint16_t>(tiling.singleCoreK - kIter * BASE_K);
                        curStepK = curStepK < BASE_K * STEP_K ? curStepK : BASE_K * STEP_K;
                        asc_lock(PIPE_MTE2, L1_INDEX);
                        copy(
                            gm2l1, l1A,
                            globalA.slice(make_coord(i * BASE_M, kIter * BASE_K), make_shape(curM, curStepK)));
                        copy(
                            gm2l1, l1B,
                            globalB.slice(make_coord(kIter * BASE_K, j * BASE_N), make_shape(curStepK, curN)));
                        asc_unlock(PIPE_MTE2, L1_INDEX);
                        asc_lock(PIPE_MTE1, L1_INDEX);
                    }

                    asc_lock(PIPE_MTE1, L0_INDEX);
                    copy(l1tol0a, l0A, l1A.slice(make_coord(0, kIter % STEP_K * BASE_K), make_shape(curM, curK)));
                    copy(l1tol0b, l0B, l1B.slice(make_coord(kIter % STEP_K * BASE_K, 0), make_shape(curK, curN)));
                    if ((kIter + 1) % STEP_K == 0 || kIter + 1 == kLoop) {
                        asc_unlock(PIPE_MTE1, L1_INDEX);
                    }
                    asc_unlock(PIPE_MTE1, L0_INDEX);
                    asc_lock(PIPE_M, L0_INDEX);
                    if (kIter == 0) {
                        asc_lock(PIPE_M, L0C_INDEX);
                        asc_lock(PIPE_M, L0_BIAS_INDEX);
                        asc::te::mmad(
                            mm.with(mmad_params(curM, curN, curK, unit_flag_mode::disable, true)), l0C, l0A, l0B,
                            l0Bias);
                        asc_unlock(PIPE_M, L0_BIAS_INDEX);
                    } else {
                        asc::te::mmad(
                            mm.with(mmad_params(curM, curN, curK, unit_flag_mode::disable, false)), l0C, l0A, l0B);
                    }
                    if (kIter == kLoop - 1) {
                        asc_unlock(PIPE_M, L0C_INDEX);
                    }
                    asc_unlock(PIPE_M, L0_INDEX);
                }

                asc_lock(PIPE_FIX, L0C_INDEX);
                copy(l0c2ub, ubTensor.slice(make_coord(slot * BASE_M / 2, 0), make_shape(curM, curN)), l0C);
                asc_sync_block_arrive(PIPE_FIX, AIC_TO_AIV_FLAGS[slot]);
                asc_unlock(PIPE_FIX, L0C_INDEX);
            }
        }
        const uint32_t tileCount = mLoop * nLoop;
        const uint32_t firstOutstanding = tileCount > PIPE_DEPTH ? tileCount - PIPE_DEPTH : 0;
        for (uint32_t sequence = firstOutstanding; sequence < tileCount; ++sequence) {
            asc_sync_block_wait(PIPE_MTE2, AIV_TO_AIC_FLAGS[sequence % PIPE_DEPTH]);
        }
    }

    if ASCEND_IS_AIV {
        __ubuf__ C_TYPE valueBuf[VECTOR_LEN];
        __ubuf__ C_TYPE residualBuf[VECTOR_LEN];
        __ubuf__ C_TYPE outputBuf[VECTOR_LEN];
        auto vectorLayout = make_layout(make_shape(VECTOR_LEN));
        auto copyLayout = make_frame_layout<nd_ext_layout_ptn>(1, VECTOR_LEN);
        auto valueVec = make_tensor(make_mem_ptr(valueBuf), vectorLayout);
        auto residualVec = make_tensor(make_mem_ptr(residualBuf), vectorLayout);
        auto outputVec = make_tensor(make_mem_ptr(outputBuf), vectorLayout);
        auto valueCopy = make_tensor(make_mem_ptr(valueBuf), copyLayout);
        auto residualCopy = make_tensor(make_mem_ptr(residualBuf), copyLayout);
        auto outputCopy = make_tensor(make_mem_ptr(outputBuf), copyLayout);
        auto ub2ub = make_copy(copy_ub_to_ub{}, ub_to_ub_trait_default{});
        auto gm2ub = make_copy(copy_gm_to_ub{});
        auto ub2gm = make_copy(copy_ub_to_gm{});
        const uint32_t subBlockId = static_cast<uint32_t>(asc_get_sub_block_id());

        for (uint32_t i = 0; i < mLoop; ++i) {
            const uint16_t curM = (i + 1 == mLoop) ? tileM : BASE_M;
            const uint16_t halfM = curM / 2;
            for (uint32_t j = 0; j < nLoop; ++j) {
                const uint16_t curN = (j + 1 == nLoop) ? tileN : BASE_N;
                const uint32_t sequence = i * nLoop + j;
                const uint32_t slot = sequence % PIPE_DEPTH;
                asc_sync_block_wait(PIPE_S, AIC_TO_AIV_FLAGS[slot]);
                for (uint32_t row = 0; row < halfM; ++row) {
                    const uint32_t globalRow =
                        iterInfo.mIterIdx * tiling.singleCoreM + i * BASE_M + subBlockId * halfM + row;
                    for (uint32_t column = 0; column < curN; column += VECTOR_LEN) {
                        const uint32_t length = curN - column < VECTOR_LEN ? curN - column : VECTOR_LEN;
                        auto ubPart =
                            ubTensor.slice(make_coord(slot * BASE_M / 2 + row, column), make_shape(1, length));
                        auto residualPart = gmResidual.slice(
                            make_coord(globalRow, iterInfo.nIterIdx * tiling.singleCoreN + j * BASE_N + column),
                            make_shape(1, length));
                        auto outputPart = gmY.slice(
                            make_coord(globalRow, iterInfo.nIterIdx * tiling.singleCoreN + j * BASE_N + column),
                            make_shape(1, length));
                        asc_lock(PIPE_MTE2, 0);
                        copy(ub2ub, valueCopy.slice(make_coord(0, 0), make_shape(1, length)), ubPart);
                        copy(gm2ub, residualCopy.slice(make_coord(0, 0), make_shape(1, length)), residualPart);
                        asc_unlock(PIPE_MTE2, 0);
                        asc_lock(PIPE_V, 0);
                        ComputeAdd(valueVec, residualVec, outputVec, length);
                        asc_unlock(PIPE_V, 0);
                        asc_lock(PIPE_MTE3, 0);
                        copy(ub2gm, outputPart, outputCopy.slice(make_coord(0, 0), make_shape(1, length)));
                        asc_unlock(PIPE_MTE3, 0);
                    }
                }
                asc_sync_block_arrive(PIPE_MTE3, AIV_TO_AIC_FLAGS[slot]);
            }
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    using A_TYPE = half;
    using B_TYPE = half;
    using C_TYPE = float;
    using BIAS_TYPE = float;

    MatmulTiling tiling;
    tiling.m = MATRIX_M;
    tiling.n = MATRIX_N;
    tiling.k = MATRIX_K;
    tiling.singleCoreM = SINGLE_CORE_M;
    tiling.singleCoreN = SINGLE_CORE_N;
    tiling.singleCoreK = MATRIX_K;

    const uint32_t mBlocks = (tiling.m + tiling.singleCoreM - 1) / tiling.singleCoreM;
    const uint32_t nBlocks = (tiling.n + tiling.singleCoreN - 1) / tiling.singleCoreN;
    const uint32_t numBlocks = mBlocks * nBlocks;

    size_t aFileSize = tiling.m * tiling.k * sizeof(A_TYPE);
    size_t bFileSize = tiling.k * tiling.n * sizeof(B_TYPE);
    size_t biasFileSize = tiling.n * sizeof(BIAS_TYPE);
    size_t matrixFileSize = tiling.m * tiling.n * sizeof(C_TYPE);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *aHost, *bHost, *biasHost, *residualHost, *yHost;
    A_TYPE* aDevice;
    B_TYPE* bDevice;
    BIAS_TYPE* biasDevice;
    C_TYPE* residualDevice;
    C_TYPE* yDevice;

    aclrtMallocHost((void**)(&aHost), aFileSize);
    aclrtMallocHost((void**)(&bHost), bFileSize);
    aclrtMallocHost((void**)(&biasHost), biasFileSize);
    aclrtMallocHost((void**)(&residualHost), matrixFileSize);
    aclrtMallocHost((void**)(&yHost), matrixFileSize);
    aclrtMalloc((void**)&aDevice, aFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDevice, bFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&biasDevice, biasFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&residualDevice, matrixFileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&yDevice, matrixFileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    ReadFile("./input/a.bin", aHost, aFileSize);
    ReadFile("./input/b.bin", bHost, bFileSize);
    ReadFile("./input/bias.bin", biasHost, biasFileSize);
    ReadFile("./input/residual.bin", residualHost, matrixFileSize);

    aclrtMemcpy(aDevice, aFileSize, aHost, aFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bFileSize, bHost, bFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(biasDevice, biasFileSize, biasHost, biasFileSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(residualDevice, matrixFileSize, residualHost, matrixFileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    MatmulTiling* tilingHost;
    MatmulTiling* tilingDevice;
    aclrtMallocHost((void**)(&tilingHost), sizeof(MatmulTiling));
    aclrtMalloc((void**)&tilingDevice, sizeof(MatmulTiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tilingHost = tiling;
    aclrtMemcpy(tilingDevice, sizeof(MatmulTiling), tilingHost, sizeof(MatmulTiling), ACL_MEMCPY_HOST_TO_DEVICE);

    matmul_bias_fusion<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE>
        <<<numBlocks, 0, stream>>>(aDevice, bDevice, biasDevice, residualDevice, yDevice, tilingDevice);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(yHost, matrixFileSize, yDevice, matrixFileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", yHost, matrixFileSize);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(biasDevice);
    aclrtFree(residualDevice);
    aclrtFree(yDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(biasHost);
    aclrtFreeHost(residualHost);
    aclrtFreeHost(yHost);
    aclrtFreeHost(tilingHost);

    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();

    return 0;
}
