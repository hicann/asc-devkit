/* !
 * \file custom_op_tensor_api.asc
 * \brief Batched QKV projection using a custom Tensor API copy operation.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

namespace asc {
namespace te {

// Flatten a batched [B, S, H] ND tensor into a [B * S, H] NZ tensor while copying it from GM to L1.
struct copy_slice_gm_to_l1 {
    template <typename Trait, const Trait& trait, typename DstTensor, typename SrcTensor>
    __aicore__ inline static void copy(const DstTensor& dst, const SrcTensor& src)
    {
        using src_type = typename SrcTensor::element_type;
        const auto src_layout = src.layout();
        const auto dst_layout = dst.layout();

        const auto src_shape = src_layout.shape();
        const auto src_stride = src_layout.stride();
        const uint16_t matrix_num = static_cast<uint16_t>(get<0>(src_shape));
        const uint16_t n_value = static_cast<uint16_t>(get<1, 0>(src_shape));
        const uint32_t d_value = static_cast<uint32_t>(get<1, 1>(src_shape));
        const uint64_t src_d_value = get<1, 0>(src_stride) * sizeof(src_type);
        const uint64_t src_nd_matrix_stride = get<0>(src_stride) * sizeof(src_type);

        constexpr uint16_t dst_nz_n_stride = 1;
        const auto dst_column_stride = get<1, 1>(dst_layout.stride());
        const uint16_t dst_nz_c0_stride = static_cast<uint16_t>(dst_column_stride / c0_element<src_type>);
        const uint16_t dst_nz_matrix_stride = static_cast<uint16_t>(n_value);
        const auto l2_cache_mode = static_cast<asc_load_l2_cache_mode>(src.engine().get_cache_mode());

        if constexpr (sizeof(src_type) == sizeof(half)) {
            copy_gm_to_cbuf_multi_nd2nz(
                reinterpret_cast<__cbuf__ half*>(dst.data().get()), reinterpret_cast<__gm__ half*>(src.data().get()),
                matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride, src_d_value, l2_cache_mode,
                n_value, d_value, src_nd_matrix_stride, false);
        } else if constexpr (sizeof(src_type) == sizeof(float)) {
            copy_gm_to_cbuf_multi_nd2nz(
                reinterpret_cast<__cbuf__ float*>(dst.data().get()), reinterpret_cast<__gm__ float*>(src.data().get()),
                matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride, src_d_value, l2_cache_mode,
                n_value, d_value, src_nd_matrix_stride, false);
        }
    }

private:
    template <typename DataType>
    __aicore__ inline static void copy_gm_to_cbuf_multi_nd2nz(
        __cbuf__ DataType* dst, __gm__ DataType* src, uint16_t matrix_num, uint16_t dst_nz_n_stride,
        uint16_t dst_nz_c0_stride, uint16_t dst_nz_matrix_stride, uint64_t src_d_value,
        asc_load_l2_cache_mode l2_cache_mode, uint16_t n_value, uint32_t d_value, uint64_t src_nd_matrix_stride,
        bool enable_small_c0)
    {
        if constexpr (current_arch_version == arch_version::v3510) {
            asc_set_gm2l1_nz_para(matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride);
            asc_copy_gm2l1_nd2nz(
                dst, src, src_d_value, l2_cache_mode, n_value, d_value, src_nd_matrix_stride, enable_small_c0);
        }
    }
};

template <typename Trait>
struct copy_traits<copy_slice_gm_to_l1, Trait>
    : public copy_traits<copy_slice_gm_to_l1, Trait, copy_slice_gm_to_l1, Trait> {};

template <>
struct copy_traits<copy_slice_gm_to_l1> : public copy_traits<copy_slice_gm_to_l1, gm_to_l1_trait_default> {};

} // namespace te
} // namespace asc

template <
    typename DataType, uint32_t batch, uint32_t sequence_length, uint32_t hidden_size, uint32_t projection_size,
    uint32_t single_core_m, uint32_t single_core_n, uint32_t single_core_k, uint32_t base_m, uint32_t base_n,
    uint32_t base_k>
__global__ __cube__ void custom_op_tensor_api(
    __gm__ DataType* input, __gm__ DataType* weight, __gm__ DataType* bias, __gm__ DataType* output)
{
    asc_init();
    using namespace asc::te;

    constexpr uint32_t flattened_m = batch * sequence_length;
    constexpr uint32_t m_iter = flattened_m / single_core_m;
    constexpr uint32_t m_loop = single_core_m / base_m;
    constexpr uint32_t n_loop = single_core_n / base_n;
    constexpr uint32_t k_loop = single_core_k / base_k;

    // Each Cube core computes a single_core_m x single_core_n region of the flattened [B * S, 3H] output.
    const uint32_t m_iter_index = block_idx % m_iter;
    const uint32_t n_iter_index = block_idx / m_iter;
    const uint32_t single_core_m_start = m_iter_index * single_core_m;
    const uint32_t single_core_n_start = n_iter_index * single_core_n;

    __cbuf__ DataType input_l1_buffer[base_m * base_k];
    __cbuf__ DataType weight_l1_buffer[base_k * base_n];
    __cbuf__ DataType bias_l1_buffer[base_n];
    __ca__ DataType input_l0_buffer[base_m * base_k];
    __cb__ DataType weight_l0_buffer[base_k * base_n];
    __biasbuf__ float bias_l0_buffer[base_n];
    __cc__ float output_l0_buffer[base_m * base_n];

    auto input_gm_tensor =
        make_tensor(make_mem_ptr(input), make_frame_layout<nd_layout_ptn>(batch, sequence_length, hidden_size));
    auto weight_gm_tensor =
        make_tensor(make_mem_ptr(weight), make_frame_layout<nd_layout_ptn>(hidden_size, projection_size));
    auto bias_gm_tensor = make_tensor(make_mem_ptr(bias), make_frame_layout<nd_layout_ptn>(1, projection_size));
    auto output_gm_tensor =
        make_tensor(make_mem_ptr(output), make_frame_layout<nd_layout_ptn>(flattened_m, projection_size));

    auto input_l1_tensor =
        make_tensor(make_mem_ptr(input_l1_buffer), make_frame_layout<nz_layout_ptn, DataType>(base_m, base_k));
    auto weight_l1_tensor =
        make_tensor(make_mem_ptr(weight_l1_buffer), make_frame_layout<nz_layout_ptn, DataType>(base_k, base_n));
    auto bias_l1_tensor =
        make_tensor(make_mem_ptr(bias_l1_buffer), make_frame_layout<nd_layout_ptn, DataType>(1, base_n));
    auto input_l0_tensor =
        make_tensor(make_mem_ptr(input_l0_buffer), make_frame_layout<nz_layout_ptn, DataType>(base_m, base_k));
    auto weight_l0_tensor =
        make_tensor(make_mem_ptr(weight_l0_buffer), make_frame_layout<zn_layout_ptn, DataType>(base_k, base_n));
    auto bias_l0_tensor = make_tensor(make_mem_ptr(bias_l0_buffer), make_frame_layout<nd_layout_ptn>(1, base_n));
    auto output_l0_tensor =
        make_tensor(make_mem_ptr(output_l0_buffer), make_frame_layout<nz_layout_ptn>(base_m, base_n));

    const auto custom_copy_atom = make_copy(copy_slice_gm_to_l1{}, gm_to_l1_trait_default{});
    const auto projection_mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    constexpr uint8_t mutex_id = 0;
    for (uint32_t m_block_index = 0; m_block_index < m_loop; ++m_block_index) {
        const uint32_t m_start = single_core_m_start + m_block_index * base_m;
        const uint32_t batch_start = m_start / sequence_length;
        for (uint32_t n_block_index = 0; n_block_index < n_loop; ++n_block_index) {
            const uint32_t n_start = single_core_n_start + n_block_index * base_n;
            for (uint32_t k_tile_index = 0; k_tile_index < k_loop; ++k_tile_index) {
                const uint32_t k_start = k_tile_index * base_k;

                asc_lock(PIPE_MTE2, mutex_id);
                copy(
                    custom_copy_atom, input_l1_tensor,
                    input_gm_tensor.slice(
                        make_coord(batch_start, make_coord(0, k_start)),
                        make_shape(base_m / sequence_length, make_shape(sequence_length, base_k))));
                copy(
                    weight_l1_tensor, weight_gm_tensor.slice(make_coord(k_start, n_start), make_shape(base_k, base_n)));
                if (k_tile_index == 0) {
                    copy(bias_l1_tensor, bias_gm_tensor.slice(make_coord(0, n_start), make_shape(1, base_n)));
                }
                asc_unlock(PIPE_MTE2, mutex_id);

                asc_lock(PIPE_MTE1, mutex_id);
                copy(input_l0_tensor, input_l1_tensor);
                copy(weight_l0_tensor, weight_l1_tensor);
                if (k_tile_index == 0) {
                    copy(bias_l0_tensor, bias_l1_tensor);
                }
                asc_unlock(PIPE_MTE1, mutex_id);

                asc_lock(PIPE_M, mutex_id);
                const auto projection_atom = projection_mmad_atom.with(mmad_params{
                    static_cast<uint16_t>(base_m), static_cast<uint16_t>(base_n), static_cast<uint16_t>(base_k),
                    unit_flag_mode::disable, k_tile_index == 0});
                if (k_tile_index == 0) {
                    mmad(projection_atom, output_l0_tensor, input_l0_tensor, weight_l0_tensor, bias_l0_tensor);
                } else {
                    mmad(projection_atom, output_l0_tensor, input_l0_tensor, weight_l0_tensor);
                }
                asc_unlock(PIPE_M, mutex_id);
            }

            asc_lock(PIPE_FIX, mutex_id);
            copy(output_gm_tensor.slice(make_coord(m_start, n_start), make_shape(base_m, base_n)), output_l0_tensor);
            asc_unlock(PIPE_FIX, mutex_id);
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    using DataType = half;
    constexpr uint32_t batch = 16;
    constexpr uint32_t sequence_length = 64;
    constexpr uint32_t hidden_size = 256;
    constexpr uint32_t projection_size = 3 * hidden_size;
    constexpr uint32_t single_core_m = 256;
    constexpr uint32_t single_core_n = 384;
    constexpr uint32_t single_core_k = hidden_size;
    constexpr uint32_t base_m = 128;
    constexpr uint32_t base_n = 192;
    constexpr uint32_t base_k = 64;
    constexpr uint32_t num_blocks = (batch * sequence_length / single_core_m) * (projection_size / single_core_n);

    constexpr size_t input_size = batch * sequence_length * hidden_size * sizeof(DataType);
    constexpr size_t weight_size = hidden_size * projection_size * sizeof(DataType);
    constexpr size_t bias_size = projection_size * sizeof(DataType);
    constexpr size_t output_size = batch * sequence_length * projection_size * sizeof(DataType);

    aclInit(nullptr);
    constexpr int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* input_host = nullptr;
    uint8_t* weight_host = nullptr;
    uint8_t* bias_host = nullptr;
    uint8_t* output_host = nullptr;
    DataType* input_device = nullptr;
    DataType* weight_device = nullptr;
    DataType* bias_device = nullptr;
    DataType* output_device = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&input_host), input_size);
    aclrtMallocHost(reinterpret_cast<void**>(&weight_host), weight_size);
    aclrtMallocHost(reinterpret_cast<void**>(&bias_host), bias_size);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), output_size);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&weight_device), weight_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST);

    read_file("./input/input.bin", input_size, input_host);
    read_file("./input/weight.bin", weight_size, weight_host);
    read_file("./input/bias.bin", bias_size, bias_host);
    aclrtMemcpy(input_device, input_size, input_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(weight_device, weight_size, weight_host, weight_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, bias_size, bias_host, bias_size, ACL_MEMCPY_HOST_TO_DEVICE);

    custom_op_tensor_api<
        DataType, batch, sequence_length, hidden_size, projection_size, single_core_m, single_core_n, single_core_k,
        base_m, base_n, base_k><<<num_blocks, 0, stream>>>(input_device, weight_device, bias_device, output_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(output_host, output_size, output_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", output_host, output_size);

    aclrtFree(input_device);
    aclrtFree(weight_device);
    aclrtFree(bias_device);
    aclrtFree(output_device);
    aclrtFreeHost(input_host);
    aclrtFreeHost(weight_host);
    aclrtFreeHost(bias_host);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
