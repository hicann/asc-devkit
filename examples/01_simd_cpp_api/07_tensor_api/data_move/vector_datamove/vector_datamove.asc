/*!
 * \file vector_datamove.asc
 * \brief Demonstrate the four AIV Tensor API copy paths under impl/tensor_api/arch/vector.
 */

#include <cstdint>
#include <cstring>
#include <iostream>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

constexpr uint32_t scenario = SCENARIO_NUM;
constexpr uint32_t row = 32;
constexpr uint32_t col = 32;
constexpr uint32_t total_length = row * col;
constexpr uint8_t buffer_lock_id = 0;
constexpr uint8_t left_padding = 3;
constexpr uint8_t right_padding = 5;
constexpr int8_t padding_value = -9;

__aicore__ inline void vector_datamove_process(__gm__ int8_t* src, __gm__ int8_t* dst)
{
    __ubuf__ int8_t srcUbBuffer[total_length];
    __ubuf__ int8_t dstUbBuffer[total_length];
    __cbuf__ int8_t l1Buffer[total_length];

    if constexpr (scenario == 1) {
        // GM -> UB, ND: infer copy_gm_to_ub from the tensor locations.
        auto layout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn,
            asc::te::layout_trait_default<int8_t>>(row, col);
        auto srcGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
        auto dstGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
        auto srcUb = asc::te::make_tensor(asc::te::make_mem_ptr(srcUbBuffer), layout);
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc::te::copy(srcUb, srcGm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_ub_to_gm {}), dstGm, srcUb);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 2) {
        // UB -> GM, DN: construct the output atom explicitly and invoke it directly.
        auto layout = asc::te::make_frame_layout<asc::te::dn_ext_layout_ptn,
            asc::te::layout_trait_default<int8_t>>(row, col);
        auto srcGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
        auto dstGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
        auto srcUb = asc::te::make_tensor(asc::te::make_mem_ptr(srcUbBuffer), layout);
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc::te::copy(asc::te::make_copy(asc::te::copy_gm_to_ub {}), srcUb, srcGm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        auto ubToGm = asc::te::make_copy(
            asc::te::copy_ub_to_gm {}, asc::te::ub_to_gm_trait_default {});
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        ubToGm.call(dstGm, srcUb);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 3) {
        // UB -> UB, NZ: use the coordinate/shape overload for the complete aligned region.
        auto layout = asc::te::make_frame_layout<asc::te::nz_layout_ptn,
            asc::te::layout_trait_default<int8_t>>(row, col);
        auto srcGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), layout);
        auto dstGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), layout);
        auto srcUb = asc::te::make_tensor(asc::te::make_mem_ptr(srcUbBuffer), layout);
        auto dstUb = asc::te::make_tensor(asc::te::make_mem_ptr(dstUbBuffer), layout);
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc::te::copy(srcUb, srcGm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        auto ubToUb = asc::te::make_copy(
            asc::te::copy_ub_to_ub {}, asc::te::ub_to_ub_trait_default {});
        asc_lock(pipe_t::PIPE_V, buffer_lock_id);
        asc::te::copy(ubToUb, dstUb, srcUb, asc::te::zero_coord, asc::te::zero_coord,
            asc::te::make_shape(row, col));
        asc_unlock(pipe_t::PIPE_V, buffer_lock_id);
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(dstGm, dstUb);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (scenario == 4) {
        // UB -> L1, ZN: explicitly select the vector copy path.
        auto znLayout = asc::te::make_frame_layout<asc::te::zn_layout_ptn,
            asc::te::layout_trait_default<int8_t>>(row, col);
        auto ndLayout = asc::te::make_frame_layout<asc::te::nd_ext_layout_ptn,
            asc::te::layout_trait_default<int8_t>>(row, col);
        auto srcGm = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(src), znLayout);
        auto srcUb = asc::te::make_tensor(asc::te::make_mem_ptr(srcUbBuffer), znLayout);
        auto dstL1 = asc::te::make_tensor(asc::te::make_mem_ptr(l1Buffer), znLayout);
        auto srcUbNd = asc::te::make_tensor(asc::te::make_mem_ptr(srcUbBuffer), ndLayout);
        auto dstGmNd = asc::te::make_tensor(asc::te::make_mem_ptr<asc::te::location::gm>(dst), ndLayout);
        asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
        asc::te::copy(srcUb, srcGm);
        asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);

        auto ubToL1 = asc::te::make_copy(
            asc::te::copy_ub_to_l1 {}, asc::te::ub_to_l1_trait_default {});
        asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
        asc::te::copy(ubToL1, dstL1, srcUb);

        // L1 -> UB is AIC-only. Return the source UB to verify that the AIV copy completed.
        asc::te::copy(dstGmNd, srcUbNd);
        asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    } else if constexpr (SCENARIO == 5) {
            // GM -> UB, ND: add constant padding to both sides of every source row.
            auto srcLayout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(ROW, PAD_DATA_COL);
            auto dstLayout = make_frame_layout<nd_ext_layout_ptn, layout_trait_default<int8_t>>(ROW, COL);
            auto srcGm = make_tensor(make_mem_ptr<location::gm>(src), srcLayout);
            auto dstUb = make_tensor(make_mem_ptr(dstUbBuffer), dstLayout);
            auto dstGm = make_tensor(make_mem_ptr<location::gm>(dst), dstLayout);

            constexpr gm_to_ub_params paddingParams{left_padding, right_padding, true};
            asc_lock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_set_copy_pad_val(PADDING_VALUE);
            copy(make_copy(copy_gm_to_ub {}).with(paddingParams), dstUb, srcGm);
            asc_unlock(pipe_t::PIPE_MTE2, buffer_lock_id);
            asc_lock(pipe_t::PIPE_MTE3, buffer_lock_id);
            copy(dstGm, dstUb);
            asc_unlock(pipe_t::PIPE_MTE3, buffer_lock_id);
    }
}

__global__ __vector__ void vector_datamove(__gm__ uint8_t* src, __gm__ uint8_t* dst)
{
    vector_datamove_process(
        reinterpret_cast<__gm__ int8_t*>(src), reinterpret_cast<__gm__ int8_t*>(dst));
}

static bool CheckAcl(aclError result, const char* apiName)
{
    if (result != ACL_SUCCESS) {
        ERROR_LOG("%s failed, error code = %d", apiName, static_cast<int32_t>(result));
        return false;
    }
    return true;
}

static bool CompareResult(const void* outputData, size_t outputSize)
{
    void* goldenData = nullptr;
    if (!CheckAcl(aclrtMallocHost(&goldenData, outputSize), "aclrtMallocHost goldenData")) {
        return false;
    }

    size_t goldenSize = outputSize;
    const bool readSuccess = ReadFile("./output/golden.bin", goldenSize, goldenData, outputSize);
    const bool matched = readSuccess && goldenSize == outputSize &&
        std::memcmp(outputData, goldenData, outputSize) == 0;
    (void)CheckAcl(aclrtFreeHost(goldenData), "aclrtFreeHost goldenData");
    return matched;
}

static bool RunScenario(aclrtStream stream)
{
    constexpr size_t data_size = total_length * sizeof(int8_t);
    uint8_t* srcHost = nullptr;
    uint8_t* dstHost = nullptr;
    uint8_t* srcDevice = nullptr;
    uint8_t* dstDevice = nullptr;
    size_t readSize = data_size;
    bool success = false;

    if (!CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&srcHost), data_size), "aclrtMallocHost src") ||
        !CheckAcl(aclrtMallocHost(reinterpret_cast<void**>(&dstHost), data_size), "aclrtMallocHost dst") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&srcDevice), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc src") ||
        !CheckAcl(aclrtMalloc(reinterpret_cast<void**>(&dstDevice), data_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc dst")) {
        goto cleanup;
    }

    if (!ReadFile("./input/input_x.bin", readSize, srcHost, data_size) || readSize != data_size ||
        !CheckAcl(aclrtMemcpy(srcDevice, data_size, srcHost, data_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy host to device")) {
        goto cleanup;
    }

    vector_datamove<<<1, 0, stream>>>(srcDevice, dstDevice);
    if (!CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !CheckAcl(aclrtMemcpy(dstHost, data_size, dstDevice, data_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy device to host") ||
        !WriteFile("./output/output.bin", dstHost, data_size)) {
        goto cleanup;
    }
    success = CompareResult(dstHost, data_size);

cleanup:
    if (srcDevice != nullptr) {
        (void)aclrtFree(srcDevice);
    }
    if (dstDevice != nullptr) {
        (void)aclrtFree(dstDevice);
    }
    if (srcHost != nullptr) {
        (void)aclrtFreeHost(srcHost);
    }
    if (dstHost != nullptr) {
        (void)aclrtFreeHost(dstHost);
    }
    return success;
}

int32_t main()
{
    if (!CheckAcl(aclInit(nullptr), "aclInit")) {
        return 1;
    }

    constexpr int32_t device_id = 0;
    aclrtStream stream = nullptr;
    bool success = CheckAcl(aclrtSetDevice(device_id), "aclrtSetDevice") &&
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");
    if (success) {
        success = RunScenario(stream);
    }

    std::cout << (success ? "test pass!" : "test failed!") << std::endl;
    if (stream != nullptr) {
        (void)aclrtDestroyStream(stream);
    }
    (void)aclrtResetDevice(device_id);
    (void)aclFinalize();
    return success ? 0 : 1;
}
