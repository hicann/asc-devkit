/* !
 * \file quant_matmul.asc
 * \brief QuantMatmul with per-channel/per-token dequantization and FastGelu.
 */

#include <cstdint>

#include "acl/acl.h"
#include "data_utils.h"
#include "tensor_api/experimental/vector_ops.h"
#include "tensor_api/tensor.h"

// 输出矩阵全局形状。
constexpr uint32_t matrix_m = 1024;
constexpr uint32_t matrix_n = 1024;
constexpr uint32_t matrix_k = 256;

// 单个Block负责的输出子矩阵大小。当前配置为256x128，32个Block覆盖1024x1024输出。
constexpr uint32_t single_core_m = 256;
constexpr uint32_t single_core_n = 128;

// Cube侧一次mmad的输出tile大小和K方向分块大小。
constexpr uint32_t base_m = 128;
constexpr uint32_t base_n = 128;
constexpr uint32_t base_k = 64;

// L1中沿M/N/K方向缓存的base块数量。step_k=4表示GM到L1一次搬入4个K分块。
constexpr uint32_t step_m = 1;
constexpr uint32_t step_n = 1;
constexpr uint32_t step_k = 4;

// AIV一次Vector计算处理的元素数；pipe_depth为UB slot数量，用于输出tile双缓冲。
constexpr uint32_t vector_len = 64;
constexpr uint32_t pipe_depth = 2;

// 每个UB slot绑定一对跨核同步flag：AIC->AIV表示数据就绪，两个AIV->AIC表示数据消费完成。
// slot 0使用8/10，slot 1使用9/11，避免相邻tile复用同一个事件计数。
constexpr int64_t aic_to_aiv_flags[pipe_depth] = {8, 9};
constexpr int64_t aiv_to_aic_flags[pipe_depth] = {10, 11};

constexpr float fast_gelu_coefficient = -1.702f;
// int32到float转换只做类型转换，不使用额外布局转换和饱和模式。
constexpr asc::te::experimental::cast_options int32_to_float_options = {
    asc::te::experimental::cast_layout::unknown, asc::te::experimental::cast_round_mode::rint,
    asc::te::experimental::cast_sat_mode::unknown};

static_assert(matrix_m % single_core_m == 0, "M must be evenly distributed across logical blocks");
static_assert(single_core_m % base_m == 0, "single_core_m must contain complete Cube tiles");
static_assert(matrix_n % single_core_n == 0, "N must be evenly distributed across logical blocks");
static_assert(single_core_n % base_n == 0, "single_core_n must contain complete Cube tiles");
static_assert(matrix_k % base_k == 0, "K must contain complete base_k blocks");
static_assert(base_m % 2 == 0, "split_m requires an even tile M");
static_assert(base_n % vector_len == 0, "base_n must contain complete Vector blocks");

constexpr asc::te::l0c_to_ub_trait copy_l0c2ub_trait = {
    asc::te::round_mode::default_round, false, false, asc::te::dual_dst_mode::split_m};
// 自定义trait使L0C到UB搬运启用split_m双目标模式：
// L0C的base_m x base_n结果按M轴拆成两个base_m/2 x base_n半块，
// 分别写入AIV 0和AIV 1的本地UB，避免经过GM中转。
struct CopyL0C2UBTraitCustom {
    using TraitType = asc::te::l0c_to_ub_trait;
    static constexpr const TraitType value = copy_l0c2ub_trait;
};

template <typename SrcTensor, typename SrcCoord, typename DstTensor>
__simd_vf__ inline void cast_int32_to_float(SrcTensor src, SrcCoord src_coord, DstTensor dst)
{
    using namespace asc::te;
    // src_coord定位当前AIV的UB slot中一行int32数据；load直接读到Vector寄存器，
    // 不需要先在UB内部复制一份value_vec。当前列块为完整vector_len块。
    auto value = experimental::load(src, src_coord).with_mask(experimental::all_mask<int32_t>());
    // mmad输出为int32，反量化前必须转换为float，否则无法和float scale相乘。
    auto result = experimental::cast<float, int32_to_float_options>(value);
    experimental::store(dst, make_coord(0), result);
}

// 处理一列片段的反量化和FastGelu计算：
// value为已转换成float的矩阵乘结果，channel_scale按输出列对应，
// token_scale是标量广播到当前行，FastGelu公式为x / (1 + exp(-1.702x))。
template <typename SrcTensor, typename ScaleTensor, typename TokenScaleTensor, typename DstTensor>
__simd_vf__ inline void compute_quant_fast_gelu(
    SrcTensor src, ScaleTensor channel_scale, TokenScaleTensor token_scale, DstTensor dst)
{
    using namespace asc::te;
    const auto coord = make_coord(0);
    auto mask = experimental::all_mask<float>();
    auto value = experimental::load(src, coord).with_mask(mask);
    auto channel_value = experimental::load(channel_scale, coord).with_mask(mask);
    auto token_value =
        experimental::load_broadcast<experimental::broadcast_mode::elem>(token_scale, make_coord(0)).with_mask(mask);
    auto scaled_value = value * channel_value * token_value;
    auto denominator = experimental::exp(scaled_value * fast_gelu_coefficient) + 1.0f;
    auto result = scaled_value / denominator;
    experimental::store(dst, coord, result);
}

template <typename AType, typename BType, typename L0CType, typename CType, typename ScaleType>
__global__ __mix__(1, 2) void quant_matmul_custom(
    __gm__ AType* x, __gm__ BType* y, __gm__ ScaleType* channel_scale, __gm__ ScaleType* token_scale, __gm__ CType* z,
    int32_t m, int32_t n, int32_t k, int32_t single_core_m, int32_t single_core_n, int32_t single_core_k)
{
    using namespace asc::te;
    init_soc_state();

    // block_idx先沿M方向展开，再沿N方向展开。参数约束保证M/N均按完整基础块切分。
    const uint32_t m_iter = m / single_core_m;
    const uint32_t m_iter_idx = block_idx % m_iter;
    const uint32_t n_iter_idx = block_idx / m_iter;

    // A矩阵按ND排布存储；B矩阵文件按[n, k] DN排布存储，
    // 因此这里用[k, n]的逻辑视图访问。
    auto gm_a = make_tensor(make_mem_ptr(x), make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gm_b = make_tensor(make_mem_ptr(y), make_frame_layout<dn_ext_layout_ptn>(k, n));
    auto gm_channel_scale = make_tensor(make_mem_ptr(channel_scale), make_frame_layout<nd_ext_layout_ptn>(1, n));
    auto gm_token_scale = make_tensor(make_mem_ptr(token_scale), make_frame_layout<nd_ext_layout_ptn>(m, 1));
    auto gm_z = make_tensor(make_mem_ptr(z), make_frame_layout<nd_ext_layout_ptn>(m, n));

    auto global_a = gm_a.slice(make_coord(m_iter_idx * single_core_m, 0), make_shape(single_core_m, single_core_k));
    auto global_b = gm_b.slice(make_coord(0, n_iter_idx * single_core_n), make_shape(single_core_k, single_core_n));
    auto global_channel_scale =
        gm_channel_scale.slice(make_coord(0, n_iter_idx * single_core_n), make_shape(1, single_core_n));
    auto global_token_scale =
        gm_token_scale.slice(make_coord(m_iter_idx * single_core_m, 0), make_shape(single_core_m, 1));
    auto global_z = gm_z.slice(
        make_coord(m_iter_idx * single_core_m, n_iter_idx * single_core_n), make_shape(single_core_m, single_core_n));

    const uint32_t m_loop = single_core_m / base_m;
    const uint32_t n_loop = single_core_n / base_n;
    const uint32_t k_loop = single_core_k / base_k;

    // split_m后每个AIV只接收输出tile的M半块。pipe_depth个slot按tile序号轮转：
    // Cube可以写入下一个slot，同时两个AIV处理上一个slot，实现生产消费并行。
    __ubuf__ L0CType ub_buf[pipe_depth * base_m * base_n / 2];
    auto ub_tensor =
        make_tensor(make_mem_ptr(ub_buf), make_frame_layout<nd_ext_layout_ptn>(pipe_depth * base_m, base_n));

    if ASCEND_IS_AIC {
        constexpr uint32_t l1_index = 0;
        constexpr uint32_t l0_index = 1;
        constexpr uint32_t l0c_index = 2;

        // L1缓存step_k个K分块；L0A/L0B/L0C只保存当前一次mmad的输入和累加结果。
        __cbuf__ AType l1_a_buf[base_m * step_m * base_k * step_k];
        __cbuf__ BType l1_b_buf[base_k * step_k * base_n * step_n];
        __ca__ AType l0_a_buf[base_m * base_k];
        __cb__ BType l0_b_buf[base_k * base_n];
        __cc__ L0CType l0_c_buf[base_m * base_n];

        auto l1_a = make_tensor(
            make_mem_ptr(l1_a_buf), make_frame_layout<nz_layout_ptn, AType>(base_m * step_m, base_k * step_k));
        auto l1_b = make_tensor(
            make_mem_ptr(l1_b_buf), make_frame_layout<zn_layout_ptn, BType>(base_k * step_k, base_n * step_n));
        auto l0_a_ptr = make_mem_ptr(l0_a_buf);
        auto l0_b_ptr = make_mem_ptr(l0_b_buf);
        auto l0_c_ptr = make_mem_ptr(l0_c_buf);
        auto l0c_to_ub = make_copy(copy_l0c_to_ub{}, CopyL0C2UBTraitCustom{});
        auto mm = make_mmad(mmad_operation{}, mmad_trait_default{});

        // 输出tile按(i,j)顺序生成；sequence是tile全序号，slot=sequence%pipe_depth。
        // 复用slot前必须等待两个AIV的上一次消费完成事件，防止FIX阶段覆盖未读数据。
        for (uint32_t i = 0; i < m_loop; ++i) {
            for (uint32_t j = 0; j < n_loop; ++j) {
                const uint32_t sequence = i * n_loop + j;
                const uint32_t slot = sequence % pipe_depth;
                if (sequence >= pipe_depth) {
                    sync_block_wait(PIPE_MTE2, aiv_to_aic_flags[slot]);
                }

                // 该互斥依赖保护L0C：当前tile的mmad开始前，上一个tile的L0C->UB必须完成。
                mutex<PIPE_FIX> fix_l0c_mutex(l0c_index);
                auto l0_c = make_tensor(l0_c_ptr, make_frame_layout<nz_layout_ptn>(base_m, base_n));
                for (uint32_t k_iter = 0; k_iter < k_loop; ++k_iter) {
                    mutex<PIPE_MTE1> mte1_l1_mutex(l1_index);
                    mutex<PIPE_MTE1> mte1_l0_mutex(l0_index);
                    mutex<PIPE_M> m_l0_mutex(l0_index);
                    mutex<PIPE_M> m_l0c_mutex(l0c_index);
                    auto l0_a = make_tensor(l0_a_ptr, make_frame_layout<nz_layout_ptn, AType>(base_m, base_k));
                    auto l0_b = make_tensor(l0_b_ptr, make_frame_layout<zn_layout_ptn, BType>(base_k, base_n));

                    // 每step_k个K分块做一次GM->L1搬运。L1中的K槽位用k_iter%step_k定位，
                    // 同一组L1数据在MTE1全部消费完成后才允许下一次MTE2覆盖。
                    if (k_iter % step_k == 0) {
                        mutex<PIPE_MTE2> mte2_l1_mutex(l1_index);
                        uint16_t cur_step_k = static_cast<uint16_t>(single_core_k - k_iter * base_k);
                        cur_step_k = cur_step_k < base_k * step_k ? cur_step_k : base_k * step_k;
                        mte2_l1_mutex.lock();
                        copy(
                            l1_a, global_a, make_coord(0, k_iter * base_k), make_coord(i * base_m, k_iter * base_k),
                            make_shape(base_m, cur_step_k));
                        copy(
                            l1_b, global_b, make_coord(k_iter * base_k, 0), make_coord(k_iter * base_k, j * base_n),
                            make_shape(cur_step_k, base_n));
                        mte2_l1_mutex.unlock();
                        mte1_l1_mutex.lock();
                    }

                    mte1_l0_mutex.lock();
                    copy(l0_a, l1_a, zero_coord, make_coord(0, k_iter % step_k * base_k), make_shape(base_m, base_k));
                    copy(l0_b, l1_b, zero_coord, make_coord(k_iter % step_k * base_k, 0), make_shape(base_k, base_n));
                    if ((k_iter + 1) % step_k == 0 || k_iter + 1 == k_loop) {
                        mte1_l1_mutex.unlock();
                    }
                    mte1_l0_mutex.unlock();

                    // L0A/L0B由MTE1写入，由PIPE_M中的mmad读取，互斥依赖保证写入先于计算。
                    m_l0_mutex.lock();
                    if (k_iter == 0) {
                        // 第一个K分块设置init_with_zero=true，先清零L0C再写入首个乘加结果；
                        // 后续分块保持false，保留L0C累加结果，继续执行C=A*B+C。
                        m_l0c_mutex.lock();
                    }
                    mmad(
                        mm.with(mmad_params(base_m, base_n, base_k, unit_flag_mode::disable, k_iter == 0)), l0_c, l0_a,
                        l0_b);
                    if (k_iter + 1 == k_loop) {
                        m_l0c_mutex.unlock();
                    }
                    m_l0_mutex.unlock();
                }

                // m_l0c_mutex在最后一个mmad后才解锁，因此FIX在这里等待全部K累加完成。
                fix_l0c_mutex.lock();
                // split_m使L0C结果沿M轴拆分，分别写入两个AIV的本地UB；
                // 每个AIV只接收自己负责的M半块。写入完成后按slot发送数据就绪事件。
                copy(l0c_to_ub, ub_tensor.slice(make_coord(slot * base_m / 2, 0), make_shape(base_m, base_n)), l0_c);
                sync_block_arrive(PIPE_FIX, aic_to_aiv_flags[slot]);
                fix_l0c_mutex.unlock();
            }
        }

        // AIC最多领先AIV pipe_depth个tile。函数退出前等待最后pipe_depth个slot全部消费完成。
        const uint32_t tile_count = m_loop * n_loop;
        const uint32_t first_outstanding = tile_count > pipe_depth ? tile_count - pipe_depth : 0;
        for (uint32_t sequence = first_outstanding; sequence < tile_count; ++sequence) {
            sync_block_wait(PIPE_MTE2, aiv_to_aic_flags[sequence % pipe_depth]);
        }
    }

    if ASCEND_IS_AIV {
        // AIV按行处理数据：middle_vec保存float矩阵乘结果，scale_vec保存按列的
        // channel_scale，token_scale_vec保存当前行的token_scale，output_vec保存激活结果。
        __ubuf__ float middle_buf[vector_len];
        __ubuf__ float scale_buf[vector_len];
        __ubuf__ float token_scale_buf[1];
        __ubuf__ CType output_buf[vector_len];
        auto middle_vec = make_tensor(make_mem_ptr(middle_buf), make_layout(make_shape(vector_len)));
        auto scale_vec = make_tensor(make_mem_ptr(scale_buf), make_layout(make_shape(vector_len)));
        auto token_scale_vec = make_tensor(make_mem_ptr(token_scale_buf), make_layout(make_shape(1)));
        auto output_vec = make_tensor(make_mem_ptr(output_buf), make_layout(make_shape(vector_len)));
        auto scale_copy = make_tensor(make_mem_ptr(scale_buf), make_frame_layout<nd_ext_layout_ptn>(1, vector_len));
        auto token_scale_copy = make_tensor(make_mem_ptr(token_scale_buf), make_frame_layout<nd_ext_layout_ptn>(1, 1));
        auto output_copy = make_tensor(make_mem_ptr(output_buf), make_frame_layout<nd_ext_layout_ptn>(1, vector_len));
        // split_m下AIV 0处理输出tile前半M行，AIV 1处理后半M行。
        const uint32_t sub_block_id = static_cast<uint32_t>(get_sub_block_id());

        // 每个AIV处理当前tile的M半块；每行内按vector_len列分块，列块均为完整块。
        for (uint32_t i = 0; i < m_loop; ++i) {
            const uint16_t half_m = base_m / 2;
            for (uint32_t j = 0; j < n_loop; ++j) {
                const uint32_t sequence = i * n_loop + j;
                const uint32_t slot = sequence % pipe_depth;
                // 等待当前slot的L0C->UB搬运完成。两个AIV使用同一个flag；
                // AIC一次arrive会使两个AIV各自解除等待。
                sync_block_wait(PIPE_S, aic_to_aiv_flags[slot]);
                for (uint32_t row = 0; row < half_m; ++row) {
                    // global_token_scale已经切到当前Block的M区间，因此这里使用Block内局部行号。
                    // local_row包含tile内M偏移、sub_block_id选择的半块和半块内行偏移。
                    const uint32_t local_row = i * base_m + sub_block_id * half_m + row;
                    mutex<PIPE_MTE2> token_scale_mutex(0);
                    token_scale_mutex.lock();
                    copy(token_scale_copy, global_token_scale, zero_coord, make_coord(local_row, 0), make_shape(1, 1));
                    token_scale_mutex.unlock();

                    for (uint32_t column = 0; column < base_n; column += vector_len) {
                        mutex<PIPE_MTE2> pipe_mte2_mutex(0);
                        mutex<PIPE_V> pipe_v_mutex(0);
                        mutex<PIPE_MTE3> pipe_mte3_mutex(0);
                        pipe_mte2_mutex.lock();
                        // 当前列片段对应的channel_scale[j*base_n+column : j*base_n+column+vector_len]，
                        // 它与即将处理的矩阵乘结果列一一对应。
                        copy(
                            scale_copy, global_channel_scale, zero_coord, make_coord(0, j * base_n + column),
                            make_shape(1, vector_len));
                        pipe_mte2_mutex.unlock();

                        pipe_v_mutex.lock();
                        // 从当前UB slot的(slot*base_m/2+row, column)坐标直接读取int32结果，
                        // 先转换为float，再做后续scale乘法和FastGelu。
                        cast_int32_to_float(ub_tensor, make_coord(slot * base_m / 2 + row, column), middle_vec);
                        pipe_v_mutex.unlock();
                        pipe_v_mutex.lock();
                        compute_quant_fast_gelu(middle_vec, scale_vec, token_scale_vec, output_vec);
                        pipe_v_mutex.unlock();

                        // 写回坐标同样是Block内局部坐标；global_z已包含当前Block的M/N偏移。
                        pipe_mte3_mutex.lock();
                        copy(
                            global_z, output_copy,
                            make_coord(i * base_m + sub_block_id * half_m + row, j * base_n + column), zero_coord,
                            make_shape(1, vector_len));
                        pipe_mte3_mutex.unlock();
                    }
                }
                // 两个AIV都完成当前slot的GM写回后，AIC才会解除等待并复用该slot。
                sync_block_arrive(PIPE_MTE3, aiv_to_aic_flags[slot]);
            }
        }
    }

    sync_pipe(PIPE_ALL);
}

int32_t main()
{
    using a_type = int8_t;
    using b_type = int8_t;
    using l0c_type = int32_t;
    using c_type = float;
    using scale_type = float;

    constexpr uint32_t m = matrix_m;
    constexpr uint32_t n = matrix_n;
    constexpr uint32_t k = matrix_k;
    size_t x_file_size = m * k * sizeof(a_type);
    size_t y_file_size = n * k * sizeof(b_type);
    size_t channel_scale_file_size = n * sizeof(scale_type);
    size_t token_scale_file_size = m * sizeof(scale_type);
    size_t z_file_size = m * n * sizeof(c_type);

    const int32_t device_id = 0;
    const uint32_t m_blocks = m / single_core_m;
    const uint32_t n_blocks = n / single_core_n;
    const uint32_t num_blocks = m_blocks * n_blocks;

    uint8_t* x_host = nullptr;
    uint8_t* y_host = nullptr;
    uint8_t* channel_scale_host = nullptr;
    uint8_t* token_scale_host = nullptr;
    uint8_t* z_host = nullptr;
    a_type* x_device = nullptr;
    b_type* y_device = nullptr;
    scale_type* channel_scale_device = nullptr;
    scale_type* token_scale_device = nullptr;
    c_type* z_device = nullptr;
    aclrtStream stream = nullptr;
    aclError acl_status = aclInit(nullptr);
    if (acl_status != ACL_SUCCESS) {
        ERROR_LOG("aclInit failed, status=%d.", acl_status);
        return -1;
    }
    acl_status = aclrtSetDevice(device_id);
    if (acl_status != ACL_SUCCESS) {
        ERROR_LOG("aclrtSetDevice failed, status=%d.", acl_status);
        aclFinalize();
        return -1;
    }
    acl_status = aclrtCreateStream(&stream);
    if (acl_status != ACL_SUCCESS) {
        ERROR_LOG("aclrtCreateStream failed, status=%d.", acl_status);
        aclrtResetDevice(device_id);
        aclFinalize();
        return -1;
    }

    do {
        acl_status = aclrtMallocHost(reinterpret_cast<void**>(&x_host), x_file_size);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMallocHost failed for x, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMallocHost(reinterpret_cast<void**>(&y_host), y_file_size);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMallocHost failed for y, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMallocHost(reinterpret_cast<void**>(&channel_scale_host), channel_scale_file_size);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMallocHost failed for channel scale, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMallocHost(reinterpret_cast<void**>(&token_scale_host), token_scale_file_size);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMallocHost failed for token scale, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMallocHost(reinterpret_cast<void**>(&z_host), z_file_size);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMallocHost failed for z, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMalloc(reinterpret_cast<void**>(&x_device), x_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMalloc failed for x, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMalloc(reinterpret_cast<void**>(&y_device), y_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMalloc failed for y, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMalloc(
            reinterpret_cast<void**>(&channel_scale_device), channel_scale_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMalloc failed for channel scale, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMalloc(
            reinterpret_cast<void**>(&token_scale_device), token_scale_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMalloc failed for token scale, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMalloc(reinterpret_cast<void**>(&z_device), z_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMalloc failed for z, status=%d.", acl_status);
            break;
        }

        if (!ReadFile("./input/input_x.bin", x_file_size, x_host, x_file_size) ||
            !ReadFile("./input/input_y.bin", y_file_size, y_host, y_file_size) ||
            !ReadFile(
                "./input/channel_scale.bin", channel_scale_file_size, channel_scale_host, channel_scale_file_size) ||
            !ReadFile("./input/token_scale.bin", token_scale_file_size, token_scale_host, token_scale_file_size)) {
            ERROR_LOG("Read input files failed.");
            break;
        }

        acl_status = aclrtMemcpy(x_device, x_file_size, x_host, x_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
        if (acl_status == ACL_SUCCESS) {
            acl_status = aclrtMemcpy(y_device, y_file_size, y_host, y_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
        }
        if (acl_status == ACL_SUCCESS) {
            acl_status = aclrtMemcpy(
                channel_scale_device, channel_scale_file_size, channel_scale_host, channel_scale_file_size,
                ACL_MEMCPY_HOST_TO_DEVICE);
        }
        if (acl_status == ACL_SUCCESS) {
            acl_status = aclrtMemcpy(
                token_scale_device, token_scale_file_size, token_scale_host, token_scale_file_size,
                ACL_MEMCPY_HOST_TO_DEVICE);
        }
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMemcpy failed, status=%d.", acl_status);
            break;
        }

        quant_matmul_custom<a_type, b_type, l0c_type, c_type, scale_type><<<num_blocks, 0, stream>>>(
            x_device, y_device, channel_scale_device, token_scale_device, z_device, m, n, k, single_core_m,
            single_core_n, k);

        acl_status = aclrtSynchronizeStream(stream);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtSynchronizeStream failed, status=%d.", acl_status);
            break;
        }
        acl_status = aclrtMemcpy(z_host, z_file_size, z_device, z_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
        if (acl_status != ACL_SUCCESS) {
            ERROR_LOG("aclrtMemcpy z failed, status=%d.", acl_status);
            break;
        }
        if (!WriteFile("./output/output.bin", z_host, z_file_size)) {
            ERROR_LOG("Write output file failed.");
            break;
        }

        aclrtFree(x_device);
        aclrtFree(y_device);
        aclrtFree(channel_scale_device);
        aclrtFree(token_scale_device);
        aclrtFree(z_device);
        aclrtFreeHost(x_host);
        aclrtFreeHost(y_host);
        aclrtFreeHost(channel_scale_host);
        aclrtFreeHost(token_scale_host);
        aclrtFreeHost(z_host);
        aclrtDestroyStream(stream);
        aclrtResetDevice(device_id);
        aclFinalize();
        return 0;
    } while (false);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(channel_scale_device);
    aclrtFree(token_scale_device);
    aclrtFree(z_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(channel_scale_host);
    aclrtFreeHost(token_scale_host);
    aclrtFreeHost(z_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return -1;
}
