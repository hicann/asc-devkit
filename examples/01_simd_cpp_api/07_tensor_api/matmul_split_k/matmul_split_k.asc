/* !
 * \file matmul_split_k.asc
 * \brief Split-K matmul based on Tensor API with C API atomic accumulation.
 */

#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "c_api/atomic/datamove_atomic.h"
#include "data_utils.h"
#include "tensor_api/tensor.h"

constexpr uint32_t M = 16;
constexpr uint32_t K = 1024;
constexpr uint32_t N = 16;
constexpr uint32_t SPLIT_K = 4;
constexpr uint32_t BASE_K = K / SPLIT_K;

static_assert(K % SPLIT_K == 0, "K must be divisible by SPLIT_K");

__global__ __cube__ void matmul_split_k_kernel(__gm__ half* a, __gm__ half* b, __gm__ float* c)
{
    asc_init();
    using namespace asc::te;

    const uint32_t splitIdx = block_idx;
    if (splitIdx >= SPLIT_K) {
        return;
    }
    const uint32_t kOffset = splitIdx * BASE_K;

    auto gmA = make_tensor(make_mem_ptr(a), make_frame_layout<nd_ext_layout_ptn>(M, K));
    auto gmB = make_tensor(make_mem_ptr(b), make_frame_layout<nd_ext_layout_ptn>(K, N));
    auto gmC = make_tensor(make_mem_ptr(c), make_frame_layout<nd_ext_layout_ptn>(M, N));
    auto aTile = gmA.slice(make_coord(0, kOffset), make_shape(M, BASE_K));
    auto bTile = gmB.slice(make_coord(kOffset, 0), make_shape(BASE_K, N));

    auto l1ALayout = make_frame_layout<nz_layout_ptn>(M, BASE_K);
    auto l1BLayout = make_frame_layout<nz_layout_ptn>(BASE_K, N);
    auto l0ALayout = make_frame_layout<nz_layout_ptn>(M, BASE_K);
    auto l0BLayout = make_frame_layout<zn_layout_ptn>(BASE_K, N);
    auto l0CLayout = make_frame_layout<nz_layout_ptn>(M, N);
    __cbuf__ half l1ABuf[M * BASE_K];
    __cbuf__ half l1BBuf[BASE_K * N];
    __ca__ half l0ABuf[M * BASE_K];
    __cb__ half l0BBuf[BASE_K * N];
    __cc__ float l0CBuf[M * N];

    auto l1A = make_tensor(make_mem_ptr(l1ABuf), l1ALayout);
    auto l1B = make_tensor(make_mem_ptr(l1BBuf), l1BLayout);
    auto l0A = make_tensor(make_mem_ptr(l0ABuf), l0ALayout);
    auto l0B = make_tensor(make_mem_ptr(l0BBuf), l0BLayout);
    auto l0C = make_tensor(make_mem_ptr(l0CBuf), l0CLayout);

    auto gm2l1 = make_copy(copy_gm_to_l1{}, gm_to_l1_trait_default{});
    auto l1tol0a = make_copy(copy_l1_to_l0a{}, l1_to_l0a_trait_default{});
    auto l1tol0b = make_copy(copy_l1_to_l0b{}, l1_to_l0b_trait_default{});
    auto l0c2gm = make_copy(copy_l0c_to_gm{}, l0c_to_gm_trait_default{});
    auto mm = make_mmad(mmad_operation{}, mmad_trait_default{});

    constexpr uint32_t L1_ID = 0;
    constexpr uint32_t L0_ID = 1;
    constexpr uint32_t L0C_ID = 2;
    asc_lock(PIPE_M, L0C_ID);
    asc_lock(PIPE_MTE2, L1_ID);
    copy(gm2l1, l1A, aTile);
    copy(gm2l1, l1B, bTile);
    asc_unlock(PIPE_MTE2, L1_ID);
    asc_lock(PIPE_MTE1, L1_ID);
    asc_lock(PIPE_MTE1, L0_ID);
    copy(l1tol0a, l0A, l1A);
    copy(l1tol0b, l0B, l1B);
    asc_unlock(PIPE_MTE1, L0_ID);
    asc_unlock(PIPE_MTE1, L1_ID);
    asc_lock(PIPE_M, L0_ID);
    auto params = mmad_params{M, N, BASE_K, unit_flag_mode::disable, true};
    mmad(mm.with(params), l0C, l0A, l0B);
    asc_unlock(PIPE_M, L0_ID);
    asc_unlock(PIPE_M, L0C_ID);

    // Each Cube core contributes one K slice to the same output matrix.
    asc_lock(PIPE_FIX, L0C_ID);
    asc_set_atomic_add_float();
    copy(l0c2gm, gmC, l0C);
    asc_disable_dma_atomic();
    asc_unlock(PIPE_FIX, L0C_ID);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t aBytes = static_cast<size_t>(M) * K * sizeof(half);
    size_t bBytes = static_cast<size_t>(K) * N * sizeof(half);
    size_t cBytes = static_cast<size_t>(M) * N * sizeof(float);

    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    half* aHost;
    half* aDevice;
    aclrtMallocHost((void**)(&aHost), aBytes);
    aclrtMalloc((void**)&aDevice, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", aHost, aBytes);
    aclrtMemcpy(aDevice, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    half* bHost;
    half* bDevice;
    aclrtMallocHost((void**)(&bHost), bBytes);
    aclrtMalloc((void**)&bDevice, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", bHost, bBytes);
    aclrtMemcpy(bDevice, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    float* cHost;
    float* cDevice;
    aclrtMallocHost((void**)(&cHost), cBytes);
    aclrtMalloc((void**)&cDevice, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    // Atomic accumulation requires the shared output matrix to start at zero.
    aclrtMemset(cDevice, cBytes, 0, cBytes);

    matmul_split_k_kernel<<<SPLIT_K, 0, stream>>>(aDevice, bDevice, cDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, cBytes, cDevice, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", cHost, cBytes);

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(cHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
