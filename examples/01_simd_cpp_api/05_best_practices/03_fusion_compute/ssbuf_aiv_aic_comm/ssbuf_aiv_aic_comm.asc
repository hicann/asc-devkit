/* !
 * \file ssbuf_aiv_aic_comm.asc
 * \brief Demonstrates a KFC-inspired AIV-to-AIC ring queue in SSBuffer without calling internal KFC APIs.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t AIV_COUNT = 2;
constexpr uint32_t QUEUE_DEPTH = 8;
constexpr uint32_t MESSAGE_COUNT_PER_AIV = 12;
constexpr uint32_t TOTAL_RESULT_COUNT = AIV_COUNT * MESSAGE_COUNT_PER_AIV;
constexpr uint32_t VALID_MASK = 0x00008000U;
constexpr uint32_t FUNCTION_ID = 0x5A01U;
constexpr uint64_t CHECKSUM_MAGIC = 0x5353425546434D4DULL;
constexpr uint16_t MESSAGE_READY_FLAG_ID = 0;
constexpr uint16_t MESSAGE_ACK_FLAG_ID = 1;
constexpr uint16_t START_FLAG_ID = 2;
constexpr uint16_t AIC_FLAG_ID_STRIDE = 16;

struct alignas(128) CommMessage {
    volatile uint32_t head;
    volatile uint32_t reserved0;
    volatile uint64_t sequence;
    volatile uint64_t value;
    volatile uint64_t checksum;
    uint64_t reserved[12];
};

struct SsbufWorkspace {
    CommMessage queue[AIV_COUNT][QUEUE_DEPTH];
};

struct CommResult {
    uint32_t sender;
    uint32_t valid;
    uint64_t sequence;
    uint64_t value;
    uint64_t checksum;
};

static_assert(sizeof(CommResult) == 32, "CommResult must be 32 bytes");

__aicore__ inline uint32_t MakeHead(uint32_t sender) { return (FUNCTION_ID << 16) | VALID_MASK | (sender & 0xFFU); }

__aicore__ inline uint32_t GetFunctionId(uint32_t head) { return head >> 16; }

__aicore__ inline uint32_t GetSender(uint32_t head) { return head & 0xFFU; }

__aicore__ inline bool IsValid(uint32_t head) { return (head & VALID_MASK) != 0; }

__aicore__ inline uint16_t GetAicFlagId(uint32_t sender, uint16_t aivFlagId)
{
    return static_cast<uint16_t>(sender * AIC_FLAG_ID_STRIDE + aivFlagId);
}

__aicore__ inline uint64_t MakeValue(uint32_t sender, uint64_t sequence)
{
    return 1000ULL + static_cast<uint64_t>(sender) * 100ULL + sequence;
}

__aicore__ inline uint64_t MakeChecksum(uint32_t sender, uint64_t sequence, uint64_t value)
{
    return CHECKSUM_MAGIC ^ static_cast<uint64_t>(sender) ^ sequence ^ value;
}

__aicore__ inline __ssbuf__ SsbufWorkspace* GetWorkspace()
{
    return reinterpret_cast<__ssbuf__ SsbufWorkspace*>(AscendC::GetSsbufBaseAddr());
}

__aicore__ inline void ClearMessage(__ssbuf__ CommMessage* message)
{
    *reinterpret_cast<__ssbuf__ volatile uint64_t*>(message) = 0;
}

__aicore__ inline void InitQueues(__ssbuf__ SsbufWorkspace* workspace)
{
    for (uint32_t sender = 0; sender < AIV_COUNT; ++sender) {
        for (uint32_t slot = 0; slot < QUEUE_DEPTH; ++slot) {
            ClearMessage(&workspace->queue[sender][slot]);
        }
    }
}

__aicore__ inline void SendMessages(__ssbuf__ SsbufWorkspace* workspace, uint32_t sender)
{
    // Mode 4: this AIV waits until AIC finishes initializing SSBuffer.
    AscendC::CrossCoreWaitFlag<4, PIPE_S>(START_FLAG_ID);

    for (uint64_t sequence = 0; sequence < MESSAGE_COUNT_PER_AIV; ++sequence) {
        // Before the queue wraps, wait until AIC releases the message space to be reused.
        if (sequence >= QUEUE_DEPTH) {
            AscendC::CrossCoreWaitFlag<4, PIPE_S>(MESSAGE_ACK_FLAG_ID);
        }

        __ssbuf__ CommMessage* message = &workspace->queue[sender][sequence & (QUEUE_DEPTH - 1)];
        const uint64_t value = MakeValue(sender, sequence);
        message->sequence = sequence;
        message->value = value;
        message->checksum = MakeChecksum(sender, sequence, value);
        message->head = MakeHead(sender);
        // Mode 4: notify AIC after all PIPE_S writes for this message have completed.
        AscendC::CrossCoreSetFlag<4, PIPE_S>(MESSAGE_READY_FLAG_ID);
    }

    constexpr uint32_t REMAINING_ACK_COUNT = MESSAGE_COUNT_PER_AIV < QUEUE_DEPTH ? MESSAGE_COUNT_PER_AIV : QUEUE_DEPTH;
    for (uint32_t ackIndex = 0; ackIndex < REMAINING_ACK_COUNT; ++ackIndex) {
        AscendC::CrossCoreWaitFlag<4, PIPE_S>(MESSAGE_ACK_FLAG_ID);
    }
}

__aicore__ inline void ReceiveMessages(__ssbuf__ SsbufWorkspace* workspace, __gm__ CommResult* output)
{
    for (uint32_t expectedSender = 0; expectedSender < AIV_COUNT; ++expectedSender) {
        for (uint64_t expectedSequence = 0; expectedSequence < MESSAGE_COUNT_PER_AIV; ++expectedSequence) {
            // Mode 4: wait for one message from the selected AIV.
            AscendC::CrossCoreWaitFlag<4, PIPE_S>(GetAicFlagId(expectedSender, MESSAGE_READY_FLAG_ID));
            __ssbuf__ CommMessage* message = &workspace->queue[expectedSender][expectedSequence & (QUEUE_DEPTH - 1)];
            const uint32_t head = message->head;

            const uint32_t sender = GetSender(head);
            const uint64_t sequence = message->sequence;
            const uint64_t value = message->value;
            const uint64_t checksum = message->checksum;
            const bool valid = GetFunctionId(head) == FUNCTION_ID && IsValid(head) && sender == expectedSender &&
                               sequence == expectedSequence && checksum == MakeChecksum(sender, sequence, value);

            __gm__ CommResult* result = output + expectedSender * MESSAGE_COUNT_PER_AIV + expectedSequence;
            result->sender = sender;
            result->valid = valid ? 1U : 0U;
            result->sequence = sequence;
            result->value = value;
            result->checksum = checksum;

            ClearMessage(message);
            // Mode 4: release this message space after all PIPE_S reads and writes have completed.
            AscendC::CrossCoreSetFlag<4, PIPE_S>(GetAicFlagId(expectedSender, MESSAGE_ACK_FLAG_ID));
        }
    }
}
} // namespace

extern "C" __global__ __mix__(1, 2) void ssbuf_aiv_aic_comm(__gm__ CommResult* output)
{
    AscendC::InitSocState();
    __ssbuf__ SsbufWorkspace* workspace = GetWorkspace();

    if ASCEND_IS_AIC {
        InitQueues(workspace);
        // Mode 4 sends a separate initialization notification to each AIV.
        AscendC::CrossCoreSetFlag<4, PIPE_S>(GetAicFlagId(0, START_FLAG_ID));
        AscendC::CrossCoreSetFlag<4, PIPE_S>(GetAicFlagId(1, START_FLAG_ID));
        ReceiveMessages(workspace, output);
    }

    if ASCEND_IS_AIV {
        SendMessages(workspace, static_cast<uint32_t>(AscendC::GetSubBlockIdx()));
    }
}

static bool CheckAcl(aclError result, const char* expression)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed, ret=%d\n", expression, static_cast<int32_t>(result));
    return false;
}

#define CHECK_ACL(expression)                       \
    do {                                            \
        if (!CheckAcl((expression), #expression)) { \
            return 1;                               \
        }                                           \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    constexpr int32_t DEVICE_ID = 0;
    constexpr size_t OUTPUT_BYTES = TOTAL_RESULT_COUNT * sizeof(CommResult);

    CommResult* outputHost = nullptr;
    CommResult* outputDevice = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&outputHost), OUTPUT_BYTES));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&outputDevice), OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(outputDevice, OUTPUT_BYTES, 0, OUTPUT_BYTES));

    ssbuf_aiv_aic_comm<<<1, 0, stream>>>(outputDevice);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(outputHost, OUTPUT_BYTES, outputDevice, OUTPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));

    bool passed = true;
    for (uint32_t sender = 0; sender < AIV_COUNT; ++sender) {
        for (uint64_t sequence = 0; sequence < MESSAGE_COUNT_PER_AIV; ++sequence) {
            const CommResult& result = outputHost[sender * MESSAGE_COUNT_PER_AIV + sequence];
            const uint64_t expectedValue = 1000ULL + static_cast<uint64_t>(sender) * 100ULL + sequence;
            const uint64_t expectedChecksum = CHECKSUM_MAGIC ^ static_cast<uint64_t>(sender) ^ sequence ^ expectedValue;
            if (result.valid != 1U || result.sender != sender || result.sequence != sequence ||
                result.value != expectedValue || result.checksum != expectedChecksum) {
                std::fprintf(
                    stderr,
                    "[ERROR] sender=%u sequence=%llu: valid=%u senderOut=%u sequenceOut=%llu value=%llu "
                    "checksum=0x%llx\n",
                    sender, static_cast<unsigned long long>(sequence), result.valid, result.sender,
                    static_cast<unsigned long long>(result.sequence), static_cast<unsigned long long>(result.value),
                    static_cast<unsigned long long>(result.checksum));
                passed = false;
            }
        }
    }

    CHECK_ACL(aclrtFree(outputDevice));
    CHECK_ACL(aclrtFreeHost(outputHost));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    std::printf(passed ? "test pass!\n" : "test failed!\n");
    return passed ? 0 : 1;
}
