/*!
 * \file matmul_hif8.asc
 */

#include <cstdint>
#include <cstdlib>
#include <iostream>

#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "register/tilingdata_base.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

constexpr uint32_t M = 1024;
constexpr uint32_t N = 1024;
constexpr uint32_t K = 1024;
constexpr bool IS_TRANS_A = false;
constexpr bool IS_TRANS_B = false;
constexpr bool IS_BIAS = false;

#if SCENARIO_NUM == 0
constexpr size_t INPUT_ELEMENT_SIZE = sizeof(uint16_t);
constexpr size_t OUTPUT_ELEMENT_SIZE = sizeof(float);
#elif SCENARIO_NUM == 1
constexpr size_t INPUT_ELEMENT_SIZE = sizeof(uint8_t);
constexpr size_t OUTPUT_ELEMENT_SIZE = sizeof(float);
#elif SCENARIO_NUM == 2
constexpr size_t INPUT_ELEMENT_SIZE = sizeof(uint8_t);
constexpr size_t OUTPUT_ELEMENT_SIZE = sizeof(uint8_t);
#else
#error "SCENARIO_NUM must be 0, 1, or 2"
#endif

struct MatmulCaseParams {
    int32_t usedCoreNum;
    int32_t m;
    int32_t n;
    int32_t k;
};

bool GenerateTiling(const MatmulCaseParams& params, TCubeTiling& tilingData)
{
#if defined(ASCENDC_CPU_DEBUG) && (__NPU_ARCH__ == 3510)
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend950PR_9589");
#else
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
#endif
    matmul_tiling::MultiCoreMatmulTiling tiling(*platform);
    tiling.SetDim(params.usedCoreNum);

#if SCENARIO_NUM == 0
    constexpr auto inputType = matmul_tiling::DataType::DT_FLOAT16;
#else
    constexpr auto inputType = matmul_tiling::DataType::DT_HIFLOAT8;
#endif
#if SCENARIO_NUM == 2
    constexpr auto outputType = matmul_tiling::DataType::DT_HIFLOAT8;
#else
    constexpr auto outputType = matmul_tiling::DataType::DT_FLOAT;
#endif

    tiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, IS_TRANS_A);
    tiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, inputType, IS_TRANS_B);
    tiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, outputType);
    tiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
#if SCENARIO_NUM == 2
    tiling.SetDequantType(matmul_tiling::DequantType::SCALAR);
#endif
    tiling.SetOrgShape(params.m, params.n, params.k);
    tiling.SetShape(params.m, params.n, params.k);
    tiling.EnableBias(IS_BIAS);
    tiling.SetBufferSpace(-1, -1, -1);

    if (tiling.GetTiling(tilingData) == -1) {
        ERROR_LOG("failed to generate Matmul tiling");
        return false;
    }
    return true;
}

template <typename AType, typename BType, typename CType, typename BiasType>
class MatmulHif8Kernel {
public:
    __aicore__ inline MatmulHif8Kernel() = default;

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, const TCubeTiling& tilingData)
    {
        tiling = tilingData;
        aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ AType*>(a), tiling.M * tiling.Ka);
        bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ BType*>(b), tiling.Kb * tiling.N);
        cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ CType*>(c), tiling.M * tiling.N);

        int32_t offsetA = 0;
        int32_t offsetB = 0;
        int32_t offsetC = 0;
        CalcOffset(AscendC::GetBlockIdx(), offsetA, offsetB, offsetC);
        aGlobal = aGlobal[offsetA];
        bGlobal = bGlobal[offsetB];
        cGlobal = cGlobal[offsetC];
    }

    __aicore__ inline void Process(AscendC::TPipe* pipe)
    {
        if (AscendC::GetBlockIdx() >= tiling.usedCoreNum) {
            return;
        }
        REGIST_MATMUL_OBJ(pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);

#if SCENARIO_NUM == 2
        float quantScale = 1.0f;
        uint64_t quantScalar = static_cast<uint64_t>(*reinterpret_cast<int32_t*>(&quantScale));
        matmulObj.SetQuantScalar(quantScalar);
#endif

        int32_t tailM = tiling.M - mCoreIndex * tiling.singleCoreM;
        int32_t tailN = tiling.N - nCoreIndex * tiling.singleCoreN;
        tailM = tailM < tiling.singleCoreM ? tailM : tiling.singleCoreM;
        tailN = tailN < tiling.singleCoreN ? tailN : tiling.singleCoreN;
        if (tailM < tiling.singleCoreM || tailN < tiling.singleCoreN) {
            matmulObj.SetTail(tailM, tailN);
        }

        matmulObj.SetTensorA(aGlobal, IS_TRANS_A);
        matmulObj.SetTensorB(bGlobal, IS_TRANS_B);
        matmulObj.IterateAll(cGlobal);
        matmulObj.End();
    }

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t& offsetA, int32_t& offsetB, int32_t& offsetC)
    {
        int32_t mCoreBlocks = (tiling.M + tiling.singleCoreM - 1) / tiling.singleCoreM;
        mCoreIndex = blockIdx % mCoreBlocks;
        nCoreIndex = blockIdx / mCoreBlocks;

        offsetA = mCoreIndex * tiling.Ka * tiling.singleCoreM;
        offsetB = nCoreIndex * tiling.singleCoreN;
        offsetC = mCoreIndex * tiling.N * tiling.singleCoreM + nCoreIndex * tiling.singleCoreN;
    }

    static constexpr MatmulConfig MM_CFG = GetMDLConfig();
    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, AType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, CType>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, BiasType>, MM_CFG>
        matmulObj;
    AscendC::GlobalTensor<AType> aGlobal;
    AscendC::GlobalTensor<BType> bGlobal;
    AscendC::GlobalTensor<CType> cGlobal;
    TCubeTiling tiling;
    int32_t mCoreIndex = 0;
    int32_t nCoreIndex = 0;
};

__aicore__ inline void CopyTiling(TCubeTiling* tiling, __gm__ uint8_t* tilingGm)
{
    uint32_t* dst = reinterpret_cast<uint32_t*>(tiling);
    auto src = reinterpret_cast<__gm__ uint32_t*>(tilingGm);
    for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); ++i) {
        dst[i] = src[i];
    }
}

__global__ __cube__ void matmul_hif8_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __kfc_workspace__ __gm__ uint8_t* workspace,
    __gm__ uint8_t* tilingGm)
{
    TCubeTiling tiling;
    CopyTiling(&tiling, tilingGm);
    AscendC::TPipe pipe;

#if SCENARIO_NUM == 0
    MatmulHif8Kernel<half, half, float, float> kernel;
#elif SCENARIO_NUM == 1
    MatmulHif8Kernel<hifloat8_t, hifloat8_t, float, float> kernel;
#else
    MatmulHif8Kernel<hifloat8_t, hifloat8_t, hifloat8_t, float> kernel;
#endif
    kernel.Init(a, b, c, tiling);
    kernel.Process(&pipe);
}

void LaunchMatmul(
    uint32_t blockDim, void* stream, uint8_t* a, uint8_t* b, uint8_t* c, uint8_t* workspace, uint8_t* tilingDevice)
{
    matmul_hif8_custom<<<blockDim, 0, stream>>>(a, b, c, workspace, tilingDevice);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
#if defined(ASCENDC_CPU_DEBUG) && (__NPU_ARCH__ == 3510)
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance("Ascend950PR_9589");
#else
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
#endif
    MatmulCaseParams params{
        static_cast<int32_t>(platform->GetCoreNumAic()), static_cast<int32_t>(M), static_cast<int32_t>(N),
        static_cast<int32_t>(K)};
    TCubeTiling tiling;
    if (!GenerateTiling(params, tiling)) {
        return 1;
    }

    const size_t aSize = static_cast<size_t>(M) * K * INPUT_ELEMENT_SIZE;
    const size_t bSize = static_cast<size_t>(K) * N * INPUT_ELEMENT_SIZE;
    const size_t cSize = static_cast<size_t>(M) * N * OUTPUT_ELEMENT_SIZE;
    const size_t workspaceSize = static_cast<size_t>(platform->GetLibApiWorkSpaceSize());
    const size_t tilingSize = sizeof(TCubeTiling);

    int32_t deviceId = 0;
    aclrtContext context = nullptr;
    aclrtStream stream = nullptr;
    aclInit(nullptr);
    aclrtSetDevice(deviceId);
    aclrtCreateContext(&context, deviceId);
    aclrtCreateStream(&stream);

    uint8_t* aHost = nullptr;
    uint8_t* bHost = nullptr;
    uint8_t* cHost = nullptr;
    uint8_t* tilingHost = nullptr;
    uint8_t* aDevice = nullptr;
    uint8_t* bDevice = nullptr;
    uint8_t* cDevice = nullptr;
    uint8_t* workspaceDevice = nullptr;
    uint8_t* tilingDevice = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&aHost), aSize);
    aclrtMallocHost(reinterpret_cast<void**>(&bHost), bSize);
    aclrtMallocHost(reinterpret_cast<void**>(&cHost), cSize);
    aclrtMallocHost(reinterpret_cast<void**>(&tilingHost), tilingSize);
    aclrtMalloc(reinterpret_cast<void**>(&aDevice), aSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bDevice), bSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cDevice), cSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&workspaceDevice), workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&tilingDevice), tilingSize, ACL_MEM_MALLOC_HUGE_FIRST);

    size_t actualSize = aSize;
    bool readSuccess = ReadFile("./input/a.bin", actualSize, aHost, aSize) && actualSize == aSize;
    actualSize = bSize;
    readSuccess = readSuccess && ReadFile("./input/b.bin", actualSize, bHost, bSize) && actualSize == bSize;
    if (!readSuccess) {
        ERROR_LOG("failed to read input data; run scripts/gen_data.py for the selected scenario first");
        return 1;
    }

    aclrtMemcpy(aDevice, aSize, aHost, aSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDevice, bSize, bHost, bSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(tilingHost, tilingSize, &tiling, tilingSize, ACL_MEMCPY_HOST_TO_HOST);
    aclrtMemcpy(tilingDevice, tilingSize, tilingHost, tilingSize, ACL_MEMCPY_HOST_TO_DEVICE);

    LaunchMatmul(tiling.usedCoreNum, stream, aDevice, bDevice, cDevice, workspaceDevice, tilingDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(cHost, cSize, cDevice, cSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (!WriteFile("./output/output.bin", cHost, cSize)) {
        return 1;
    }

    aclrtFree(aDevice);
    aclrtFree(bDevice);
    aclrtFree(cDevice);
    aclrtFree(workspaceDevice);
    aclrtFree(tilingDevice);
    aclrtFreeHost(aHost);
    aclrtFreeHost(bHost);
    aclrtFreeHost(cHost);
    aclrtFreeHost(tilingHost);
    aclrtDestroyStream(stream);
    aclrtDestroyContext(context);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
