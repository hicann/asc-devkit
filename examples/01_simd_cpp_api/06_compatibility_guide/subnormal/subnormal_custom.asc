/*!
 * \file subnormal_custom.asc
 * \brief 本样例演示Ln接口的Subnormal计算模式兼容性适配，通过编译时宏隔离不同硬件实现
 */

#include "kernel_operator.h"
#include "data_utils.h"
#include "acl/acl.h"

template <typename T, int32_t COUNT>
class KernelSubnormal {
public:
    __aicore__ inline KernelSubnormal() {}
    __aicore__ inline void Init(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm)
    {
        xAddr = 0;
        yAddr = xAddr + static_cast<uint64_t>(COUNT) * sizeof(T);
        srcGlobal.SetGlobalBuffer((__gm__ T*)srcGm, COUNT);
        dstGlobal.SetGlobalBuffer((__gm__ T*)dstGm, COUNT);
    }

    __aicore__ inline void Process()
    {
        AscendC::LocalTensor<T> srcLocal(AscendC::TPosition::VECCALC, xAddr, COUNT);
        AscendC::LocalTensor<T> dstLocal(AscendC::TPosition::VECCALC, yAddr, COUNT);

        // 数据搬入：GM -> UB
        AscendC::DataCopy(srcLocal, srcGlobal, COUNT);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // 计算Ln，根据架构采用不同配置以保留Subnormal数据的计算结果
#if defined(__NPU_ARCH__) && (__NPU_ARCH__ == 2201)
        // Atlas A2/A3 训练/推理系列产品：硬件默认支持Subnormal，无需额外配置
        AscendC::Ln<T>(dstLocal, srcLocal, COUNT);
#elif defined(__NPU_ARCH__) && (__NPU_ARCH__ == 3510)
        // Ascend 950PR/950DT：默认不支持Subnormal（输入中的Subnormal会被近似为0），
        // 通过LnConfig将algo配置为PRECISION_1ULP_FTZ_FALSE，由软件仿真保留Subnormal计算结果
        static constexpr AscendC::LnConfig CONFIG = {AscendC::LnAlgo::PRECISION_1ULP_FTZ_FALSE};
        AscendC::Ln<T, CONFIG>(dstLocal, srcLocal, COUNT);
#endif

        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

        // 数据搬出：UB -> GM
        AscendC::DataCopy(dstGlobal, dstLocal, COUNT);
    }

private:
    uint64_t xAddr = 0;
    uint64_t yAddr = 0;
    AscendC::GlobalTensor<T> srcGlobal;
    AscendC::GlobalTensor<T> dstGlobal;
};

__vector__ __global__ void subnormal_custom(__gm__ uint8_t* srcGm, __gm__ uint8_t* dstGm)
{
    AscendC::InitSocState();
    KernelSubnormal<half, 1024> op;
    op.Init(srcGm, dstGm);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t NUM_BLOCKS = 1;
    constexpr int32_t COUNT = 1024;
    size_t inputByteSize = COUNT * sizeof(uint16_t);
    size_t outputByteSize = COUNT * sizeof(uint16_t);

    CHECK_ACL(aclInit(nullptr));
    int32_t deviceId = 0;
    CHECK_ACL(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    uint8_t* xHost = nullptr;
    uint8_t* zHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* zDevice = nullptr;

    CHECK_ACL(aclrtMallocHost((void**)(&xHost), inputByteSize));
    CHECK_ACL(aclrtMallocHost((void**)(&zHost), outputByteSize));
    CHECK_ACL(aclrtMalloc((void**)&xDevice, inputByteSize, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&zDevice, outputByteSize, ACL_MEM_MALLOC_HUGE_FIRST));

    size_t fileSize = 0;
    if (!ReadFile("./input/input_x.bin", fileSize, xHost, inputByteSize)) {
        ERROR_LOG("Read input file failed");
        return -1;
    }

    CHECK_ACL(aclrtMemcpy(xDevice, inputByteSize, xHost, inputByteSize, ACL_MEMCPY_HOST_TO_DEVICE));

    subnormal_custom<<<NUM_BLOCKS, 0, stream>>>(xDevice, zDevice);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    CHECK_ACL(aclrtMemcpy(zHost, outputByteSize, zDevice, outputByteSize, ACL_MEMCPY_DEVICE_TO_HOST));
    if (!WriteFile("./output/output.bin", zHost, outputByteSize)) {
        ERROR_LOG("Write output file failed");
        return -1;
    }

    CHECK_ACL(aclrtFree(xDevice));
    CHECK_ACL(aclrtFree(zDevice));
    CHECK_ACL(aclrtFreeHost(xHost));
    CHECK_ACL(aclrtFreeHost(zHost));

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(deviceId));
    CHECK_ACL(aclFinalize());

    return 0;
}
