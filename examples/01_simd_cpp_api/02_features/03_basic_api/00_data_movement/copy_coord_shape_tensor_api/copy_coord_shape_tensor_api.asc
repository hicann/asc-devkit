/* !
 * \file copy_coord_shape_tensor_api.asc
 * \brief copy_coord_shape_tensor_api
 */

#include "tensor_api/tensor.h"
#include "c_api/asc_simd.h"
#include "acl/acl.h"
#include "data_utils.h"

struct matmul_tiling {
    int32_t m;
    int32_t n;
    int32_t k;
    int32_t single_core_m;
    int32_t single_core_n;
    int32_t single_core_k;
};

struct core_iter_info {
    uint32_t m_iter;
    uint32_t m_iter_idx;
    uint32_t n_iter_idx;
    int32_t actual_single_core_m;
    int32_t actual_single_core_n;
};

// Custom copy_l0c_to_ub_trait parameters used only for l0c to ub copies
constexpr asc::te::dual_dst_mode g_dual_dst_mode =
    (SCENARIO_NUM == 3) ? asc::te::dual_dst_mode::split_n : asc::te::dual_dst_mode::split_m;
constexpr asc::te::copy_l0c_to_ub_trait custom_copy_l0c_to_ub_trait_value{
    asc::te::round_mode::default_round, false, false, g_dual_dst_mode};
struct copy_l0c_to_ub_trait_custom {
    using trait_type = asc::te::copy_l0c_to_ub_trait;
    static constexpr const trait_type value = custom_copy_l0c_to_ub_trait_value;
};

// copy tiling information from gm to a local struct
__aicore__ inline void copy_tiling_from_gm(__gm__ matmul_tiling* src_info, matmul_tiling& dst_info)
{
    auto src_ptr = reinterpret_cast<__gm__ int32_t*>(src_info);
    auto dst_ptr = reinterpret_cast<int32_t*>(&dst_info);
    for (size_t i = 0; i < sizeof(matmul_tiling) / sizeof(int32_t); ++i) {
        dst_ptr[i] = src_ptr[i];
    }
}

// Calculate iteration information for the current core from tiling parameters and the core index
__aicore__ inline core_iter_info calc_core_iter_info(const matmul_tiling& tiling)
{
    uint32_t m_iter = (tiling.m + tiling.single_core_m - 1) / tiling.single_core_m;
    auto block_idx = asc_get_block_idx();
    if ASCEND_IS_AIV {
        block_idx /= 2;
    }
    uint32_t m_iter_idx = block_idx % m_iter;
    uint32_t n_iter_idx = block_idx / m_iter;
    int32_t actual_single_core_m = tiling.m - m_iter_idx * tiling.single_core_m;
    actual_single_core_m = actual_single_core_m < tiling.single_core_m ? actual_single_core_m : tiling.single_core_m;
    int32_t actual_single_core_n = tiling.n - n_iter_idx * tiling.single_core_n;
    actual_single_core_n = actual_single_core_n < tiling.single_core_n ? actual_single_core_n : tiling.single_core_n;
    return {m_iter, m_iter_idx, n_iter_idx, actual_single_core_m, actual_single_core_n};
}

template <typename AType, typename BType, typename CDataType, typename BiasType,
          int32_t base_m, int32_t base_n, int32_t base_k, int32_t step_m, int32_t step_n, int32_t step_k>
__global__ __mix__(1,2) void copy_coord_shape_tensor_api(__gm__ AType* x, __gm__ BType* y, __gm__ CDataType* z,
                                                  __gm__ BiasType* bias, __gm__ matmul_tiling* tiling_info)
{
    using namespace asc::te;

    // 1. copy tiling information from gm
    matmul_tiling tiling;
    copy_tiling_from_gm(tiling_info, tiling);

    // 2. get SCENARIO_NUM
    constexpr uint32_t scenario_num = SCENARIO_NUM;

    // 3. Calculate iteration information for the current core
    core_iter_info iter_info = calc_core_iter_info(tiling);

    int32_t m = tiling.m;
    int32_t n = tiling.n;
    int32_t k = tiling.k;
    int32_t single_core_m = tiling.single_core_m;
    int32_t single_core_n = tiling.single_core_n;
    int32_t single_core_k = tiling.single_core_k;

    // 4. create gm tensors and slices
    auto gm_ptr_a = make_mem_ptr(x);
    auto gm_ptr_b = make_mem_ptr(y);
    auto gm_ptr_c = make_mem_ptr(z);
    auto gm_ptr_bias = make_mem_ptr(bias);

    auto gm_a = make_tensor(gm_ptr_a, make_frame_layout<nd_ext_layout_ptn>(m, k));
    auto gm_b = make_tensor(gm_ptr_b, make_frame_layout<nd_ext_layout_ptn>(k, n));
    auto gm_c = make_tensor(gm_ptr_c, make_frame_layout<nd_ext_layout_ptn>(m, n));
    auto gm_bias = make_tensor(gm_ptr_bias, make_frame_layout<nd_ext_layout_ptn>(1, n));

    // slice the current single-core data block from the complete gm tensors.
    auto global_a = gm_a.slice(make_coord(iter_info.m_iter_idx * single_core_m, 0),
                             make_shape(iter_info.actual_single_core_m, single_core_k));
    auto global_b = gm_b.slice(make_coord(0, iter_info.n_iter_idx * single_core_n),
                             make_shape(single_core_k, iter_info.actual_single_core_n));
    auto global_c = gm_c.slice(make_coord(iter_info.m_iter_idx * single_core_m, iter_info.n_iter_idx * single_core_n),
                             make_shape(iter_info.actual_single_core_m, iter_info.actual_single_core_n));
    auto global_bias = gm_bias.slice(make_coord(0, iter_info.n_iter_idx * single_core_n),
                                   make_shape(1, iter_info.actual_single_core_n));
    // 5. create l1 tensors
    auto l1a_layout = make_frame_layout<nz_layout_ptn, AType>(base_m * step_m, base_k * step_k);
    auto l1b_layout = make_frame_layout<nz_layout_ptn, BType>(base_k * step_k, base_n * step_n);
    auto l1_bias_layout = make_frame_layout<nd_ext_layout_ptn>(1, base_n * step_n);
    auto ub_layout = make_frame_layout<nd_ext_layout_ptn>(iter_info.actual_single_core_m, iter_info.actual_single_core_n);

    __cbuf__ AType l1a_buf[base_m * step_m * base_k * step_k];
    __cbuf__ BType l1b_buf[base_k * step_k * base_n * step_n];
    __cbuf__ BiasType l1_bias_buf[base_n * step_n];
    __ca__ AType l0a_buf[base_m * base_k];
    __cb__ BType l0b_buf[base_k * base_n];
    __biasbuf__ BiasType l0_bias_buf[base_n];
    __cc__ CDataType l0c_buf[base_m * base_n];
    __ubuf__ CDataType ub_buf[base_m * step_m * base_n * step_n];

    auto l1a_ptr = make_mem_ptr(l1a_buf);
    auto l1b_ptr = make_mem_ptr(l1b_buf);
    auto l1_bias_ptr = make_mem_ptr(l1_bias_buf);
    auto l0a_ptr = make_mem_ptr(l0a_buf);
    auto l0b_ptr = make_mem_ptr(l0b_buf);
    auto l0_bias_ptr = make_mem_ptr(l0_bias_buf);
    auto l0c_ptr = make_mem_ptr(l0c_buf);
    auto ub_ptr = make_mem_ptr(ub_buf);

    auto l1a_tensor = make_tensor(l1a_ptr, l1a_layout);
    auto l1b_tensor = make_tensor(l1b_ptr, l1b_layout);
    auto l1_bias_tensor = make_tensor(l1_bias_ptr, l1_bias_layout);
    auto ub_tensor = make_tensor(ub_ptr, ub_layout);
    auto copy_gm_to_l1_atom = make_copy(copy_gm_to_l1{}, copy_gm_to_l1_trait_default{});
    auto copy_l1_to_bt_atom = make_copy(copy_l1_to_biastable{}, copy_l1_to_biastable_trait_default{});
    auto copy_l1_to_l0a_atom = make_copy(copy_l1_to_l0a{}, copy_l1_to_l0a_trait_default{});
    auto copy_l1_to_l0b_atom = make_copy(copy_l1_to_l0b{}, copy_l1_to_l0b_trait_default{});
    auto copy_l0c_to_gm_atom = make_copy(copy_l0c_to_gm{}, copy_l0c_to_gm_trait_default{});
    auto copy_l0c_to_ub_atom = make_copy(copy_l0c_to_ub{}, copy_l0c_to_ub_trait_custom{});
    auto copy_ub_to_gm_atom = make_copy(copy_ub_to_gm{}, copy_ub_to_gm_trait_default{});
    auto mmad_atom = make_mmad(mmad_operation{}, mmad_trait_default{});

    // 6. Calculate loop counts
    uint32_t m_loop = (iter_info.actual_single_core_m + base_m - 1) / base_m;
    uint32_t n_loop = (iter_info.actual_single_core_n + base_n - 1) / base_n;
    uint32_t k_loop = (single_core_k + base_k - 1) / base_k;
    uint32_t tile_m = (iter_info.actual_single_core_m % base_m != 0) ? iter_info.actual_single_core_m % base_m : base_m;
    uint32_t tile_n = (iter_info.actual_single_core_n % base_n != 0) ? iter_info.actual_single_core_n % base_n : base_n;
    uint32_t tile_k = (single_core_k % base_k != 0) ? single_core_k % base_k : base_k;

    if ASCEND_IS_AIC {
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
        asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);

        // 7. main compute loop
        for (uint32_t i = 0; i < m_loop; i++) {
            uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
            for (uint32_t j = 0; j < n_loop; j++) {
                uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                auto l0c_layout = make_frame_layout<nz_layout_ptn>(cur_m, cur_n);
                auto l0_bias_layout = make_frame_layout<nd_ext_layout_ptn>(1, cur_n);
                auto l0c_tensor = make_tensor(l0c_ptr, l0c_layout);
                auto l0_bias_tensor = make_tensor(l0_bias_ptr, l0_bias_layout);

                // Move bias along the N dimension to L1 and then L0 for the first Mmad of this N tile
                asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
                copy(copy_gm_to_l1_atom, l1_bias_tensor, global_bias,
                    zero_coord, make_coord(0, j * base_n), make_shape(1, cur_n));
                asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
                asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID1);
                asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
                copy(copy_l1_to_bt_atom, l0_bias_tensor, l1_bias_tensor,
                    zero_coord, make_coord(0, 0), make_shape(1, cur_n));
                asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID1);
                asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);

                for (uint32_t k_iter = 0; k_iter < k_loop; k_iter++) {
                    uint16_t cur_k = (k_iter + 1 == k_loop) ? tile_k : base_k;
                    auto l0a_layout = make_frame_layout<nz_layout_ptn, AType>(cur_m, cur_k);
                    auto l0b_layout = make_frame_layout<zn_layout_ptn, BType>(cur_k, cur_n);
                    auto l0a_tensor = make_tensor(l0a_ptr, l0a_layout);
                    auto l0b_tensor = make_tensor(l0b_ptr, l0b_layout);

                    // gm -> l1
                    if (k_iter % step_k == 0) {
                        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
                        copy(copy_gm_to_l1_atom, l1a_tensor, global_a,
                            zero_coord, make_coord(i * base_m, k_iter * base_k * step_k), make_shape(base_m, base_k * step_k));
                        copy(copy_gm_to_l1_atom, l1b_tensor, global_b,
                            zero_coord, make_coord(k_iter * base_k * step_k, j * base_n), make_shape(base_k * step_k, base_n));
                        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
                        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
                    }

                    // l1 -> L0
                    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
                    copy(copy_l1_to_l0a_atom, l0a_tensor, l1a_tensor,
                        zero_coord, make_coord(0, k_iter % step_k * base_k), make_shape(cur_m, cur_k));
                    copy(copy_l1_to_l0b_atom, l0b_tensor, l1b_tensor,
                        zero_coord, make_coord(k_iter % step_k * base_k, 0), make_shape(cur_k, cur_n));
                    if ((k_iter + 1) % step_k == 0) {
                        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
                    }
                    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
                    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

                    if (k_iter % step_k == 0) {
                        asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
                    }

                    // mmad compute
                    if (k_iter == 0) {
                        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID1);
                        mmad(mmad_atom.with(mmad_params(
                                 cur_m, cur_n, cur_k, scenario_num == 1 ? ((k_iter == k_loop - 1) ? 3 : 2) : 0, true)),
                             l0c_tensor, l0a_tensor, l0b_tensor, l0_bias_tensor);
                        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID1);
                    } else {
                        mmad(mmad_atom.with(mmad_params(
                                 cur_m, cur_n, cur_k, scenario_num == 1 ? ((k_iter == k_loop - 1) ? 3 : 2) : 0, false)),
                             l0c_tensor, l0a_tensor, l0b_tensor);
                    }
                    if (k_iter == k_loop - 1) {
                        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
                    }
                    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
                }

                asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
                if constexpr (scenario_num < 2) {
                    // l0c -> gm
                    fixpipe_params params;
                    if constexpr (scenario_num == 1) {
                        params.unit_flag = 3;
                    }
                    copy(copy_l0c_to_gm_atom.with(params), global_c, l0c_tensor,
                        make_coord(i * base_m, j * base_n), zero_coord, make_shape(cur_m, cur_n));
                } else {
                    // l0c -> ub
                    if constexpr (scenario_num == 2) {
                        // Split along the M dimension
                        copy(copy_l0c_to_ub_atom, ub_tensor, l0c_tensor,
                            make_coord(i * base_m / 2, j * base_n), zero_coord, make_shape(cur_m, cur_n));
                    } else if constexpr (scenario_num == 3) {
                        // Split along the N dimension
                        copy(copy_l0c_to_ub_atom, ub_tensor, l0c_tensor,
                            make_coord(i * base_m, j * base_n / 2), zero_coord, make_shape(cur_m, cur_n));
                    }
                    if (i + 1 == m_loop && j + 1 == n_loop) {
                        // Notify aiv only after all l0c tiles have reached ub, then wait until the notification is consumed.
                        asc_sync_block_arrive(PIPE_FIX, 0x8);
                        asc_sync_block_wait(PIPE_S, 0x9);
                    }
                }
                asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
            }
        }

        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID1);
    }

    if ASCEND_IS_AIV {
        if constexpr (scenario_num > 1) {
            asc_sync_block_wait(PIPE_S, 0x8);
            // keep aic alive until both aiv subcores have observed that ub is ready.
            asc_sync_block_arrive(PIPE_MTE3, 0x9);
            for (uint32_t i = 0; i < m_loop; i++) {
                uint16_t cur_m = (i + 1 == m_loop) ? tile_m : base_m;
                for (uint32_t j = 0; j < n_loop; j++) {
                    uint16_t cur_n = (j + 1 == n_loop) ? tile_n : base_n;
                    if constexpr (scenario_num == 2) {
                        // Split along the M dimension
                        copy(copy_ub_to_gm_atom,
                             global_c.slice(make_coord(i * base_m + asc_get_sub_block_id() * cur_m / 2, j * base_n),
                                           make_shape(cur_m / 2, cur_n)),
                             ub_tensor.slice(make_coord(i * base_m / 2, j * base_n), make_shape(cur_m / 2, cur_n)));
                    } else if constexpr (scenario_num == 3) {
                        // Split along the N dimension
                        copy(copy_ub_to_gm_atom,
                             global_c.slice(make_coord(i * base_m, j * base_n + asc_get_sub_block_id() * cur_n / 2),
                                           make_shape(cur_m, cur_n / 2)),
                             ub_tensor.slice(make_coord(i * base_m, j * base_n / 2), make_shape(cur_m, cur_n / 2)));
                    }
                }
            }
        }
    }
}

int32_t main(int32_t argc, char* argv[])
{
    using a_type = half;
    using b_type = half;
    using c_data_type = float;
    using bias_type = float;

    // Tiling info filled into struct (dynamic at runtime)
    matmul_tiling tiling;
    tiling.m = 1024;
    tiling.n = 1024;
    tiling.k = 256;
    tiling.single_core_m = 256;
    tiling.single_core_n = 128;
    tiling.single_core_k = 256;

    // static tiling parameters (compile-time constants)
    constexpr int32_t base_m = 128;
    constexpr int32_t base_n = 128;
    constexpr int32_t base_k = 64;
    constexpr int32_t step_m = 1;
    constexpr int32_t step_n = 1;
    constexpr int32_t step_k = 4;

    constexpr uint32_t num_blocks = 32;

    size_t param_1_file_size = tiling.m * tiling.k * sizeof(a_type);
    size_t param_2_file_size = tiling.n * tiling.k * sizeof(b_type);
    size_t param_3_file_size = tiling.m * tiling.n * sizeof(c_data_type);
    size_t param_4_file_size = tiling.n * sizeof(bias_type);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t *x_host, *y_host, *z_host, *bias_host;
    a_type *x_device;
    b_type *y_device;
    c_data_type *z_device;
    bias_type *bias_device;

    aclrtMallocHost((void**)(&x_host), param_1_file_size);
    aclrtMallocHost((void**)(&y_host), param_2_file_size);
    aclrtMallocHost((void**)(&z_host), param_3_file_size);
    aclrtMallocHost((void**)(&bias_host), param_4_file_size);
    aclrtMalloc((void**)&x_device, param_1_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, param_2_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, param_3_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bias_device, param_4_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    read_file("./input/input_x.bin", param_1_file_size, x_host, param_1_file_size);
    read_file("./input/input_y.bin", param_2_file_size, y_host, param_2_file_size);
    read_file("./input/bias.bin", param_4_file_size, bias_host, param_4_file_size);

    aclrtMemcpy(x_device, param_1_file_size, x_host, param_1_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(y_device, param_2_file_size, y_host, param_2_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bias_device, param_4_file_size, bias_host, param_4_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    // Allocate and copy tiling info struct to device
    matmul_tiling *tiling_host;
    matmul_tiling *tiling_device;
    aclrtMallocHost((void**)(&tiling_host), sizeof(matmul_tiling));
    aclrtMalloc((void**)&tiling_device, sizeof(matmul_tiling), ACL_MEM_MALLOC_HUGE_FIRST);
    *tiling_host = tiling;
    aclrtMemcpy(tiling_device, sizeof(matmul_tiling), tiling_host, sizeof(matmul_tiling), ACL_MEMCPY_HOST_TO_DEVICE);

    copy_coord_shape_tensor_api<a_type, b_type, c_data_type, bias_type,
                              base_m, base_n, base_k, step_m, step_n, step_k>
        <<<num_blocks, nullptr, stream>>>(x_device, y_device, z_device, bias_device, tiling_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(z_host, param_3_file_size, z_device, param_3_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", z_host, param_3_file_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFree(bias_device);
    aclrtFree(tiling_device);
    aclrtFreeHost(x_host);
    aclrtFreeHost(y_host);
    aclrtFreeHost(z_host);
    aclrtFreeHost(bias_host);
    aclrtFreeHost(tiling_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();

    return 0;
}
