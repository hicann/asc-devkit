#include <cstdint>
#include "acl/acl.h"
#include "data_utils.h"
#include "kernel_operator.h"
#include "utils/debug/asc_dump.h"

namespace {
constexpr uint32_t kTotal = 65536;
constexpr uint32_t kTile = 16384;
constexpr float kScalar = 1.0f;

class LargeTensorDump {
public:
    __aicore__ inline void Init(GM_ADDR input, GM_ADDR output)
    {
        input_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(input), kTotal);
        output_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(output), kTotal);
    }

    __aicore__ inline void Process()
    {
        constexpr uint32_t ubDesc = 100;
        constexpr uint32_t gmDesc = 200;
        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        auto input = ubAllocator.Alloc<float, kTile>();
        auto output = ubAllocator.Alloc<float, kTile>();
        for (uint32_t offset = 0; offset < kTotal; offset += kTile) {
            AscendC::DataCopy(input, input_[offset], kTile);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::Adds(output, input, kScalar, kTile);
            // Complete vector writes before asc_dump reads the UB tensor.
            AscendC::PipeBarrier<PIPE_ALL>();
            // Tensor data segmentation is handled by the framework.
            if (offset == 0) {
                asc_dump<float>(reinterpret_cast<__ubuf__ float*>(output.GetPhyAddr()), ubDesc, kTile);
            }
            AscendC::DataCopy(output_[offset], output, kTile);
            // Finish the copy-out before reusing the UB tensors in the next tile.
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        asc_dump<float>(const_cast<__gm__ float*>(output_.GetPhyAddr()), gmDesc, kTotal);
        AscendC::PipeBarrier<PIPE_ALL>();
    }

private:
    AscendC::GlobalTensor<float> input_;
    AscendC::GlobalTensor<float> output_;
};

} // namespace

__global__ __vector__ void large_tensor_dump(GM_ADDR input, GM_ADDR output)
{
    AscendC::InitSocState();
    LargeTensorDump op;
    op.Init(input, output);
    op.Process();
}

int32_t main(int32_t argc, char* argv[])
{
    aclInit(nullptr);
    int32_t deviceId = 0;
    aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    size_t fileSize = kTotal * sizeof(float);
    uint8_t* inputHost = nullptr;
    uint8_t* inputDevice = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&inputHost), fileSize);
    aclrtMalloc(reinterpret_cast<void**>(&inputDevice), fileSize, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/input.bin", fileSize, inputHost, fileSize);
    aclrtMemcpy(inputDevice, fileSize, inputHost, fileSize, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* outputHost = nullptr;
    uint8_t* outputDevice = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&outputHost), fileSize);
    aclrtMalloc(reinterpret_cast<void**>(&outputDevice), fileSize, ACL_MEM_MALLOC_HUGE_FIRST);

    constexpr uint32_t numBlocks = 1;
    large_tensor_dump<<<numBlocks, nullptr, stream>>>(inputDevice, outputDevice);
    aclrtSynchronizeStream(stream);
    aclrtMemcpy(outputHost, fileSize, outputDevice, fileSize, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", outputHost, fileSize);

    aclrtFree(inputDevice);
    aclrtFreeHost(inputHost);
    aclrtFree(outputDevice);
    aclrtFreeHost(outputHost);
    aclrtDestroyStream(stream);
    aclrtResetDevice(deviceId);
    aclFinalize();
    return 0;
}
