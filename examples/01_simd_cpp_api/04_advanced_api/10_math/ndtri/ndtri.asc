/* !
 * \file ndtri.asc
 * \brief 本用例用于验证Ndtri高阶API的功能与性能。
 */

#include <algorithm>
#include <cmath>
#include <cstring>

#include "acl/acl.h"
#define CANN_ASC_USE_EXPERIMENTAL
#include "adv_api/experimental/ndtri.h"
#include "data_utils.h"
#include "kernel_operator.h"

#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif

struct NdtriCustomTilingData {
    uint32_t totalLength;
};

void GenerateTilingData(uint8_t* tilingBuf, const uint32_t totalLength, const uint32_t coreNum)
{
    (void)coreNum;
    NdtriCustomTilingData* tiling = reinterpret_cast<NdtriCustomTilingData*>(tilingBuf);

    tiling->totalLength = totalLength;
}

namespace MyCustomKernel {

/**
 * @brief Ndtri核函数实现类，演示Ndtri API的使用场景
 * @tparam T 数据类型
 */
template <typename T>
class KernelNdtri {
public:
    static constexpr uint32_t TILE_LENGTH = 32768;

    __aicore__ inline KernelNdtri() {}
    __aicore__ inline void Init(
        __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* sourceAfter, NdtriCustomTilingData tilingData,
        AscendC::TPipe* pipeIn)
    {
        ASCENDC_ASSERT(AscendC::GetBlockNum() != 0, { KERNEL_LOG(KERNEL_ERROR, "block dim can not be zero!"); });
        this->blockLength = tilingData.totalLength;
        this->tileLength = this->blockLength < TILE_LENGTH ? this->blockLength : TILE_LENGTH;

        // UB Buffer 要求 32B 对齐：计算对齐后的元素个数，用于 InitBuffer 分配与 DataCopy 搬运
        constexpr uint32_t oneBlkSize = 32 / sizeof(T);
        this->alignLength = (this->tileLength + oneBlkSize - 1) / oneBlkSize * oneBlkSize;

        xGm.SetGlobalBuffer((__gm__ T*)x, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y, this->blockLength);
        sourceAfterGm.SetGlobalBuffer((__gm__ T*)sourceAfter, this->blockLength);

        pipe = pipeIn;
        pipe->InitBuffer(inQueueX, 1, this->alignLength * sizeof(T));
        pipe->InitBuffer(outQueueY, 1, this->alignLength * sizeof(T));
    }

    __aicore__ inline void ProcessPrecision()
    {
        for (uint32_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            uint32_t count = Min(this->tileLength, this->blockLength - offset);
            CopyIn(offset, count);
            ComputeOnce(offset, count);
            CopyOut(offset, count);
        }
    }

    __aicore__ inline void ProcessCopyOnly()
    {
        for (uint32_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            uint32_t count = Min(this->tileLength, this->blockLength - offset);
            CopyIn(offset, count);
            CopyOutInput(offset, count);
        }
    }

    __aicore__ inline void ProcessInPlace()
    {
        for (uint32_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            uint32_t count = Min(this->tileLength, this->blockLength - offset);
            CopyIn(offset, count);
            AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
            xLocal.SetSize(count);
            AscendC::experimental::Ndtri<T, false>(xLocal, xLocal);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            AscendC::DataCopyPad(yGm[offset], xLocal, copyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
            inQueueX.FreeTensor(xLocal);
        }
    }

    __aicore__ inline void ProcessComputeLoop()
    {
        for (uint32_t offset = 0; offset < this->blockLength; offset += this->tileLength) {
            uint32_t count = Min(this->tileLength, this->blockLength - offset);
            CopyIn(offset, count);
            ComputeLoop(count);
            CopyOut(offset, count);
        }
    }

private:
    __aicore__ inline uint32_t Min(uint32_t lhs, uint32_t rhs) const { return lhs < rhs ? lhs : rhs; }

    __aicore__ inline void CopyIn(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<T> padParams{false, 0, 0, 0};
        AscendC::DataCopyPad(xLocal, xGm[offset], copyParams, padParams);
        inQueueX.EnQue(xLocal);
    }
    __aicore__ inline void ComputeOnce(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        xLocal.SetSize(count);
        yLocal.SetSize(count);
#if API_MODE == 1
        AscendC::experimental::Ndtri<T, false>(yLocal, xLocal, count);
#elif API_MODE == 2
        AscendC::experimental::Ndtri<T, false>(yLocal, xLocal);
#else
        AscendC::experimental::Ndtri<T, false>(yLocal, xLocal, count);
#endif
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(sourceAfterGm[offset], xLocal, copyParams);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void ComputeLoop(uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        xLocal.SetSize(count);
        yLocal.SetSize(count);
        for (int32_t j = 0; j < 1000; j++) {
            AscendC::experimental::Ndtri<T, false>(yLocal, xLocal, count);
        }
        outQueueY.EnQue<T>(yLocal);
        inQueueX.FreeTensor(xLocal);
    }
    __aicore__ inline void CopyOut(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm[offset], yLocal, copyParams);
        outQueueY.FreeTensor(yLocal);
    }
    __aicore__ inline void CopyOutInput(uint32_t offset, uint32_t count)
    {
        AscendC::LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        AscendC::DataCopyExtParams copyParams{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        AscendC::DataCopyPad(yGm[offset], xLocal, copyParams);
        inQueueX.FreeTensor(xLocal);
    }

private:
    AscendC::TPipe* pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inQueueX;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueueY;
    AscendC::GlobalTensor<T> xGm;
    AscendC::GlobalTensor<T> yGm;
    AscendC::GlobalTensor<T> sourceAfterGm;

    uint32_t blockLength = 0;
    uint32_t tileLength = 0;
    uint32_t alignLength = 0;
};
} // namespace MyCustomKernel

__vector__ __global__ void ndtri_custom(
    __gm__ uint8_t* x, __gm__ uint8_t* y, __gm__ uint8_t* sourceAfter, NdtriCustomTilingData tiling)
{
    if ASCEND_IS_AIC {
        return;
    }
    AscendC::TPipe pipe;
    MyCustomKernel::KernelNdtri<float> op;
    op.Init(x, y, sourceAfter, tiling, &pipe);
#if TEST_MODE == 1
#if API_MODE == 3
    op.ProcessInPlace();
#else
    op.ProcessPrecision();
#endif
#elif TEST_MODE == 2
    op.ProcessCopyOnly();
#elif TEST_MODE == 3
    op.ProcessComputeLoop();
#else
#error "TEST_MODE must be 1, 2, or 3"
#endif
}

namespace {
constexpr uint32_t USED_CORE_NUM = 1;
constexpr uint32_t TOTAL_LENGTH = SIZE;
} // namespace

static bool CompareResult(const void* outputData, uint32_t outSize)
{
    void* goldenData = nullptr;
    aclError ret = aclrtMallocHost(&goldenData, outSize);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMallocHost for golden data failed: %d\n", ret);
        return false;
    }
    size_t goldenSize = outSize;
    bool readSuccess = ReadFile("./output/golden.bin", goldenSize, goldenData, goldenSize);
    if (!readSuccess || goldenSize != outSize) {
        printf("[ERROR] ReadFile golden.bin failed or has unexpected size: %zu, expected: %u\n", goldenSize, outSize);
        ret = aclrtFreeHost(goldenData);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFreeHost for golden data failed: %d\n", ret);
        }
        return false;
    }
    printf("ReadFile golden.bin success!\n");
    constexpr float EPS = 1e-4;
    constexpr float ERR_RATIO = 1e-4;
    int64_t wrongNum = 0;
    int64_t totalNum = outSize / sizeof(float);
    float maxAbsError = 0.0f;
    float maxRelError = 0.0f;
    size_t maxErrorIndex = 0;

    for (size_t i = 0; i < totalNum; i++) {
        float a = (reinterpret_cast<const float*>(outputData))[i];
        float b = (reinterpret_cast<const float*>(goldenData))[i];
        bool isWrong = false;
        if (std::isnan(b)) {
            isWrong = !std::isnan(a);
        } else if (std::isinf(b)) {
            isWrong = !std::isinf(a) || std::signbit(a) != std::signbit(b);
        } else if (std::isnan(a)) {
            isWrong = true;
        } else {
            float absError = std::abs(a - b);
            float relError = absError / std::max(std::abs(b), EPS);
            if (absError > maxAbsError) {
                maxAbsError = absError;
                maxErrorIndex = i;
            }
            maxRelError = std::max(maxRelError, relError);
            isWrong = absError > EPS && relError > EPS;
        }
        if (isWrong) {
            printf("CompareResult golden.bin failed output is %lf, golden is %lf\n", a, b);
            wrongNum++;
        }
    }
    ret = aclrtFreeHost(goldenData);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtFreeHost for golden data failed: %d\n", ret);
        return false;
    }
    float wrongRatio = (totalNum > 0) ? static_cast<float>(wrongNum) / totalNum : 0.0f;
    printf("wrong elements: %ld/%ld, error ratio: %.9f, tolerance: %.9f\n", wrongNum, totalNum, wrongRatio, ERR_RATIO);
    printf(
        "max absolute error: %.9g, max relative error: %.9g, max absolute error index: %zu\n", maxAbsError, maxRelError,
        maxErrorIndex);
    if (wrongRatio > ERR_RATIO) {
        return false;
    }
    printf("CompareResult golden.bin success!\n");
    return true;
}

static bool CompareSource(const void* inputData, const void* sourceAfterData, uint32_t dataSize)
{
    if (std::memcmp(inputData, sourceAfterData, dataSize) != 0) {
        const float* input = reinterpret_cast<const float*>(inputData);
        const float* sourceAfter = reinterpret_cast<const float*>(sourceAfterData);
        const size_t elementCount = dataSize / sizeof(float);
        for (size_t i = 0; i < elementCount; ++i) {
            if (std::memcmp(input + i, sourceAfter + i, sizeof(float)) != 0) {
                printf("source data changed at index %zu: before=%f, after=%f\n", i, input[i], sourceAfter[i]);
                break;
            }
        }
        return false;
    }
    printf("source data integrity check success!\n");
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    size_t inputSize = TOTAL_LENGTH * sizeof(float);
    size_t outputSize = inputSize;
    NdtriCustomTilingData tiling = {TOTAL_LENGTH};

    int32_t deviceId = 0;
    aclrtStream stream = nullptr;
    uint8_t* xHost = nullptr;
    uint8_t* yHost = nullptr;
    uint8_t* sourceAfterHost = nullptr;
    uint8_t* xDevice = nullptr;
    uint8_t* yDevice = nullptr;
    uint8_t* sourceAfterDevice = nullptr;
    bool initialized = false;
    bool deviceSet = false;
    bool testResult = false;
    bool goldenResult = true;
    bool sourceResult = true;
    size_t inputFileSize = 0;
    aclError ret = aclInit(nullptr);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclInit failed: %d\n", ret);
        goto cleanup;
    }
    initialized = true;
    ret = aclrtSetDevice(deviceId);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtSetDevice failed: %d\n", ret);
        goto cleanup;
    }
    deviceSet = true;
    ret = aclrtCreateStream(&stream);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtCreateStream failed: %d\n", ret);
        goto cleanup;
    }

    ret = aclrtMallocHost(reinterpret_cast<void**>(&xHost), inputSize);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMallocHost for xHost failed: %d\n", ret);
        goto cleanup;
    }
    ret = aclrtMallocHost(reinterpret_cast<void**>(&yHost), outputSize);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMallocHost for yHost failed: %d\n", ret);
        goto cleanup;
    }
    ret = aclrtMallocHost(reinterpret_cast<void**>(&sourceAfterHost), inputSize);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMallocHost for sourceAfterHost failed: %d\n", ret);
        goto cleanup;
    }

    ret = aclrtMalloc(reinterpret_cast<void**>(&xDevice), inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMalloc for xDevice failed: %d\n", ret);
        goto cleanup;
    }
    ret = aclrtMalloc(reinterpret_cast<void**>(&yDevice), outputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMalloc for yDevice failed: %d\n", ret);
        goto cleanup;
    }
    ret = aclrtMalloc(reinterpret_cast<void**>(&sourceAfterDevice), inputSize, ACL_MEM_MALLOC_HUGE_FIRST);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMalloc for sourceAfterDevice failed: %d\n", ret);
        goto cleanup;
    }

    inputFileSize = inputSize;
    if (!ReadFile("./input/input_x.bin", inputFileSize, xHost, inputSize) || inputFileSize != inputSize) {
        printf("[ERROR] Read input file failed or has unexpected size: %zu, expected: %zu\n", inputFileSize, inputSize);
        goto cleanup;
    }

    // Copy host memory to device memory
    ret = aclrtMemcpy(xDevice, inputSize, xHost, inputSize, ACL_MEMCPY_HOST_TO_DEVICE);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMemcpy input failed: %d\n", ret);
        goto cleanup;
    }

    // Execute the kernel
    ndtri_custom<<<USED_CORE_NUM, nullptr, stream>>>(xDevice, yDevice, sourceAfterDevice, tiling);

    // Wait for the stop event to complete
    ret = aclrtSynchronizeStream(stream);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtSynchronizeStream failed: %d\n", ret);
        goto cleanup;
    }

    // Copy result to host memory and write to output file
    ret = aclrtMemcpy(yHost, outputSize, yDevice, outputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMemcpy output failed: %d\n", ret);
        goto cleanup;
    }
    if (!WriteFile("./output/output.bin", yHost, outputSize)) {
        printf("[ERROR] Write output file failed\n");
        goto cleanup;
    }

    // Compare the result with the golden result（仅功能验证模式进行精度对比）
#if TEST_MODE == 1
    goldenResult = CompareResult(yHost, outputSize);
#if API_MODE != 3
    ret = aclrtMemcpy(sourceAfterHost, inputSize, sourceAfterDevice, inputSize, ACL_MEMCPY_DEVICE_TO_HOST);
    if (ret != ACL_SUCCESS) {
        printf("[ERROR] aclrtMemcpy source data failed: %d\n", ret);
        goto cleanup;
    }
    sourceResult = CompareSource(xHost, sourceAfterHost, inputSize);
#endif
#endif

    testResult = goldenResult && sourceResult;

cleanup:
    if (xDevice != nullptr) {
        ret = aclrtFree(xDevice);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFree for xDevice failed: %d\n", ret);
            testResult = false;
        }
    }
    if (yDevice != nullptr) {
        ret = aclrtFree(yDevice);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFree for yDevice failed: %d\n", ret);
            testResult = false;
        }
    }
    if (sourceAfterDevice != nullptr) {
        ret = aclrtFree(sourceAfterDevice);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFree for sourceAfterDevice failed: %d\n", ret);
            testResult = false;
        }
    }
    if (xHost != nullptr) {
        ret = aclrtFreeHost(xHost);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFreeHost for xHost failed: %d\n", ret);
            testResult = false;
        }
    }
    if (yHost != nullptr) {
        ret = aclrtFreeHost(yHost);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFreeHost for yHost failed: %d\n", ret);
            testResult = false;
        }
    }
    if (sourceAfterHost != nullptr) {
        ret = aclrtFreeHost(sourceAfterHost);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtFreeHost for sourceAfterHost failed: %d\n", ret);
            testResult = false;
        }
    }
    if (stream != nullptr) {
        ret = aclrtDestroyStream(stream);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtDestroyStream failed: %d\n", ret);
            testResult = false;
        }
    }
    if (deviceSet) {
        ret = aclrtResetDevice(deviceId);
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclrtResetDevice failed: %d\n", ret);
            testResult = false;
        }
    }
    if (initialized) {
        ret = aclFinalize();
        if (ret != ACL_SUCCESS) {
            printf("[ERROR] aclFinalize failed: %d\n", ret);
            testResult = false;
        }
    }

#if TEST_MODE == 1
    if (testResult) {
        printf("test pass!\n");
    } else {
        printf("test failed!\n");
    }
#endif
    return testResult ? 0 : 1;
}
