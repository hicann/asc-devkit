/* !
 * \file lambda_operator_hybrid.asc
 * \brief 以LeakyReLU-Affine融合算子与Clamp算子为载体的混合编程Lambda捕获实战样例，
 *        与纯SIMT版样例（examples/03_simt_api/02_features/02_language_features/
 *        00_lambda_operator_capture）呼应，展示同一算子在SIMD与SIMT混合编程下的Lambda组织方式：
 *        1. SIMT VF内lambda需标记__simt_callee__：值捕获LeakyReLU斜率与仿射系数完成激活+仿射，
 *           引用捕获负数计数器完成同遍历统计（每线程计数经原子累加合并为单核计数）；
 *        2. SIMD VF内lambda需标记__simd_callee__：值捕获Clamp上下界，标量结果在矢量循环前算好，
 *           作为矢量intrinsics的操作数进入连续向量计算；
 *        3. 核函数体内（SIMD侧scalar代码）lambda需标记__aicore__：按核号计算本核数据分片，
 *           供SIMT VF与SIMD VF复用。
 * 标记选择规则见《Lambda表达式》文档混合编程章节；与纯SIMT版对照，本样例的线程映射框架
 * elementwise_transform位于SIMT VF内且以__simt_callee__标记内联辅助函数形式提供。
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

namespace {
// 每核处理元素数：SIMT VF启动同数线程，每线程处理1个元素
constexpr uint32_t THREAD_COUNT = 1024;
// 启动Vector Core数
constexpr uint32_t NUM_BLOCKS = 8;
// 总数据量 = 核数 * 每核元素数
constexpr uint32_t TOTAL_LENGTH = NUM_BLOCKS * THREAD_COUNT;

// 算子超参：LeakyReLU负区斜率、仿射变换系数、Clamp上下界
constexpr float ALPHA = 0.1f;
constexpr float SCALE = 2.0f;
constexpr float BIAS = 1.0f;
constexpr float CLAMP_LO = -2.0f;
constexpr float CLAMP_HI = 3.0f;

// Host侧以同一公式生成输入（取值[-5, 5]，覆盖正数/负数/越界裁剪点），保证期望值可精确复算
inline float make_input(uint32_t i) { return static_cast<float>((i * 7U) % 11U) - 5.0f; }
} // namespace

/*
 * 通用逐元素变换框架（SIMT VF内）：只负责线程保护与逐元素分发，不感知任何算子语义。
 * 与纯SIMT版模板框架对照：混合编程下lambda必须标记callee属性，闭包经模板形参传入
 * __simt_callee__框架函数。
 */
template <typename Op>
__simt_callee__ inline void elementwise_simt(Op op, __ubuf__ float* output, float v)
{
    output[threadIdx.x] = op(v);
}

/*
 * SIMT VF函数：LeakyReLU-Affine融合 + 负数统计。
 *
 * 本核输入分片已由核函数搬入UB（input形参即该UB副本首地址），输出写入UB连续区域供MTE
 * 搬出使用。融合闭包与统计闭包均定义在本函数体内并标记__simt_callee__：
 *   - leaky/affine 值捕获超参；
 *   - tally 引用捕获线程私有计数器；
 *   - fused 引用捕获三个内层闭包，一次遍历完成"统计-激活-仿射"；
 *   - 每线程计数经asc_atomic_add原子累加到本核计数器neg_count（__gm__指针）。
 */
__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_leaky_affine_vf(
    __ubuf__ float* input, __ubuf__ float* output, __gm__ uint32_t* neg_count, uint32_t count, float alpha, float scale,
    float bias)
{
    if (threadIdx.x >= count) {
        return;
    }
    float v = input[threadIdx.x];

    // 值捕获：超参拷贝进闭包，框架函数elementwise_simt无需为算子参数增加形参
    auto leaky = [alpha](float x) __simt_callee__ { return x > 0.0f ? x : alpha * x; };
    auto affine = [scale, bias](float x) __simt_callee__ { return x * scale + bias; };
    // 引用捕获：线程私有负数计数器被统计闭包原地更新
    uint32_t neg_local = 0;
    auto tally = [&neg_local](float x) __simt_callee__ {
        if (x < 0.0f) {
            ++neg_local;
        }
    };
    // 闭包组合：外层闭包引用捕获三个内层闭包，单遍完成融合算子
    auto fused = [&tally, &leaky, &affine](float x) __simt_callee__ {
        tally(x);
        return affine(leaky(x));
    };
    elementwise_simt(fused, output, v);
    // 线程级计数原子合并为本核计数（返回值参与*0防优化，保证累加不被裁剪）
    asc_atomic_add(neg_count, neg_local);
}

/*
 * SIMD VF函数：Clamp算子（连续向量计算）。
 *
 * __simd_callee__ lambda值捕获上下界：标量比较在矢量循环前逐元素完成、结果作为乘数掩码，
 * 演示"lambda标量逻辑与矢量intrinsics结合"的标准数据流：callee-lambda的标量结果参与矢量
 * 计算时，先在矢量循环外算好再进入向量计算。
 */
__simd_vf__ inline void simd_clamp_vf(__ubuf__ float* output, __ubuf__ float* input, uint32_t count, float lo, float hi)
{
    constexpr uint32_t one_repeat_size = asc_get_vf_len() / sizeof(float);
    uint16_t loop_times = (count + one_repeat_size - 1) / one_repeat_size;

    vector_float src_reg;
    vector_float dst_reg;
    vector_bool mask_reg;
    vector_float lo_reg;
    vector_float hi_reg;

    // lambda标量逻辑在矢量循环前完成：生成上下界矢量寄存器
    auto bound = [lo, hi](float x) __simd_callee__ { return x < lo ? lo : (x > hi ? hi : x); };
    (void)bound(0.0f); // 闭包仅作语义说明载体，实际边界由下述duplicate进入矢量路径

    asc_duplicate_scalar(lo_reg, lo);
    asc_duplicate_scalar(hi_reg, hi);
    for (uint16_t i = 0; i < loop_times; i++) {
        mask_reg = asc_update_mask_b32(count);
        asc_loadalign(src_reg, input + i * one_repeat_size);
        // 逐元素取max(lo, min(hi, x))完成裁剪：先min后max
        asc_min(dst_reg, src_reg, hi_reg, mask_reg);
        asc_max(src_reg, dst_reg, lo_reg, mask_reg);
        asc_storealign(output + i * one_repeat_size, src_reg, mask_reg);
    }
}

/*
 * 入口核函数（SIMD侧scalar代码）：
 * 1. 核函数体内lambda标记__aicore__：按核号计算本核数据分片；
 * 2. 将本核GM输入分片搬入UB，SIMT VF与SIMD VF均以该UB副本为输入；
 * 3. SIMT VF完成LeakyReLU-Affine融合与负数统计，SIMD VF完成Clamp（均读UB写UB）；
 * 4. 流水同步后将两份UB结果搬回GM；neg_count按核偏移写入，各核独立计数。
 */
__global__ __vector__ void lambda_operator_hybrid_kernel(
    __gm__ float* input, __gm__ float* y_leaky_affine, __gm__ float* y_clamp, __gm__ uint32_t* neg_count,
    uint32_t total_length, float alpha, float scale, float bias, float lo, float hi)
{
    asc_init();
    // 混合编程核函数体内lambda：标记__aicore__，按核号计算本核分片（返回每核元素数）
    auto per_block = [total_length]() __aicore__ { return total_length / block_num; };
    uint32_t count = per_block();

    // 动态UB布局：本核输入分片 + 两段输出（融合结果、Clamp结果），单段extern数组内按偏移划分
    extern __ubuf__ float dyn_ub[];
    __ubuf__ float* ub_in = dyn_ub;
    __ubuf__ float* ub_leaky = dyn_ub + count;
    __ubuf__ float* ub_clamp = dyn_ub + count * 2;

    // 将本核GM输入分片搬入UB：SIMT与SIMD两阶段均以该副本为输入，Clamp作用于原始输入。
    asc_copy_gm2ub_align(
        ub_in, input + block_idx * count, 1, count * sizeof(float), 0, 0, false, asc_load_l2_cache_mode::NOTALLOC_KEEP,
        0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    // SIMT阶段：融合算子 + 负数统计，输出写UB；neg_count按核偏移，各核累加到自己的槽位
    asc_vf_call<simt_leaky_affine_vf>(
        dim3(THREAD_COUNT), ub_in, ub_leaky, neg_count + block_idx, count, alpha, scale, bias);
    // SIMD阶段：Clamp，UB到UB的连续向量计算
    asc_vf_call<simd_clamp_vf>(ub_clamp, ub_in, count, lo, hi);
    // 同步Vector计算流水和MTE3搬出流水，确保UB结果写入后再搬运到GM
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(
        y_leaky_affine + block_idx * count, ub_leaky, 1, count * sizeof(float),
        asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, 0, 0);
    asc_copy_ub2gm_align(
        y_clamp + block_idx * count, ub_clamp, 1, count * sizeof(float), asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        0, 0);
}

namespace {

// Host侧复算期望值：与核内Lambda完全相同的公式、相同的核分片映射
bool verify_result(
    const std::vector<float>& input, const std::vector<float>& yLeakyAffine, const std::vector<float>& yClamp,
    const std::vector<uint32_t>& negCountPerBlock, uint32_t& negTotal)
{
    constexpr float tolerance = 1e-5f;
    bool ok = true;
    uint32_t printed = 0;

    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        const float x = input[i];
        const float expectLeakyAffine = (x > 0.0f ? x : ALPHA * x) * SCALE + BIAS;
        const float expectClamp = x < CLAMP_LO ? CLAMP_LO : (x > CLAMP_HI ? CLAMP_HI : x);
        if (std::fabs(yLeakyAffine[i] - expectLeakyAffine) >
            tolerance * std::fmax(1.0f, std::fabs(expectLeakyAffine))) {
            ok = false;
            if (printed < 8) {
                std::printf("leaky-affine mismatch @%u: %f expect %f\n", i, yLeakyAffine[i], expectLeakyAffine);
                ++printed;
            }
        }
        if (std::fabs(yClamp[i] - expectClamp) > tolerance * std::fmax(1.0f, std::fabs(expectClamp))) {
            ok = false;
            if (printed < 8) {
                std::printf("clamp mismatch @%u: %f expect %f\n", i, yClamp[i], expectClamp);
                ++printed;
            }
        }
    }

    // 负数计数期望值：按核分片复算（每核count个连续元素）
    negTotal = 0;
    const uint32_t count = TOTAL_LENGTH / NUM_BLOCKS;
    for (uint32_t b = 0; b < NUM_BLOCKS; ++b) {
        uint32_t expectCount = 0;
        for (uint32_t i = b * count; i < (b + 1) * count; ++i) {
            if (input[i] < 0.0f) {
                ++expectCount;
            }
        }
        negTotal += negCountPerBlock[b];
        if (negCountPerBlock[b] != expectCount) {
            ok = false;
            if (printed < 8) {
                std::printf("neg-count mismatch @block %u: %u expect %u\n", b, negCountPerBlock[b], expectCount);
                ++printed;
            }
        }
    }
    return ok;
}

} // namespace

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t tensorBytes = TOTAL_LENGTH * sizeof(float);
    const size_t countBytes = NUM_BLOCKS * sizeof(uint32_t);

    std::vector<float> hostInput(TOTAL_LENGTH);
    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        hostInput[i] = make_input(i);
    }
    std::vector<float> hostLeakyAffine(TOTAL_LENGTH, 0.0f);
    std::vector<float> hostClamp(TOTAL_LENGTH, 0.0f);
    std::vector<uint32_t> hostNegCount(NUM_BLOCKS, 0U);

    float* devInput = nullptr;
    float* devLeakyAffine = nullptr;
    float* devClamp = nullptr;
    uint32_t* devNegCount = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&devInput), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devLeakyAffine), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devClamp), tensorBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&devNegCount), countBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(devInput, tensorBytes, hostInput.data(), tensorBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(devNegCount, countBytes, hostNegCount.data(), countBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    // 第二个参数为动态UB大小：三段UB（输入副本 + 融合结果 + Clamp结果）
    constexpr uint32_t dyn_ub_size = 3 * THREAD_COUNT * sizeof(float);
    lambda_operator_hybrid_kernel<<<NUM_BLOCKS, dyn_ub_size, stream>>>(
        devInput, devLeakyAffine, devClamp, devNegCount, TOTAL_LENGTH, ALPHA, SCALE, BIAS, CLAMP_LO, CLAMP_HI);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(hostLeakyAffine.data(), tensorBytes, devLeakyAffine, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hostClamp.data(), tensorBytes, devClamp, tensorBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hostNegCount.data(), countBytes, devNegCount, countBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t negTotal = 0;
    const bool ok = verify_result(hostInput, hostLeakyAffine, hostClamp, hostNegCount, negTotal);
    std::printf(
        "[lambda_operator_hybrid] leaky-affine(SIMT VF) + clamp(SIMD VF) via capturing lambdas: %s "
        "(y[5]=%f, yClamp[5]=%f, negTotal=%u)\n",
        ok ? "PASS" : "FAIL", hostLeakyAffine[5], hostClamp[5], negTotal);

    aclrtFree(devInput);
    aclrtFree(devLeakyAffine);
    aclrtFree(devClamp);
    aclrtFree(devNegCount);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ok ? 0 : 1;
}
