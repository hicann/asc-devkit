/* !
 * \file case3_out_of_bounds_result.asc
 * \brief Observes runtime and accuracy results when out-of-bounds UB access reaches different UB regions.
 */

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t UB_BYTES = 4 * 1024;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);
constexpr uint32_t DATA_WORDS = 512; // 每次处理2KB input，并生成2KB bias。
constexpr uint32_t DATA_BYTES = DATA_WORDS * sizeof(uint32_t);
constexpr uint32_t BIAS_OFFSET = DATA_WORDS;
constexpr uint32_t RESERVED_BYTES = 8 * 1024;
constexpr uint32_t DCACHE_BYTES = 128 * 1024;
constexpr uint32_t RESERVED_START_BYTES = UB_TOTAL_BYTES - DCACHE_BYTES - RESERVED_BYTES;
constexpr uint32_t INPUT_BASE_VALUE = 0xC0030000;
constexpr uint32_t ACCESS_OFFSETS[] = {
    // 静态UB合法范围内的bias区域。
    BIAS_OFFSET * sizeof(uint32_t),
    // 已申请静态UB之后、预留空间之前的未申请UB范围中部。
    (UB_BYTES + RESERVED_START_BYTES) / 2,
    // 8KB预留空间起始位置。
    RESERVED_START_BYTES,
    // Data Cache起始位置。
    UB_TOTAL_BYTES - DCACHE_BYTES,
};
constexpr uint32_t SCALAR_ACCESS_MODE = 0;
constexpr uint32_t SIMT_VF_ACCESS_MODE = 1;
constexpr uint32_t ACCESS_MODE = SCENARIO_NUM <= 10 ? SCALAR_ACCESS_MODE : SIMT_VF_ACCESS_MODE;
constexpr uint32_t ACCESS_REGION = ACCESS_MODE == SCALAR_ACCESS_MODE ? SCENARIO_NUM - 7 : SCENARIO_NUM - 11;
constexpr uint32_t ACCESS_OFFSET_BYTES = ACCESS_OFFSETS[ACCESS_REGION];
static_assert(SCENARIO_NUM >= 7 && SCENARIO_NUM <= 14, "Case 3 SCENARIO_NUM must be in [7, 14]");
} // namespace

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_prepare_input_ub(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub)
{
    for (uint32_t index = threadIdx.x; index < DATA_WORDS; index += blockDim.x) {
        const uint32_t input_data = input[index];
        static_ub[index] = input_data;
        static_ub[BIAS_OFFSET + index] = input_data & 0xff;
    }
}

__aicore__ inline void copy_bias_to_target_by_scalar(__ubuf__ uint32_t* static_ub, uint32_t bias_index)
{
    __ubuf__ volatile uint32_t* static_ub_ptr = static_ub;
    for (uint32_t index = 0; index < DATA_WORDS; ++index) {
        const uint32_t bias = static_ub[BIAS_OFFSET + index];
        static_ub_ptr[bias_index + index] = bias;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_store_output_with_prepared_bias(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub, __gm__ uint32_t* output)
{
    for (uint32_t index = threadIdx.x; index < DATA_WORDS; index += blockDim.x) {
        const uint32_t input_data = input[index];
        const uint32_t bias = static_ub[BIAS_OFFSET + index];
        output[index] = input_data + bias;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_copy_bias_to_target(
    __ubuf__ uint32_t* static_ub, uint32_t bias_index)
{
    for (uint32_t index = threadIdx.x; index < DATA_WORDS; index += blockDim.x) {
        const uint32_t bias = static_ub[BIAS_OFFSET + index];
        static_ub[bias_index + index] = bias;
    }
}

// Case 3观察MainScalar写入目标UB区域后的运行和精度结果。
__global__ __vector__ void scalar_ub_access_result_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    // access_index由访问字节偏移换算得到，表示目标UB区域的起始下标。
    copy_bias_to_target_by_scalar(static_ub, access_index);
    asc_unlock(PIPE_S, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_store_output_with_prepared_bias>(dim3(THREAD_COUNT), input, static_ub, output);
    asc_unlock(PIPE_V, mutex_id);
}

// Case 3观察SIMT VF写入目标UB区域后的运行和精度结果。
__global__ __vector__ void simt_vf_ub_access_result_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t access_index)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    // access_index由访问字节偏移换算得到，表示目标UB区域的起始下标。
    asc_vf_call<simt_copy_bias_to_target>(dim3(THREAD_COUNT), static_ub, access_index);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simt_store_output_with_prepared_bias>(dim3(THREAD_COUNT), input, static_ub, output);
    asc_unlock(PIPE_V, mutex_id);
}

int32_t main()
{
    std::vector<uint32_t> input(DATA_WORDS);
    for (uint32_t index = 0; index < DATA_WORDS; ++index) {
        input[index] = INPUT_BASE_VALUE + index;
    }

    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), DATA_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), DATA_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, DATA_BYTES, input.data(), DATA_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    constexpr const char* MODE_NAMES[] = {"main_scalar", "simt_vf"};
    constexpr const char* REGION_NAMES[] = {"static_ub", "unallocated_ub", "reserved_ub", "data_cache"};
    std::cout << "[Case3] mode=" << MODE_NAMES[ACCESS_MODE] << ", region=" << REGION_NAMES[ACCESS_REGION] << std::endl;
#if SCENARIO_NUM <= 10
    scalar_ub_access_result_kernel<<<1, 0, stream>>>(
        input_device, output_device, ACCESS_OFFSET_BYTES / sizeof(uint32_t));
#else
    simt_vf_ub_access_result_kernel<<<1, 0, stream>>>(
        input_device, output_device, ACCESS_OFFSET_BYTES / sizeof(uint32_t));
#endif

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    bool passed = false;
    if (sync_ret == ACL_SUCCESS && err == nullptr) {
        aclrtMemcpy(output_host, DATA_BYTES, output_device, DATA_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
        bool accuracy_passed = true;
        // Case3用于观察访问不同UB区域后的运行和精度结果，运行完成不说明访问合法。
        for (uint32_t index = 0; index < DATA_WORDS; ++index) {
            const uint32_t input_data = INPUT_BASE_VALUE + index;
            const uint32_t expected = input_data + (input_data & 0xff);
            if (output_host[index] != expected) {
                accuracy_passed = false;
                break;
            }
        }
        passed = true;
        std::cout << (accuracy_passed ? "test pass!" : "[Failed] Case accuracy verification failed!") << std::endl;
    }
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
