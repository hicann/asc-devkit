/* !
 * \file case2_ub_layout.asc
 * \brief Observes static and dynamic UB layout across MainScalar, SIMD VF, and SIMT VF.
 */

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
constexpr uint32_t UB_TOTAL_BYTES = 256 * 1024;
constexpr uint32_t MAIN_STATIC_WORDS = 256;
constexpr uint32_t SIMD_STATIC_WORDS = 512;
constexpr uint32_t SIMT_STATIC_WORDS = THREAD_COUNT;
constexpr uint32_t FILL_VALUE_BASE = 0xC0020000;
constexpr uint32_t RESERVED_UB_BYTES = 8 * 1024;
constexpr uint32_t MIN_SIMT_DATA_CACHE_BYTES = 32 * 1024;
constexpr uint32_t USER_UB_BYTES_WITH_SIMT = UB_TOTAL_BYTES - RESERVED_UB_BYTES - MIN_SIMT_DATA_CACHE_BYTES;
constexpr uint32_t RESULT_WORDS = 8;
constexpr uint32_t RESULT_BYTES = RESULT_WORDS * sizeof(uint32_t);
constexpr uint32_t STATIC_BYTES = (MAIN_STATIC_WORDS + SIMD_STATIC_WORDS + SIMT_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t MAIN_STATIC_ADDR = 0;
constexpr uint32_t SIMD_STATIC_ADDR = MAIN_STATIC_WORDS * sizeof(uint32_t);
constexpr uint32_t SIMT_STATIC_ADDR = (MAIN_STATIC_WORDS + SIMD_STATIC_WORDS) * sizeof(uint32_t);
constexpr uint32_t DYNAMIC_BYTES = USER_UB_BYTES_WITH_SIMT - STATIC_BYTES;
constexpr uint32_t DYNAMIC_WORDS = DYNAMIC_BYTES / sizeof(uint32_t);
} // namespace

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_record_ub_addr(
    __ubuf__ uint32_t* result, uint32_t value_base)
{
    __ubuf__ uint32_t simt_static_ub[SIMT_STATIC_WORDS];
    extern __ubuf__ uint32_t simt_dynamic_ub[];
    for (uint32_t index = threadIdx.x; index < SIMT_STATIC_WORDS; index += blockDim.x) {
        simt_static_ub[index] = value_base + index;
    }
    if (threadIdx.x == 0) {
        simt_dynamic_ub[DYNAMIC_WORDS - 1] = value_base;
        // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
        const uint32_t tail_check = simt_static_ub[SIMT_STATIC_WORDS - 1] - (value_base + SIMT_STATIC_WORDS - 1);
        // 写回SIMT VF中的静态UB和动态UB首地址。
        result[6] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_static_ub)) + tail_check;
        result[7] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simt_dynamic_ub));
    }
}

__simd_vf__ inline void simd_record_ub_addr(__ubuf__ uint32_t* result, uint32_t value_base)
{
    __ubuf__ uint32_t simd_static_ub[SIMD_STATIC_WORDS];
    extern __ubuf__ uint32_t simd_dynamic_ub[];
    for (uint32_t index = 0; index < SIMD_STATIC_WORDS; ++index) {
        simd_static_ub[index] = value_base + index;
    }
    simd_dynamic_ub[DYNAMIC_WORDS - 1] = value_base;
    // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
    const uint32_t tail_check = simd_static_ub[SIMD_STATIC_WORDS - 1] - (value_base + SIMD_STATIC_WORDS - 1);
    // 写回SIMD VF中的静态UB和动态UB首地址。
    result[4] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_static_ub)) + tail_check;
    result[5] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(simd_dynamic_ub));
}

// Case 2：观察MainScalar、SIMD VF和SIMT VF中的静态UB与动态UB共用关系。
__global__ __vector__ void ub_layout_kernel(__gm__ uint32_t* output)
{
    extern __ubuf__ uint32_t main_dynamic_ub[];
    __ubuf__ uint32_t main_static_ub[MAIN_STATIC_WORDS];
    uint8_t mutex_id = 0;

    asc_lock(PIPE_S, mutex_id);
    for (uint32_t index = 0; index < MAIN_STATIC_WORDS; ++index) {
        main_static_ub[index] = FILL_VALUE_BASE + index;
    }
    main_dynamic_ub[DYNAMIC_WORDS - 1] = FILL_VALUE_BASE;
    asc_unlock(PIPE_S, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    asc_vf_call<simd_record_ub_addr>(main_static_ub, FILL_VALUE_BASE);
    asc_vf_call<simt_record_ub_addr>(dim3(THREAD_COUNT), main_static_ub, FILL_VALUE_BASE);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_S, mutex_id);
    main_static_ub[0] = FILL_VALUE_BASE;
    main_static_ub[1] = STATIC_BYTES;
    // 读取数组尾部，确保该静态UB声明参与当前Kernel布局。
    const uint32_t tail_check = main_static_ub[MAIN_STATIC_WORDS - 1] - (FILL_VALUE_BASE + MAIN_STATIC_WORDS - 1);
    // 写回MainScalar中的静态UB和动态UB首地址。
    main_static_ub[2] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_static_ub)) + tail_check;
    main_static_ub[3] = static_cast<uint32_t>(reinterpret_cast<uintptr_t>(main_dynamic_ub));
    asc_unlock(PIPE_S, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm_align(output, main_static_ub, 1, RESULT_BYTES, 0, 0, 0);
    asc_unlock(PIPE_MTE3, mutex_id);
}

int32_t main()
{
    uint32_t* output_host = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), RESULT_BYTES);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), RESULT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);

    std::cout << "[Case2] static_total_bytes=" << STATIC_BYTES << std::endl;
    ub_layout_kernel<<<1, DYNAMIC_BYTES, stream>>>(output_device);

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    bool passed = false;
    if (sync_ret == ACL_SUCCESS && err == nullptr) {
        aclrtMemcpy(output_host, RESULT_BYTES, output_device, RESULT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST);
        const uint32_t static_bytes = output_host[1];
        const uint32_t main_static_addr = output_host[2];
        const uint32_t main_dynamic_addr = output_host[3];
        const uint32_t simd_static_addr = output_host[4];
        const uint32_t simd_dynamic_addr = output_host[5];
        const uint32_t simt_static_addr = output_host[6];
        const uint32_t simt_dynamic_addr = output_host[7];
        const bool expected_static_addresses = main_static_addr == MAIN_STATIC_ADDR &&
                                               simd_static_addr == SIMD_STATIC_ADDR &&
                                               simt_static_addr == SIMT_STATIC_ADDR;
        const bool same_dynamic_addr = main_dynamic_addr == simd_dynamic_addr && main_dynamic_addr == simt_dynamic_addr;
        passed = output_host[0] == FILL_VALUE_BASE && expected_static_addresses && same_dynamic_addr &&
                 main_dynamic_addr == STATIC_BYTES && static_bytes == STATIC_BYTES;
        std::cout << "[Case2] main_static_ub=0x" << std::hex << main_static_addr << ", simd_static_ub=0x"
                  << simd_static_addr << ", simt_static_ub=0x" << simt_static_addr << std::dec << std::endl;
        std::cout << "[Case2] main_dynamic_ub=0x" << std::hex << main_dynamic_addr << ", simd_dynamic_ub=0x"
                  << simd_dynamic_addr << ", simt_dynamic_ub=0x" << simt_dynamic_addr << std::dec << std::endl;
    }
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    } else {
        std::cout << "[Case2] result=" << (passed ? "PASSED" : "FAILED") << std::endl;
    }

    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return passed ? 0 : 1;
}
