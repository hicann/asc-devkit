/* !
 * \file case0_ub_out_of_bounds.asc
 * \brief Reproduces a UB out-of-bounds write that causes an output accuracy issue.
 */

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "simt_api/asc_simt.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t THREAD_COUNT = 1024;
// SIMT场景下，256KB UB扣除8KB预留空间和32KB Data Cache后，可用静态UB为216KB。
constexpr uint32_t UB_BYTES = 216 * 1024;
constexpr uint32_t UB_WORDS = UB_BYTES / sizeof(uint32_t);
constexpr uint32_t UB_TILE_COUNT = 4;
constexpr uint32_t UB_TILE_WORDS = UB_WORDS / UB_TILE_COUNT;
constexpr uint32_t DATA_TILE_WORDS = 2048; // 每个数据块包含2048个uint32_t元素，即8KB。
constexpr uint32_t BIAS_OFFSET = DATA_TILE_WORDS;
constexpr uint32_t DEFAULT_INPUT_WORDS = 4 * DATA_TILE_WORDS; // 默认输入共32KB，对应4个数据块。
constexpr uint32_t INPUT_BASE_VALUE = 0xC0000000;
} // namespace

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_prepare_input_ub(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub, uint32_t ub_base, uint32_t tile_id)
{
    const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
    for (uint32_t index = threadIdx.x; index < DATA_TILE_WORDS; index += blockDim.x) {
        const uint32_t input_data = input[gm_base + index];
        static_ub[ub_base + index] = input_data;
    }
}

__simt_vf__ __launch_bounds__(THREAD_COUNT) inline void simt_store_calibrated_output(
    __gm__ const uint32_t* input, __ubuf__ uint32_t* static_ub, __gm__ uint32_t* output, uint32_t ub_base,
    uint32_t word_count, uint32_t tile_id)
{
    const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
    for (uint32_t index = threadIdx.x; index < word_count; index += blockDim.x) {
        const uint32_t input_data = input[gm_base + index];
        const uint32_t mask = static_ub[ub_base + index];
        const uint32_t bias = static_ub[ub_base + BIAS_OFFSET + index];
        output[gm_base + index] = input_data + bias * mask;
    }
}

__aicore__ inline void generate_bias_and_mask_values(__ubuf__ uint32_t* static_ub, uint32_t ub_base, uint32_t tile_id)
{
    const uint32_t bias_base = tile_id * UB_TILE_WORDS + BIAS_OFFSET;
    for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
        const uint32_t input = static_ub[ub_base + index];
        static_ub[bias_base + index] = input & 0xff;
        static_ub[ub_base + index] = input & 1;
    }
}

__aicore__ inline void generate_bias_and_mask_values_fixed(__ubuf__ uint32_t* static_ub, uint32_t ub_base)
{
    const uint32_t bias_base = ub_base + BIAS_OFFSET;
    for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
        const uint32_t input = static_ub[ub_base + index];
        static_ub[bias_base + index] = input & 0xff;
        static_ub[ub_base + index] = input & 1;
    }
}

// Case 0问题场景：生成bias区域起始下标时直接使用数据块编号。
__global__ __vector__ void static_ub_out_of_bounds_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t input_words)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;
    const uint32_t input_tile_count = input_words / DATA_TILE_WORDS;

    for (uint32_t tile_id = 0; tile_id < input_tile_count; ++tile_id) {
        const uint32_t ub_base = (tile_id & (UB_TILE_COUNT - 1)) * UB_TILE_WORDS;
        // 按当前复用的UB区域保存输入数据。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub, ub_base, tile_id);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_S, mutex_id);
        generate_bias_and_mask_values(static_ub, ub_base, tile_id);
        asc_unlock(PIPE_S, mutex_id);

        // 后续SIMT阶段读取GM input和UB bias生成输出；如果中间数据写入位置错误，输出精度可能异常。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_store_calibrated_output>(
            dim3(THREAD_COUNT), input, static_ub, output, ub_base, DATA_TILE_WORDS, tile_id);
        asc_unlock(PIPE_V, mutex_id);
    }
}

// Case 0修复场景：生成bias区域起始下标时使用当前复用的UB区域起始下标。
__global__ __vector__ void static_ub_bias_offset_fixed_kernel(
    __gm__ const uint32_t* input, __gm__ uint32_t* output, uint32_t input_words)
{
    __ubuf__ uint32_t static_ub[UB_WORDS];
    uint8_t mutex_id = 0;
    const uint32_t input_tile_count = input_words / DATA_TILE_WORDS;

    for (uint32_t tile_id = 0; tile_id < input_tile_count; ++tile_id) {
        const uint32_t ub_base = (tile_id & (UB_TILE_COUNT - 1)) * UB_TILE_WORDS;
        // 按当前复用的UB区域保存输入数据。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_prepare_input_ub>(dim3(THREAD_COUNT), input, static_ub, ub_base, tile_id);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_S, mutex_id);
        generate_bias_and_mask_values_fixed(static_ub, ub_base);
        asc_unlock(PIPE_S, mutex_id);

        // 后续SIMT阶段读取GM input和UB bias生成输出。
        asc_lock(PIPE_V, mutex_id);
        asc_vf_call<simt_store_calibrated_output>(
            dim3(THREAD_COUNT), input, static_ub, output, ub_base, DATA_TILE_WORDS, tile_id);
        asc_unlock(PIPE_V, mutex_id);
    }
}

uint32_t verify_result(const uint32_t* output, uint32_t input_tile_count)
{
    for (uint32_t tile_id = 0; tile_id < input_tile_count; ++tile_id) {
        const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
        for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
            const uint32_t input_data = INPUT_BASE_VALUE + gm_base + index;
            const uint32_t expected = input_data + (input_data & 0xff) * (input_data & 1);
            if (output[gm_base + index] != expected) {
                printf("[Failed] Case accuracy verification failed!\n");
                return 1;
            }
        }
    }
    printf("test pass!\n");
    return 0;
}

void generate_input_data(std::vector<uint32_t>& input, uint32_t input_tile_count)
{
    for (uint32_t tile_id = 0; tile_id < input_tile_count; ++tile_id) {
        const uint32_t gm_base = tile_id * DATA_TILE_WORDS;
        for (uint32_t index = 0; index < DATA_TILE_WORDS; ++index) {
            input[gm_base + index] = INPUT_BASE_VALUE + gm_base + index;
        }
    }
}

bool parse_input_words(int32_t argc, char* argv[], uint32_t& input_words)
{
    input_words = DEFAULT_INPUT_WORDS;
    if (argc == 1) {
        return true;
    }
    if (argc != 2) {
        std::cerr << "Usage: " << argv[0] << " [input_words]" << std::endl;
        return false;
    }

    char* end = nullptr;
    unsigned long parsed = std::strtoul(argv[1], &end, 10);
    if (end == argv[1] || *end != '\0' || parsed == 0 || parsed > UINT32_MAX) {
        std::cerr << "Invalid input_words: " << argv[1] << std::endl;
        return false;
    }

    input_words = static_cast<uint32_t>(parsed);
    if (input_words % DATA_TILE_WORDS != 0) {
        std::cerr << "input_words must be a multiple of " << DATA_TILE_WORDS << std::endl;
        return false;
    }
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t input_words = 0;
    if (!parse_input_words(argc, argv, input_words)) {
        return 1;
    }
    const uint32_t input_tile_count = input_words / DATA_TILE_WORDS;
    const uint32_t input_bytes = input_words * sizeof(uint32_t);
    std::vector<uint32_t> input(input_words);
    generate_input_data(input, input_tile_count);

    uint32_t* output_host = nullptr;
    uint32_t* input_device = nullptr;
    uint32_t* output_device = nullptr;
    aclrtStream stream = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtCreateStream(&stream);
    aclrtMallocHost(reinterpret_cast<void**>(&output_host), input_bytes);
    aclrtMalloc(reinterpret_cast<void**>(&input_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&output_device), input_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(input_device, input_bytes, input.data(), input_bytes, ACL_MEMCPY_HOST_TO_DEVICE);

#if SCENARIO_NUM == 1
    constexpr const char* MODE = "fixed";
    static_ub_bias_offset_fixed_kernel<<<1, 0, stream>>>(input_device, output_device, input_words);
#else
    constexpr const char* MODE = "baseline";
    static_ub_out_of_bounds_kernel<<<1, 0, stream>>>(input_device, output_device, input_words);
#endif
    std::cout << "[Case0] mode=" << MODE << std::endl;

    aclError sync_ret = aclrtSynchronizeStream(stream);
    const char* err = aclGetRecentErrMsg();
    uint32_t ret = 1;
    if (sync_ret == ACL_SUCCESS && err == nullptr) {
        aclrtMemcpy(output_host, input_bytes, output_device, input_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
        ret = verify_result(output_host, input_tile_count);
    }
    if (err != nullptr) {
        fprintf(stderr, "[Host] kernel error: %s\n", err);
    }

    aclrtFree(input_device);
    aclrtFree(output_device);
    aclrtFreeHost(output_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return ret;
}
