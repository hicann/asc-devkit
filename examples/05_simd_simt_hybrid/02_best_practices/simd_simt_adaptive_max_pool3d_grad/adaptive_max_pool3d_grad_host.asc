#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"

#include "adaptive_max_pool3d_grad_simd.h"
#include "adaptive_max_pool3d_grad_scalar.h"
#include "adaptive_max_pool3d_grad_hybrid.h"
#include "adaptive_max_pool3d_grad_hybrid_ub.h"

namespace {

enum class Implementation {
    SIMD,
    SCALAR,
    HYBRID,
    HYBRID_UB,
};

bool parse_implementation(const char* value, Implementation& implementation)
{
    if (std::strcmp(value, "simd") == 0) {
        implementation = Implementation::SIMD;
        return true;
    }
    if (std::strcmp(value, "scalar") == 0) {
        implementation = Implementation::SCALAR;
        return true;
    }
    if (std::strcmp(value, "hybrid") == 0) {
        implementation = Implementation::HYBRID;
        return true;
    }
    if (std::strcmp(value, "hybrid_ub") == 0) {
        implementation = Implementation::HYBRID_UB;
        return true;
    }
    return false;
}

bool parse_profile_mode(const char* value, bool& profileMode)
{
    if (std::strcmp(value, "profile") == 0) {
        profileMode = true;
        return true;
    }
    return false;
}

constexpr uint32_t BATCH_SIZE = 1;
constexpr uint32_t CHANNEL_SIZE = 4096;
// D/H/W of grad/argmax, configured by the GRAD_DHW CMake option, used to reproduce the performance comparison tables in
// the README.
#ifndef GRAD_DHW
#define GRAD_DHW 8
#endif

constexpr uint32_t D_OUT = 32;
constexpr uint32_t H_OUT = 32;
constexpr uint32_t W_OUT = 32;
constexpr uint32_t D_GRAD = GRAD_DHW;
constexpr uint32_t H_GRAD = GRAD_DHW;
constexpr uint32_t W_GRAD = GRAD_DHW;

static_assert(D_OUT % D_GRAD == 0, "D_OUT must be divisible by D_GRAD in this sample");
static_assert(H_OUT % H_GRAD == 0, "H_OUT must be divisible by H_GRAD in this sample");
static_assert(W_OUT % W_GRAD == 0, "W_OUT must be divisible by W_GRAD in this sample");

constexpr uint32_t NC = BATCH_SIZE * CHANNEL_SIZE;
// Upper bound on the number of blocks to launch. Devices with more AIV cores exist (72 on Ascend950PR_9599 and the
// Ascend950DT 36-core parts), but the simd implementation strides over ceil(NC / NC_TILE) = 64 tiles, so any block
// beyond the 64th would exit immediately without doing work. Capping here also keeps the block count aligned with the
// configuration the README performance tables were collected on.
constexpr uint32_t MAX_BLOCK_COUNT = 64;
constexpr uint32_t OUTPUT_SPATIAL = D_OUT * H_OUT * W_OUT;
constexpr uint32_t GRAD_SPATIAL = D_GRAD * H_GRAD * W_GRAD;
constexpr uint64_t OUTPUT_COUNT = static_cast<uint64_t>(NC) * OUTPUT_SPATIAL;
constexpr uint64_t GRAD_COUNT = static_cast<uint64_t>(NC) * GRAD_SPATIAL;
constexpr uint32_t DATA_SEED = 2026;
constexpr uint32_t MAX_DIFF_PRINT_COUNT = 100;
constexpr float VERIFY_ATOL = 1e-5F;

static_assert(
    OUTPUT_SPATIAL <= hybrid_ub_impl::OUTPUT_UB_SIZE,
    "hybrid_ub static output UB capacity only covers output shape [1, C, 32, 32, 32]");

uint32_t next_random(uint32_t& state)
{
    state = state * 1664525U + 1013904223U;
    return state;
}

void generate_grad_argmax(std::vector<float>& grad, std::vector<int32_t>& argmax)
{
    uint32_t state = DATA_SEED;
    constexpr uint32_t dTile = D_OUT / D_GRAD;
    constexpr uint32_t hTile = H_OUT / H_GRAD;
    constexpr uint32_t wTile = W_OUT / W_GRAD;

    for (uint64_t ncIndex = 0; ncIndex < NC; ++ncIndex) {
        for (uint32_t od = 0; od < D_GRAD; ++od) {
            for (uint32_t oh = 0; oh < H_GRAD; ++oh) {
                for (uint32_t ow = 0; ow < W_GRAD; ++ow) {
                    const uint64_t gradPlaneIndex = (static_cast<uint64_t>(od) * H_GRAD + oh) * W_GRAD + ow;
                    const uint64_t gradIndex = ncIndex * GRAD_SPATIAL + gradPlaneIndex;
                    const float unitValue = static_cast<float>(next_random(state) & 0x00FFFFFFU) / 8388608.0F;
                    const uint32_t localD = next_random(state) % dTile;
                    const uint32_t localH = next_random(state) % hTile;
                    const uint32_t localW = next_random(state) % wTile;
                    const uint32_t outputD = od * dTile + localD;
                    const uint32_t outputH = oh * hTile + localH;
                    const uint32_t outputW = ow * wTile + localW;

                    grad[static_cast<size_t>(gradIndex)] = unitValue - 1.0F;
                    argmax[static_cast<size_t>(gradIndex)] =
                        static_cast<int32_t>((outputD * H_OUT + outputH) * W_OUT + outputW);
                }
            }
        }
    }
}

bool check_argmax_range(const std::vector<int32_t>& argmax)
{
    for (size_t index = 0; index < argmax.size(); ++index) {
        if (argmax[index] < 0 || static_cast<uint32_t>(argmax[index]) >= OUTPUT_SPATIAL) {
            std::fprintf(
                stderr, "ERROR! argmax[%zu]=%d is out of output spatial range [0, %u)\n", index, argmax[index],
                OUTPUT_SPATIAL);
            return false;
        }
    }
    return true;
}

void generate_golden_data(
    const std::vector<float>& grad, const std::vector<int32_t>& argmax, std::vector<float>& golden)
{
    std::fill(golden.begin(), golden.end(), 0.0F);
    for (uint64_t gradIndex = 0; gradIndex < GRAD_COUNT; ++gradIndex) {
        const uint64_t ncIndex = gradIndex / GRAD_SPATIAL;
        const uint64_t outputIndex =
            ncIndex * OUTPUT_SPATIAL + static_cast<uint64_t>(argmax[static_cast<size_t>(gradIndex)]);
        golden[static_cast<size_t>(outputIndex)] = grad[static_cast<size_t>(gradIndex)];
    }
}

bool verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    if (output.size() != golden.size()) {
        std::fprintf(stderr, "ERROR! output size: %zu, golden size: %zu\n", output.size(), golden.size());
        return false;
    }

    uint64_t diffCount = 0;
    for (size_t index = 0; index < output.size(); ++index) {
        const float diff =
            output[index] > golden[index] ? output[index] - golden[index] : golden[index] - output[index];
        if (diff <= VERIFY_ATOL) {
            continue;
        }
        if (diffCount < MAX_DIFF_PRINT_COUNT) {
            std::fprintf(
                stderr, "data index: %06zu, expected: %.9f, actual: %.9f\n", index, golden[index], output[index]);
        }
        ++diffCount;
    }

    const double errorRatio = static_cast<double>(diffCount) / static_cast<double>(golden.size());
    std::fprintf(stdout, "error ratio: %.4f\n", errorRatio);
    if (diffCount != 0) {
        std::fprintf(stderr, "ERROR! result error\n");
        return false;
    }
    std::fprintf(stdout, "test pass!\n");
    return true;
}

void print_usage(const char* program)
{
    std::fprintf(stderr, "ERROR! Usage: %s <simd|scalar|hybrid|hybrid_ub> [profile]\n", program);
}

bool check_acl(aclError error, const char* operation)
{
    if (error == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "ERROR! %s failed with ACL error %d: %s\n", operation, error, aclGetRecentErrMsg());
    return false;
}

// Query the number of AIV cores on this device. Launching more blocks than physical cores makes the framework schedule
// the kernel in several rounds, which roughly doubles the duration for one extra block, so the sample sizes the grid to
// the real core count instead of hard coding it. Must be called after aclrtSetDevice.
uint32_t query_aiv_core_num(int32_t deviceId)
{
    constexpr uint32_t FALLBACK_CORE_NUM = 1U;
    int64_t coreNum = 0;
    const aclError error = aclrtGetDeviceInfo(static_cast<uint32_t>(deviceId), ACL_DEV_ATTR_VECTOR_CORE_NUM, &coreNum);
    if (error != ACL_SUCCESS || coreNum <= 0) {
        std::fprintf(
            stderr, "WARNING! query AIV core count failed (ACL error %d, value %ld), fall back to %u block\n", error,
            static_cast<long>(coreNum), FALLBACK_CORE_NUM);
        return FALLBACK_CORE_NUM;
    }
    return static_cast<uint32_t>(coreNum);
}

// Clamped to MAX_BLOCK_COUNT so that no block is left without work to do, and to NC so that every block owns at least
// one plane.
uint32_t resolve_block_count(int32_t deviceId) { return std::min({query_aiv_core_num(deviceId), MAX_BLOCK_COUNT, NC}); }

// Every kernel receives the full NC and derives its own share from block_idx/block_num, so the same code works for any
// block count.
void launch_kernel(
    Implementation implementation, uint32_t blockCount, uint8_t* gradDevice, uint8_t* argmaxDevice,
    uint8_t* outputDevice, aclrtStream stream)
{
    if (implementation == Implementation::SIMD) {
        adaptive_max_pool3d_grad_simd_kernel<<<blockCount, 0, stream>>>(
            gradDevice, argmaxDevice, outputDevice, NC, D_OUT, H_OUT, W_OUT, D_GRAD, H_GRAD, W_GRAD);
    } else if (implementation == Implementation::SCALAR) {
        adaptive_max_pool3d_grad_scalar_kernel<<<blockCount, 0, stream>>>(
            gradDevice, argmaxDevice, outputDevice, NC, OUTPUT_SPATIAL, GRAD_SPATIAL);
    } else if (implementation == Implementation::HYBRID) {
        adaptive_max_pool3d_grad_hybrid_kernel<<<blockCount, 0, stream>>>(
            gradDevice, argmaxDevice, outputDevice, NC, OUTPUT_SPATIAL, GRAD_SPATIAL);
    } else {
        adaptive_max_pool3d_grad_hybrid_ub_kernel<<<blockCount, 0, stream>>>(
            gradDevice, argmaxDevice, outputDevice, NC, OUTPUT_SPATIAL, GRAD_SPATIAL);
    }
}

} // namespace

int32_t main(int32_t argc, char* argv[])
{
    if (argc < 2) {
        print_usage(argv[0]);
        return 1;
    }

    Implementation implementation = Implementation::SIMD;
    if (!parse_implementation(argv[1], implementation)) {
        print_usage(argv[0]);
        return 1;
    }

    bool profileMode = false;
    if (argc > 3 || (argc == 3 && !parse_profile_mode(argv[2], profileMode))) {
        print_usage(argv[0]);
        return 1;
    }

    const size_t gradBytes = static_cast<size_t>(GRAD_COUNT) * sizeof(float);
    const size_t argmaxBytes = static_cast<size_t>(GRAD_COUNT) * sizeof(int32_t);
    const size_t outputBytes = static_cast<size_t>(OUTPUT_COUNT) * sizeof(float);
    std::vector<float> gradHost(static_cast<size_t>(GRAD_COUNT));
    std::vector<int32_t> argmaxHost(static_cast<size_t>(GRAD_COUNT));
    std::vector<float> outputHost;
    std::vector<float> goldenHost;

    generate_grad_argmax(gradHost, argmaxHost);
    if (!check_argmax_range(argmaxHost)) {
        return 1;
    }
    if (!profileMode) {
        outputHost.resize(static_cast<size_t>(OUTPUT_COUNT));
        goldenHost.resize(static_cast<size_t>(OUTPUT_COUNT));
        generate_golden_data(gradHost, argmaxHost, goldenHost);
    }

    if (!check_acl(aclInit(nullptr), "aclInit")) {
        return 1;
    }
    if (!check_acl(aclrtSetDevice(0), "aclrtSetDevice")) {
        aclFinalize();
        return 1;
    }

    const uint32_t blockCount = resolve_block_count(0);

    aclrtStream stream = nullptr;
    if (!check_acl(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }

    uint8_t* gradDevice = nullptr;
    uint8_t* argmaxDevice = nullptr;
    uint8_t* outputDevice = nullptr;
    bool ok =
        check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&gradDevice), gradBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc grad") &&
        check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&argmaxDevice), argmaxBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc argmax") &&
        check_acl(
            aclrtMalloc(reinterpret_cast<void**>(&outputDevice), outputBytes, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc output") &&
        check_acl(
            aclrtMemcpy(gradDevice, gradBytes, gradHost.data(), gradBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy grad") &&
        check_acl(
            aclrtMemcpy(argmaxDevice, argmaxBytes, argmaxHost.data(), argmaxBytes, ACL_MEMCPY_HOST_TO_DEVICE),
            "copy argmax");

    if (ok) {
        launch_kernel(implementation, blockCount, gradDevice, argmaxDevice, outputDevice, stream);
    }
    ok = ok && check_acl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");
    if (ok && !profileMode) {
        ok = check_acl(
            aclrtMemcpy(outputHost.data(), outputBytes, outputDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST),
            "copy output");
    }

    if (gradDevice != nullptr) {
        aclrtFree(gradDevice);
    }
    if (argmaxDevice != nullptr) {
        aclrtFree(argmaxDevice);
    }
    if (outputDevice != nullptr) {
        aclrtFree(outputDevice);
    }
    if (stream != nullptr) {
        aclrtDestroyStream(stream);
    }
    aclrtResetDevice(0);
    aclFinalize();

    if (!ok) {
        return 1;
    }
    if (profileMode) {
        std::fprintf(stdout, "[Profile] Kernel execution completed; result verification skipped.\n");
        return 0;
    }
    return verify_result(outputHost, goldenHost) ? 0 : 1;
}
