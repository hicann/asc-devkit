#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "data_utils.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 2
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 2
#error "SCENARIO_NUM must be one of 0, 1, 2."
#endif

#if SCENARIO_NUM == 0
#include "softmax_gm.h"
#define SCENARIO_NAME "gm"
#elif SCENARIO_NUM == 1
#include "softmax_ub.h"
#define SCENARIO_NAME "ub"
#else
#include "softmax_bucket.h"
#define SCENARIO_NAME "bucket"
#endif

namespace {

constexpr uint32_t DEFAULT_ROWS = 8192;
constexpr uint32_t DEFAULT_COLS = 197;
constexpr uint32_t MAX_ROWS = 1U << 28;
constexpr uint32_t MAX_COLS = 512;
constexpr int32_t DEVICE_ID = 0;
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;

// 单次运行的配置，由parse_args按命令行参数取得
struct RunConfig {
    uint32_t rows; // 输入行数
    uint32_t cols; // softmax最后一维大小
};

bool parse_u32(const char* text, uint32_t min_value, uint32_t max_value, uint32_t& result)
{
    char* end = nullptr;
    const unsigned long parsed = std::strtoul(text, &end, 10);
    if (text[0] == '\0' || *end != '\0' || parsed < min_value || parsed > max_value) {
        return false;
    }
    result = static_cast<uint32_t>(parsed);
    return true;
}

#if SCENARIO_NUM == 2
uint32_t ceil_div(uint32_t numerator, uint32_t denominator) { return (numerator + denominator - 1) / denominator; }

// bucket路径按shape动态选择线程数：rows_per_core个warp分别处理一行，
// 线程数在512/1024/2048中取满足需求的最小值；cols较大时收敛线程数以控制UB占用。
uint32_t calc_bucket_thread_count(uint32_t rows, uint32_t cols, uint32_t block_count)
{
    const uint32_t rows_per_core = ceil_div(rows, block_count);
    const uint32_t needed_threads = rows_per_core * 32; // 一个Warp 32个线程
    if (needed_threads <= softmax_bucket_impl::BUCKET_THREAD_COUNT_SMALL) {
        return softmax_bucket_impl::BUCKET_THREAD_COUNT_SMALL;
    }
    if (needed_threads <= softmax_bucket_impl::BUCKET_THREAD_COUNT_MID) {
        return softmax_bucket_impl::BUCKET_THREAD_COUNT_MID;
    }
    if (cols > softmax_bucket_impl::BUCKET_DYNAMIC_MAX_COLS) {
        return softmax_bucket_impl::BUCKET_THREAD_COUNT_MID;
    }
    return softmax_bucket_impl::BUCKET_THREAD_COUNT_LARGE;
}
#endif

} // namespace

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

int32_t parse_args(int32_t argc, char* argv[], RunConfig& config)
{
    config.rows = DEFAULT_ROWS;
    config.cols = DEFAULT_COLS;

    if (argc == 1) {
        return SUCCESS;
    }
    if (argc != 3 || !parse_u32(argv[1], 1, MAX_ROWS, config.rows) || !parse_u32(argv[2], 1, MAX_COLS, config.cols)) {
        printf("[Failed] Invalid input, usage: \"%s\" or \"%s <rows> <cols>\".\n", argv[0], argv[0]);
        printf("Default shape is [%u, %u], cols must be in [1, %u].\n", DEFAULT_ROWS, DEFAULT_COLS, MAX_COLS);
        return FAILED;
    }
    // 行偏移按32位计算，限制总元素数避免rows*cols回绕。
    if (config.rows > UINT32_MAX / config.cols) {
        printf("[Failed] rows * cols must not exceed %u.\n", UINT32_MAX);
        return FAILED;
    }
    return SUCCESS;
}

int32_t load_input_data(const RunConfig& config, std::vector<uint16_t>& input)
{
    const size_t byte_size = static_cast<size_t>(config.rows) * config.cols * sizeof(uint16_t);
    input.resize(byte_size / sizeof(uint16_t));
    if (!read_file("./input/input_x.bin", byte_size, input.data(), byte_size)) {
        printf("[Failed] Cannot read ./input/input_x.bin, run scripts/gen_data.py first.\n");
        return FAILED;
    }
    return SUCCESS;
}

int32_t set_device(aclrtStream& stream)
{
    if (check_acl_result(aclInit(nullptr), "aclInit(nullptr)", __LINE__) != SUCCESS) {
        return FAILED;
    }
    if (check_acl_result(aclrtSetDevice(DEVICE_ID), "aclrtSetDevice(DEVICE_ID)", __LINE__) != SUCCESS) {
        (void)aclFinalize();
        return FAILED;
    }
    if (check_acl_result(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)", __LINE__) != SUCCESS) {
        (void)aclrtResetDevice(DEVICE_ID);
        (void)aclFinalize();
        return FAILED;
    }
    return SUCCESS;
}

// 通过 aclrtGetDeviceInfo(ACL_DEV_ATTR_VECTOR_CORE_NUM) 查询硬件AIV核数。
int32_t query_aiv_core_num(uint32_t& core_num)
{
    int64_t value = 0;
    CHECK_ACL(aclrtGetDeviceInfo(DEVICE_ID, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value));
    core_num = static_cast<uint32_t>(value);
    return SUCCESS;
}

int32_t prepare_device_data(const std::vector<uint16_t>& input, uint16_t*& input_device, uint16_t*& output_device)
{
    const size_t byte_size = input.size() * sizeof(uint16_t);
    CHECK_ACL(aclrtMalloc((void**)&input_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&output_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(input_device, byte_size, input.data(), byte_size, ACL_MEMCPY_HOST_TO_DEVICE));
    return SUCCESS;
}

int32_t release_device_memory(uint16_t*& input_device, uint16_t*& output_device)
{
    int32_t ret = SUCCESS;

    if (output_device != nullptr) {
        ret = check_acl_result(aclrtFree(output_device), "aclrtFree(output_device)", __LINE__);
        output_device = nullptr;
    }
    if (input_device != nullptr) {
        const int32_t free_ret = check_acl_result(aclrtFree(input_device), "aclrtFree(input_device)", __LINE__);
        ret = (ret == SUCCESS) ? free_ret : ret;
        input_device = nullptr;
    }
    return ret;
}

#if SCENARIO_NUM == 2
template <uint32_t kThreadCount>
void launch_bucket_by_cols(
    const RunConfig& config, uint32_t block_count, uint16_t* output_device, const uint16_t* input_device,
    aclrtStream stream)
{
    if (config.cols <= 64) {
        softmax_bucket_impl::softmax_bucket_kernel<kThreadCount, 64><<<block_count, 0, stream>>>(
            reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows,
            config.cols);
    } else if (config.cols <= 128) {
        softmax_bucket_impl::softmax_bucket_kernel<kThreadCount, 128><<<block_count, 0, stream>>>(
            reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows,
            config.cols);
    } else if (config.cols <= 256) {
        softmax_bucket_impl::softmax_bucket_kernel<kThreadCount, 256><<<block_count, 0, stream>>>(
            reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows,
            config.cols);
    } else if constexpr (kThreadCount != softmax_bucket_impl::BUCKET_THREAD_COUNT_LARGE) {
        if (config.cols <= 384) {
            softmax_bucket_impl::softmax_bucket_kernel<kThreadCount, 384><<<block_count, 0, stream>>>(
                reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows,
                config.cols);
        } else {
            softmax_bucket_impl::softmax_bucket_kernel<kThreadCount, 512><<<block_count, 0, stream>>>(
                reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows,
                config.cols);
        }
    }
}
#endif

void launch_selected_kernel(
    const RunConfig& config, uint32_t block_count, uint16_t* output_device, const uint16_t* input_device,
    aclrtStream stream)
{
#if SCENARIO_NUM == 0
    printf("Case 0: softmax_gm_kernel, %u blocks, SIMT VF reads GM directly\n", block_count);
    softmax_gm_impl::softmax_gm_kernel<<<block_count, 0, stream>>>(
        reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows, config.cols);
#elif SCENARIO_NUM == 1
    const uint32_t dynamic_ub_size = softmax_ub_impl::calc_ub_size(config.rows, config.cols, block_count);
    printf("Case 1: softmax_ub_kernel, %u blocks, dynamic UB size = %u bytes\n", block_count, dynamic_ub_size);
    softmax_ub_impl::softmax_ub_kernel<<<block_count, dynamic_ub_size, stream>>>(
        reinterpret_cast<half*>(output_device), reinterpret_cast<const half*>(input_device), config.rows, config.cols);
#else
    const uint32_t thread_count = calc_bucket_thread_count(config.rows, config.cols, block_count);
    printf("Case 2: softmax_bucket_kernel, %u blocks x %u threads\n", block_count, thread_count);
    if (thread_count == softmax_bucket_impl::BUCKET_THREAD_COUNT_SMALL) {
        launch_bucket_by_cols<softmax_bucket_impl::BUCKET_THREAD_COUNT_SMALL>(
            config, block_count, output_device, input_device, stream);
    } else if (thread_count == softmax_bucket_impl::BUCKET_THREAD_COUNT_MID) {
        launch_bucket_by_cols<softmax_bucket_impl::BUCKET_THREAD_COUNT_MID>(
            config, block_count, output_device, input_device, stream);
    } else {
        launch_bucket_by_cols<softmax_bucket_impl::BUCKET_THREAD_COUNT_LARGE>(
            config, block_count, output_device, input_device, stream);
    }
#endif
}

int32_t copy_output_to_host(uint16_t* output_device, std::vector<uint16_t>& output)
{
    const size_t byte_size = output.size() * sizeof(uint16_t);
    CHECK_ACL(aclrtMemcpy(output.data(), byte_size, output_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    return SUCCESS;
}

int32_t reset_device(aclrtStream& stream)
{
    CHECK_ACL(aclrtDestroyStream(stream));
    stream = nullptr;
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());
    return SUCCESS;
}

int32_t save_output_data(const std::vector<uint16_t>& output)
{
    const size_t byte_size = output.size() * sizeof(uint16_t);
    if (!write_file("./output/output.bin", output.data(), byte_size)) {
        printf("[Failed] Cannot write ./output/output.bin.\n");
        return FAILED;
    }
    return SUCCESS;
}

int32_t main(int32_t argc, char* argv[])
{
    RunConfig config{};
    int32_t ret = parse_args(argc, argv, config);
    if (ret != SUCCESS) {
        return ret;
    }

    std::vector<uint16_t> input;
    ret = load_input_data(config, input);
    if (ret != SUCCESS) {
        return ret;
    }

    aclrtStream stream = nullptr;
    ret = set_device(stream);
    if (ret != SUCCESS) {
        return ret;
    }

    uint16_t* input_device = nullptr;
    uint16_t* output_device = nullptr;

    ret = prepare_device_data(input, input_device, output_device);
    if (ret == SUCCESS) {
        uint32_t core_num = 0;
        ret = query_aiv_core_num(core_num);
        if (ret == SUCCESS) {
            // 线程块数量取硬件AIV核数与rows中的较小值。
            // 一个Warp处理一行：Case 0/1的Warp数随rows自适应，Case 2按固定行数分派，rows较小时部分Block直接退出。
            const uint32_t block_count = (core_num < config.rows) ? core_num : config.rows;
            launch_selected_kernel(config, block_count, output_device, input_device, stream);
            ret = check_acl_result(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream(stream)", __LINE__);
        }
    }

    std::vector<uint16_t> output;
    if (ret == SUCCESS) {
        output.resize(input.size());
        ret = copy_output_to_host(output_device, output);
    }

    const int32_t release_ret = release_device_memory(input_device, output_device);
    if (ret == SUCCESS) {
        ret = release_ret;
    }
    if (ret != SUCCESS) {
        (void)reset_device(stream);
        return ret;
    }

    ret = reset_device(stream);
    if (ret != SUCCESS) {
        return ret;
    }

    ret = save_output_data(output);
    if (ret != SUCCESS) {
        return ret;
    }

    printf("[Run] %s rows=%u cols=%u completed.\n", SCENARIO_NAME, config.rows, config.cols);
    printf("[Success] Output written to ./output/output.bin, verify it by scripts/verify_result.py.\n");
    return SUCCESS;
}
