/* !
 * \file mmad_direction.asc
 * \brief C API MMAD计算方向样例。
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 10
#error "SCENARIO_NUM must be an integer from 1 to 10"
#endif

#if SCENARIO_NUM == 3 || SCENARIO_NUM == 4
constexpr uint32_t matrix_m = 192;
constexpr uint32_t matrix_n = 64;
#elif SCENARIO_NUM == 9 || SCENARIO_NUM == 10
constexpr uint32_t matrix_m = 256;
constexpr uint32_t matrix_n = 256;
#else
constexpr uint32_t matrix_m = 256;
constexpr uint32_t matrix_n = 256;
#endif

#if SCENARIO_NUM == 9 || SCENARIO_NUM == 10
constexpr uint32_t matrix_k = 64;
#else
constexpr uint32_t matrix_k = 128;
#endif
constexpr uint32_t cube_block = 16;
constexpr uint32_t c0_elements = 16;
constexpr uint32_t a_elements = matrix_m * matrix_k;
constexpr uint32_t b_elements = matrix_n * matrix_k;
constexpr uint32_t c_elements = matrix_m * matrix_n;
constexpr uint8_t l2_cache_normal = 0;
constexpr float quant_scale = 1.0f;
constexpr asc_store_l2_cache_mode l0c2gm_l2_cache_normal = asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM;
constexpr asc_unit_flag_mode l0c2gm_unit_flag_update = asc_unit_flag_mode::ENABLE_UPDATE;
constexpr asc_relu_pre_mode l0c2gm_relu_none = asc_relu_pre_mode::NONE;

__global__ __cube__ void mmad_direction(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __cbuf__ half a_l1[a_elements];
    __cbuf__ half b_l1[b_elements];
    __ca__ half a_l0[a_elements];
    __cb__ half b_l0[b_elements];
    __cc__ float c_l0[c_elements];

    asc_set_gm2l1_nz_para(1, 1, matrix_m, 0);
    asc_copy_gm2l1_nd2nz(a_l1, a_gm, matrix_k * sizeof(half), l2_cache_normal, matrix_m, matrix_k, 0, false);
    asc_set_gm2l1_nz_para(1, 1, matrix_n, 0);
    asc_copy_gm2l1_nd2nz(b_l1, b_gm, matrix_k * sizeof(half), l2_cache_normal, matrix_n, matrix_k, 0, false);
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    asc_copy_l12l0a(
        a_l0, a_l1, 0, 0, matrix_m / cube_block, matrix_k / c0_elements, matrix_m / cube_block, matrix_m / cube_block);
    asc_copy_l12l0b(
        b_l0, b_l1, 0, 0, matrix_n / cube_block, matrix_k / c0_elements, matrix_n / cube_block, matrix_n / cube_block);
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

#if SCENARIO_NUM == 5 || SCENARIO_NUM == 6
    asc_set_l0c_copy_nz_para(1, 0, 0);
#elif SCENARIO_NUM == 7 || SCENARIO_NUM == 8
    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_set_l0c_copy_channel_para(1);
#elif SCENARIO_NUM == 3 || SCENARIO_NUM == 4 || SCENARIO_NUM == 9 || SCENARIO_NUM == 10
    asc_set_l0c_copy_prequant(quant_scale, 0, true);
#endif

    // 设置Mmad计算方向。
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 4 || SCENARIO_NUM == 6 || SCENARIO_NUM == 7 || SCENARIO_NUM == 10
    asc_set_mmad_direction_m();
#else
    asc_set_mmad_direction_n();
#endif
    // 开启UnitFlag功能后，Mmad计算与搬出指令之间无需手动插入同步。
    asc_mmad(c_l0, a_l0, b_l0, matrix_m, matrix_k, matrix_n, asc_unit_flag_mode::ENABLE_UPDATE, false, false, true);

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
    // float类型Nz2Nz搬出。
    asc_copy_l0c2gm(
        reinterpret_cast<__gm__ float*>(c), c_l0, matrix_n, matrix_m, matrix_m * cube_block, matrix_m,
        l0c2gm_l2_cache_normal, l0c2gm_unit_flag_update, QuantMode_t::NoQuant, l0c2gm_relu_none, false, false, false,
        false);
#elif SCENARIO_NUM == 3 || SCENARIO_NUM == 4
    // float量化为int4b_t并保持Nz2NZ，硬件自动使能ChannelMerge。
    asc_copy_l0c2gm(
        reinterpret_cast<__gm__ int4b_t*>(c), c_l0, matrix_n, matrix_m, matrix_m * 64, matrix_m, l0c2gm_l2_cache_normal,
        l0c2gm_unit_flag_update, QuantMode_t::QF322S4_PRE, l0c2gm_relu_none, false, false, false, false);
#elif SCENARIO_NUM == 5 || SCENARIO_NUM == 6
    // Nz2ND随路格式转换搬出。
    asc_copy_l0c2gm(
        reinterpret_cast<__gm__ float*>(c), c_l0, matrix_n, matrix_m, matrix_n, matrix_m, l0c2gm_l2_cache_normal,
        l0c2gm_unit_flag_update, QuantMode_t::NoQuant, l0c2gm_relu_none, false, true, false, false);
#elif SCENARIO_NUM == 7 || SCENARIO_NUM == 8
    // Nz2DN随路格式转换搬出。
    asc_copy_l0c2gm(
        reinterpret_cast<__gm__ float*>(c), c_l0, matrix_n, matrix_m, matrix_m, matrix_m, l0c2gm_l2_cache_normal,
        l0c2gm_unit_flag_update, QuantMode_t::NoQuant, l0c2gm_relu_none, false, false, true, false);
#else
    // float量化为int8_t并保持Nz2NZ，硬件自动使能ChannelMerge。
    asc_copy_l0c2gm(
        reinterpret_cast<__gm__ int8_t*>(c), c_l0, matrix_n, matrix_m, matrix_m * 32, matrix_m, l0c2gm_l2_cache_normal,
        l0c2gm_unit_flag_update, QuantMode_t::QF322B8_PRE, l0c2gm_relu_none, false, false, false, false);
#endif
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr size_t a_file_size = a_elements * sizeof(half);
    constexpr size_t b_file_size = b_elements * sizeof(half);
#if SCENARIO_NUM == 3 || SCENARIO_NUM == 4
    constexpr size_t c_file_size = c_elements / 2;
#elif SCENARIO_NUM == 9 || SCENARIO_NUM == 10
    constexpr size_t c_file_size = c_elements;
#else
    constexpr size_t c_file_size = c_elements * sizeof(float);
#endif
    constexpr int32_t device_id = 0;
    constexpr uint32_t num_blocks = 1;

    aclInit(nullptr);
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host;
    uint8_t* a_device;
    aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_gm.bin", a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host;
    uint8_t* b_device;
    aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_gm.bin", b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host;
    uint8_t* c_device;
    aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_direction<<<num_blocks, 0, stream>>>(a_device, b_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
