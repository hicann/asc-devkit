/* !
 * \file mmad_double_buffer.asc
 * \brief MMAD L1 Buffer双缓冲优化对比样例
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// 计算C[M, N] = A[M, K] x B[K, N]，三个维度均为1024。
constexpr uint32_t MATRIX_M = 1024;
constexpr uint32_t MATRIX_K = 1024;
constexpr uint32_t MATRIX_N = 1024;

// 每个Cube核计算一个128 x 128输出块，每轮沿K轴处理64个元素。
constexpr uint32_t TILE_M = 128;
constexpr uint32_t TILE_K = 64;
constexpr uint32_t TILE_N = 128;

// Cube基础分形为16 x 16，Tile各维度均按16对齐。
constexpr uint32_t CUBE_BLOCK = 16;
// K轴按64切分为16轮，每轮结果累加到同一个L0C Buffer。
constexpr uint32_t K_ROUNDS = MATRIX_K / TILE_K;
// M轴和N轴各切分为8块，共启动8 x 8 = 64个逻辑Cube核。
constexpr uint32_t M_TILES = MATRIX_M / TILE_M;
constexpr uint32_t N_TILES = MATRIX_N / TILE_N;
constexpr uint32_t NUM_BLOCKS = M_TILES * N_TILES;

// A/B Tile各包含8192个half元素，占16 KiB；C Tile包含16384个float元素，占64 KiB。
constexpr uint32_t A_TILE_ELEMENTS = TILE_M * TILE_K;
constexpr uint32_t B_TILE_ELEMENTS = TILE_N * TILE_K;
constexpr uint32_t C_TILE_ELEMENTS = TILE_M * TILE_N;

// 使用默认L2 Cache策略；关闭UnitFlag，以便16轮MMAD在L0C Buffer中持续累加。
constexpr uint8_t L2_CACHE_NORMAL = 0;
constexpr uint8_t UNIT_FLAG_DISABLE = 0;

#ifndef SCENARIO_NUM
// 场景0为单Buffer基线，场景1对L1启用Ping/Pong双Buffer。
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM != 0 && SCENARIO_NUM != 1
#error "SCENARIO_NUM must be 0 or 1"
#endif

// 将ND到Nz转换所需的四个16 bit字段编码到一个64 bit配置值中。
constexpr uint64_t make_nd2nz_config(uint16_t c0_stride)
{
    // 单矩阵连续搬运：最外层目的Stride为0，N方向Stride为1，矩阵数量为1。
    constexpr uint16_t loop4_dst_stride = 0;
    constexpr uint16_t n_stride = 1;
    constexpr uint16_t matrix_count = 1;
    return (static_cast<uint64_t>(loop4_dst_stride) << 48) | (static_cast<uint64_t>(c0_stride) << 32) |
           (static_cast<uint64_t>(n_stride) << 16) | matrix_count;
}

// A和B分别使用Tile的M/N维度作为ND到Nz转换的C0方向Stride。
constexpr uint64_t A_ND2NZ_CONFIG = make_nd2nz_config(TILE_M);
constexpr uint64_t B_ND2NZ_CONFIG = make_nd2nz_config(TILE_N);

__aicore__ inline void copy_a_to_l1(__cbuf__ half* dst, __gm__ half* src, uint32_t m_tile_idx, uint32_t k_tile_idx)
{
    // 定位当前[M Tile, K Tile]，搬入L1 Buffer并将ND转换为Nz。
    __gm__ half* tile_src = src + m_tile_idx * TILE_M * MATRIX_K + k_tile_idx * TILE_K;
    asc_set_gm2l1_nz_para(A_ND2NZ_CONFIG);
    asc_copy_gm2l1_nd2nz(dst, tile_src, MATRIX_K * sizeof(half), L2_CACHE_NORMAL, TILE_M, TILE_K, 0, false);
}

__aicore__ inline void copy_b_to_l1(__cbuf__ half* dst, __gm__ half* src, uint32_t n_tile_idx, uint32_t k_tile_idx)
{
    // B在GM中按转置后的[N, K]存储，因此K维连续。
    __gm__ half* tile_src = src + n_tile_idx * TILE_N * MATRIX_K + k_tile_idx * TILE_K;
    asc_set_gm2l1_nz_para(B_ND2NZ_CONFIG);
    asc_copy_gm2l1_nd2nz(dst, tile_src, MATRIX_K * sizeof(half), L2_CACHE_NORMAL, TILE_N, TILE_K, 0, false);
}

__aicore__ inline void copy_a_to_l0(__ca__ half* dst, __cbuf__ half* src)
{
    // 按8 x 4个基础分形将128 x 64的A Tile从L1 Buffer加载到L0A Buffer。
    asc_copy_l12l0a(dst, src, 0, 0, TILE_M / CUBE_BLOCK, TILE_K / CUBE_BLOCK, TILE_M / CUBE_BLOCK, TILE_M / CUBE_BLOCK);
}

__aicore__ inline void copy_b_to_l0(__cb__ half* dst, __cbuf__ half* src)
{
    // 转置后的B已符合常规L1 Buffer到L0B Buffer搬运所需的排布。
    asc_copy_l12l0b(dst, src, 0, 0, TILE_N / CUBE_BLOCK, TILE_K / CUBE_BLOCK, TILE_N / CUBE_BLOCK, TILE_N / CUBE_BLOCK);
}

__aicore__ inline void copy_c_to_gm(__gm__ float* dst, __cc__ float* src)
{
    // 将L0C中的128 x 128 Nz结果转换为ND并写回GM。
    asc_set_l0c2gm_nz2nd(1, 0, 0);
    asc_copy_l0c2gm(
        dst, src, TILE_N, TILE_M, MATRIX_N, TILE_M, L2_CACHE_NORMAL, 0, UNIT_FLAG_DISABLE, 0, 0, false, true, 0, 0,
        false, 0, false, false, false, false);
}

__global__ __cube__ void mmad_baseline(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    // 将64个Block映射到8 x 8个输出Tile，每个Block计算一个128 x 128的C Tile。
    int64_t core_idx = block_idx;
    uint32_t m_tile_idx = static_cast<uint32_t>(core_idx) % M_TILES;
    uint32_t n_tile_idx = static_cast<uint32_t>(core_idx) / M_TILES;

    // 将Kernel入参转换为对应的数据类型指针，A/B为half，C为float。
    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);

    // 基线场景仅分配一组L1、L0A和L0B Buffer，所有K轮重复使用。
    __cbuf__ half a_l1[A_TILE_ELEMENTS];
    __cbuf__ half b_l1[B_TILE_ELEMENTS];
    __ca__ half a_l0[A_TILE_ELEMENTS];
    __cb__ half b_l0[B_TILE_ELEMENTS];
    __cc__ float c_l0[C_TILE_ELEMENTS];

    // 单个Mutex串联MTE2、MTE1和M流水，保证同组Buffer按顺序复用。
    constexpr uint8_t mutex_id = 0;
    for (uint32_t k_tile_idx = 0; k_tile_idx < K_ROUNDS; ++k_tile_idx) {
        // 通过MTE2将当前K轮的A/B Tile从GM搬入L1 Buffer。
        asc_lock(PIPE_MTE2, mutex_id);
        copy_a_to_l1(a_l1, a_gm, m_tile_idx, k_tile_idx);
        copy_b_to_l1(b_l1, b_gm, n_tile_idx, k_tile_idx);
        asc_unlock(PIPE_MTE2, mutex_id);

        // 等待L1数据就绪，再通过MTE1加载到L0A/L0B Buffer。
        asc_lock(PIPE_MTE1, mutex_id);
        copy_a_to_l0(a_l0, a_l1);
        copy_b_to_l0(b_l0, b_l1);
        asc_unlock(PIPE_MTE1, mutex_id);

        // 执行128 x 64与64 x 128的MMAD；首轮清零L0C，后续轮次继续累加。
        asc_lock(PIPE_M, mutex_id);
        asc_mmad(c_l0, a_l0, b_l0, TILE_M, TILE_K, TILE_N, UNIT_FLAG_DISABLE, false, false, k_tile_idx == 0);
        asc_unlock(PIPE_M, mutex_id);
    }

    // 等待最后一轮MMAD完成，再将当前Block负责的C Tile从L0C写回GM。
    asc_lock(PIPE_FIX, mutex_id);
    __gm__ float* c_tile = c_gm + m_tile_idx * TILE_M * MATRIX_N + n_tile_idx * TILE_N;
    copy_c_to_gm(c_tile, c_l0);
    asc_unlock(PIPE_FIX, mutex_id);
    asc_sync_pipe(PIPE_FIX);
}

__global__ __cube__ void mmad_l1_double_buffer(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    int64_t core_idx = block_idx;
    uint32_t m_tile_idx = static_cast<uint32_t>(core_idx) % M_TILES;
    uint32_t n_tile_idx = static_cast<uint32_t>(core_idx) / M_TILES;
    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);

    // L1采用Ping/Pong双Buffer，L0仍复用同一组A/B Buffer。
    __cbuf__ half a_l1_ping[A_TILE_ELEMENTS];
    __cbuf__ half a_l1_pong[A_TILE_ELEMENTS];
    __cbuf__ half b_l1_ping[B_TILE_ELEMENTS];
    __cbuf__ half b_l1_pong[B_TILE_ELEMENTS];
    __ca__ half a_l0[A_TILE_ELEMENTS];
    __cb__ half b_l0[B_TILE_ELEMENTS];
    __cc__ float c_l0[C_TILE_ELEMENTS];

    constexpr uint8_t l0_mutex_id = 2;
    for (uint32_t k_tile_idx = 0; k_tile_idx < K_ROUNDS; ++k_tile_idx) {
        uint8_t l1_mutex_id = static_cast<uint8_t>(k_tile_idx & 1);
        __cbuf__ half* a_l1 = (k_tile_idx & 1) == 0 ? a_l1_ping : a_l1_pong;
        __cbuf__ half* b_l1 = (k_tile_idx & 1) == 0 ? b_l1_ping : b_l1_pong;

        // MTE2可在M使用L0时向另一组L1 Buffer搬入后续K Tile。
        asc_lock(PIPE_MTE2, l1_mutex_id);
        copy_a_to_l1(a_l1, a_gm, m_tile_idx, k_tile_idx);
        copy_b_to_l1(b_l1, b_gm, n_tile_idx, k_tile_idx);
        asc_unlock(PIPE_MTE2, l1_mutex_id);

        // L0只有一组，MTE1复用它前仍需等待前一轮MMAD读取完成。
        asc_lock(PIPE_MTE1, l1_mutex_id);
        asc_lock(PIPE_MTE1, l0_mutex_id);
        copy_a_to_l0(a_l0, a_l1);
        copy_b_to_l0(b_l0, b_l1);
        asc_unlock(PIPE_MTE1, l1_mutex_id);
        asc_unlock(PIPE_MTE1, l0_mutex_id);

        asc_lock(PIPE_M, l0_mutex_id);
        asc_mmad(c_l0, a_l0, b_l0, TILE_M, TILE_K, TILE_N, UNIT_FLAG_DISABLE, false, false, k_tile_idx == 0);
        asc_unlock(PIPE_M, l0_mutex_id);
    }

    asc_lock(PIPE_FIX, l0_mutex_id);
    __gm__ float* c_tile = c_gm + m_tile_idx * TILE_M * MATRIX_N + n_tile_idx * TILE_N;
    copy_c_to_gm(c_tile, c_l0);
    asc_unlock(PIPE_FIX, l0_mutex_id);
    asc_sync_pipe(PIPE_ALL);
}

struct AclResources {
    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    aclrtStream stream = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
};

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

bool run_sample(AclResources& resources, size_t a_file_size, size_t b_file_size, size_t c_file_size, int32_t device_id)
{
    // 初始化ACL、设置Device并创建执行Stream。
    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        return false;
    }
    resources.acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        return false;
    }
    resources.device_set = true;
    if (!check_acl_status(aclrtCreateStream(&resources.stream), "aclrtCreateStream")) {
        return false;
    }
    resources.stream_created = true;

    // 申请A矩阵的Host/Device内存，读取输入文件并拷贝到Device。
    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.a_host), a_file_size), "aclrtMallocHost(a_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&resources.a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(a_device)") ||
        !ReadFile("./input/x1_gm.bin", resources.a_host, a_file_size) ||
        !check_acl_status(
            aclrtMemcpy(resources.a_device, a_file_size, resources.a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(a_device)")) {
        return false;
    }

    // 申请B矩阵的Host/Device内存，读取转置后的输入文件并拷贝到Device。
    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.b_host), b_file_size), "aclrtMallocHost(b_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&resources.b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(b_device)") ||
        !ReadFile("./input/x2_gm.bin", resources.b_host, b_file_size) ||
        !check_acl_status(
            aclrtMemcpy(resources.b_device, b_file_size, resources.b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(b_device)")) {
        return false;
    }

    // 为float32输出矩阵C申请Host和Device内存。
    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&resources.c_host), c_file_size), "aclrtMallocHost(c_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&resources.c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(c_device)")) {
        return false;
    }

    // 启动所选场景的Kernel，每个Block计算一个128 x 128的输出Tile。
    if constexpr (SCENARIO_NUM == 0) {
        mmad_baseline<<<NUM_BLOCKS, 0, resources.stream>>>(resources.a_device, resources.b_device, resources.c_device);
    } else if constexpr (SCENARIO_NUM == 1) {
        mmad_l1_double_buffer<<<NUM_BLOCKS, 0, resources.stream>>>(
            resources.a_device, resources.b_device, resources.c_device);
    }
    // 等待Kernel完成，将C拷贝回Host并写入输出文件。
    if (!check_acl_status(aclrtSynchronizeStream(resources.stream), "aclrtSynchronizeStream") ||
        !check_acl_status(
            aclrtMemcpy(resources.c_host, c_file_size, resources.c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(c_host)") ||
        !WriteFile("./output/output.bin", resources.c_host, c_file_size)) {
        return false;
    }

    return true;
}

bool release_resources(AclResources& resources, int32_t device_id)
{
    // 释放所有已成功创建的资源，并保留清理过程中出现的错误状态。
    bool success = true;
    // 先销毁Stream，避免同步失败时Kernel仍可能访问随后释放的Device Buffer。
    if (resources.stream_created && !check_acl_status(aclrtDestroyStream(resources.stream), "aclrtDestroyStream")) {
        success = false;
    }
    if (resources.c_device != nullptr && !check_acl_status(aclrtFree(resources.c_device), "aclrtFree(c_device)")) {
        success = false;
    }
    if (resources.c_host != nullptr && !check_acl_status(aclrtFreeHost(resources.c_host), "aclrtFreeHost(c_host)")) {
        success = false;
    }
    if (resources.b_device != nullptr && !check_acl_status(aclrtFree(resources.b_device), "aclrtFree(b_device)")) {
        success = false;
    }
    if (resources.b_host != nullptr && !check_acl_status(aclrtFreeHost(resources.b_host), "aclrtFreeHost(b_host)")) {
        success = false;
    }
    if (resources.a_device != nullptr && !check_acl_status(aclrtFree(resources.a_device), "aclrtFree(a_device)")) {
        success = false;
    }
    if (resources.a_host != nullptr && !check_acl_status(aclrtFreeHost(resources.a_host), "aclrtFreeHost(a_host)")) {
        success = false;
    }
    if (resources.device_set && !check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
        success = false;
    }
    if (resources.acl_initialized && !check_acl_status(aclFinalize(), "aclFinalize")) {
        success = false;
    }

    return success;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    // A/B为1024 x 1024个half元素，C为1024 x 1024个float元素，样例在Device 0上运行。
    constexpr size_t a_file_size = MATRIX_M * MATRIX_K * sizeof(uint16_t);
    constexpr size_t b_file_size = MATRIX_K * MATRIX_N * sizeof(uint16_t);
    constexpr size_t c_file_size = MATRIX_M * MATRIX_N * sizeof(float);
    constexpr int32_t device_id = 0;

    AclResources resources;
    int32_t result = run_sample(resources, a_file_size, b_file_size, c_file_size, device_id) ? 0 : 1;
    if (!release_resources(resources, device_id)) {
        result = 1;
    }
    return result;
}
