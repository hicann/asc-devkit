/* !
 * \file c_api_add.asc
 * \brief
 */

#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 8 * 2048;
constexpr uint32_t NUM_BLOCKS = 8;

__simd_vf__ inline void add_vf(
    __ubuf__ float* x_local, __ubuf__ float* y_local, __ubuf__ float* z_local, uint32_t num_elems)
{
    const uint16_t repeat_elems = static_cast<uint16_t>(asc_get_vf_len() / sizeof(float));
    const uint16_t num_repeats = static_cast<uint16_t>((num_elems + repeat_elems - 1U) / repeat_elems);

    vector_bool vmask;
    vector_float src0;
    vector_float src1;
    vector_float dst;
    for (uint16_t i = 0; i < num_repeats; ++i) {
        vmask = asc_update_mask_b32(num_elems);
        asc_load(src0, x_local + i * repeat_elems);
        asc_load(src1, y_local + i * repeat_elems);
        asc_add(dst, src0, src1, vmask);
        asc_store(z_local + i * repeat_elems, dst);
    }
}

__vector__ __global__ void add_custom(__gm__ float* x, __gm__ float* y, __gm__ float* z)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;
    constexpr uint32_t block_byte_size = block_length * sizeof(float);
    constexpr uint8_t mutex_id = 1;

    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ float* y_gm = y + block_idx * block_length;
    __gm__ float* z_gm = z + block_idx * block_length;

    __ubuf__ float x_local[block_length];
    __ubuf__ float y_local[block_length];
    __ubuf__ float z_local[block_length];

    asc_lock(PIPE_MTE2, mutex_id);
    asc_copy_gm2ub(x_local, x_gm, block_byte_size);
    asc_copy_gm2ub(y_local, y_gm, block_byte_size);
    asc_unlock(PIPE_MTE2, mutex_id);

    asc_lock(PIPE_V, mutex_id);
    add_vf((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, (__ubuf__ float*)z_local, block_length);
    asc_unlock(PIPE_V, mutex_id);

    asc_lock(PIPE_MTE3, mutex_id);
    asc_copy_ub2gm(z_gm, z_local, block_byte_size);
    asc_unlock(PIPE_MTE3, mutex_id);
}

#define ASC_CHECK_ACL_CALL_DEMO(func)                                                                                 \
    do {                                                                                                              \
        aclError err = (func);                                                                                        \
        if (err != ACL_SUCCESS) {                                                                                     \
            printf("%s(%d): ERROR: %s returned %s (err#%d)\n", __FILE__, __LINE__, #func, aclGetRecentErrMsg(), err); \
            exit(EXIT_FAILURE);                                                                                       \
        }                                                                                                             \
    } while (0)

void add(const float* x, const float* y, float* z, uint32_t num_elems)
{
    const uint32_t num_blocks = NUM_BLOCKS;
    const size_t total_byte_size = num_elems * sizeof(float);
    const int32_t device_id = 0;
    const uint8_t* x_host = (const uint8_t*)x;
    const uint8_t* y_host = (const uint8_t*)y;
    uint8_t* z_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;
    float* z_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    ASC_CHECK_ACL_CALL_DEMO(aclrtMallocHost((void**)(&z_host), total_byte_size));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));

    aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)y_device, total_byte_size, y_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    add_custom<<<num_blocks, 0>>>(x_device, y_device, z_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(z_host, total_byte_size, (uint8_t*)z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    memcpy(z, z_host, total_byte_size);

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);

    aclrtResetDevice(device_id);
    aclFinalize();
}

uint32_t verify_result(const float* output, const float* golden, uint32_t num_elems)
{
    const uint32_t max_print_size = 20;
    const uint32_t print_size = num_elems < max_print_size ? num_elems : max_print_size;
    const float* tensors[] = {output, golden};
    const char* names[] = {"Output", "Golden"};
    for (uint32_t tensor_idx = 0; tensor_idx < 2; ++tensor_idx) {
        printf("%s: ", names[tensor_idx]);
        for (uint32_t i = 0; i < print_size; ++i) {
            printf("%f ", tensors[tensor_idx][i]);
        }
        if (num_elems > max_print_size) {
            printf("...");
        }
        printf("\n");
    }
    for (uint32_t i = 0; i < num_elems; ++i) {
        if (output[i] != golden[i]) {
            printf("[Failed] Case accuracy is verification failed!\n");
            return 1;
        }
    }
    printf("[Success] Case accuracy is verification passed.\n");
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    float x[total_length];
    float y[total_length];
    float output[total_length];
    float golden[total_length];

    for (uint32_t i = 0; i < total_length; ++i) {
        x[i] = i * 0.1f;
        y[i] = i * 0.1f;
    }
    add(x, y, output, total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = x[i] + y[i];
    }
    return verify_result(output, golden, total_length);
}
