/* !
 * \file matmul_multi_core.asc
 * \brief 使用SIMD C API实现矩阵乘法，展示Cube单元的基本使用方法
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// half type, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;

template <uint32_t M, uint32_t K, uint32_t N, uint32_t single_core_m, uint32_t base_m, uint32_t base_k, uint32_t base_n>
__global__ __cube__ void matmul_multi_core_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();
    uint32_t m_iter_idx = static_cast<uint32_t>(block_idx) % (M / single_core_m);
    __gm__ half* a_gm = (__gm__ half*)a + m_iter_idx * single_core_m * K;
    __gm__ half* b_gm = (__gm__ half*)b;
    __gm__ half* c_gm = (__gm__ half*)c + m_iter_idx * single_core_m * N;
    // 使用地址空间限定符声明片上数组，由编译器分配对应位置的片上内存。
    __cbuf__ half a1_local[base_m * base_k];
    __cbuf__ half b1_local[base_k * base_n];
    __ca__ half a2_local[base_m * base_k];
    __cb__ half b2_local[base_k * base_n];
    __cc__ float c_local[base_m * base_n];
    // A矩阵GM->L1调用asc_set_gm2l1_nz_para接口配置目的Nz排布：
    // {matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride}
    asc_set_gm2l1_nz_para(1, 1, base_m, 0);
    // A矩阵GM->L1调用asc_copy_gm2l1_nd2nz接口：
    // {dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, enable_small_c0}
    asc_copy_gm2l1_nd2nz(
        a1_local, a_gm, K * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_m, base_k, 0, false);
    // B矩阵GM->L1调用asc_set_gm2l1_nz_para接口配置目的Nz排布：
    // {matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride}
    asc_set_gm2l1_nz_para(1, 1, base_k, 0);
    // B矩阵GM->L1调用asc_copy_gm2l1_nd2nz接口：
    // {dst, src, loop1_src_stride, l2_cache_ctl, n_value, d_value, loop4_src_stride, enable_small_c0}
    asc_copy_gm2l1_nd2nz(
        b1_local, b_gm, N * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_k, base_n, 0, false);
    // asc_sync_notify用于在生产者流水完成当前任务后写入同步事件，asc_sync_wait用于让消费者流水等待该事件；
    // 前两个参数描述同步方向，EVENT_ID用于区分同类同步事件。
    // GM->L1的asc_copy_gm2l1_nd2nz由MTE2流水完成，后续L1->L0的搬运由MTE1流水读取L1数据；
    // 这里设置MTE2到MTE1事件，使MTE1等待MTE2，避免读取到尚未搬运完成的数据。
    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    // A矩阵L1->L0A（Nz->Nz）
    // A矩阵L1->L0A调用asc_copy_l12l0a接口：
    // {dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride}
    asc_copy_l12l0a(
        a2_local, a1_local, 0, 0, base_m / CUBE_BLOCK, base_k / CUBE_BLOCK, base_m / CUBE_BLOCK, base_m / CUBE_BLOCK);
    // B矩阵L1->L0B（Nz->Zn）
    // B矩阵L1->L0B调用asc_copy_l12l0b_transpose接口：
    // {dst, src, m_start_position, k_start_position, m_step, k_step, src_stride, dst_stride}
    asc_copy_l12l0b_transpose(
        b2_local, b1_local, 0, 0, base_k / CUBE_BLOCK, base_n / CUBE_BLOCK, base_k / CUBE_BLOCK, base_n / CUBE_BLOCK);
    // L1->L0搬运由MTE1流水完成，后续asc_mmad由PIPE_M流水读取L0A/L0B数据；
    // 这里设置MTE1到PIPE_M事件，使PIPE_M流水等待MTE1，避免asc_mmad读取到尚未搬运完成的数据。
    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
    // 矩阵乘调用asc_mmad接口：
    // {c_matrix, a_matrix, b_matrix, m, k, n, unit_flag_mode, disable_gemv, c_matrix_source, c_matrix_init_val}
    asc_mmad(c_local, a2_local, b2_local, base_m, base_k, base_n, asc_unit_flag_mode::DISABLE, false, false, true);

    // asc_mmad由PIPE_M流水完成并写入L0C，后续asc_copy_l0c2gm由FIX流水读取L0C并搬运到GM；
    // 这里设置PIPE_M到FIX事件，使FIX流水等待PIPE_M流水，避免asc_copy_l0c2gm读取到尚未计算完成的数据。
    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    // L0C->GM搬运调用asc_set_l0c_copy_nz_para接口配置Nz->ND单矩阵搬运：
    // {matrix_num, src_matrix_stride, dst_matrix_stride}
    asc_set_l0c_copy_nz_para(1, 0, 0);
    // L0C->GM搬运调用asc_copy_l0c2gm接口：
    // {dst, src, n_size, m_size, dst_stride, src_stride, l2_cache_mode, unit_flag_mode,
    //  quant_pre_mode, relu_pre_mode, enable_channel_split, enable_nz2nd, enable_nz2dn, enable_clip_relu_pre}
    asc_copy_l0c2gm(
        c_gm, c_local, base_n, base_m, N, base_m, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        asc_unit_flag_mode::DISABLE, QuantMode_t::F322F16, asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    // matmul参数
    constexpr uint32_t M = 256;
    constexpr uint32_t K = 64;
    constexpr uint32_t N = 256;
    // 单核计算量
    constexpr uint32_t single_core_m = 128;
    // 矩阵乘执行单元Tile参数
    constexpr uint32_t base_m = 128;
    constexpr uint32_t base_k = 64;
    constexpr uint32_t base_n = 256;

    size_t a_file_size = M * K * sizeof(half);
    size_t b_file_size = K * N * sizeof(half);
    size_t c_file_size = M * N * sizeof(half);
    uint32_t num_blocks = 2;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    auto cleanup = [&]() {
        if (c_device != nullptr) {
            CHECK_ACL(aclrtFree(c_device));
        }
        if (c_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(c_host));
        }
        if (b_device != nullptr) {
            CHECK_ACL(aclrtFree(b_device));
        }
        if (b_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(b_host));
        }
        if (a_device != nullptr) {
            CHECK_ACL(aclrtFree(a_device));
        }
        if (a_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(a_host));
        }
        if (stream != nullptr) {
            CHECK_ACL(aclrtDestroyStream(stream));
        }
        if (device_set) {
            CHECK_ACL(aclrtResetDevice(device_id));
        }
        if (acl_initialized) {
            CHECK_ACL(aclFinalize());
        }
    };

    CHECK_ACL(aclInit(nullptr));
    acl_initialized = true;
    CHECK_ACL(aclrtSetDevice(device_id));
    device_set = true;
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST));

    matmul_multi_core_custom<M, K, N, single_core_m, base_m, base_k, base_n>
        <<<num_blocks, 0, stream>>>(a_device, b_device, c_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    CHECK_ACL(aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST));
    bool write_success = WriteFile("./output/output.bin", c_host, c_file_size);

    cleanup();
    return write_success ? 0 : 1;
}
