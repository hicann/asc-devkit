/* !
 * \file reduce.asc
 * \brief Demonstrates Memory vector compute C API reduction interfaces.
 */

#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t input_element_count = 64;
constexpr uint32_t output_element_count = SCENARIO_NUM == 1 ? 1 : 8;

__global__ __vector__ void reduce_kernel(__gm__ float* output, __gm__ float* input)
{
    asc_init();

    __ubuf__ float input_local[input_element_count];
    __ubuf__ float output_local[output_element_count];
    asc_copy_gm2ub_align(input_local, input, input_element_count * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

#if SCENARIO_NUM == 1
    asc_repeat_reduce_sum(output_local, input_local, input_element_count);
#elif SCENARIO_NUM == 2
    asc_datablock_reduce_sum(output_local, input_local, input_element_count);
#endif
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, output_element_count * sizeof(float));
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << "[ERROR] " << operation << " failed, ret=" << static_cast<int32_t>(result) << std::endl;
    return false;
}

bool run_kernel(const std::vector<float>& input, std::vector<float>& output)
{
    constexpr size_t input_byte_size = input_element_count * sizeof(float);
    constexpr size_t output_byte_size = output_element_count * sizeof(float);
    float* input_device = nullptr;
    float* output_device = nullptr;
    aclrtStream stream = nullptr;
    bool device_set = false;

    if (!check_acl("aclInit", aclInit(nullptr))) {
        return false;
    }
    const auto cleanup = [&]() {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (input_device != nullptr) {
            (void)aclrtFree(input_device);
        }
        if (output_device != nullptr) {
            (void)aclrtFree(output_device);
        }
        if (device_set) {
            (void)aclrtResetDevice(0);
        }
        (void)aclFinalize();
    };

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(0))) {
        cleanup();
        return false;
    }
    device_set = true;
    if (!check_acl("aclrtCreateStream", aclrtCreateStream(&stream)) ||
        !check_acl(
            "aclrtMalloc(input)",
            aclrtMalloc(reinterpret_cast<void**>(&input_device), input_byte_size, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&output_device), output_byte_size, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMemcpy(input)",
            aclrtMemcpy(input_device, input_byte_size, input.data(), input_byte_size, ACL_MEMCPY_HOST_TO_DEVICE))) {
        cleanup();
        return false;
    }

    reduce_kernel<<<1, 0, stream>>>(output_device, input_device);
    if (!check_acl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream)) ||
        !check_acl(
            "aclrtMemcpy(output)",
            aclrtMemcpy(output.data(), output_byte_size, output_device, output_byte_size, ACL_MEMCPY_DEVICE_TO_HOST))) {
        cleanup();
        return false;
    }

    cleanup();
    return true;
}

int32_t main()
{
    std::vector<float> input(input_element_count);
    std::vector<float> golden(output_element_count);
    std::vector<float> output(output_element_count);

    if (!ReadFile("./input/input_x.bin", input.data(), input.size() * sizeof(float)) ||
        !ReadFile("./output/golden.bin", golden.data(), golden.size() * sizeof(float))) {
        return 1;
    }
    if (!run_kernel(input, output)) {
        return 1;
    }

    bool passed = true;
    for (uint32_t index = 0; index < output_element_count; ++index) {
        if (std::fabs(output[index] - golden[index]) >= 1e-4F) {
            passed = false;
            break;
        }
    }
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    return passed ? 0 : 1;
}
