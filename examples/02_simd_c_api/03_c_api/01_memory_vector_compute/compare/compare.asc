/* !
 * \file compare.asc
 * \brief Demonstrates Memory vector compute C API vector and vector-scalar comparisons.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t ELEMENT_COUNT = 64;
constexpr uint32_t GOLDEN_BYTE_SIZE = ELEMENT_COUNT / 8;
constexpr uint32_t DEVICE_OUTPUT_BYTE_SIZE = 32;

__global__ __vector__ void compare_kernel(__gm__ uint8_t* output, __gm__ float* x, __gm__ float* y)
{
    asc_init();

    __ubuf__ float x_local[ELEMENT_COUNT];
    __ubuf__ float y_local[ELEMENT_COUNT];
    __ubuf__ uint8_t output_local[DEVICE_OUTPUT_BYTE_SIZE];
    asc_copy_gm2ub_align(x_local, x, ELEMENT_COUNT * sizeof(float));
    asc_copy_gm2ub_align(y_local, y, ELEMENT_COUNT * sizeof(float));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

#if SCENARIO_NUM == 1
    asc_lt(output_local, x_local, y_local, 1, 1, 1, 1, 1, 8, 8);
#elif SCENARIO_NUM == 2
    asc_lt(x_local, y_local, 1, 1, 1, 1, 1, 8, 8);
    asc_get_cmp_mask(output_local);
#elif SCENARIO_NUM == 3
    asc_gt_scalar(output_local, x_local, y_local[0], 1, 1, 1, 1, 8);
#endif
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, DEVICE_OUTPUT_BYTE_SIZE);
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << "[ERROR] " << operation << " failed, ret=" << static_cast<int32_t>(result) << std::endl;
    return false;
}

bool run_kernel(const std::vector<float>& x, const std::vector<float>& y, std::vector<uint8_t>& output)
{
    constexpr size_t INPUT_BYTE_SIZE = ELEMENT_COUNT * sizeof(float);
    float* x_device = nullptr;
    float* y_device = nullptr;
    uint8_t* output_device = nullptr;
    aclrtStream stream = nullptr;
    bool device_set = false;

    if (!check_acl("aclInit", aclInit(nullptr))) {
        return false;
    }
    const auto cleanup = [&]() {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (x_device != nullptr) {
            (void)aclrtFree(x_device);
        }
        if (y_device != nullptr) {
            (void)aclrtFree(y_device);
        }
        if (output_device != nullptr) {
            (void)aclrtFree(output_device);
        }
        if (device_set) {
            (void)aclrtResetDevice(0);
        }
        (void)aclFinalize();
    };

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(0))) {
        cleanup();
        return false;
    }
    device_set = true;
    if (!check_acl("aclrtCreateStream", aclrtCreateStream(&stream)) ||
        !check_acl(
            "aclrtMalloc(x)",
            aclrtMalloc(reinterpret_cast<void**>(&x_device), INPUT_BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMalloc(y)",
            aclrtMalloc(reinterpret_cast<void**>(&y_device), INPUT_BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMalloc(output)",
            aclrtMalloc(
                reinterpret_cast<void**>(&output_device), DEVICE_OUTPUT_BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMemcpy(x)",
            aclrtMemcpy(x_device, INPUT_BYTE_SIZE, x.data(), INPUT_BYTE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE)) ||
        !check_acl(
            "aclrtMemcpy(y)",
            aclrtMemcpy(y_device, INPUT_BYTE_SIZE, y.data(), INPUT_BYTE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE))) {
        cleanup();
        return false;
    }

    compare_kernel<<<1, 0, stream>>>(output_device, x_device, y_device);
    if (!check_acl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream)) ||
        !check_acl(
            "aclrtMemcpy(output)", aclrtMemcpy(
                                       output.data(), DEVICE_OUTPUT_BYTE_SIZE, output_device, DEVICE_OUTPUT_BYTE_SIZE,
                                       ACL_MEMCPY_DEVICE_TO_HOST))) {
        cleanup();
        return false;
    }

    cleanup();
    return true;
}

int32_t main()
{
    std::vector<float> x(ELEMENT_COUNT);
    std::vector<float> y(ELEMENT_COUNT);
    std::vector<uint8_t> golden(GOLDEN_BYTE_SIZE);
    std::vector<uint8_t> output(DEVICE_OUTPUT_BYTE_SIZE);

    if (!ReadFile("./input/input_x.bin", x.data(), x.size() * sizeof(float)) ||
        !ReadFile("./input/input_y.bin", y.data(), y.size() * sizeof(float)) ||
        !ReadFile("./output/golden.bin", golden.data(), golden.size())) {
        return 1;
    }
    if (!run_kernel(x, y, output)) {
        return 1;
    }

    const bool passed = std::equal(golden.begin(), golden.end(), output.begin());
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    return passed ? 0 : 1;
}
