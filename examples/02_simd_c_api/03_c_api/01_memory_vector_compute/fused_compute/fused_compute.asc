/* !
 * \file fused_compute.asc
 * \brief Demonstrates Memory vector compute C API asc_leakyrelu.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t ELEMENT_COUNT = 512;
constexpr half ALPHA = static_cast<half>(0.01F);

__global__ __vector__ void fused_compute_kernel(__gm__ half* output, __gm__ half* input)
{
    asc_init();

    __ubuf__ half input_local[ELEMENT_COUNT];
    __ubuf__ half output_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    asc_leakyrelu(output_local, input_local, ALPHA, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, ELEMENT_COUNT * sizeof(half));
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << "[ERROR] " << operation << " failed, ret=" << static_cast<int32_t>(result) << std::endl;
    return false;
}

bool run_kernel(const std::vector<half>& input, std::vector<half>& output)
{
    constexpr size_t BYTE_SIZE = ELEMENT_COUNT * sizeof(half);
    half* input_device = nullptr;
    half* output_device = nullptr;
    aclrtStream stream = nullptr;
    bool device_set = false;

    if (!check_acl("aclInit", aclInit(nullptr))) {
        return false;
    }
    const auto cleanup = [&]() {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (input_device != nullptr) {
            (void)aclrtFree(input_device);
        }
        if (output_device != nullptr) {
            (void)aclrtFree(output_device);
        }
        if (device_set) {
            (void)aclrtResetDevice(0);
        }
        (void)aclFinalize();
    };

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(0))) {
        cleanup();
        return false;
    }
    device_set = true;
    if (!check_acl("aclrtCreateStream", aclrtCreateStream(&stream)) ||
        !check_acl(
            "aclrtMalloc(input)",
            aclrtMalloc(reinterpret_cast<void**>(&input_device), BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&output_device), BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMemcpy(input)",
            aclrtMemcpy(input_device, BYTE_SIZE, input.data(), BYTE_SIZE, ACL_MEMCPY_HOST_TO_DEVICE))) {
        cleanup();
        return false;
    }

    fused_compute_kernel<<<1, 0, stream>>>(output_device, input_device);
    if (!check_acl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream)) ||
        !check_acl(
            "aclrtMemcpy(output)",
            aclrtMemcpy(output.data(), BYTE_SIZE, output_device, BYTE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST))) {
        cleanup();
        return false;
    }

    cleanup();
    return true;
}

int32_t main()
{
    std::vector<half> input(ELEMENT_COUNT);
    std::vector<half> golden(ELEMENT_COUNT);
    std::vector<half> output(ELEMENT_COUNT);
    constexpr size_t BYTE_SIZE = ELEMENT_COUNT * sizeof(half);

    if (!ReadFile("./input/input_x.bin", input.data(), BYTE_SIZE) ||
        !ReadFile("./output/golden.bin", golden.data(), BYTE_SIZE)) {
        return 1;
    }
    if (!run_kernel(input, output)) {
        return 1;
    }

    const bool passed = std::equal(output.begin(), output.end(), golden.begin());
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    return passed ? 0 : 1;
}
