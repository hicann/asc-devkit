/* !
 * \file cast.asc
 * \brief Demonstrates Memory vector compute C API half-to-int conversion with round-up mode.
 */

#include <algorithm>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t ELEMENT_COUNT = 512;
constexpr uint32_t OUTPUT_BYTE_SIZE = SCENARIO_NUM == 1 ? ELEMENT_COUNT / 2 : ELEMENT_COUNT * sizeof(int32_t);

__global__ __vector__ void cast_kernel(__gm__ uint8_t* output, __gm__ half* input)
{
    asc_init();

    __ubuf__ half input_local[ELEMENT_COUNT];
    asc_copy_gm2ub_align(input_local, input, ELEMENT_COUNT * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

#if SCENARIO_NUM == 1
    __ubuf__ uint8_t output_local[ELEMENT_COUNT / 2];
    asc_half2int4_ru(reinterpret_cast<__ubuf__ int4b_t*>(output_local), input_local, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, OUTPUT_BYTE_SIZE);
#else
    __ubuf__ int32_t output_local[ELEMENT_COUNT];
    asc_half2int32_ru(output_local, input_local, ELEMENT_COUNT);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(reinterpret_cast<__gm__ int32_t*>(output), output_local, OUTPUT_BYTE_SIZE);
#endif
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl(const char* operation, aclError result)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::cerr << "[ERROR] " << operation << " failed, ret=" << static_cast<int32_t>(result) << std::endl;
    return false;
}

bool run_kernel(const std::vector<half>& input, std::vector<uint8_t>& output)
{
    half* input_device = nullptr;
    uint8_t* output_device = nullptr;
    aclrtStream stream = nullptr;
    bool device_set = false;

    if (!check_acl("aclInit", aclInit(nullptr))) {
        return false;
    }
    const auto cleanup = [&]() {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (input_device != nullptr) {
            (void)aclrtFree(input_device);
        }
        if (output_device != nullptr) {
            (void)aclrtFree(output_device);
        }
        if (device_set) {
            (void)aclrtResetDevice(0);
        }
        (void)aclFinalize();
    };

    if (!check_acl("aclrtSetDevice", aclrtSetDevice(0))) {
        cleanup();
        return false;
    }
    device_set = true;
    if (!check_acl("aclrtCreateStream", aclrtCreateStream(&stream)) ||
        !check_acl(
            "aclrtMalloc(input)",
            aclrtMalloc(
                reinterpret_cast<void**>(&input_device), input.size() * sizeof(half), ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMalloc(output)",
            aclrtMalloc(reinterpret_cast<void**>(&output_device), OUTPUT_BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST)) ||
        !check_acl(
            "aclrtMemcpy(input)", aclrtMemcpy(
                                      input_device, input.size() * sizeof(half), input.data(),
                                      input.size() * sizeof(half), ACL_MEMCPY_HOST_TO_DEVICE))) {
        cleanup();
        return false;
    }

    cast_kernel<<<1, 0, stream>>>(output_device, input_device);
    if (!check_acl("aclrtSynchronizeStream", aclrtSynchronizeStream(stream)) ||
        !check_acl(
            "aclrtMemcpy(output)",
            aclrtMemcpy(output.data(), OUTPUT_BYTE_SIZE, output_device, OUTPUT_BYTE_SIZE, ACL_MEMCPY_DEVICE_TO_HOST))) {
        cleanup();
        return false;
    }

    cleanup();
    return true;
}

int32_t main()
{
    std::vector<half> input(ELEMENT_COUNT);
    std::vector<uint8_t> golden(OUTPUT_BYTE_SIZE);
    std::vector<uint8_t> output(OUTPUT_BYTE_SIZE);

    if (!ReadFile("./input/input_x.bin", input.data(), input.size() * sizeof(half)) ||
        !ReadFile("./output/golden.bin", golden.data(), golden.size())) {
        return 1;
    }
    if (!run_kernel(input, output)) {
        return 1;
    }

    const bool passed = std::equal(output.begin(), output.end(), golden.begin());
    std::cout << (passed ? "test pass!" : "test fail!") << std::endl;
    return passed ? 0 : 1;
}
