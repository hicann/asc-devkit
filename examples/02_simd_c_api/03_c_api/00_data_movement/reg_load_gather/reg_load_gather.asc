/* !
 * \file reg_load_gather.asc
 * \brief Demonstrates indexed element and DataBlock loads from UB to vector registers.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t SRC_LENGTH = 1024;
constexpr uint32_t HALF_ELEMENTS_PER_BLOCK = 32 / sizeof(half);
constexpr uint32_t DATABLOCK_INDEX_LENGTH = TOTAL_LENGTH / HALF_ELEMENTS_PER_BLOCK;

__simd_vf__ inline void gather_elements(
    __ubuf__ half* dst, __ubuf__ half* src, __ubuf__ uint16_t* index, uint32_t count, uint32_t one_repeat_size,
    uint16_t repeat_times)
{
    vector_half dst_reg;
    vector_uint16_t index_reg;
    vector_bool mask;

    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(count);
        asc_loadalign(index_reg, index + i * one_repeat_size);
        asc_gather(dst_reg, src, index_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__simd_vf__ inline void gather_datablocks(
    __ubuf__ half* dst, __ubuf__ half* src, __ubuf__ uint32_t* index, uint32_t count, uint32_t one_repeat_size,
    uint32_t index_repeat_size, uint16_t repeat_times)
{
    vector_half dst_reg;
    vector_uint32_t index_reg;
    vector_bool mask;

    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(count);
        asc_loadalign(index_reg, index + i * index_repeat_size);
        asc_gather_datablock(dst_reg, src, index_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__global__ __vector__ void reg_load_gather(__gm__ half* src, __gm__ void* index, __gm__ half* dst)
{
    asc_init();
    constexpr uint32_t half_elements_per_vf = asc_get_vf_len() / sizeof(half);
    constexpr uint32_t uint32_elements_per_vf = asc_get_vf_len() / sizeof(uint32_t);
    constexpr uint32_t datablocks_per_vf = half_elements_per_vf / HALF_ELEMENTS_PER_BLOCK;
    constexpr uint16_t repeat_times =
        static_cast<uint16_t>((TOTAL_LENGTH + half_elements_per_vf - 1) / half_elements_per_vf);
    constexpr uint32_t datablock_index_ub_length = DATABLOCK_INDEX_LENGTH + uint32_elements_per_vf - datablocks_per_vf;
    __ubuf__ half src_ub[SRC_LENGTH];
    __ubuf__ half dst_ub[TOTAL_LENGTH];

    asc_copy_gm2ub(src_ub, src, SRC_LENGTH * sizeof(half));
    if constexpr (scenarioNum == 1) {
        __ubuf__ uint16_t index_ub[TOTAL_LENGTH];
        asc_copy_gm2ub(index_ub, reinterpret_cast<__gm__ uint16_t*>(index), TOTAL_LENGTH * sizeof(uint16_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_vf_call<gather_elements>(dst_ub, src_ub, index_ub, TOTAL_LENGTH, half_elements_per_vf, repeat_times);
    } else {
        __ubuf__ uint32_t index_ub[datablock_index_ub_length];
        asc_copy_gm2ub(index_ub, reinterpret_cast<__gm__ uint32_t*>(index), DATABLOCK_INDEX_LENGTH * sizeof(uint32_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_vf_call<gather_datablocks>(
            dst_ub, src_ub, index_ub, TOTAL_LENGTH, half_elements_per_vf, datablocks_per_vf, repeat_times);
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, TOTAL_LENGTH * sizeof(half));
    asc_sync_pipe(PIPE_ALL);
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t src_size = SRC_LENGTH * sizeof(half);
    constexpr size_t dst_size = TOTAL_LENGTH * sizeof(half);
    constexpr size_t index_size =
        scenarioNum == 1 ? TOTAL_LENGTH * sizeof(uint16_t) : DATABLOCK_INDEX_LENGTH * sizeof(uint32_t);
    constexpr int32_t device_id = 0;

    aclrtStream stream = nullptr;
    half* src_host = nullptr;
    uint8_t* index_host = nullptr;
    half* dst_host = nullptr;
    half* src_device = nullptr;
    uint8_t* index_device = nullptr;
    half* dst_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
    int32_t result = 1;

    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&src_host), src_size), "aclrtMallocHost(src_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&src_device), src_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(src_device)") ||
        !ReadFile("./input/input_x.bin", src_host, src_size) ||
        !check_acl_status(
            aclrtMemcpy(src_device, src_size, src_host, src_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(src_device)")) {
        goto cleanup;
    }

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&index_host), index_size), "aclrtMallocHost(index_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&index_device), index_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(index_device)") ||
        !ReadFile("./input/input_y.bin", index_host, index_size) ||
        !check_acl_status(
            aclrtMemcpy(index_device, index_size, index_host, index_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(index_device)")) {
        goto cleanup;
    }

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&dst_host), dst_size), "aclrtMallocHost(dst_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), dst_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(dst_device)")) {
        goto cleanup;
    }

    reg_load_gather<<<1, 0, stream>>>(src_device, index_device, dst_device);
    if (!check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl_status(
            aclrtMemcpy(dst_host, dst_size, dst_device, dst_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(dst_host)") ||
        !WriteFile("./output/output.bin", dst_host, dst_size)) {
        goto cleanup;
    }

    result = 0;

cleanup:
    if (dst_device != nullptr) {
        if (!check_acl_status(aclrtFree(dst_device), "aclrtFree(dst_device)")) {
            result = 1;
        }
    }
    if (index_device != nullptr) {
        if (!check_acl_status(aclrtFree(index_device), "aclrtFree(index_device)")) {
            result = 1;
        }
    }
    if (src_device != nullptr) {
        if (!check_acl_status(aclrtFree(src_device), "aclrtFree(src_device)")) {
            result = 1;
        }
    }
    if (dst_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(dst_host), "aclrtFreeHost(dst_host)")) {
            result = 1;
        }
    }
    if (index_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(index_host), "aclrtFreeHost(index_host)")) {
            result = 1;
        }
    }
    if (src_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(src_host), "aclrtFreeHost(src_host)")) {
            result = 1;
        }
    }
    if (stream_created) {
        if (!check_acl_status(aclrtDestroyStream(stream), "aclrtDestroyStream")) {
            result = 1;
        }
    }
    if (device_set) {
        if (!check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
            result = 1;
        }
    }
    if (acl_initialized) {
        if (!check_acl_status(aclFinalize(), "aclFinalize")) {
            result = 1;
        }
    }
    return result;
}
