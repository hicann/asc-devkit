/* !
 * \file reg_load_store_mask.asc
 * \brief Demonstrates mask-register load, store, and selection operations.
 */

#include <cstddef>
#include <cstdint>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"
#include "kernel_operator.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t SCENARIO1_LENGTH = 1024;
constexpr uint32_t SCENARIO2_LENGTH = 256;
constexpr uint32_t SCENARIO2_MASK_LENGTH = 128;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void load_store_mask_register(
    __ubuf__ uint8_t* dst, __ubuf__ uint8_t* src, uint32_t repeat_times, uint32_t one_repeat_size)
{
    vector_bool input_mask;
    vector_uint8_t zero_reg;
    vector_uint8_t result_reg;
    vector_bool all_mask = asc_create_mask_b8(PAT_ALL);
    // Initialize the output buffer to zero before storing values at mask-selected positions.
    asc_duplicate_scalar(zero_reg, static_cast<uint8_t>(0), all_mask);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_storealign(dst + i * one_repeat_size, zero_reg, all_mask);
    }
    asc_loadalign(input_mask, reinterpret_cast<__ubuf__ uint32_t*>(src));
    asc_duplicate_scalar(result_reg, static_cast<uint8_t>(2), input_mask);
    asc_storealign(dst, result_reg, input_mask);
    asc_storealign(dst + one_repeat_size, all_mask);
}

__simd_vf__ inline void select_with_mask_register(
    __ubuf__ float* dst, __ubuf__ float* src0, __ubuf__ float* src1, __ubuf__ uint8_t* mask, uint32_t one_repeat_size,
    uint32_t mask_repeat_size, uint32_t repeat_times)
{
    vector_float src0_reg;
    vector_float src1_reg;
    vector_float dst_reg;
    vector_bool select_mask;
    vector_bool store_mask = asc_create_mask_b32(PAT_ALL);
    __ubuf__ uint32_t* mask_ptr = reinterpret_cast<__ubuf__ uint32_t*>(mask);
    for (uint32_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_postupdate(src0_reg, src0, one_repeat_size);
        asc_loadalign_postupdate(src1_reg, src1, one_repeat_size);
        asc_loadalign_postupdate(select_mask, mask_ptr, mask_repeat_size);
        asc_select(dst_reg, src0_reg, src1_reg, select_mask);
        asc_storealign_postupdate(dst, dst_reg, one_repeat_size, store_mask);
    }
}

__global__ __vector__ void reg_load_store_mask(
    __gm__ void* src0, __gm__ void* src1, __gm__ void* mask, __gm__ void* dst)
{
    asc_init();
    constexpr uint32_t byte_elements_per_vf = asc_get_vf_len() / sizeof(uint8_t);
    constexpr uint32_t float_elements_per_vf = asc_get_vf_len() / sizeof(float);
    constexpr uint32_t mask_bytes_per_vf = asc_get_vf_len() / 8;

    if constexpr (scenarioNum == 1) {
        __ubuf__ uint8_t src_ub[SCENARIO1_LENGTH];
        __ubuf__ uint8_t dst_ub[SCENARIO1_LENGTH];
        asc_copy_gm2ub(src_ub, reinterpret_cast<__gm__ uint8_t*>(src0), SCENARIO1_LENGTH * sizeof(uint8_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

        asc_vf_call<load_store_mask_register>(
            dst_ub, src_ub, ceil_division(SCENARIO1_LENGTH, byte_elements_per_vf), byte_elements_per_vf);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(reinterpret_cast<__gm__ uint8_t*>(dst), dst_ub, SCENARIO1_LENGTH * sizeof(uint8_t));
    } else {
        __ubuf__ float src0_ub[SCENARIO2_LENGTH];
        __ubuf__ float src1_ub[SCENARIO2_LENGTH];
        __ubuf__ uint8_t mask_ub[SCENARIO2_MASK_LENGTH];
        __ubuf__ float dst_ub[SCENARIO2_LENGTH];
        asc_copy_gm2ub(src0_ub, reinterpret_cast<__gm__ float*>(src0), SCENARIO2_LENGTH * sizeof(float));
        asc_copy_gm2ub(src1_ub, reinterpret_cast<__gm__ float*>(src1), SCENARIO2_LENGTH * sizeof(float));
        asc_copy_gm2ub(mask_ub, reinterpret_cast<__gm__ uint8_t*>(mask), SCENARIO2_MASK_LENGTH * sizeof(uint8_t));
        asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
        constexpr uint32_t float_repeat_times = ceil_division(SCENARIO2_LENGTH, float_elements_per_vf);

        asc_vf_call<select_with_mask_register>(
            dst_ub, src0_ub, src1_ub, mask_ub, float_elements_per_vf, mask_bytes_per_vf, float_repeat_times);

        asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
        asc_copy_ub2gm(reinterpret_cast<__gm__ float*>(dst), dst_ub, SCENARIO2_LENGTH * sizeof(float));
    }

    asc_sync_pipe(PIPE_ALL);
}

bool check_acl_status(aclError status, const char* operation)
{
    if (status != ACL_SUCCESS) {
        ERROR_LOG("%s failed. error code = %d", operation, static_cast<int32_t>(status));
        return false;
    }
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr bool is_scenario1 = scenarioNum == 1;
    constexpr size_t src0_size = is_scenario1 ? SCENARIO1_LENGTH * sizeof(uint8_t) : SCENARIO2_LENGTH * sizeof(float);
    constexpr size_t src1_size = is_scenario1 ? 0 : SCENARIO2_LENGTH * sizeof(float);
    constexpr size_t mask_size = is_scenario1 ? 0 : SCENARIO2_MASK_LENGTH * sizeof(uint8_t);
    constexpr size_t output_size = is_scenario1 ? SCENARIO1_LENGTH * sizeof(uint8_t) : SCENARIO2_LENGTH * sizeof(float);
    constexpr int32_t device_id = 0;
    const char* src0_file = is_scenario1 ? "./input/input.bin" : "./input/input_x.bin";

    aclrtStream stream = nullptr;
    uint8_t* src0_host = nullptr;
    uint8_t* src1_host = nullptr;
    uint8_t* mask_host = nullptr;
    uint8_t* dst_host = nullptr;
    uint8_t* src0_device = nullptr;
    uint8_t* src1_device = nullptr;
    uint8_t* mask_device = nullptr;
    uint8_t* dst_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    bool stream_created = false;
    int32_t result = 1;

    if (!check_acl_status(aclInit(nullptr), "aclInit")) {
        goto cleanup;
    }
    acl_initialized = true;
    if (!check_acl_status(aclrtSetDevice(device_id), "aclrtSetDevice")) {
        goto cleanup;
    }
    device_set = true;
    if (!check_acl_status(aclrtCreateStream(&stream), "aclrtCreateStream")) {
        goto cleanup;
    }
    stream_created = true;

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&src0_host), src0_size), "aclrtMallocHost(src0_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&src0_device), src0_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(src0_device)") ||
        !ReadFile(src0_file, src0_host, src0_size) ||
        !check_acl_status(
            aclrtMemcpy(src0_device, src0_size, src0_host, src0_size, ACL_MEMCPY_HOST_TO_DEVICE),
            "aclrtMemcpy(src0_device)")) {
        goto cleanup;
    }

    if constexpr (!is_scenario1) {
        if (!check_acl_status(
                aclrtMallocHost(reinterpret_cast<void**>(&src1_host), src1_size), "aclrtMallocHost(src1_host)") ||
            !check_acl_status(
                aclrtMalloc(reinterpret_cast<void**>(&src1_device), src1_size, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(src1_device)") ||
            !ReadFile("./input/input_y.bin", src1_host, src1_size) ||
            !check_acl_status(
                aclrtMemcpy(src1_device, src1_size, src1_host, src1_size, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(src1_device)")) {
            goto cleanup;
        }

        if (!check_acl_status(
                aclrtMallocHost(reinterpret_cast<void**>(&mask_host), mask_size), "aclrtMallocHost(mask_host)") ||
            !check_acl_status(
                aclrtMalloc(reinterpret_cast<void**>(&mask_device), mask_size, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(mask_device)") ||
            !ReadFile("./input/input_mask.bin", mask_host, mask_size) ||
            !check_acl_status(
                aclrtMemcpy(mask_device, mask_size, mask_host, mask_size, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(mask_device)")) {
            goto cleanup;
        }
    }

    if (!check_acl_status(
            aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_size), "aclrtMallocHost(dst_host)") ||
        !check_acl_status(
            aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST),
            "aclrtMalloc(dst_device)")) {
        goto cleanup;
    }

    reg_load_store_mask<<<1, 0, stream>>>(src0_device, src1_device, mask_device, dst_device);
    if (!check_acl_status(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream") ||
        !check_acl_status(
            aclrtMemcpy(dst_host, output_size, dst_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST),
            "aclrtMemcpy(dst_host)") ||
        !WriteFile("./output/output.bin", dst_host, output_size)) {
        goto cleanup;
    }

    result = 0;

cleanup:
    if (dst_device != nullptr) {
        if (!check_acl_status(aclrtFree(dst_device), "aclrtFree(dst_device)")) {
            result = 1;
        }
    }
    if (mask_device != nullptr) {
        if (!check_acl_status(aclrtFree(mask_device), "aclrtFree(mask_device)")) {
            result = 1;
        }
    }
    if (src1_device != nullptr) {
        if (!check_acl_status(aclrtFree(src1_device), "aclrtFree(src1_device)")) {
            result = 1;
        }
    }
    if (src0_device != nullptr) {
        if (!check_acl_status(aclrtFree(src0_device), "aclrtFree(src0_device)")) {
            result = 1;
        }
    }
    if (dst_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(dst_host), "aclrtFreeHost(dst_host)")) {
            result = 1;
        }
    }
    if (mask_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(mask_host), "aclrtFreeHost(mask_host)")) {
            result = 1;
        }
    }
    if (src1_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(src1_host), "aclrtFreeHost(src1_host)")) {
            result = 1;
        }
    }
    if (src0_host != nullptr) {
        if (!check_acl_status(aclrtFreeHost(src0_host), "aclrtFreeHost(src0_host)")) {
            result = 1;
        }
    }
    if (stream_created) {
        if (!check_acl_status(aclrtDestroyStream(stream), "aclrtDestroyStream")) {
            result = 1;
        }
    }
    if (device_set) {
        if (!check_acl_status(aclrtResetDevice(device_id), "aclrtResetDevice")) {
            result = 1;
        }
    }
    if (acl_initialized) {
        if (!check_acl_status(aclFinalize(), "aclFinalize")) {
            result = 1;
        }
    }
    return result;
}
