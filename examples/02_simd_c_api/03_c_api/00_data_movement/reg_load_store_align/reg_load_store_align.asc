/* !
 * \file reg_load_store_align.asc
 * \brief Demonstrates aligned load and store operations between UB and vector registers.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

constexpr uint32_t scenarioNum = SCENARIO_NUM;
constexpr uint32_t INPUT_LENGTH = 1024;
constexpr uint32_t HALF_ELEMENTS_PER_DATABLOCK = 32 / sizeof(half);

__simd_vf__ inline void add_with_offset(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times,
    uint32_t element_count)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_half zero_reg;
    vector_bool mask;
    vector_bool all_mask = asc_create_mask_b16(PAT_ALL);
    // Initialize output vectors so elements outside the final partial mask remain zero.
    asc_duplicate_scalar(zero_reg, static_cast<half>(0), all_mask);
    for (uint16_t i = 0; i < repeat_times; ++i) {
        asc_storealign(dst + i * one_repeat_size, zero_reg, all_mask);
        mask = asc_update_mask_b16(element_count);
        asc_loadalign(src0_reg, src0 + i * one_repeat_size);
        asc_loadalign(src1_reg, src1 + i * one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__simd_vf__ inline void add_with_postupdate(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times,
    uint32_t output_length)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(output_length);
        asc_loadalign_postupdate(src0_reg, src0, one_repeat_size);
        asc_loadalign_postupdate(src1_reg, src1, one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst, dst_reg, one_repeat_size, mask);
    }
}

__simd_vf__ inline void add_with_addr_reg(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times,
    uint32_t output_length)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask;
    addr_reg offset;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        offset = asc_update_addr_reg_b16(one_repeat_size);
        mask = asc_update_mask_b16(output_length);
        asc_loadalign(src0_reg, src0, offset);
        asc_loadalign(src1_reg, src1, offset);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst, dst_reg, offset, mask);
    }
}

__simd_vf__ inline void add_with_datablock(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times,
    uint32_t output_length, uint16_t src_block_stride)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask;
    const uint16_t blocks_per_vector = one_repeat_size / HALF_ELEMENTS_PER_DATABLOCK;
    const uint16_t src_repeat_stride = src_block_stride * blocks_per_vector;
    constexpr uint16_t dst_block_stride = 1;
    const uint16_t dst_repeat_stride = dst_block_stride * blocks_per_vector;
    for (uint16_t i = 0; i < repeat_times; ++i) {
        mask = asc_update_mask_b16(output_length);
        asc_loadalign_postupdate(src0_reg, src0, src_block_stride, src_repeat_stride, mask);
        asc_loadalign_postupdate(src1_reg, src1, src_block_stride, src_repeat_stride, mask);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign_postupdate(dst, dst_reg, dst_block_stride, dst_repeat_stride, mask);
    }
}

__simd_vf__ inline void add_with_broadcast(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint16_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_brc(src0_reg, src0 + i * one_repeat_size);
        asc_loadalign_brc(src1_reg, src1 + i * one_repeat_size);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__simd_vf__ inline void add_with_upsample(
    __ubuf__ half* dst, __ubuf__ half* src0, __ubuf__ half* src1, uint32_t one_repeat_size, uint16_t repeat_times)
{
    vector_half src0_reg;
    vector_half src1_reg;
    vector_half dst_reg;
    vector_bool mask = asc_create_mask_b16(PAT_ALL);
    for (uint16_t i = 0; i < repeat_times; ++i) {
        asc_loadalign_upsample(src0_reg, src0 + i * one_repeat_size / 2);
        asc_loadalign_upsample(src1_reg, src1 + i * one_repeat_size / 2);
        asc_add(dst_reg, src0_reg, src1_reg, mask);
        asc_storealign(dst + i * one_repeat_size, dst_reg, mask);
    }
}

__global__ __vector__ void reg_load_store_align(__gm__ half* src0, __gm__ half* src1, __gm__ half* dst)
{
    asc_init();
    constexpr uint32_t half_elements_per_vf = asc_get_vf_len() / sizeof(half);

    __ubuf__ half src0_ub[INPUT_LENGTH];
    __ubuf__ half src1_ub[INPUT_LENGTH];
    constexpr uint32_t output_length = scenarioNum == 4 ? INPUT_LENGTH / 2 :
                                       scenarioNum == 6 ? INPUT_LENGTH * 2 :
                                                          INPUT_LENGTH;
    __ubuf__ half dst_ub[output_length];

    asc_copy_gm2ub(src0_ub, src0, INPUT_LENGTH * sizeof(half));
    asc_copy_gm2ub(src1_ub, src1, INPUT_LENGTH * sizeof(half));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    constexpr uint16_t input_repeat_times =
        static_cast<uint16_t>(AscendC::Std::ceil_div(INPUT_LENGTH, half_elements_per_vf));

    if constexpr (scenarioNum == 1) {
        asc_vf_call<add_with_offset>(
            dst_ub, src0_ub, src1_ub, half_elements_per_vf, input_repeat_times, output_length - 3);
    } else if constexpr (scenarioNum == 2) {
        asc_vf_call<add_with_postupdate>(
            dst_ub, src0_ub, src1_ub, half_elements_per_vf, input_repeat_times, output_length);
    } else if constexpr (scenarioNum == 3) {
        asc_vf_call<add_with_addr_reg>(
            dst_ub, src0_ub, src1_ub, half_elements_per_vf, input_repeat_times, output_length);
    } else if constexpr (scenarioNum == 4) {
        asc_vf_call<add_with_datablock>(
            dst_ub, src0_ub, src1_ub, half_elements_per_vf, static_cast<uint16_t>(input_repeat_times / 2),
            output_length, 2);
    } else if constexpr (scenarioNum == 5) {
        asc_vf_call<add_with_broadcast>(dst_ub, src0_ub, src1_ub, half_elements_per_vf, input_repeat_times);
    } else {
        asc_vf_call<add_with_upsample>(
            dst_ub, src0_ub, src1_ub, half_elements_per_vf, static_cast<uint16_t>(input_repeat_times * 2));
    }

    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm(dst, dst_ub, output_length * sizeof(half));
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr size_t input_size = INPUT_LENGTH * sizeof(half);
    constexpr uint32_t output_length = scenarioNum == 4 ? INPUT_LENGTH / 2 :
                                       scenarioNum == 6 ? INPUT_LENGTH * 2 :
                                                          INPUT_LENGTH;
    constexpr size_t output_size = output_length * sizeof(half);
    constexpr int32_t device_id = 0;

    aclrtStream stream = nullptr;
    half* src0_host = nullptr;
    half* src1_host = nullptr;
    half* dst_host = nullptr;
    half* src0_device = nullptr;
    half* src1_device = nullptr;
    half* dst_device = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&src0_host), input_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&src0_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/input_x.bin", src0_host, input_size);
    CHECK_ACL(aclrtMemcpy(src0_device, input_size, src0_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&src1_host), input_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&src1_device), input_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/input_y.bin", src1_host, input_size);
    CHECK_ACL(aclrtMemcpy(src1_device, input_size, src1_host, input_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&dst_host), output_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&dst_device), output_size, ACL_MEM_MALLOC_HUGE_FIRST));

    reg_load_store_align<<<1, 0, stream>>>(src0_device, src1_device, dst_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(dst_host, output_size, dst_device, output_size, ACL_MEMCPY_DEVICE_TO_HOST));
    WriteFile("./output/output.bin", dst_host, output_size);

    CHECK_ACL(aclrtFree(dst_device));
    CHECK_ACL(aclrtFree(src1_device));
    CHECK_ACL(aclrtFree(src0_device));
    CHECK_ACL(aclrtFreeHost(dst_host));
    CHECK_ACL(aclrtFreeHost(src1_host));
    CHECK_ACL(aclrtFreeHost(src0_host));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return 0;
}
