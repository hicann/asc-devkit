/* !
 * \file data_copy_ub2l1.asc
 * \brief Demonstrates UB-to-L1 matrix data movement with the Ascend C C API.
 */

#include <cstddef>
#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_BYTES = 32;
constexpr uint32_t C0_ELEMENTS = C0_BYTES / sizeof(half);

__aicore__ constexpr uint32_t ceil_align(uint32_t numerator, uint32_t denominator)
{
    return AscendC::Std::ceil_div(numerator, denominator) * denominator;
}

constexpr uint16_t M = 127;
constexpr uint16_t K = 129;
constexpr uint16_t N = 130;
constexpr uint16_t M_ALIGN = ceil_align(M, CUBE_BLOCK);
constexpr uint16_t K_ALIGN = ceil_align(K, C0_ELEMENTS);
constexpr uint16_t N_ALIGN = ceil_align(N, C0_ELEMENTS);

constexpr uint32_t A_ELEMENTS = M * K;
constexpr uint32_t B_ELEMENTS = K * N;
constexpr uint32_t C_ELEMENTS = M * N;
constexpr uint32_t A_BYTES = A_ELEMENTS * sizeof(half);
constexpr uint32_t B_BYTES = B_ELEMENTS * sizeof(half);

constexpr uint32_t A_L1_ELEMENTS = M_ALIGN * K_ALIGN;
constexpr uint32_t B_L1_ELEMENTS = K_ALIGN * N_ALIGN;
constexpr uint32_t C_L0_ELEMENTS = M_ALIGN * N_ALIGN;
constexpr uint32_t A_L1_BYTES = A_L1_ELEMENTS * sizeof(half);
constexpr uint32_t B_L1_BYTES = B_L1_ELEMENTS * sizeof(half);

constexpr uint8_t L2_CACHE_NORMAL = 0;
constexpr uint8_t UNIT_FLAG_DISABLE = 0;
constexpr int64_t CROSS_CORE_FLAG_ID = 0x8;
constexpr uint64_t AIV_TO_AIC_SYNC_ID = 0x1;
constexpr uint64_t AIC_TO_AIV_SYNC_ID = 0x2;
constexpr uint64_t A_UB_OFFSET = 0;
constexpr uint64_t ROUNDTRIP_UB_OFFSET = A_L1_BYTES;
constexpr uint64_t A_L1_OFFSET = 0;

__aicore__ void copy_gm_nd_to_padded_ub(
    __ubuf__ half* dst, __gm__ half* src, uint16_t height, uint16_t width, uint16_t height_align, uint16_t width_align)
{
    asc_set_ndim_loop0_stride(1, 1);
    asc_set_ndim_loop1_stride(width_align, width);
    asc_set_ndim_loop2_stride(0, 0);
    asc_set_ndim_loop3_stride(0, 0);
    asc_set_ndim_loop4_stride(0, 0);

    half pad_value = 0.0;
    asc_set_ndim_pad_value(pad_value);

    asc_ndim_pad_count_config pad_count_config{};
    pad_count_config.loop1_rp_count = static_cast<uint8_t>(height_align - height);
    asc_set_ndim_pad_count(pad_count_config);

    asc_ndim_copy_gm2ub(
        dst, src, width, height, 1, 1, 1, 0, static_cast<uint8_t>(width_align - width), true,
        asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM);
}

__aicore__ void copy_ub_nd_to_nz(__ubuf__ half* dst, __ubuf__ half* src, uint16_t height, uint16_t width)
{
    const uint16_t column_blocks = width / C0_ELEMENTS;
    const uint16_t src_gap = column_blocks - 1;

    for (uint16_t column_block = 0; column_block < column_blocks; ++column_block) {
        asc_copy_ub2ub(
            dst + column_block * height * C0_ELEMENTS, src + column_block * C0_ELEMENTS, height, 1, src_gap, 0);
    }
}

__global__ __mix__(1, 2) void data_copy_ub2l1(__gm__ half* a, __gm__ half* b, __gm__ void* c)
{
    asc_init();

    if constexpr (SCENARIO_NUM == 3) {
        __cbuf__ half* a_l1 = (__cbuf__ half*)asc_get_phy_buf_addr(A_L1_OFFSET);
        __ubuf__ half* a_ub = (__ubuf__ half*)asc_get_phy_buf_addr(A_UB_OFFSET);
        __ubuf__ half* a_roundtrip_ub = (__ubuf__ half*)asc_get_phy_buf_addr(ROUNDTRIP_UB_OFFSET);

        if ASC_IS_AIV {
            const bool is_data_producer = asc_get_sub_block_id() == 0;
            if (is_data_producer) {
                asc_copy_gm2ub(a_ub, a, A_L1_BYTES);
                asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
                asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
                asc_copy_ub2l1(a_l1, a_ub, A_L1_BYTES);
            }
            asc_sync_block_arrive(PIPE_MTE3, CROSS_CORE_FLAG_ID);

            if (is_data_producer) {
                asc_sync_intra_arrive(PIPE_MTE3, AIV_TO_AIC_SYNC_ID);
                asc_sync_intra_wait(PIPE_MTE3, AIC_TO_AIV_SYNC_ID);
                asc_copy_ub2gm(c, a_roundtrip_ub, A_L1_BYTES);
            }
        }

        if ASC_IS_AIC {
            asc_sync_intra_wait(PIPE_MTE1, AIV_TO_AIC_SYNC_ID);
            asc_sync_block_wait(PIPE_MTE1, CROSS_CORE_FLAG_ID);
            asc_copy_l12ub_sync(a_roundtrip_ub, a_l1, false, 1, A_L1_BYTES / C0_BYTES, 0, 0);
            asc_sync_intra_arrive(PIPE_MTE1, AIC_TO_AIV_SYNC_ID);
        }
    } else {
        // A1 and B1 use separate L1 buffers shared by the AIV and AIC subcores.
        __cbuf__ half a_l1[A_L1_ELEMENTS];
        __cbuf__ half b_l1[B_L1_ELEMENTS];
        __ubuf__ half a_ub[A_L1_ELEMENTS];
        __ubuf__ half b_ub[B_L1_ELEMENTS];
        __ubuf__ half a_nz_ub[A_L1_ELEMENTS];
        __ubuf__ half b_nz_ub[B_L1_ELEMENTS];
        __ca__ half a_l0[A_L1_ELEMENTS];
        __cb__ half b_l0[B_L1_ELEMENTS];
        __cc__ float c_l0[C_L0_ELEMENTS];

        if ASC_IS_AIV {
            const bool is_data_producer = asc_get_sub_block_id() == 0;
            if (is_data_producer) {
                if constexpr (SCENARIO_NUM == 1) {
                    // The inputs are already stored in padded Nz layout.
                    asc_copy_gm2ub(a_ub, a, A_L1_BYTES);
                    asc_copy_gm2ub(b_ub, b, B_L1_BYTES);
                    asc_sync_notify(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
                    asc_sync_wait(PIPE_MTE2, PIPE_MTE3, EVENT_ID0);
                    asc_copy_ub2l1(a_l1, a_ub, A_L1_BYTES);
                    asc_copy_ub2l1(b_l1, b_ub, B_L1_BYTES);
                } else {
                    // Copy compact non-aligned ND inputs to padded UB buffers, then reorder to Nz.
                    copy_gm_nd_to_padded_ub(a_ub, a, M, K, M_ALIGN, K_ALIGN);
                    copy_gm_nd_to_padded_ub(b_ub, b, K, N, K_ALIGN, N_ALIGN);
                    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
                    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
                    copy_ub_nd_to_nz(a_nz_ub, a_ub, M_ALIGN, K_ALIGN);
                    copy_ub_nd_to_nz(b_nz_ub, b_ub, K_ALIGN, N_ALIGN);
                    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
                    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
                    asc_copy_ub2l1(a_l1, a_nz_ub, A_L1_BYTES);
                    asc_copy_ub2l1(b_l1, b_nz_ub, B_L1_BYTES);
                }
            }

            // All AIV subblocks participate in the block-level handshake; AIV0
            // additionally tells AIC that the actual L1 producer has arrived.
            asc_sync_block_arrive(PIPE_MTE3, CROSS_CORE_FLAG_ID);
            if (is_data_producer) {
                asc_sync_intra_arrive(PIPE_MTE3, AIV_TO_AIC_SYNC_ID);
            }
        }

        if ASC_IS_AIC {
            asc_sync_intra_wait(PIPE_MTE1, AIV_TO_AIC_SYNC_ID);
            asc_sync_block_wait(PIPE_MTE1, CROSS_CORE_FLAG_ID);
            asc_copy_l12l0a(
                a_l0, a_l1, 0, 0, AscendC::Std::ceil_div(M, CUBE_BLOCK), AscendC::Std::ceil_div(K, C0_ELEMENTS),
                AscendC::Std::ceil_div(M, CUBE_BLOCK), AscendC::Std::ceil_div(M, CUBE_BLOCK));
            asc_copy_l12l0b_transpose(
                b_l0, b_l1, 0, 0, AscendC::Std::ceil_div(K, CUBE_BLOCK), AscendC::Std::ceil_div(N, C0_ELEMENTS),
                AscendC::Std::ceil_div(K, CUBE_BLOCK), AscendC::Std::ceil_div(N, C0_ELEMENTS));
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

            asc_mmad(c_l0, a_l0, b_l0, M, K, N_ALIGN, UNIT_FLAG_DISABLE, false, false, true);
            asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

            // Configure one Nz matrix to be written back as a contiguous ND matrix.
            asc_set_l0c2gm_nz2nd(1, 2, M * N);
            asc_copy_l0c2gm(
                (__gm__ float*)c, c_l0, N, M, N, M_ALIGN, L2_CACHE_NORMAL, 0, 0,
                static_cast<uint64_t>(QuantMode_t::NoQuant), 0, false, true,
                static_cast<uint64_t>(QuantMode_post::NoConv), 0, false, 0, false, false, false, false);
        }
    }
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    constexpr bool is_roundtrip_scenario = SCENARIO_NUM == 3;
    constexpr size_t a_file_size = (SCENARIO_NUM == 2) ? A_BYTES : A_L1_BYTES;
    constexpr size_t b_file_size = (SCENARIO_NUM == 1) ? B_L1_BYTES : B_BYTES;
    constexpr size_t c_file_size = is_roundtrip_scenario ? A_L1_BYTES : C_ELEMENTS * sizeof(float);
    constexpr int32_t device_id = 0;

    uint8_t* a_host = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* c_host = nullptr;
    half* a_device = nullptr;
    half* b_device = nullptr;
    void* c_device = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ReadFile("./input/x1_gm.bin", a_host, a_file_size);
    CHECK_ACL(aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    if constexpr (!is_roundtrip_scenario) {
        CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size));
        CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
        ReadFile("./input/x2_gm.bin", b_host, b_file_size);
        CHECK_ACL(aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size));
    CHECK_ACL(aclrtMalloc(&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST));

    data_copy_ub2l1<<<1, 0, stream>>>(a_device, b_device, c_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST));
    WriteFile("./output/output.bin", c_host, c_file_size);

    CHECK_ACL(aclrtFree(c_device));
    CHECK_ACL(aclrtFreeHost(c_host));
    if constexpr (!is_roundtrip_scenario) {
        CHECK_ACL(aclrtFree(b_device));
        CHECK_ACL(aclrtFreeHost(b_host));
    }
    CHECK_ACL(aclrtFree(a_device));
    CHECK_ACL(aclrtFreeHost(a_host));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return 0;
}
