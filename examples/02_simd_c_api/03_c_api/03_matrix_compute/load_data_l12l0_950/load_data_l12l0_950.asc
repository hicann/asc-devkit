/* !
 * \file load_data_l12l0_950.asc
 * \brief 使用C API将Nz格式矩阵从L1 Buffer搬运到L0A/L0B Buffer，并完成矩阵乘计算。
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

#define ceil_align(value, alignment) (AscendC::Std::ceil_div((value), (alignment)) * (alignment))

constexpr uint32_t scenario_num = SCENARIO_NUM;
constexpr uint32_t matrix_m = 40;
constexpr uint32_t matrix_n = 50;
constexpr uint32_t matrix_k = 70;

// 场景1、2、7使用B8输入，场景3、4使用B16输入，场景5、6使用B32输入。
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2 || SCENARIO_NUM == 7
typedef int8_t input_t;
typedef int32_t output_t;
#elif SCENARIO_NUM == 3 || SCENARIO_NUM == 4
typedef half input_t;
typedef float output_t;
#else
typedef float input_t;
typedef float output_t;
#endif

// A转置输入时shape为[k, m]，否则为[m, k]；B转置输入时shape为[n, k]，否则为[k, n]。
constexpr bool is_a_transpose = scenario_num == 2 || scenario_num == 4 || scenario_num == 6 || scenario_num == 7;
constexpr bool is_b_transpose = !is_a_transpose;

// B8、B16、B32的小分形shape分别为[16, 32]、[16, 16]、[16, 8]。
// 转置搬运时，fractal_num表示拼成一个方型所需的连续小分形个数。
constexpr uint32_t fractal_m = 16;
constexpr uint32_t c0_size = 32 / sizeof(input_t);
constexpr bool is_b16 = sizeof(input_t) == 2;
constexpr bool is_b32 = sizeof(input_t) == 4;
constexpr uint32_t fractal_num = is_b16 ? 1 : 2;
// B8转置搬运的m_step必须是2的倍数。
constexpr uint32_t int8_m_step_align = 2;

// A矩阵在L1上为Nz排布。非转置输入按[m, k]对齐，转置输入按[k, m]对齐。
// B32转置时，col方向需要将2个小分形拼成方型；B8转置时，row方向需要拼接2个小分形。
constexpr uint32_t m_align_l1 =
    is_a_transpose ? ceil_align(matrix_m, c0_size*(is_b32 ? fractal_num : 1)) : ceil_align(matrix_m, fractal_m);
constexpr uint32_t ka_align_l1 =
    is_a_transpose ? ceil_align(matrix_k, fractal_m*(is_b32 ? 1 : fractal_num)) : ceil_align(matrix_k, c0_size);
// 场景2单次转置搬运会多搬一个无效分形，L0A的m轴需要按方型对齐。
// 场景7通过for循环跳过该无效分形，因此L0A的m轴只需按fractal_m对齐。
constexpr uint32_t m_align_l0_single_call =
    is_a_transpose ? ceil_align(matrix_m, fractal_m*(is_b32 ? 1 : fractal_num)) : ceil_align(matrix_m, fractal_m);
constexpr uint32_t m_align_l0 = scenario_num == 7 ? ceil_align(matrix_m, fractal_m) : m_align_l0_single_call;
constexpr uint32_t ka_align_l0 =
    is_a_transpose ? ceil_align(matrix_k, c0_size*(is_b32 ? fractal_num : 1)) : ceil_align(matrix_k, c0_size);

// B矩阵在L1上为Nz排布，在L0B上为Zn排布。各轴根据是否转置和方型分形要求进行对齐。
constexpr uint32_t kb_align_l1 =
    is_b_transpose ? ceil_align(matrix_k, c0_size) : ceil_align(matrix_k, fractal_m*(is_b32 ? 1 : fractal_num));
constexpr uint32_t n_align_l1 =
    is_b_transpose ? ceil_align(matrix_n, fractal_m) : ceil_align(matrix_n, c0_size*(is_b32 ? fractal_num : 1));
constexpr uint32_t kb_align_l0 =
    is_b_transpose ? ceil_align(matrix_k, c0_size) : ceil_align(matrix_k, c0_size*(is_b32 ? fractal_num : 1));
constexpr uint32_t n_align_l0 =
    is_b_transpose ? ceil_align(matrix_n, fractal_m) : ceil_align(matrix_n, fractal_m*(is_b32 ? 1 : fractal_num));

// Buffer数组按各轴对齐后的元素个数申请。
constexpr uint32_t a_l1_size = m_align_l1 * ka_align_l1;
constexpr uint32_t b_l1_size = kb_align_l1 * n_align_l1;
constexpr uint32_t a_l0_size = m_align_l0 * ka_align_l0;
constexpr uint32_t b_l0_size = kb_align_l0 * n_align_l0;
// 场景2的多搬分形参与asc_mmad计算，因此L0C的m轴按m_align_l0申请；其他场景按有效区域对齐。
constexpr uint32_t c_l0_size =
    scenario_num == 2 ? m_align_l0 * n_align_l0 : ceil_align(matrix_m, fractal_m) * ceil_align(matrix_n, fractal_m);

// GM(ND) -> L1(Nz)参数。dst_nz_c0_stride表示Nz矩阵中相邻Z分形的间隔，单位为32字节。
constexpr uint16_t gm2l1_matrix_num = 1;
constexpr uint16_t gm2l1_dst_nz_n_stride = 1;
constexpr uint16_t gm2l1_dst_nz_matrix_stride = 0;
constexpr uint64_t gm2l1_loop4_src_stride = 0;
constexpr bool gm2l1_enable_small_c0 = false;
constexpr uint16_t a_nd_rows = is_a_transpose ? matrix_k : matrix_m;
constexpr uint32_t a_nd_cols = is_a_transpose ? matrix_m : matrix_k;
constexpr uint16_t a_nz_c0_stride = is_a_transpose ? ka_align_l1 : m_align_l1;
constexpr uint16_t b_nd_rows = is_b_transpose ? matrix_n : matrix_k;
constexpr uint32_t b_nd_cols = is_b_transpose ? matrix_k : matrix_n;
constexpr uint16_t b_nz_c0_stride = is_b_transpose ? n_align_l1 : kb_align_l1;

// A矩阵L1 -> L0A参数。m_step、k_step表示row、col方向搬运的小分形个数。
// src_stride、dst_stride表示源、目的矩阵col方向相邻小分形的间隔，单位为512字节。
constexpr uint8_t a_m_step = scenario_num == 7 ? int8_m_step_align :
                                                 (is_a_transpose ? AscendC::Std::ceil_div(ka_align_l1, fractal_m) :
                                                                   AscendC::Std::ceil_div(m_align_l1, fractal_m));
constexpr uint8_t a_k_step = scenario_num == 7 ? AscendC::Std::ceil_div(m_align_l0, c0_size) :
                                                 (is_a_transpose ? AscendC::Std::ceil_div(m_align_l1, c0_size) :
                                                                   AscendC::Std::ceil_div(ka_align_l1, c0_size));
constexpr int16_t a_src_stride =
    is_a_transpose ? AscendC::Std::ceil_div(ka_align_l1, fractal_m) : AscendC::Std::ceil_div(m_align_l1, fractal_m);
constexpr uint16_t a_dst_stride = AscendC::Std::ceil_div(m_align_l0, fractal_m);
// 场景7沿L1 row方向（A矩阵k轴）分段搬运，每次搬运int8_m_step_align个小分形。
constexpr uint32_t a_loop_num = AscendC::Std::ceil_div(ka_align_l0, fractal_m* fractal_num);
// a_dst_offset为每次循环在L0A上的元素偏移，用于跳过m方向尾部的无效分形。
constexpr uint32_t a_dst_offset = ceil_align(m_align_l0, fractal_m) * c0_size;

// B矩阵L1 -> L0B参数，含义与A矩阵对应参数一致。
constexpr uint8_t b_m_step =
    is_b_transpose ? AscendC::Std::ceil_div(n_align_l1, fractal_m) : AscendC::Std::ceil_div(kb_align_l1, fractal_m);
constexpr uint8_t b_k_step =
    is_b_transpose ? AscendC::Std::ceil_div(kb_align_l1, c0_size) : AscendC::Std::ceil_div(n_align_l1, c0_size);
constexpr int16_t b_src_stride =
    is_b_transpose ? AscendC::Std::ceil_div(n_align_l1, fractal_m) : AscendC::Std::ceil_div(kb_align_l1, fractal_m);
constexpr uint16_t b_dst_stride = AscendC::Std::ceil_div(n_align_l0, fractal_m);

// 场景2需要让多搬的m方向无效分形参与计算；最终仅通过m_size搬出matrix_m行有效数据。
constexpr uint16_t mmad_m = scenario_num == 2 ? ceil_align(matrix_m, fractal_m* fractal_num) : matrix_m;
constexpr bool mmad_disable_gemv = false;
constexpr bool mmad_c_matrix_source = false;
constexpr bool mmad_c_matrix_init_val = true;

// L0C(Nz) -> GM(ND)参数。仅搬出一个矩阵，相邻矩阵stride设置为0。
constexpr uint16_t l0c_matrix_num = 1;
constexpr uint16_t l0c_src_nz_matrix_stride = 0;
constexpr uint32_t l0c_dst_matrix_stride = 0;
constexpr uint16_t l0c_src_stride =
    scenario_num == 2 ? ceil_align(matrix_m, fractal_m* fractal_num) : ceil_align(matrix_m, fractal_m);
constexpr bool l0c_enable_channel_split = false;
constexpr bool l0c_enable_nz2nd = true;
constexpr bool l0c_enable_nz2dn = false;
constexpr bool l0c_enable_clip_relu_pre = false;

__global__ __cube__ void load_data_l12l0_950_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();

    __cbuf__ input_t a_l1[a_l1_size];
    __cbuf__ input_t b_l1[b_l1_size];
    __ca__ input_t a_l0[a_l0_size];
    __cb__ input_t b_l0[b_l0_size];
    __cc__ output_t c_l0[c_l0_size];

    // GM(ND) -> L1(Nz)：分别根据A、B的输入shape配置ND矩阵行列数和目的Nz排布。
    asc_set_gm2l1_nz_para(gm2l1_matrix_num, gm2l1_dst_nz_n_stride, a_nz_c0_stride, gm2l1_dst_nz_matrix_stride);
    asc_copy_gm2l1_nd2nz(
        a_l1, (__gm__ input_t*)a, a_nd_cols * sizeof(input_t), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, a_nd_rows,
        a_nd_cols, gm2l1_loop4_src_stride, gm2l1_enable_small_c0);

    asc_set_gm2l1_nz_para(gm2l1_matrix_num, gm2l1_dst_nz_n_stride, b_nz_c0_stride, gm2l1_dst_nz_matrix_stride);
    asc_copy_gm2l1_nd2nz(
        b_l1, (__gm__ input_t*)b, b_nd_cols * sizeof(input_t), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, b_nd_rows,
        b_nd_cols, gm2l1_loop4_src_stride, gm2l1_enable_small_c0);

    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    // L1(Nz) -> L0A(Nz)/L0B(Zn).
#if SCENARIO_NUM == 7
    for (uint32_t loop_idx = 0; loop_idx < a_loop_num; ++loop_idx) {
        asc_copy_l12l0a_transpose(
            a_l0 + loop_idx * a_dst_offset, a_l1, int8_m_step_align * loop_idx, 0, a_m_step, a_k_step, a_src_stride,
            a_dst_stride);
    }
#elif SCENARIO_NUM == 2 || SCENARIO_NUM == 4 || SCENARIO_NUM == 6
    asc_copy_l12l0a_transpose(a_l0, a_l1, 0, 0, a_m_step, a_k_step, a_src_stride, a_dst_stride);
#else
    asc_copy_l12l0a(a_l0, a_l1, 0, 0, a_m_step, a_k_step, a_src_stride, a_dst_stride);
#endif

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 3 || SCENARIO_NUM == 5
    asc_copy_l12l0b(b_l0, b_l1, 0, 0, b_m_step, b_k_step, b_src_stride, b_dst_stride);
#else
    asc_copy_l12l0b_transpose(b_l0, b_l1, 0, 0, b_m_step, b_k_step, b_src_stride, b_dst_stride);
#endif

    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

    asc_mmad(
        c_l0, a_l0, b_l0, mmad_m, matrix_k, matrix_n, asc_unit_flag_mode::DISABLE, mmad_disable_gemv,
        mmad_c_matrix_source, mmad_c_matrix_init_val);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

    // L0C(Nz) -> GM(ND).
    asc_set_l0c_copy_nz_para(l0c_matrix_num, l0c_src_nz_matrix_stride, l0c_dst_matrix_stride);
    asc_copy_l0c2gm(
        (__gm__ output_t*)c, c_l0, matrix_n, matrix_m, matrix_n, l0c_src_stride,
        asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, asc_unit_flag_mode::DISABLE, asc_quant_mode::NoQuant,
        asc_relu_pre_mode::NONE, l0c_enable_channel_split, l0c_enable_nz2nd, l0c_enable_nz2dn,
        l0c_enable_clip_relu_pre);
    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    size_t a_file_size = matrix_m * matrix_k * sizeof(input_t);
    size_t b_file_size = matrix_n * matrix_k * sizeof(input_t);
    size_t c_file_size = matrix_m * matrix_n * sizeof(output_t);

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    aclrtMallocHost((void**)(&a_host), a_file_size);
    aclrtMalloc((void**)&a_device, a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    aclrtMallocHost((void**)(&b_host), b_file_size);
    aclrtMalloc((void**)&b_device, b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    read_file("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    aclrtMallocHost((void**)(&c_host), c_file_size);
    aclrtMalloc((void**)&c_device, c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    load_data_l12l0_950_custom<<<1, 0, stream>>>(a_device, b_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    write_file("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(c_device);
    aclrtFreeHost(c_host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
