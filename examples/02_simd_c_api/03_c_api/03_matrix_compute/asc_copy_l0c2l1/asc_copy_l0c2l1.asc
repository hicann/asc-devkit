/* !
 * \file asc_copy_l0c2l1.asc
 * \brief Demonstrates copying matrix-multiplication results from L0C Buffer to L1
 * Buffer.
 */

#include <type_traits>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"

#include "data_utils.h"

constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t K_ROUND = 2;
constexpr uint16_t LIMIT_MNSIZE = 10;
constexpr uint16_t ALIGN_NUM = 16;

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void asc_copy_l0c2l1_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, __gm__ uint8_t* quant_alpha)
{
    asc_init();
    constexpr uint32_t base_m = M;
    constexpr uint32_t base_k = K / K_ROUND;
    constexpr uint32_t base_n = N;
    constexpr bool is_quantized = SCENARIO_NUM == 2 || SCENARIO_NUM == 3;
    using output_type = typename std::conditional<is_quantized, int8_t, half>::type;

    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);
    __gm__ uint64_t* quant_alpha_gm = reinterpret_cast<__gm__ uint64_t*>(quant_alpha);
    __cbuf__ half a1_local[base_m * base_k];
    __ca__ half a2_local[base_m * base_k];
    __cbuf__ half b1_local[base_k * base_n];
    __cb__ half b2_local[base_k * base_n];
    __cc__ float c_local[base_m * base_n];
    __cbuf__ output_type c1_local[base_m * base_n];

    for (uint32_t k_index = 0; k_index < K_ROUND; ++k_index) {
        uint16_t dst_nz_c0_stride = static_cast<uint16_t>(AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK);
        asc_set_gm2l1_nz_para(1, 1, dst_nz_c0_stride, 0);
        asc_copy_gm2l1_nd2nz(
            a1_local, a_gm + k_index * base_m * base_k, base_k * sizeof(half),
            asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_m, base_k, 0, false);
        dst_nz_c0_stride = static_cast<uint16_t>(AscendC::Std::ceil_div(base_k, CUBE_BLOCK) * CUBE_BLOCK);
        asc_set_gm2l1_nz_para(1, 1, dst_nz_c0_stride, 0);
        asc_copy_gm2l1_nd2nz(
            b1_local, b_gm + k_index * base_k * base_n, base_n * sizeof(half),
            asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_k, base_n, 0, false);
        asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
        asc_copy_l12l0a(
            a2_local, a1_local, 0, 0, AscendC::Std::ceil_div(base_m, CUBE_BLOCK),
            AscendC::Std::ceil_div(base_k, C0_SIZE / sizeof(half)), AscendC::Std::ceil_div(base_m, CUBE_BLOCK),
            AscendC::Std::ceil_div(base_m, CUBE_BLOCK));
        asc_copy_l12l0b_transpose(
            b2_local, b1_local, 0, 0, AscendC::Std::ceil_div(base_k, CUBE_BLOCK),
            AscendC::Std::ceil_div(base_n, C0_SIZE / sizeof(half)), AscendC::Std::ceil_div(base_k, CUBE_BLOCK),
            AscendC::Std::ceil_div(base_n, CUBE_BLOCK));
        asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID0);
        asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
        asc_mmad(
            c_local, a2_local, b2_local, base_m, base_k, AscendC::Std::ceil_div(base_n, C0_SIZE) * C0_SIZE,
            asc_unit_flag_mode::DISABLE, false, false, k_index == 0);
        if ((base_m / ALIGN_NUM) * (base_n / ALIGN_NUM) < LIMIT_MNSIZE) {
            asc_sync_pipe(PIPE_M);
        }
        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
    }

    if constexpr (SCENARIO_NUM == 3) {
        __cbuf__ uint64_t quant_alpha_tensor[base_n];
        __fbuf__ uint64_t quant_alpha_fbuf[base_n];
        asc_sync_notify(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        asc_sync_wait(PIPE_FIX, PIPE_MTE2, EVENT_ID0);
        uint16_t burst_len = static_cast<uint16_t>(AscendC::Std::ceil_div(base_n * sizeof(uint64_t), 128) * 128 / 32);
        asc_copy_gm2l1(
            (__cbuf__ void*)quant_alpha_tensor, (__gm__ void*)quant_alpha_gm, 1, burst_len, asc_channel_pad_mode::NONE,
            0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_MTE2, PIPE_FIX, EVENT_ID0);
        asc_copy_l12fb(
            (__fbuf__ void*)quant_alpha_fbuf, (__cbuf__ void*)quant_alpha_tensor, 1,
            AscendC::Std::ceil_div(base_n * sizeof(uint64_t), 128) * 128 / 64, 0, 0);
        uint64_t quant_alpha_fbuf_addr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(quant_alpha_fbuf)) / 128;
        asc_set_l0c_copy_config(0, quant_alpha_fbuf_addr, false);
        asc_sync_pipe(PIPE_FIX);
    }

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    constexpr uint16_t c0_size = C0_SIZE / sizeof(output_type);
    constexpr uint32_t dst_stride = base_m * c0_size;
    if constexpr (SCENARIO_NUM == 1) {
        asc_copy_l0c2l1(
            c1_local, c_local, AscendC::Std::ceil_div(base_n, c0_size) * c0_size, base_m, dst_stride,
            AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK, asc_unit_flag_mode::DISABLE,
            asc_quant_mode::F322F16, asc_relu_pre_mode::NONE, false, false, false, false);
    } else if constexpr (SCENARIO_NUM == 2) {
        asc_set_l0c_copy_prequant(2.0F, 0, true);
        asc_copy_l0c2l1(
            c1_local, c_local, base_n, base_m, dst_stride, AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK,
            asc_unit_flag_mode::DISABLE, asc_quant_mode::QF322B8_PRE, asc_relu_pre_mode::NONE, false, false, false,
            false);
    } else if constexpr (SCENARIO_NUM == 3) {
        asc_copy_l0c2l1(
            c1_local, c_local, base_n, base_m, dst_stride, AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK,
            asc_unit_flag_mode::DISABLE, asc_quant_mode::VQF322B8_PRE, asc_relu_pre_mode::NONE, false, false, false,
            false);
    } else if constexpr (SCENARIO_NUM == 4) {
        asc_copy_l0c2l1(
            c1_local, c_local, AscendC::Std::ceil_div(base_n, c0_size) * c0_size, base_m, dst_stride,
            AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK, asc_unit_flag_mode::DISABLE,
            asc_quant_mode::F322F16, asc_relu_pre_mode::NORMAL, false, false, false, false);
    }

    asc_set_l0c_copy_nz_para(1, 0, 0);
    asc_copy_l0c2gm(
        c_gm, c_local, base_n, base_m, base_n, AscendC::Std::ceil_div(base_m, CUBE_BLOCK) * CUBE_BLOCK,
        asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, asc_unit_flag_mode::DISABLE, asc_quant_mode::NoQuant,
        asc_relu_pre_mode::NONE, false, true, false, false);
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 128;
    size_t a_file_size = M * K * sizeof(half);
    size_t b_file_size = K * N * sizeof(half);
    size_t c_file_size = M * N * sizeof(float);

    size_t quant_alpha_size = 1 * N * sizeof(uint64_t);
    uint32_t num_blocks = 1;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    uint8_t* quant_alpha_host = nullptr;
    uint8_t* quant_alpha_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    auto cleanup = [&]() {
        if (quant_alpha_device != nullptr) {
            CHECK_ACL(aclrtFree(quant_alpha_device));
        }
        if (quant_alpha_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(quant_alpha_host));
        }
        if (c_device != nullptr) {
            CHECK_ACL(aclrtFree(c_device));
        }
        if (c_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(c_host));
        }
        if (b_device != nullptr) {
            CHECK_ACL(aclrtFree(b_device));
        }
        if (b_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(b_host));
        }
        if (a_device != nullptr) {
            CHECK_ACL(aclrtFree(a_device));
        }
        if (a_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(a_host));
        }
        if (stream != nullptr) {
            CHECK_ACL(aclrtDestroyStream(stream));
        }
        if (device_set) {
            CHECK_ACL(aclrtResetDevice(device_id));
        }
        if (acl_initialized) {
            CHECK_ACL(aclFinalize());
        }
    };

    CHECK_ACL(aclInit(nullptr));
    acl_initialized = true;
    CHECK_ACL(aclrtSetDevice(device_id));
    device_set = true;
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST));

    // vector quant mode
    if constexpr (SCENARIO_NUM == 3) {
        CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&quant_alpha_host), quant_alpha_size));
        CHECK_ACL(
            aclrtMalloc(reinterpret_cast<void**>(&quant_alpha_device), quant_alpha_size, ACL_MEM_MALLOC_HUGE_FIRST));
        if (!ReadFile("./input/quant_pre.bin", quant_alpha_size, quant_alpha_host, quant_alpha_size)) {
            cleanup();
            return 1;
        }
        CHECK_ACL(aclrtMemcpy(
            quant_alpha_device, quant_alpha_size, quant_alpha_host, quant_alpha_size, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    asc_copy_l0c2l1_custom<M, K, N><<<num_blocks, 0, stream>>>(a_device, b_device, c_device, quant_alpha_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    CHECK_ACL(aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST));
    bool write_success = WriteFile("./output/output.bin", c_host, c_file_size);

    cleanup();
    return write_success ? 0 : 1;
}
