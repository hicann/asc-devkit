/* !
 * \file asc_copy_l0c2ub.asc
 * \brief 本样例介绍如何使用asc_copy_l0c2ub将矩阵乘的结果从L0C Buffer搬出到UB（Unified Buffer）
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"

#include "data_utils.h"

// half格式, cube block: [16, 16]
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t C0_SIZE = 32;
constexpr uint32_t CUBE_BLOCK_SIZE = 16 * 16;

constexpr uint32_t K_ROUND = 2;

constexpr static uint16_t LIMIT_MNSIZE = 10;
constexpr static uint16_t ALIGN_NUM = 16;

constexpr int64_t OUTPUT_READY_FLAG = 0x8;

__aicore__ constexpr uint16_t ceil_align(uint16_t numerator, uint16_t denominator)
{
    return static_cast<uint16_t>(AscendC::Std::ceil_div(numerator, denominator) * denominator);
}

template <class input_type, uint32_t base_m, uint32_t base_k>
__aicore__ inline void split_a(__cbuf__ input_type* a1_local, __ca__ input_type* a2_local)
{
    constexpr uint32_t m_block_count = static_cast<uint32_t>(AscendC::Std::ceil_div(base_m, CUBE_BLOCK));
    constexpr uint32_t k_block_count =
        static_cast<uint32_t>(AscendC::Std::ceil_div(base_k, C0_SIZE / sizeof(input_type)));
    asc_copy_l12l0a(
        a2_local, a1_local, 0, 0, static_cast<uint8_t>(m_block_count), static_cast<uint8_t>(k_block_count),
        static_cast<int16_t>(m_block_count), static_cast<uint16_t>(m_block_count));
}

template <class input_type, uint32_t base_k, uint32_t base_n>
__aicore__ inline void split_b(__cbuf__ input_type* b1_local, __cb__ input_type* b2_local)
{
    constexpr uint32_t c0_elements = C0_SIZE / sizeof(input_type);
    constexpr uint32_t n_block_count = static_cast<uint32_t>(AscendC::Std::ceil_div(base_n, c0_elements));
    constexpr uint32_t k_block_count = static_cast<uint32_t>(AscendC::Std::ceil_div(base_k, c0_elements));
    constexpr uint32_t src_stride_value = static_cast<uint32_t>(AscendC::Std::ceil_div(base_k, CUBE_BLOCK));
    constexpr uint32_t dst_offset = n_block_count * CUBE_BLOCK_SIZE;
    constexpr uint32_t src_offset = CUBE_BLOCK_SIZE;
    constexpr uint8_t repeat = static_cast<uint8_t>(n_block_count);
    constexpr uint16_t src_stride = static_cast<uint16_t>(src_stride_value);
    for (uint32_t i = 0; i < k_block_count; ++i) {
        asc_copy_l12l0b_trans(
            b2_local + i * dst_offset, b1_local + i * src_offset, static_cast<uint16_t>(0), repeat, src_stride,
            static_cast<uint16_t>(0), static_cast<uint16_t>(0), static_cast<uint16_t>(0));
    }
}

template <class output_type, uint32_t base_m, uint32_t base_n>
__aicore__ inline void copy_aiv_result_to_gm(__gm__ output_type* c_gm, __ubuf__ output_type* c_ub)
{
    asc_sync_block_wait(PIPE_MTE3, OUTPUT_READY_FLAG);
    if constexpr (SCENARIO_NUM == 1 || SCENARIO_NUM == 2) {
        if (asc_get_sub_block_id() != 0) {
            return;
        }
        asc_copy_ub2gm_align((__gm__ uint8_t*)c_gm, (__ubuf__ uint8_t*)c_ub, base_m * base_n * sizeof(output_type));
    } else if constexpr (SCENARIO_NUM == 3) {
        constexpr uint32_t offset = base_m / 2 * base_n;
        asc_copy_ub2gm_align(
            (__gm__ uint8_t*)(c_gm + asc_get_sub_block_id() * offset), (__ubuf__ uint8_t*)c_ub,
            base_m / 2 * base_n * sizeof(output_type));
    } else if constexpr (SCENARIO_NUM == 4) {
        constexpr uint16_t block_count = static_cast<uint16_t>(base_m);
        constexpr uint16_t block_len = static_cast<uint16_t>(base_n / 2 * sizeof(output_type));
        constexpr uint16_t dst_stride = static_cast<uint16_t>(base_n * sizeof(output_type));
        constexpr uint16_t src_stride = block_len;
        constexpr uint32_t offset = base_n / 2;
        asc_copy_ub2gm(
            (__gm__ void*)(c_gm + asc_get_sub_block_id() * offset), (__ubuf__ void*)c_ub, block_count, block_len,
            dst_stride, src_stride);
    }
}

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __mix__(1, 2) void asc_copy_l0c2ub_custom(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c)
{
    asc_init();
    constexpr uint32_t base_m = M;
    constexpr uint32_t base_k = K / K_ROUND;
    constexpr uint32_t base_n = N;
    __gm__ half* a_gm = reinterpret_cast<__gm__ half*>(a);
    __gm__ half* b_gm = reinterpret_cast<__gm__ half*>(b);
    __gm__ float* c_gm = reinterpret_cast<__gm__ float*>(c);
    __ubuf__ float* c_ub = reinterpret_cast<__ubuf__ float*>(0);

    if ASC_IS_AIC {
        __cbuf__ half a1_local[base_m * base_k];
        __ca__ half a2_local[base_m * base_k];
        __cbuf__ half b1_local[base_k * base_n];
        __cb__ half b2_local[base_k * base_n];
        __cc__ float c_local[base_m * base_n];
        for (uint32_t k_index = 0; k_index < K_ROUND; ++k_index) {
            if (k_index != 0) {
                asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
            }
            constexpr uint16_t matrix_num = 1;
            constexpr uint16_t dst_nz_n_stride = 1;
            constexpr uint16_t dst_nz_matrix_stride = 0;
            uint16_t dst_nz_c0_stride = ceil_align(base_m, CUBE_BLOCK);
            asc_set_gm2l1_nz_para(matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride);
            asc_copy_gm2l1_nd2nz(
                a1_local, a_gm + k_index * base_m * base_k, base_k * sizeof(half),
                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_m, base_k, 0, false);

            dst_nz_c0_stride = ceil_align(base_k, CUBE_BLOCK);
            asc_set_gm2l1_nz_para(matrix_num, dst_nz_n_stride, dst_nz_c0_stride, dst_nz_matrix_stride);
            asc_copy_gm2l1_nd2nz(
                b1_local, b_gm + k_index * base_k * base_n, base_n * sizeof(half),
                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, base_k, base_n, 0, false);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
            split_a<half, base_m, base_k>(a1_local, a2_local);
            split_b<half, base_k, base_n>(b1_local, b2_local);
            asc_sync_notify(PIPE_MTE1, PIPE_MTE2, EVENT_ID1);
            asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);
            bool c_matrix_init_val = k_index == 0;
            asc_mmad(
                c_local, a2_local, b2_local, base_m, base_k, ceil_align(base_n, C0_SIZE), asc_unit_flag_mode::DISABLE,
                false, false, c_matrix_init_val);
            if ((base_m / ALIGN_NUM) * (base_n / ALIGN_NUM) < LIMIT_MNSIZE) {
                asc_sync_pipe(PIPE_M);
            }
            asc_sync_notify(PIPE_M, PIPE_MTE2, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_MTE2, EVENT_ID0);
        }
        asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
        asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
        constexpr auto unit_flag_mode = asc_unit_flag_mode::DISABLE;
        constexpr auto quant_mode = asc_quant_mode::NoQuant;
        constexpr auto relu_mode = asc_relu_pre_mode::NONE;
        if constexpr (SCENARIO_NUM == 1) {
            constexpr uint16_t c0_size = 16;
            asc_copy_l0c2ub(
                c_ub, c_local, ceil_align(base_n, c0_size), base_m, base_m * c0_size, ceil_align(base_m, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_DISABLE, unit_flag_mode, quant_mode, relu_mode, false, false, false, false);
        } else if constexpr (SCENARIO_NUM == 2) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                c_ub, c_local, base_n, base_m, base_n, ceil_align(base_m, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_DISABLE, unit_flag_mode, quant_mode, relu_mode, false, true, false, false);
        } else if constexpr (SCENARIO_NUM == 3) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                c_ub, c_local, base_n, ceil_align(base_m, 2), base_n, ceil_align(base_m, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_M, unit_flag_mode, quant_mode, relu_mode, false, true, false, false);
        } else if constexpr (SCENARIO_NUM == 4) {
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2ub(
                c_ub, c_local, ceil_align(base_n, 32), base_m, base_n / 2, ceil_align(base_m, CUBE_BLOCK), 0,
                asc_dual_dst_mode::DUAL_DST_SPLIT_N, unit_flag_mode, quant_mode, relu_mode, false, true, false, false);
        }
        asc_sync_block_arrive(PIPE_FIX, OUTPUT_READY_FLAG);
    }
    if ASC_IS_AIV {
        copy_aiv_result_to_gm<float, base_m, base_n>(c_gm, c_ub);
    }
    asc_sync_pipe(PIPE_ALL);
}

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    // A No Trans, B No Trans
    constexpr uint32_t M = 128;
    constexpr uint32_t K = 128;
    constexpr uint32_t N = 256;
    size_t a_file_size = M * K * sizeof(half);
    size_t b_file_size = K * N * sizeof(half);
    size_t c_file_size = M * N * sizeof(float);
    uint32_t num_blocks = 1;

    int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint8_t* a_host = nullptr;
    uint8_t* a_device = nullptr;
    uint8_t* b_host = nullptr;
    uint8_t* b_device = nullptr;
    uint8_t* c_host = nullptr;
    uint8_t* c_device = nullptr;
    bool acl_initialized = false;
    bool device_set = false;
    auto cleanup = [&]() {
        if (c_device != nullptr) {
            CHECK_ACL(aclrtFree(c_device));
        }
        if (c_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(c_host));
        }
        if (b_device != nullptr) {
            CHECK_ACL(aclrtFree(b_device));
        }
        if (b_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(b_host));
        }
        if (a_device != nullptr) {
            CHECK_ACL(aclrtFree(a_device));
        }
        if (a_host != nullptr) {
            CHECK_ACL(aclrtFreeHost(a_host));
        }
        if (stream != nullptr) {
            CHECK_ACL(aclrtDestroyStream(stream));
        }
        if (device_set) {
            CHECK_ACL(aclrtResetDevice(device_id));
        }
        if (acl_initialized) {
            CHECK_ACL(aclFinalize());
        }
    };

    CHECK_ACL(aclInit(nullptr));
    acl_initialized = true;
    CHECK_ACL(aclrtSetDevice(device_id));
    device_set = true;
    CHECK_ACL(aclrtCreateStream(&stream));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST));
    if (!ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size)) {
        cleanup();
        return 1;
    }
    CHECK_ACL(aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST));

    asc_copy_l0c2ub_custom<M, K, N><<<num_blocks, 0, stream>>>(a_device, b_device, c_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));

    CHECK_ACL(aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST));
    bool write_success = WriteFile("./output/output.bin", c_host, c_file_size);

    cleanup();
    return write_success ? 0 : 1;
}
