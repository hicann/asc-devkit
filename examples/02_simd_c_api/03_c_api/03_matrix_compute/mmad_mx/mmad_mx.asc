/* !
 * \file mmad_mx.asc
 * \brief C API MX matrix multiplication example.
 */

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))
#define CEIL_ALIGN(a, b) (CEIL_DIV((a), (b)) * (b))

constexpr uint32_t SCENARIO = SCENARIO_NUM;
constexpr bool HAS_BIAS_TENSOR = (SCENARIO == 2);

constexpr uint32_t BLOCK_CUBE = 16;
constexpr uint32_t SCALE_BLOCK = 32;
constexpr uint32_t SCALE_EVEN_NUMBER = 2;
constexpr uint32_t M = 40;
constexpr uint32_t N = 50;
constexpr uint32_t K = 70;

#if SCENARIO_NUM == 1
using AType = fp4x2_e1m2_t;
using BType = fp4x2_e2m1_t;
#elif SCENARIO_NUM == 2
using AType = fp4x2_e2m1_t;
using BType = fp4x2_e1m2_t;
#elif SCENARIO_NUM == 3
using AType = fp8_e4m3fn_t;
using BType = fp8_e5m2_t;
#endif

constexpr uint32_t FRACTAL_K = (SCENARIO <= 2) ? 64 : 32;
constexpr uint32_t PACKED_K = (SCENARIO <= 2) ? CEIL_DIV(K, 2) : K;
constexpr uint32_t SCALE_K = CEIL_DIV(K, 64) * SCALE_EVEN_NUMBER;
constexpr uint32_t ALIGN_K = CEIL_ALIGN(K, 64);
constexpr uint32_t M_ALIGN = CEIL_ALIGN(M, BLOCK_CUBE);
constexpr uint32_t N_ALIGN = CEIL_ALIGN(N, BLOCK_CUBE);

constexpr uint32_t A_L1_SIZE = M_ALIGN * ALIGN_K;
constexpr uint32_t B_L1_SIZE = N_ALIGN * ALIGN_K;
constexpr uint32_t SCALE_A_L1_SIZE = M_ALIGN * SCALE_K;
constexpr uint32_t SCALE_B_L1_SIZE = N_ALIGN * SCALE_K;
constexpr uint32_t BIAS_BYTES = CEIL_ALIGN(CEIL_DIV(N * sizeof(float), 32), 2) * 32;
constexpr uint32_t BIAS_SIZE = BIAS_BYTES / sizeof(float);
constexpr uint32_t A_L0_SIZE = M_ALIGN * ALIGN_K;
constexpr uint32_t B_L0_SIZE = ALIGN_K * N_ALIGN;
constexpr uint32_t C_L0_SIZE = M_ALIGN * N_ALIGN;

__aicore__ inline void set_gm2l1_nz_config(uint16_t dst_c0_stride)
{
    uint64_t config = (static_cast<uint64_t>(dst_c0_stride) << 32) | (static_cast<uint64_t>(1) << 16) | 1;
    asc_set_gm2l1_nz_para(config);
}

__aicore__ inline void copy_matrix_a_to_l1(__cbuf__ AType* dst, __gm__ AType* src)
{
    set_gm2l1_nz_config(M_ALIGN);
    asc_copy_gm2l1_nd2nz(
        reinterpret_cast<__cbuf__ uint8_t*>(dst), reinterpret_cast<__gm__ uint8_t*>(src), PACKED_K, 0, M, PACKED_K, 0,
        false);
}

__aicore__ inline void copy_scale_a_to_l1(__cbuf__ fp8_e8m0_t* dst, __gm__ fp8_e8m0_t* src)
{
    set_gm2l1_nz_config(SCALE_K / 2);
    asc_copy_gm2l1_dn2nz(
        reinterpret_cast<__cbuf__ half*>(dst), reinterpret_cast<__gm__ half*>(src), SCALE_K, 0, SCALE_K / 2, M, 0,
        false);
}

__aicore__ inline void copy_matrix_b_to_l1(__cbuf__ BType* dst, __gm__ BType* src)
{
    set_gm2l1_nz_config(N_ALIGN);
    asc_copy_gm2l1_nd2nz(
        reinterpret_cast<__cbuf__ uint8_t*>(dst), reinterpret_cast<__gm__ uint8_t*>(src), PACKED_K, 0, N, PACKED_K, 0,
        false);
}

__aicore__ inline void copy_scale_b_to_l1(__cbuf__ fp8_e8m0_t* dst, __gm__ fp8_e8m0_t* src)
{
    set_gm2l1_nz_config(SCALE_K / 2);
    asc_copy_gm2l1_dn2nz(
        reinterpret_cast<__cbuf__ half*>(dst), reinterpret_cast<__gm__ half*>(src), SCALE_K, 0, SCALE_K / 2, N, 0,
        false);
}

__aicore__ inline void copy_bias_to_l1(__cbuf__ float* dst, __gm__ float* src)
{
    set_gm2l1_nz_config(1);
    asc_copy_gm2l1_nd2nz(dst, src, N * sizeof(float), 0, 1, N, 0, false);
}

__aicore__ inline void fill_zero_in_a_l1(__cbuf__ AType* dst)
{
    constexpr uint32_t dst_offset = M_ALIGN * (CEIL_ALIGN(PACKED_K, SCALE_BLOCK) / 2);
    asc_fill_value_config config;
    config.repeat = M_ALIGN;
    config.blk_num = 1;
    config.dst_gap = 0;
    asc_fill_l1(reinterpret_cast<__cbuf__ uint16_t*>(dst) + dst_offset, 0U, config);
}

__aicore__ inline void fill_zero_in_b_l1(__cbuf__ BType* dst)
{
    constexpr uint32_t dst_offset = N_ALIGN * (CEIL_ALIGN(PACKED_K, SCALE_BLOCK) / 2);
    asc_fill_value_config config;
    config.repeat = N_ALIGN;
    config.blk_num = 1;
    config.dst_gap = 0;
    asc_fill_l1(reinterpret_cast<__cbuf__ uint16_t*>(dst) + dst_offset, 0U, config);
}

__aicore__ inline void copy_a_to_l0(__ca__ AType* dst, __cbuf__ AType* src, __cbuf__ fp8_e8m0_t* scale_src)
{
    asc_copy_l12l0a(
        dst, src, 0, 0, CEIL_DIV(M_ALIGN, BLOCK_CUBE), CEIL_DIV(ALIGN_K, FRACTAL_K), CEIL_DIV(M_ALIGN, BLOCK_CUBE),
        CEIL_DIV(M_ALIGN, BLOCK_CUBE));

    uint64_t mx_dst_addr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(dst)) / 16;
    asc_copy_l12l0a_mx(
        mx_dst_addr, scale_src, 0, 0, CEIL_DIV(M_ALIGN, BLOCK_CUBE), SCALE_K / 2, SCALE_K / 2, SCALE_K / 2);
}

__aicore__ inline void copy_b_to_l0(__cb__ BType* dst, __cbuf__ BType* src, __cbuf__ fp8_e8m0_t* scale_src)
{
    asc_copy_l12l0b(
        dst, src, 0, 0, CEIL_DIV(N_ALIGN, BLOCK_CUBE), CEIL_DIV(ALIGN_K, FRACTAL_K), CEIL_DIV(N_ALIGN, BLOCK_CUBE),
        CEIL_DIV(N_ALIGN, BLOCK_CUBE));

    uint64_t mx_dst_addr = static_cast<uint64_t>(reinterpret_cast<uintptr_t>(dst)) / 16;
    asc_copy_l12l0b_mx(
        mx_dst_addr, scale_src, 0, 0, CEIL_DIV(N_ALIGN, BLOCK_CUBE), SCALE_K / 2, SCALE_K / 2, SCALE_K / 2);
}

__aicore__ inline void compute_mmad_mx(__cc__ float* c_matrix, __ca__ AType* a_matrix, __cb__ BType* b_matrix)
{
    constexpr uint16_t left_height = M;
    constexpr uint16_t n_dim = ALIGN_K;
    constexpr uint16_t right_width = N;
    constexpr uint8_t unit_flag = 0;
    constexpr bool disable_gemv = false;

    if constexpr (SCENARIO == 1) {
        constexpr bool c_matrix_source = false;
        constexpr bool c_matrix_init_val = true;
        asc_mmad_mx(
            c_matrix, a_matrix, b_matrix, left_height, n_dim, right_width, unit_flag, disable_gemv, c_matrix_source,
            c_matrix_init_val);
    } else if constexpr (SCENARIO == 2) {
        constexpr bool c_matrix_source = true;
        constexpr bool c_matrix_init_val = false;
        asc_mmad_mx(
            c_matrix, a_matrix, b_matrix, left_height, n_dim, right_width, unit_flag, disable_gemv, c_matrix_source,
            c_matrix_init_val);
    } else if constexpr (SCENARIO == 3) {
        {
            constexpr bool c_matrix_source = false;
            constexpr bool c_matrix_init_val = true;
            asc_mmad_mx(
                c_matrix, a_matrix, b_matrix, left_height, n_dim, right_width, unit_flag, disable_gemv, c_matrix_source,
                c_matrix_init_val);
        }
        {
            constexpr bool c_matrix_source = false;
            constexpr bool c_matrix_init_val = false;
            asc_mmad_mx(
                c_matrix, a_matrix, b_matrix, left_height, n_dim, right_width, unit_flag, disable_gemv, c_matrix_source,
                c_matrix_init_val);
        }
    }
}

__aicore__ inline void copy_result_to_gm(__gm__ float* dst_addr, __cc__ float* src_addr)
{
    constexpr uint64_t nd_num = 1;
    constexpr uint64_t src_nd_stride = 0;
    constexpr uint64_t dst_nd_stride = 0;
    asc_set_l0c2gm_nz2nd(nd_num, src_nd_stride, dst_nd_stride);

    constexpr uint16_t n_size = N;
    constexpr uint16_t m_size = M;
    constexpr uint32_t loop_dst_stride = N;
    constexpr uint16_t loop_src_stride = M_ALIGN;
    constexpr uint8_t l2_cache_ctl = 0;
    constexpr uint8_t clip_relu_pre = 0;
    constexpr uint8_t unit_flag_ctl = 0;
    constexpr uint64_t quant_pre = 0;
    constexpr uint8_t relu_pre = 0;
    constexpr bool split_en = false;
    constexpr bool nz2nd_en = true;
    constexpr uint64_t quant_post = 0;
    constexpr uint8_t relu_post = 0;
    constexpr bool clip_relu_post = false;
    constexpr uint8_t eltwise_op = 0;
    constexpr bool eltwise_antq_en = false;
    constexpr bool c0_pad_en = false;
    constexpr bool broadcast_en = false;
    constexpr bool nz2dn_en = false;
    asc_copy_l0c2gm(
        dst_addr, src_addr, n_size, m_size, loop_dst_stride, loop_src_stride, l2_cache_ctl, clip_relu_pre,
        unit_flag_ctl, quant_pre, relu_pre, split_en, nz2nd_en, quant_post, relu_post, clip_relu_post, eltwise_op,
        eltwise_antq_en, c0_pad_en, broadcast_en, nz2dn_en);
}

__global__ __cube__ void mmad_mx_custom(
    __gm__ uint8_t* a, __gm__ uint8_t* scale_a, __gm__ uint8_t* b, __gm__ uint8_t* scale_b, __gm__ uint8_t* bias,
    __gm__ uint8_t* c)
{
    asc_init();

    __cbuf__ AType a_l1[A_L1_SIZE];
    __cbuf__ fp8_e8m0_t scale_a_l1[SCALE_A_L1_SIZE];
    __cbuf__ BType b_l1[B_L1_SIZE];
    __cbuf__ fp8_e8m0_t scale_b_l1[SCALE_B_L1_SIZE];

    copy_matrix_a_to_l1(a_l1, reinterpret_cast<__gm__ AType*>(a));
    copy_scale_a_to_l1(scale_a_l1, reinterpret_cast<__gm__ fp8_e8m0_t*>(scale_a));
    copy_matrix_b_to_l1(b_l1, reinterpret_cast<__gm__ BType*>(b));
    copy_scale_b_to_l1(scale_b_l1, reinterpret_cast<__gm__ fp8_e8m0_t*>(scale_b));

    __cbuf__ float bias_l1[BIAS_SIZE];
    if constexpr (HAS_BIAS_TENSOR) {
        copy_bias_to_l1(bias_l1, reinterpret_cast<__gm__ float*>(bias));
    }

    asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_MTE1, EVENT_ID0);

    if constexpr (SCENARIO == 3) {
        fill_zero_in_a_l1(a_l1);
        fill_zero_in_b_l1(b_l1);
        asc_sync_pipe(PIPE_MTE1);
    }

    __ca__ AType a_l0[A_L0_SIZE];
    __cb__ BType b_l0[B_L0_SIZE];
    copy_a_to_l0(a_l0, a_l1, scale_a_l1);
    copy_b_to_l0(b_l0, b_l1, scale_b_l1);
    if constexpr (HAS_BIAS_TENSOR) {
        asc_copy_l12bt(0, bias_l1, BIAS_BYTES);
    }

    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

    __cc__ float c_l0[C_L0_SIZE];
    compute_mmad_mx(c_l0, a_l0, b_l0);

    asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
    asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
    copy_result_to_gm(reinterpret_cast<__gm__ float*>(c), c_l0);

    asc_sync_pipe(PIPE_ALL);
}

int32_t main(int32_t argc, char* argv[])
{
    size_t a_file_size = M * PACKED_K * sizeof(uint8_t);
    size_t scale_a_file_size = M * SCALE_K * sizeof(uint8_t);
    size_t b_file_size = N * PACKED_K * sizeof(uint8_t);
    size_t scale_b_file_size = N * SCALE_K * sizeof(uint8_t);
    size_t bias_file_size = N * sizeof(float);
    size_t c_file_size = M * N * sizeof(float);

    uint32_t num_blocks = 1;

    aclInit(nullptr);
    int32_t device_id = 0;
    aclrtSetDevice(device_id);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* a_host;
    uint8_t* a_device;
    aclrtMallocHost(reinterpret_cast<void**>(&a_host), a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&a_device), a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_gm.bin", a_file_size, a_host, a_file_size);
    aclrtMemcpy(a_device, a_file_size, a_host, a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* scale_a_host;
    uint8_t* scale_a_device;
    aclrtMallocHost(reinterpret_cast<void**>(&scale_a_host), scale_a_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&scale_a_device), scale_a_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x1_scale_gm.bin", scale_a_file_size, scale_a_host, scale_a_file_size);
    aclrtMemcpy(scale_a_device, scale_a_file_size, scale_a_host, scale_a_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* b_host;
    uint8_t* b_device;
    aclrtMallocHost(reinterpret_cast<void**>(&b_host), b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&b_device), b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_gm.bin", b_file_size, b_host, b_file_size);
    aclrtMemcpy(b_device, b_file_size, b_host, b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* scale_b_host;
    uint8_t* scale_b_device;
    aclrtMallocHost(reinterpret_cast<void**>(&scale_b_host), scale_b_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&scale_b_device), scale_b_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
    ReadFile("./input/x2_scale_gm.bin", scale_b_file_size, scale_b_host, scale_b_file_size);
    aclrtMemcpy(scale_b_device, scale_b_file_size, scale_b_host, scale_b_file_size, ACL_MEMCPY_HOST_TO_DEVICE);

    uint8_t* bias_host = nullptr;
    uint8_t* bias_device = nullptr;
    if constexpr (HAS_BIAS_TENSOR) {
        aclrtMallocHost(reinterpret_cast<void**>(&bias_host), bias_file_size);
        aclrtMalloc(reinterpret_cast<void**>(&bias_device), bias_file_size, ACL_MEM_MALLOC_HUGE_FIRST);
        ReadFile("./input/bias_gm.bin", bias_file_size, bias_host, bias_file_size);
        aclrtMemcpy(bias_device, bias_file_size, bias_host, bias_file_size, ACL_MEMCPY_HOST_TO_DEVICE);
    }

    uint8_t* c_host;
    uint8_t* c_device;
    aclrtMallocHost(reinterpret_cast<void**>(&c_host), c_file_size);
    aclrtMalloc(reinterpret_cast<void**>(&c_device), c_file_size, ACL_MEM_MALLOC_HUGE_FIRST);

    mmad_mx_custom<<<num_blocks, 0, stream>>>(
        a_device, scale_a_device, b_device, scale_b_device, bias_device, c_device);
    aclrtSynchronizeStream(stream);

    aclrtMemcpy(c_host, c_file_size, c_device, c_file_size, ACL_MEMCPY_DEVICE_TO_HOST);
    WriteFile("./output/output.bin", c_host, c_file_size);

    aclrtFree(a_device);
    aclrtFreeHost(a_host);
    aclrtFree(scale_a_device);
    aclrtFreeHost(scale_a_host);
    aclrtFree(b_device);
    aclrtFreeHost(b_host);
    aclrtFree(scale_b_device);
    aclrtFreeHost(scale_b_host);
    if constexpr (HAS_BIAS_TENSOR) {
        aclrtFree(bias_device);
        aclrtFreeHost(bias_host);
    }
    aclrtFree(c_device);
    aclrtFreeHost(c_host);

    aclrtDestroyStream(stream);
    aclrtResetDevice(device_id);
    aclFinalize();
    return 0;
}
