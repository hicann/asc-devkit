/* !
 * \file histogram.asc
 * \brief
 */

#include <cstdint>
#include <vector>
#include <algorithm>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "utils/std/cmath.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;

__simd_vf__ inline void histogram_vf(
    __ubuf__ uint8_t* x_local, __ubuf__ uint16_t* y_local, uint32_t data_len, uint16_t one_rep_size,
    uint16_t repeat_time)
{
    vector_bool vmask_u8 = asc_create_mask_b8(PAT_ALL);
    vector_bool vmask_u16 = asc_create_mask_b16(PAT_ALL);
    vector_uint8_t src_reg;
    vector_uint16_t dst0_reg;
    vector_uint16_t dst1_reg;

    asc_duplicate_scalar(dst0_reg, 0);
    asc_duplicate_scalar(dst1_reg, 0);
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_loadalign(src_reg, x_local + i * one_rep_size);
        asc_frequency_histogram_bin0(dst0_reg, src_reg, vmask_u8);
        asc_frequency_histogram_bin1(dst1_reg, src_reg, vmask_u8);
    }

    asc_storealign(y_local, dst0_reg, vmask_u16);
    asc_storealign(y_local + 128, dst1_reg, vmask_u16);
}

__vector__ __global__ void histogram_custom(__gm__ uint8_t* x, __gm__ uint16_t* y)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ uint8_t* x_gm = x + block_idx * block_length;
    __gm__ uint16_t* y_gm = y;

    __ubuf__ uint8_t x_local[block_length];
    __ubuf__ uint16_t y_local[256];

    uint32_t burst_length = block_length * 1;
    uint32_t out_burst_length = 256 * 2;
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ uint8_t*)x_local, x_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint8_t);
    uint16_t repeat_time = AscendC::Std::ceil_div(block_length, one_rep_size);
    histogram_vf((__ubuf__ uint8_t*)x_local, (__ubuf__ uint16_t*)y_local, block_length, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        y_gm, (__ubuf__ uint16_t*)y_local, BLK_NUM, out_burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

std::vector<uint16_t> kernel_histogram(std::vector<uint8_t>& x)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = x.size();
    size_t x_byte_size = total_length * sizeof(uint8_t);
    size_t y_byte_size = 256 * sizeof(uint16_t);
    int32_t device_id = 0;
    uint8_t* x_host = x.data();
    uint8_t* y_host = nullptr;
    uint8_t* x_device = nullptr;
    uint16_t* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), y_byte_size);
    aclrtMalloc((void**)&x_device, x_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, y_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, x_byte_size, x_host, x_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    histogram_custom<<<num_blocks, 0>>>(x_device, y_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, y_byte_size, (uint8_t*)y_device, y_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> y((uint16_t*)y_host, (uint16_t*)(y_host + y_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

uint32_t verify_result(std::vector<uint16_t>& output, std::vector<uint16_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<uint8_t> x(total_length);
    std::vector<uint16_t> golden(256);

    size_t x_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", x_file_size, x.data(), total_length * sizeof(uint8_t))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), 256 * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<uint16_t> output = kernel_histogram(x);
    return verify_result(output, golden);
}
