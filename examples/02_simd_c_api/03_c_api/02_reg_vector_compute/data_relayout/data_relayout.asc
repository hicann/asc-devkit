/* !
 * \file data_relayout.asc
 * \brief 演示使用数据重排API实现Interleave和Pack操作，支持两种场景：
 *        - 场景1：Interleave，将两个uint16_t向量交织
 *        - 场景2：Pack，从uint32_t向量提取低16位到uint16_t向量
 */

#include <cstdint>
#include <vector>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 128;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void interleave_vf(
    __ubuf__ uint16_t* dst0_local, __ubuf__ uint16_t* dst1_local, __ubuf__ uint16_t* src0_local,
    __ubuf__ uint16_t* src1_local)
{
    vector_uint16_t src0_reg;
    vector_uint16_t src1_reg;
    vector_uint16_t dst0_reg;
    vector_uint16_t dst1_reg;
    vector_bool vmask = asc_create_mask_b16(PAT_ALL);

    asc_loadalign(src0_reg, src0_local);
    asc_loadalign(src1_reg, src1_local);
    asc_intlv(dst0_reg, dst1_reg, src0_reg, src1_reg);
    asc_storealign(dst0_local, dst0_reg, vmask);
    asc_storealign(dst1_local, dst1_reg, vmask);
}

__vector__ __global__ void interleave_custom(
    __gm__ uint16_t* src0, __gm__ uint16_t* src1, __gm__ uint16_t* dst0, __gm__ uint16_t* dst1)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ uint16_t* src0_gm = src0 + block_idx * block_length;
    __gm__ uint16_t* src1_gm = src1 + block_idx * block_length;
    __gm__ uint16_t* dst0_gm = dst0 + block_idx * block_length;
    __gm__ uint16_t* dst1_gm = dst1 + block_idx * block_length;

    __ubuf__ uint16_t src0_local[block_length];
    __ubuf__ uint16_t src1_local[block_length];
    __ubuf__ uint16_t dst0_local[block_length];
    __ubuf__ uint16_t dst1_local[block_length];

    uint32_t burst_length = block_length * 2;
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ uint16_t*)src0_local, src0_gm, burst_length);
    asc_copy_gm2ub_align((__ubuf__ uint16_t*)src1_local, src1_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    interleave_vf(
        (__ubuf__ uint16_t*)dst0_local, (__ubuf__ uint16_t*)dst1_local, (__ubuf__ uint16_t*)src0_local,
        (__ubuf__ uint16_t*)src1_local);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        dst0_gm, (__ubuf__ uint16_t*)dst0_local, BLK_NUM, burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_copy_ub2gm_align(
        dst1_gm, (__ubuf__ uint16_t*)dst1_local, BLK_NUM, burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

__simd_vf__ inline void pack_vf(
    __ubuf__ uint16_t* dst_local, __ubuf__ uint32_t* src_local, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_uint32_t src_reg;
    vector_uint16_t dst_reg;
    vector_bool vmask = asc_create_mask_b16(PAT_ALL);

    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_loadalign(src_reg, src_local + i * one_rep_size);
        asc_pack_to_low(dst_reg, src_reg);
        asc_storealign(dst_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void pack_custom(__gm__ uint32_t* src, __gm__ uint16_t* dst)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ uint32_t* src_gm = src + block_idx * block_length;
    __gm__ uint16_t* dst_gm = dst + block_idx * block_length;

    __ubuf__ uint32_t src_local[block_length];
    __ubuf__ uint16_t dst_local[block_length];

    uint32_t burst_length = block_length * 4;
    uint32_t out_burst_length = block_length * 2;
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ uint32_t*)src_local, src_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(uint32_t);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    pack_vf((__ubuf__ uint16_t*)dst_local, (__ubuf__ uint32_t*)src_local, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        dst_gm, (__ubuf__ uint16_t*)dst_local, BLK_NUM, out_burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

std::vector<std::vector<uint16_t>> kernel_interleave(std::vector<uint16_t>& src0, std::vector<uint16_t>& src1)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src0.size();
    size_t byte_size = total_length * sizeof(uint16_t);
    int32_t device_id = 0;
    uint8_t* src0_host = reinterpret_cast<uint8_t*>(src0.data());
    uint8_t* src1_host = reinterpret_cast<uint8_t*>(src1.data());
    uint8_t* dst0_host = nullptr;
    uint8_t* dst1_host = nullptr;
    uint16_t* src0_device = nullptr;
    uint16_t* src1_device = nullptr;
    uint16_t* dst0_device = nullptr;
    uint16_t* dst1_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst0_host), byte_size);
    aclrtMallocHost((void**)(&dst1_host), byte_size);
    aclrtMalloc((void**)&src0_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&src1_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst0_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst1_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src0_device, byte_size, src0_host, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)src1_device, byte_size, src1_host, byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    interleave_custom<<<num_blocks, 0>>>(src0_device, src1_device, dst0_device, dst1_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst0_host, byte_size, (uint8_t*)dst0_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dst1_host, byte_size, (uint8_t*)dst1_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> dst0((uint16_t*)dst0_host, (uint16_t*)(dst0_host + byte_size));
    std::vector<uint16_t> dst1((uint16_t*)dst1_host, (uint16_t*)(dst1_host + byte_size));

    aclrtFree(src0_device);
    aclrtFree(src1_device);
    aclrtFree(dst0_device);
    aclrtFree(dst1_device);
    aclrtFreeHost(dst0_host);
    aclrtFreeHost(dst1_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return {dst0, dst1};
}

std::vector<uint16_t> kernel_pack(std::vector<uint32_t>& src)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = src.size();
    size_t src_byte_size = total_length * sizeof(uint32_t);
    size_t dst_byte_size = total_length * sizeof(uint16_t);
    int32_t device_id = 0;
    uint8_t* src_host = reinterpret_cast<uint8_t*>(src.data());
    uint8_t* dst_host = nullptr;
    uint32_t* src_device = nullptr;
    uint16_t* dst_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&dst_host), dst_byte_size);
    aclrtMalloc((void**)&src_device, src_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&dst_device, dst_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)src_device, src_byte_size, src_host, src_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    pack_custom<<<num_blocks, 0>>>(src_device, dst_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(dst_host, dst_byte_size, (uint8_t*)dst_device, dst_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<uint16_t> dst((uint16_t*)dst_host, (uint16_t*)(dst_host + dst_byte_size));

    aclrtFree(src_device);
    aclrtFree(dst_device);
    aclrtFreeHost(dst_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return dst;
}

uint32_t verify_result(std::vector<std::vector<uint16_t>>& output, std::vector<std::vector<uint16_t>>& golden)
{
    if (std::equal(golden[0].begin(), golden[0].end(), output[0].begin()) &&
        std::equal(golden[1].begin(), golden[1].end(), output[1].begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

uint32_t verify_result(std::vector<uint16_t>& output, std::vector<uint16_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;

#if SCENARIO_NUM == 1
    std::vector<uint16_t> src0(total_length);
    std::vector<uint16_t> src1(total_length);

    size_t src0_file_size = 0;
    size_t src1_file_size = 0;
    if (!ReadFile("./input/input_x.bin", src0_file_size, src0.data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read input_x data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./input/input_y.bin", src1_file_size, src1.data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read input_y data file!" << std::endl;
        return 1;
    }

    std::vector<std::vector<uint16_t>> output = kernel_interleave(src0, src1);
    std::vector<std::vector<uint16_t>> golden(2, std::vector<uint16_t>(total_length));

    size_t golden0_file_size = 0;
    size_t golden1_file_size = 0;
    if (!ReadFile("./output/golden_dst0.bin", golden0_file_size, golden[0].data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read golden_dst0 data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden_dst1.bin", golden1_file_size, golden[1].data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read golden_dst1 data file!" << std::endl;
        return 1;
    }

    return verify_result(output, golden);

#elif SCENARIO_NUM == 2
    std::vector<uint32_t> src(total_length);
    std::vector<uint16_t> golden(total_length);

    size_t src_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", src_file_size, src.data(), total_length * sizeof(uint32_t))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), total_length * sizeof(uint16_t))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<uint16_t> output = kernel_pack(src);
    return verify_result(output, golden);

#endif
}
