/* !
 * \file cast.asc
 * \brief 演示使用Cast API实现数据类型转换功能，支持两种场景：
 *        - 场景1：half转int32_t（位宽小转大）
 *        - 场景2：float转int16_t（位宽大转小）
 */

#include <cstdint>
#include <vector>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void cast_vf_s1(
    __ubuf__ half* x_local, __ubuf__ int32_t* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    vector_half src_reg;
    vector_int32_t dst_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_loadalign_unpack(src_reg, x_local + i * one_rep_size);
        asc_half2int32_rd(dst_reg, src_reg, vmask);
        asc_storealign(y_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void cast_custom_s1(__gm__ half* x, __gm__ int32_t* y)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ half* x_gm = x + block_idx * block_length;
    __gm__ int32_t* y_gm = y + block_idx * block_length;

    __ubuf__ half x_local[block_length];
    __ubuf__ int32_t y_local[block_length];

    uint32_t burst_length = block_length * sizeof(half);
    uint32_t out_burst_length = block_length * sizeof(int32_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ half*)x_local, x_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(int32_t);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    cast_vf_s1((__ubuf__ half*)x_local, (__ubuf__ int32_t*)y_local, block_length, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        y_gm, (__ubuf__ int32_t*)y_local, BLK_NUM, out_burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

__simd_vf__ inline void cast_vf_s2(
    __ubuf__ float* x_local, __ubuf__ int16_t* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask = asc_create_mask_b32(PAT_ALL);
    vector_float src_reg;
    vector_int16_t dst_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        asc_loadalign(src_reg, x_local + i * one_rep_size);
        asc_float2int16_rna_sat(dst_reg, src_reg, vmask);
        asc_storealign_pack((__ubuf__ int32_t*)y_local + i * one_rep_size / 2, (vector_int32_t)dst_reg, vmask);
    }
}

__vector__ __global__ void cast_custom_s2(__gm__ float* x, __gm__ int16_t* y)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ int16_t* y_gm = y + block_idx * block_length;

    __ubuf__ float x_local[block_length];
    __ubuf__ int16_t y_local[block_length];

    uint32_t burst_length = block_length * sizeof(float);
    uint32_t out_burst_length = block_length * sizeof(int16_t);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    cast_vf_s2((__ubuf__ float*)x_local, (__ubuf__ int16_t*)y_local, block_length, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        y_gm, (__ubuf__ int16_t*)y_local, BLK_NUM, out_burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

std::vector<int32_t> kernel_cast_s1(std::vector<half>& x)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = x.size();
    size_t x_byte_size = total_length * sizeof(half);
    size_t y_byte_size = total_length * sizeof(int32_t);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    half* x_device = nullptr;
    int32_t* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), y_byte_size);
    aclrtMalloc((void**)&x_device, x_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, y_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, x_byte_size, x_host, x_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    cast_custom_s1<<<num_blocks, 0>>>(x_device, y_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, y_byte_size, (uint8_t*)y_device, y_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> y((int32_t*)y_host, (int32_t*)(y_host + y_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

std::vector<int16_t> kernel_cast_s2(std::vector<float>& x)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = x.size();
    size_t x_byte_size = total_length * sizeof(float);
    size_t y_byte_size = total_length * sizeof(int16_t);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    int16_t* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), y_byte_size);
    aclrtMalloc((void**)&x_device, x_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, y_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, x_byte_size, x_host, x_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    cast_custom_s2<<<num_blocks, 0>>>(x_device, y_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, y_byte_size, (uint8_t*)y_device, y_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int16_t> y((int16_t*)y_host, (int16_t*)(y_host + y_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

uint32_t verify_result(std::vector<int32_t>& output, std::vector<int32_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

uint32_t verify_result(std::vector<int16_t>& output, std::vector<int16_t>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;

#if SCENARIO_NUM == 1
    std::vector<half> x(total_length);
    std::vector<int32_t> golden(total_length);

    size_t x_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", x_file_size, x.data(), total_length * sizeof(half))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), total_length * sizeof(int32_t))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<int32_t> output = kernel_cast_s1(x);
    return verify_result(output, golden);

#elif SCENARIO_NUM == 2
    std::vector<float> x(total_length);
    std::vector<int16_t> golden(total_length);

    size_t x_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", x_file_size, x.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), total_length * sizeof(int16_t))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<int16_t> output = kernel_cast_s2(x);
    return verify_result(output, golden);

#endif
}
