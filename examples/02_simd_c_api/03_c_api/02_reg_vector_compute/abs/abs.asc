/* !
 * \file abs.asc
 * \brief 演示使用Abs API实现向量绝对值计算功能，对输入向量逐元素取绝对值并输出结果
 */

#include <cstdint>
#include <vector>
#include <algorithm>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"
#include "data_utils.h"

constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t NUM_BLOCKS = 1;
constexpr uint32_t BLK_NUM = 1;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void abs_vf(
    __ubuf__ float* x_local, __ubuf__ float* y_local, uint32_t data_len, uint16_t one_rep_size, uint16_t repeat_time)
{
    vector_bool vmask;
    vector_float src_reg;
    vector_float dst_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_loadalign(src_reg, x_local + i * one_rep_size);
        asc_abs(dst_reg, src_reg, vmask);
        asc_storealign(y_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void abs_custom(__gm__ float* x, __gm__ float* y)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ float* y_gm = y + block_idx * block_length;

    __ubuf__ float x_local[block_length];
    __ubuf__ float y_local[block_length];

    uint32_t burst_length = block_length * 4;
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;
    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);

    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    abs_vf((__ubuf__ float*)x_local, (__ubuf__ float*)y_local, block_length, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        y_gm, (__ubuf__ float*)y_local, BLK_NUM, burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, src_stride,
        dst_stride);
    asc_sync();
}

std::vector<float> kernel_abs(std::vector<float>& x)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = x.size();
    size_t total_byte_size = total_length * sizeof(float);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), total_byte_size);
    aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    abs_custom<<<num_blocks, 0>>>(x_device, y_device);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, total_byte_size, (uint8_t*)y_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> y((float*)y_host, (float*)(y_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return y;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test failed!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> x(total_length);
    std::vector<float> golden(total_length);

    size_t x_file_size = 0;
    size_t golden_file_size = 0;
    if (!ReadFile("./input/input_x.bin", x_file_size, x.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read input data file!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", golden_file_size, golden.data(), total_length * sizeof(float))) {
        std::cout << "[Failed] Failed to read golden data file!" << std::endl;
        return 1;
    }

    std::vector<float> output = kernel_abs(x);
    return verify_result(output, golden);
}
