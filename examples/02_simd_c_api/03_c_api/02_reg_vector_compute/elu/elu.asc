/* !
 * \file elu.asc
 * \brief 演示使用C API实现ELU激活运算，对输入向量逐元素计算并输出结果
 */

#include <cstdint>
#include <vector>
#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

#include "data_utils.h"

#define ASC_CHECK_ACL_CALL_DEMO(func)                                                                                 \
    do {                                                                                                              \
        auto err = (func);                                                                                            \
        if (err != ACL_SUCCESS) {                                                                                     \
            printf("%s(%d): ERROR: %s returned %s (err#%d)\n", __FILE__, __LINE__, #func, aclGetRecentErrMsg(), err); \
            exit(EXIT_FAILURE);                                                                                       \
        }                                                                                                             \
    } while (0)

constexpr uint32_t MAX_BLOCK_LENGTH = 8192;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;
constexpr uint32_t VECTOR_LENGTH_BYTES = 256;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void elu_vf(
    __ubuf__ float* x_local, __ubuf__ float* z_local, float alpha, float scale, float input_scale, uint32_t data_len,
    uint16_t one_rep_size, uint16_t repeat_time)
{
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t remain = data_len - i * one_rep_size;
        vector_bool vmask;
        vmask = asc_update_mask_b32(remain);
        vector_float src_reg;
        asc_loadalign(src_reg, x_local + i * one_rep_size);

        vector_float t_reg;
        asc_mul_scalar(t_reg, src_reg, input_scale, vmask);
        vector_float e_reg;
        asc_exp(e_reg, t_reg, vmask);
        vector_float e_minus1_reg;
        asc_add_scalar(e_minus1_reg, e_reg, -1.0f, vmask);

        vector_float poly_reg;
        asc_mul_scalar(poly_reg, t_reg, 1.0f / 120.0f, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f / 24.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f / 6.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f / 2.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);

        vector_float abs_reg;
        asc_abs(abs_reg, t_reg, vmask);
        vector_bool small_mask;
        asc_lt_scalar(small_mask, abs_reg, 0.1f, vmask);
        vector_float expm1_reg;
        asc_select(expm1_reg, poly_reg, e_minus1_reg, small_mask);
        vector_float y_neg_reg;
        asc_mul_scalar(y_neg_reg, expm1_reg, alpha, vmask);

        vector_bool cmp_mask;
        asc_gt_scalar(cmp_mask, src_reg, 0.0f, vmask);
        vector_float dst_reg;
        asc_select(dst_reg, src_reg, y_neg_reg, cmp_mask);
        asc_mul_scalar(dst_reg, dst_reg, scale, vmask);

        asc_storealign(z_local + i * one_rep_size, dst_reg, vmask);
    }
}

__simd_vf__ inline void elu_vf_half(
    __ubuf__ half* x_local, __ubuf__ half* z_local, float alpha, float scale, float input_scale, uint32_t data_len,
    uint16_t one_rep_size, uint16_t repeat_time)
{
    for (uint16_t i = 0; i < repeat_time; ++i) {
        uint32_t remain = data_len - i * one_rep_size;
        vector_bool vmask;
        vmask = asc_update_mask_b32(remain);
        vector_half src_half;
        asc_loadalign_unpack(src_half, x_local + i * one_rep_size);
        vector_float src_reg;
        asc_half2float(src_reg, src_half, vmask);

        vector_float t_reg;
        asc_mul_scalar(t_reg, src_reg, input_scale, vmask);
        vector_float e_reg;
        asc_exp(e_reg, t_reg, vmask);
        vector_float e_minus1_reg;
        asc_add_scalar(e_minus1_reg, e_reg, -1.0f, vmask);

        vector_float poly_reg;
        asc_mul_scalar(poly_reg, t_reg, 1.0f / 24.0f, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f / 6.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f / 2.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);
        asc_add_scalar(poly_reg, poly_reg, 1.0f, vmask);
        asc_mul(poly_reg, poly_reg, t_reg, vmask);

        vector_float abs_reg;
        asc_abs(abs_reg, t_reg, vmask);
        vector_bool small_mask;
        asc_lt_scalar(small_mask, abs_reg, 0.1f, vmask);
        vector_float expm1_reg;
        asc_select(expm1_reg, poly_reg, e_minus1_reg, small_mask);
        vector_float y_neg_reg;
        asc_mul_scalar(y_neg_reg, expm1_reg, alpha, vmask);

        vector_bool cmp_mask;
        asc_gt_scalar(cmp_mask, src_reg, 0.0f, vmask);
        vector_float dst_reg;
        asc_select(dst_reg, src_reg, y_neg_reg, cmp_mask);
        asc_mul_scalar(dst_reg, dst_reg, scale, vmask);

        vector_half dst_half;
        asc_float2half_rn(dst_half, dst_reg, vmask);
        asc_storealign_pack((__ubuf__ int32_t*)z_local + i * one_rep_size / 2, (vector_int32_t)dst_half, vmask);
    }
}

__vector__ __global__ void elu_custom(
    __gm__ float* src, __gm__ float* dst, float alpha, float scale, float input_scale, uint32_t total_length)
{
    asc_init();

    __ubuf__ float x_local[MAX_BLOCK_LENGTH];
    __ubuf__ float z_local[MAX_BLOCK_LENGTH];

    uint32_t burst_length = 0;
    uint64_t dst_stride = 0;
    uint32_t src_stride = 0;
    uint16_t one_rep_size = VECTOR_LENGTH_BYTES / sizeof(float);
    constexpr uint8_t mutex_id = 0;

    int64_t block_count = block_num;
    for (int64_t seg = block_idx; seg * static_cast<int64_t>(MAX_BLOCK_LENGTH) < static_cast<int64_t>(total_length);
         seg += block_count) {
        uint32_t start = static_cast<uint32_t>(seg * static_cast<int64_t>(MAX_BLOCK_LENGTH));
        uint32_t count = (total_length - start < MAX_BLOCK_LENGTH) ? (total_length - start) : MAX_BLOCK_LENGTH;
        uint16_t repeat_time = ceil_division(count, one_rep_size);

        __gm__ float* x_gm = src + start;
        __gm__ float* z_gm = dst + start;
        burst_length = count * sizeof(float);

        asc_lock(PIPE_MTE2, mutex_id);
        asc_copy_gm2ub_align(x_local, x_gm, 1, burst_length, 0, 0, false, 0, 0, 0);
        asc_unlock(PIPE_MTE2, mutex_id);

        asc_lock(PIPE_V, mutex_id);
        elu_vf(x_local, z_local, alpha, scale, input_scale, count, one_rep_size, repeat_time);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_MTE3, mutex_id);
        asc_copy_ub2gm_align(z_gm, z_local, BLK_NUM, burst_length, 0, dst_stride, src_stride);
        asc_unlock(PIPE_MTE3, mutex_id);
    }
}

__vector__ __global__ void elu_custom_half(
    __gm__ half* src, __gm__ half* dst, float alpha, float scale, float input_scale, uint32_t total_length)
{
    asc_init();

    __ubuf__ half x_local[MAX_BLOCK_LENGTH];
    __ubuf__ half z_local[MAX_BLOCK_LENGTH];

    uint32_t burst_length = 0;
    uint64_t dst_stride = 0;
    uint32_t src_stride = 0;
    uint16_t one_rep_size = VECTOR_LENGTH_BYTES / sizeof(float);
    constexpr uint8_t mutex_id = 0;

    int64_t block_count = block_num;
    for (int64_t seg = block_idx; seg * static_cast<int64_t>(MAX_BLOCK_LENGTH) < static_cast<int64_t>(total_length);
         seg += block_count) {
        uint32_t start = static_cast<uint32_t>(seg * static_cast<int64_t>(MAX_BLOCK_LENGTH));
        uint32_t count = (total_length - start < MAX_BLOCK_LENGTH) ? (total_length - start) : MAX_BLOCK_LENGTH;
        uint16_t repeat_time = ceil_division(count, one_rep_size);

        __gm__ half* x_gm = src + start;
        __gm__ half* z_gm = dst + start;
        burst_length = count * sizeof(half);

        asc_lock(PIPE_MTE2, mutex_id);
        asc_copy_gm2ub_align(x_local, x_gm, 1, burst_length, 0, 0, false, 0, 0, 0);
        asc_unlock(PIPE_MTE2, mutex_id);

        asc_lock(PIPE_V, mutex_id);
        elu_vf_half(x_local, z_local, alpha, scale, input_scale, count, one_rep_size, repeat_time);
        asc_unlock(PIPE_V, mutex_id);

        asc_lock(PIPE_MTE3, mutex_id);
        asc_copy_ub2gm_align(z_gm, z_local, BLK_NUM, burst_length, 0, dst_stride, src_stride);
        asc_unlock(PIPE_MTE3, mutex_id);
    }
}

uint32_t compute_num_blocks(uint32_t total_length)
{
    uint32_t num_blocks = (total_length + MAX_BLOCK_LENGTH - 1) / MAX_BLOCK_LENGTH;
    if (num_blocks < 1) {
        num_blocks = 1;
    }
    if (num_blocks > NUM_BLOCKS) {
        num_blocks = NUM_BLOCKS;
    }
    return num_blocks;
}

std::vector<float> kernel_elu(const std::vector<float>& x, float alpha, float scale, float input_scale)
{
    uint32_t total_length = x.size();
    if (total_length == 0) {
        return std::vector<float>();
    }
    uint32_t num_blocks = compute_num_blocks(total_length);
    size_t total_byte_size = total_length * sizeof(float);
    int32_t device_id = 0;
    const uint8_t* x_host = reinterpret_cast<const uint8_t*>(x.data());
    uint8_t* z_host = nullptr;
    float* x_device = nullptr;
    float* z_device = nullptr;

    ASC_CHECK_ACL_CALL_DEMO(aclInit(nullptr));
    ASC_CHECK_ACL_CALL_DEMO(aclrtSetDevice(device_id));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMallocHost((void**)(&z_host), total_byte_size));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(
        aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = nullptr;
    ASC_CHECK_ACL_CALL_DEMO(aclrtCreateStream(&stream));
    elu_custom<<<num_blocks, 0, stream>>>(x_device, z_device, alpha, scale, input_scale, total_length);
    ASC_CHECK_ACL_CALL_DEMO(aclrtSynchronizeStream(stream));
    ASC_CHECK_ACL_CALL_DEMO(aclrtDestroyStream(stream));

    ASC_CHECK_ACL_CALL_DEMO(
        aclrtMemcpy(z_host, total_byte_size, (uint8_t*)z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    std::vector<float> z((float*)z_host, (float*)(z_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);
    aclrtResetDevice(device_id);
    aclFinalize();
    return z;
}

std::vector<half> kernel_elu_half(const std::vector<half>& x, float alpha, float scale, float input_scale)
{
    uint32_t total_length = x.size();
    if (total_length == 0) {
        return std::vector<half>();
    }
    uint32_t num_blocks = compute_num_blocks(total_length);
    size_t total_byte_size = total_length * sizeof(half);
    int32_t device_id = 0;
    const uint8_t* x_host = reinterpret_cast<const uint8_t*>(x.data());
    uint8_t* z_host = nullptr;
    half* x_device = nullptr;
    half* z_device = nullptr;

    ASC_CHECK_ACL_CALL_DEMO(aclInit(nullptr));
    ASC_CHECK_ACL_CALL_DEMO(aclrtSetDevice(device_id));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMallocHost((void**)(&z_host), total_byte_size));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&x_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(aclrtMalloc((void**)&z_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    ASC_CHECK_ACL_CALL_DEMO(
        aclrtMemcpy((uint8_t*)x_device, total_byte_size, x_host, total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

    aclrtStream stream = nullptr;
    ASC_CHECK_ACL_CALL_DEMO(aclrtCreateStream(&stream));
    elu_custom_half<<<num_blocks, 0, stream>>>(x_device, z_device, alpha, scale, input_scale, total_length);
    ASC_CHECK_ACL_CALL_DEMO(aclrtSynchronizeStream(stream));
    ASC_CHECK_ACL_CALL_DEMO(aclrtDestroyStream(stream));

    ASC_CHECK_ACL_CALL_DEMO(
        aclrtMemcpy(z_host, total_byte_size, (uint8_t*)z_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    std::vector<half> z((half*)z_host, (half*)(z_host + total_byte_size));

    aclrtFree(x_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);
    aclrtResetDevice(device_id);
    aclFinalize();
    return z;
}

float half_ulp(float g)
{
    const float abs_g = std::fabs(g);
    if (abs_g < 6.103515625e-5f) {
        return 5.9604644775390625e-8f;
    }
    int expo = 0;
    std::frexp(abs_g, &expo);
    return std::ldexp(1.0f, expo - 11);
}

void print_tensor(const std::vector<float>& tensor, const char* name)
{
    constexpr size_t max_print_size = 20;
    std::cout << name << ": ";
    for (size_t i = 0; i < tensor.size() && i < max_print_size; ++i) {
        std::cout << tensor[i] << " ";
    }
    if (tensor.size() > max_print_size) {
        std::cout << "...";
    }
    std::cout << std::endl;
}

uint32_t verify_result_impl(
    const std::vector<float>& output, const std::vector<float>& golden, float atol, float rtol, float base_limit,
    const char* type_name, bool is_half)
{
    if (output.size() != golden.size()) {
        std::cout << "[Failed] " << type_name << " size mismatch: output=" << output.size()
                  << " golden=" << golden.size() << " (kernel execution may have failed)" << std::endl;
        return 1;
    }
    constexpr float required_matched_ratio = 0.99f;
    print_tensor(output, "Output");
    print_tensor(golden, "Golden");
    uint32_t fail_count = 0;
    float max_abs_error = 0.0f;
    float max_abs_error_limit = base_limit;
    for (size_t i = 0; i < golden.size(); ++i) {
        float o = output[i];
        float g = golden[i];
        bool ok = false;
        if (std::isnan(g)) {
            ok = std::isnan(o);
        } else if (std::isinf(g)) {
            ok = std::isinf(o) && (std::signbit(o) == std::signbit(g));
            if (!ok) {
                max_abs_error = INFINITY;
            }
        } else {
            if (!std::isfinite(o)) {
                ok = false;
                max_abs_error = INFINITY;
            } else {
                float abs_err = std::fabs(o - g);
                max_abs_error = std::max(max_abs_error, abs_err);

                float ulp = is_half ? half_ulp(static_cast<float>(static_cast<half>(g))) :
                                      std::fabs(std::nextafter(g, INFINITY) - g);
                max_abs_error_limit = std::max(max_abs_error_limit, 32.0f * std::fabs(ulp));
                ok = (abs_err <= atol + rtol * std::fabs(g));
            }
        }
        if (!ok) {
            ++fail_count;
            if (fail_count <= 5) {
                std::cout << "Mismatch at [" << i << "]: output=" << o << " golden=" << g << std::endl;
            }
        }
    }
    float matched_ratio =
        golden.empty() ? 1.0f : 1.0f - static_cast<float>(fail_count) / static_cast<float>(golden.size());
    bool pass = (matched_ratio >= required_matched_ratio) && (max_abs_error <= max_abs_error_limit);
    if (pass) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test failed! matched_ratio=" << matched_ratio << " max_abs_error=" << max_abs_error
              << " limit=" << max_abs_error_limit << std::endl;
    return 1;
}

uint32_t verify_result(const std::vector<float>& output, const std::vector<float>& golden)
{
    return verify_result_impl(output, golden, 1.53e-5f, 9.77e-4f, 1e-2f, "output", false);
}

uint32_t verify_result_fp16(const std::vector<float>& output, const std::vector<float>& golden)
{
    return verify_result_impl(output, golden, 1.95e-3f, 1.95e-3f, 1e-1f, "fp16 output", true);
}

float elu_golden_scalar(float v, float alpha, float scale, float input_scale, bool use_expm1)
{
    if (std::isnan(v)) {
        return NAN;
    }
    if (v > 0.0f) {
        return scale * v;
    }
    return use_expm1 ? alpha * scale * (std::expm1(v * input_scale)) :
                       alpha * scale * (std::exp(v * input_scale) - 1.0f);
}

std::vector<half> to_half_vec(const std::vector<float>& x)
{
    std::vector<half> y(x.size());
    for (uint32_t i = 0; i < x.size(); ++i) {
        y[i] = static_cast<half>(x[i]);
    }
    return y;
}

std::vector<float> to_float_vec(const std::vector<half>& x)
{
    std::vector<float> y(x.size());
    for (uint32_t i = 0; i < x.size(); ++i) {
        y[i] = static_cast<float>(x[i]);
    }
    return y;
}

std::vector<float> gen_golden(const std::vector<float>& x, float alpha, float scale, float input_scale, bool use_expm1)
{
    std::vector<float> golden(x.size());
    for (uint32_t i = 0; i < x.size(); ++i) {
        golden[i] = elu_golden_scalar(x[i], alpha, scale, input_scale, use_expm1);
    }
    return golden;
}

std::vector<float> gen_golden_fp16(
    const std::vector<half>& x, float alpha, float scale, float input_scale, bool use_expm1)
{
    std::vector<float> golden(x.size());
    for (uint32_t i = 0; i < x.size(); ++i) {
        golden[i] = elu_golden_scalar(static_cast<float>(x[i]), alpha, scale, input_scale, use_expm1);
    }
    return golden;
}

uint32_t run_and_verify(const std::vector<float>& x, float alpha, float scale, float input_scale, bool use_expm1)
{
    uint32_t fail_total = 0;

    std::vector<float> output = kernel_elu(x, alpha, scale, input_scale);
    fail_total += verify_result(output, gen_golden(x, alpha, scale, input_scale, use_expm1));

    std::vector<half> x_half = to_half_vec(x);
    std::vector<half> output_half = kernel_elu_half(x_half, alpha, scale, input_scale);
    fail_total +=
        verify_result_fp16(to_float_vec(output_half), gen_golden_fp16(x_half, alpha, scale, input_scale, use_expm1));

    return fail_total;
}

uint32_t test_special_and_params()
{
    uint32_t fail_total = 0;

    std::cout << "===== special values (NaN / Inf / 0) =====" << std::endl;
    const std::vector<float> x_special = {0.0f, -0.0f, 1.0f, -1.0f, INFINITY, -INFINITY, NAN, -100.0f};
    fail_total += run_and_verify(x_special, 1.0f, 1.0f, 1.0f, false);

    constexpr uint32_t n2 = 256;
    std::vector<float> x2(n2);
    for (uint32_t i = 0; i < n2; ++i) {
        x2[i] = -100.0f + 200.0f * static_cast<float>(i) / static_cast<float>(n2 - 1);
    }
    constexpr uint32_t num_param_cases = 8;
    const float params[num_param_cases][3] = {{2.0f, 0.5f, 1.5f}, {1.5f, 2.0f, -0.01f}, {0.5f, 1.0f, 1.0f},
                                              {0.0f, 1.0f, 1.0f}, {1.0f, 0.0f, 1.0f},   {-1.0f, 1.0f, 1.0f},
                                              {1.0f, 1.0f, 0.0f}, {2.0f, 1.25f, 1.0f}};
    for (uint32_t c = 0; c < num_param_cases; ++c) {
        std::cout << "===== params alpha=" << params[c][0] << " scale=" << params[c][1]
                  << " input_scale=" << params[c][2] << " =====" << std::endl;
        fail_total += run_and_verify(x2, params[c][0], params[c][1], params[c][2], false);
    }

    std::cout << "===== tiny x precision (expm1) =====" << std::endl;
    const std::vector<float> x_tiny = {1e-3f, 1e-4f, 1e-5f, 1e-6f, -1e-3f, -1e-5f, -1e-8f, 0.0f};
    fail_total += run_and_verify(x_tiny, 1.0f, 1.0f, 1.0f, true);

    std::cout << "===== non-finite scalar params (alpha/scale/input_scale) =====" << std::endl;
    const std::vector<float> x_nf_base = {0.0f, -0.0f, 1.0f, -1.0f, 2.0f, -2.0f, 0.5f, -0.5f};
    struct non_finite_case {
        float a, s, i;
    };
    const non_finite_case nf_cases[] = {
        {INFINITY, 1.0f, 1.0f}, {-INFINITY, 1.0f, 1.0f}, {NAN, 1.0f, 1.0f},
        {1.0f, INFINITY, 1.0f}, {1.0f, 1.0f, INFINITY},
    };
    for (const non_finite_case& nf : nf_cases) {
        std::cout << "===== non-finite params alpha=" << nf.a << " scale=" << nf.s << " input_scale=" << nf.i
                  << " =====" << std::endl;
        fail_total += run_and_verify(x_nf_base, nf.a, nf.s, nf.i, false);
    }

    std::cout << "===== empty tensor (shape=0) =====" << std::endl;
    std::vector<float> x_empty;
    std::vector<float> out_empty = kernel_elu(x_empty, 1.0f, 1.0f, 1.0f);
    if (out_empty.empty()) {
        std::cout << "[Success] empty tensor handled." << std::endl;
    } else {
        std::cout << "[Failed] empty tensor should return empty." << std::endl;
        ++fail_total;
    }

    return fail_total;
}

uint32_t verify_file_data()
{
    constexpr uint32_t total_length = 256;
    uint32_t fail_total = 0;

    std::cout << "===== file mode (fp32, gen_data.py) =====" << std::endl;
    std::vector<float> x(total_length);
    std::vector<float> golden(total_length);
    size_t file_size = 0;
    if (!read_file("./input/input_x.bin", file_size, x.data(), x.size() * sizeof(float))) {
        std::cout << "[Failed] Failed to read input_x.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    if (!read_file("./output/golden.bin", file_size, golden.data(), golden.size() * sizeof(float))) {
        std::cout << "[Failed] Failed to read golden.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    std::vector<float> output = kernel_elu(x, 1.0f, 1.0f, 1.0f);
    fail_total += verify_result(output, golden);

    std::cout << "===== file mode (fp16, gen_data.py) =====" << std::endl;
    std::vector<half> x_half(total_length);
    std::vector<half> golden_half(total_length);
    if (!read_file("./input/input_x_fp16.bin", file_size, x_half.data(), x_half.size() * sizeof(half))) {
        std::cout << "[Failed] Failed to read input_x_fp16.bin! please run: python3 ../scripts/gen_data.py"
                  << std::endl;
        return 1;
    }
    if (!read_file("./output/golden_fp16.bin", file_size, golden_half.data(), golden_half.size() * sizeof(half))) {
        std::cout << "[Failed] Failed to read golden_fp16.bin! please run: python3 ../scripts/gen_data.py" << std::endl;
        return 1;
    }
    std::vector<half> output_half = kernel_elu_half(x_half, 1.0f, 1.0f, 1.0f);
    fail_total += verify_result_fp16(to_float_vec(output_half), to_float_vec(golden_half));

    return fail_total;
}

int32_t main(int32_t argc, char* argv[])
{
    if (argc > 1 && std::string(argv[1]) == "--selftest") {
        constexpr float alpha = 1.0f;
        constexpr float scale = 1.0f;
        constexpr float input_scale = 1.0f;

        const std::vector<uint32_t> shapes = {1,    31,   32,   100,      1023,     1024,   2047,
                                              2048, 8191, 8195, 8 * 2048, 8 * 8192, 100000, 1048575};

        uint32_t fail_total = 0;
        for (uint32_t total_length : shapes) {
            std::vector<float> x(total_length);
            for (uint32_t i = 0; i < total_length; ++i) {
                x[i] = (total_length == 1) ?
                           -50.0f :
                           -100.0f + (200.0f * static_cast<float>(i) / static_cast<float>(total_length - 1));
            }

            std::cout << "===== shape=" << total_length << " (fp32) =====" << std::endl;
            std::vector<float> output = kernel_elu(x, alpha, scale, input_scale);
            fail_total += verify_result(output, gen_golden(x, alpha, scale, input_scale, false));

            std::cout << "===== shape=" << total_length << " (fp16) =====" << std::endl;
            std::vector<half> x_half = to_half_vec(x);
            std::vector<half> output_half = kernel_elu_half(x_half, alpha, scale, input_scale);
            fail_total += verify_result_fp16(
                to_float_vec(output_half), gen_golden_fp16(x_half, alpha, scale, input_scale, false));
        }

        fail_total += test_special_and_params();

        if (fail_total == 0) {
            std::cout << "\n[Success] All cases verification passed." << std::endl;
            return 0;
        }
        std::cout << "\n[Failed] Some cases verification failed! failed count=" << fail_total << std::endl;
        return 1;
    }

    uint32_t fail_total = verify_file_data();
    if (fail_total == 0) {
        std::cout << "\n[Success] File mode verification passed." << std::endl;
        return 0;
    }
    std::cout << "\n[Failed] File mode verification failed! failed count=" << fail_total << std::endl;
    return 1;
}
