/* !
 * \file muls.asc
 * \brief 演示使用Muls API实现向量与标量乘法计算功能，将输入向量每个元素与标量相乘并输出结果
 */

#include <cstdint>
#include <vector>
#include <algorithm>

#include <iostream>

#include "acl/acl.h"

#include "c_api/asc_simd.h"

constexpr uint32_t TOTAL_LENGTH = 256;
constexpr uint32_t NUM_BLOCKS = 8;
constexpr uint32_t BLK_NUM = 1;

__aicore__ constexpr uint32_t ceil_division(uint32_t numerator, uint32_t denominator)
{
    return (numerator + denominator - 1) / denominator;
}

__simd_vf__ inline void muls_vf(
    __ubuf__ float* x_local, __ubuf__ float* z_local, float scalar, uint32_t data_len, uint16_t one_rep_size,
    uint16_t repeat_time)
{
    vector_bool vmask;
    vector_float src_reg;
    vector_float dst_reg;
    for (uint16_t i = 0; i < repeat_time; ++i) {
        vmask = asc_update_mask_b32(data_len);
        asc_loadalign(src_reg, x_local + i * one_rep_size);
        asc_mul_scalar(dst_reg, src_reg, scalar, vmask);
        asc_storealign(z_local + i * one_rep_size, dst_reg, vmask);
    }
}

__vector__ __global__ void muls_custom(__gm__ float* x, __gm__ float* z, float scalar)
{
    asc_init();

    constexpr uint32_t block_length = TOTAL_LENGTH / NUM_BLOCKS;

    __gm__ float* x_gm = x + block_idx * block_length;
    __gm__ float* z_gm = z + block_idx * block_length;

    __ubuf__ float x_local[block_length];
    __ubuf__ float z_local[block_length];

    uint32_t burst_length = block_length * sizeof(float);
    uint32_t out_burst_length = block_length * sizeof(float);
    uint64_t src_stride = 0;
    uint32_t dst_stride = 0;

    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, burst_length);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float);
    uint16_t repeat_time = ceil_division(block_length, one_rep_size);
    muls_vf((__ubuf__ float*)x_local, (__ubuf__ float*)z_local, scalar, block_length, one_rep_size, repeat_time);
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);

    asc_copy_ub2gm_align(
        z_gm, (__ubuf__ float*)z_local, BLK_NUM, out_burst_length, asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
        src_stride, dst_stride);
    asc_sync();
}

std::vector<float> kernel_muls(std::vector<float>& x, float scalar)
{
    constexpr uint32_t num_blocks = NUM_BLOCKS;
    uint32_t total_length = x.size();
    size_t x_byte_size = total_length * sizeof(float);
    size_t z_byte_size = total_length * sizeof(float);
    int32_t device_id = 0;
    uint8_t* x_host = reinterpret_cast<uint8_t*>(x.data());
    uint8_t* z_host = nullptr;
    float* x_device = nullptr;
    float* z_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&z_host), z_byte_size);
    aclrtMalloc((void**)&x_device, x_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&z_device, z_byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy((uint8_t*)x_device, x_byte_size, x_host, x_byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    muls_custom<<<num_blocks, 0>>>(x_device, z_device, scalar);
    aclrtSynchronizeDevice();

    aclrtMemcpy(z_host, z_byte_size, (uint8_t*)z_device, z_byte_size, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<float> z((float*)z_host, (float*)(z_host + z_byte_size));

    aclrtFree(x_device);
    aclrtFree(z_device);
    aclrtFreeHost(z_host);

    aclrtResetDevice(device_id);
    aclFinalize();

    return z;
}

uint32_t verify_result(std::vector<float>& output, std::vector<float>& golden)
{
    if (std::equal(golden.begin(), golden.end(), output.begin())) {
        std::cout << "test pass!" << std::endl;
        return 0;
    } else {
        std::cout << "test fail!" << std::endl;
        return 1;
    }
}

int32_t main(int32_t argc, char* argv[])
{
    constexpr uint32_t total_length = TOTAL_LENGTH;
    std::vector<float> x(total_length);
    float scalar = 2.0f;

    for (uint32_t i = 0; i < total_length; ++i) {
        x[i] = i * 0.1f;
    }
    std::vector<float> output = kernel_muls(x, scalar);
    std::vector<float> golden(total_length);
    for (uint32_t i = 0; i < total_length; ++i) {
        golden[i] = static_cast<float>(x[i] * scalar);
    }
    return verify_result(output, golden);
}
