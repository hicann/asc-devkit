/* !
 * \file ssbuf_aiv_aic_comm.asc
 * \brief Demonstrates an AIV-to-AIC ring queue with the Ascend C C API.
 */

#include <cstdint>
#include <cstdio>

#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "c_api/utils/sys_var.h"

namespace {
constexpr uint32_t AIV_COUNT = 2;
constexpr uint32_t QUEUE_DEPTH = 8;
constexpr uint32_t MESSAGE_COUNT_PER_AIV = 12;
constexpr uint32_t TOTAL_RESULT_COUNT = AIV_COUNT * MESSAGE_COUNT_PER_AIV;
constexpr uint32_t VALID_MASK = 0x00008000U;
constexpr uint32_t FUNCTION_ID = 0x5A01U;
constexpr uint64_t CHECKSUM_MAGIC = 0x5353425546434D4DULL;
constexpr uint64_t MESSAGE_READY_SYNC_ID = 0;
constexpr uint64_t MESSAGE_ACK_SYNC_ID = 1;
constexpr uint64_t START_SYNC_ID = 2;
constexpr uint64_t AIC_SYNC_ID_STRIDE = 16;

struct alignas(128) CommMessage {
    volatile uint32_t head;
    volatile uint32_t reserved0;
    volatile uint64_t sequence;
    volatile uint64_t value;
    volatile uint64_t checksum;
    uint64_t reserved[12];
};

struct SsbufWorkspace {
    CommMessage queue[AIV_COUNT][QUEUE_DEPTH];
};

struct CommResult {
    uint32_t sender;
    uint32_t valid;
    uint64_t sequence;
    uint64_t value;
    uint64_t checksum;
};

__aicore__ inline uint32_t make_head(uint32_t sender) { return (FUNCTION_ID << 16) | VALID_MASK | (sender & 0xFFU); }

__aicore__ inline uint32_t get_function_id(uint32_t head) { return head >> 16; }

__aicore__ inline uint32_t get_sender(uint32_t head) { return head & 0xFFU; }

__aicore__ inline bool is_valid(uint32_t head) { return (head & VALID_MASK) != 0; }

__aicore__ inline uint64_t get_aic_sync_id(uint32_t sender, uint64_t aiv_sync_id)
{
    return static_cast<uint64_t>(sender) * AIC_SYNC_ID_STRIDE + aiv_sync_id;
}

__aicore__ inline uint64_t make_value(uint32_t sender, uint64_t sequence)
{
    return 1000ULL + static_cast<uint64_t>(sender) * 100ULL + sequence;
}

__aicore__ inline uint64_t make_checksum(uint32_t sender, uint64_t sequence, uint64_t value)
{
    return CHECKSUM_MAGIC ^ static_cast<uint64_t>(sender) ^ sequence ^ value;
}

__aicore__ inline __ssbuf__ SsbufWorkspace* get_workspace()
{
    // On DAV3510 NPU, address zero in the __ssbuf__ address space is the SSBuffer base address.
    return reinterpret_cast<__ssbuf__ SsbufWorkspace*>(0);
}

__aicore__ inline void clear_message(__ssbuf__ CommMessage* message)
{
    *reinterpret_cast<__ssbuf__ volatile uint64_t*>(message) = 0;
}

__aicore__ inline void init_queues(__ssbuf__ SsbufWorkspace* workspace)
{
    for (uint32_t sender = 0; sender < AIV_COUNT; ++sender) {
        for (uint32_t queueIndex = 0; queueIndex < QUEUE_DEPTH; ++queueIndex) {
            clear_message(&workspace->queue[sender][queueIndex]);
        }
    }
}

__aicore__ inline void send_messages(__ssbuf__ SsbufWorkspace* workspace, uint32_t sender)
{
    // Mode 4: this AIV waits until AIC finishes initializing SSBuffer.
    asc_sync_intra_wait(PIPE_S, START_SYNC_ID);

    for (uint64_t sequence = 0; sequence < MESSAGE_COUNT_PER_AIV; ++sequence) {
        // Before the queue wraps, wait until AIC releases the message space to be reused.
        if (sequence >= QUEUE_DEPTH) {
            asc_sync_intra_wait(PIPE_S, MESSAGE_ACK_SYNC_ID);
        }

        __ssbuf__ CommMessage* message = &workspace->queue[sender][sequence & (QUEUE_DEPTH - 1)];
        const uint64_t value = make_value(sender, sequence);
        message->sequence = sequence;
        message->value = value;
        message->checksum = make_checksum(sender, sequence, value);
        message->head = make_head(sender);
        // Mode 4: notify AIC after all PIPE_S writes for this message have completed.
        asc_sync_intra_arrive(PIPE_S, MESSAGE_READY_SYNC_ID);
    }

    constexpr uint32_t REMAINING_ACK_COUNT = MESSAGE_COUNT_PER_AIV < QUEUE_DEPTH ? MESSAGE_COUNT_PER_AIV : QUEUE_DEPTH;
    for (uint32_t ackIndex = 0; ackIndex < REMAINING_ACK_COUNT; ++ackIndex) {
        asc_sync_intra_wait(PIPE_S, MESSAGE_ACK_SYNC_ID);
    }
}

__aicore__ inline void receive_messages(__ssbuf__ SsbufWorkspace* workspace, __gm__ CommResult* output)
{
    for (uint32_t expected_sender = 0; expected_sender < AIV_COUNT; ++expected_sender) {
        for (uint64_t expected_sequence = 0; expected_sequence < MESSAGE_COUNT_PER_AIV; ++expected_sequence) {
            // Mode 4: wait for one message from the selected AIV.
            asc_sync_intra_wait(PIPE_S, get_aic_sync_id(expected_sender, MESSAGE_READY_SYNC_ID));
            __ssbuf__ CommMessage* message = &workspace->queue[expected_sender][expected_sequence & (QUEUE_DEPTH - 1)];
            const uint32_t head = message->head;

            const uint32_t sender = get_sender(head);
            const uint64_t sequence = message->sequence;
            const uint64_t value = message->value;
            const uint64_t checksum = message->checksum;
            const bool valid = get_function_id(head) == FUNCTION_ID && is_valid(head) && sender == expected_sender &&
                               sequence == expected_sequence && checksum == make_checksum(sender, sequence, value);

            __gm__ CommResult* result = output + expected_sender * MESSAGE_COUNT_PER_AIV + expected_sequence;
            result->sender = sender;
            result->valid = valid ? 1U : 0U;
            result->sequence = sequence;
            result->value = value;
            result->checksum = checksum;

            clear_message(message);
            // Mode 4: release this message space after all PIPE_S reads and writes have completed.
            asc_sync_intra_arrive(PIPE_S, get_aic_sync_id(expected_sender, MESSAGE_ACK_SYNC_ID));
        }
    }
}
} // namespace

extern "C" __global__ __mix__(1, 2) void c_api_ssbuf_aiv_aic_comm(__gm__ CommResult* output)
{
    asc_init();
    __ssbuf__ SsbufWorkspace* workspace = get_workspace();

    if ASC_IS_AIC {
        init_queues(workspace);
        // Mode 4 sends a separate initialization notification to each AIV.
        asc_sync_intra_arrive(PIPE_S, get_aic_sync_id(0, START_SYNC_ID));
        asc_sync_intra_arrive(PIPE_S, get_aic_sync_id(1, START_SYNC_ID));
        receive_messages(workspace, output);
    }

    if ASC_IS_AIV {
        const uint32_t sender = static_cast<uint32_t>(asc_get_sub_block_id());
        send_messages(workspace, sender);
    }
}

static bool check_acl(aclError result, const char* expression)
{
    if (result == ACL_SUCCESS) {
        return true;
    }
    std::fprintf(stderr, "[ERROR] %s failed, ret=%d\n", expression, static_cast<int32_t>(result));
    return false;
}

#define CHECK_ACL(expression)                        \
    do {                                             \
        if (!check_acl((expression), #expression)) { \
            return 1;                                \
        }                                            \
    } while (0)

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    constexpr int32_t DEVICE_ID = 0;
    constexpr size_t OUTPUT_BYTES = TOTAL_RESULT_COUNT * sizeof(CommResult);

    CommResult* output_host = nullptr;
    CommResult* output_device = nullptr;
    aclrtStream stream = nullptr;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));
    CHECK_ACL(aclrtMallocHost(reinterpret_cast<void**>(&output_host), OUTPUT_BYTES));
    CHECK_ACL(aclrtMalloc(reinterpret_cast<void**>(&output_device), OUTPUT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemset(output_device, OUTPUT_BYTES, 0, OUTPUT_BYTES));

    c_api_ssbuf_aiv_aic_comm<<<1, 0, stream>>>(output_device);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(output_host, OUTPUT_BYTES, output_device, OUTPUT_BYTES, ACL_MEMCPY_DEVICE_TO_HOST));

    bool passed = true;
    for (uint32_t sender = 0; sender < AIV_COUNT; ++sender) {
        for (uint64_t sequence = 0; sequence < MESSAGE_COUNT_PER_AIV; ++sequence) {
            const CommResult& result = output_host[sender * MESSAGE_COUNT_PER_AIV + sequence];
            const uint64_t expected_value = 1000ULL + static_cast<uint64_t>(sender) * 100ULL + sequence;
            const uint64_t expected_checksum =
                CHECKSUM_MAGIC ^ static_cast<uint64_t>(sender) ^ sequence ^ expected_value;
            if (result.valid != 1U || result.sender != sender || result.sequence != sequence ||
                result.value != expected_value || result.checksum != expected_checksum) {
                std::fprintf(
                    stderr,
                    "[ERROR] sender=%u sequence=%llu: valid=%u senderOut=%u sequenceOut=%llu value=%llu "
                    "checksum=0x%llx\n",
                    sender, static_cast<unsigned long long>(sequence), result.valid, result.sender,
                    static_cast<unsigned long long>(result.sequence), static_cast<unsigned long long>(result.value),
                    static_cast<unsigned long long>(result.checksum));
                passed = false;
            }
        }
    }

    CHECK_ACL(aclrtFree(output_device));
    CHECK_ACL(aclrtFreeHost(output_host));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    std::printf(passed ? "test pass!\n" : "test failed!\n");
    return passed ? 0 : 1;
}
