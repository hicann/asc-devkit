/* !
 * \file hello_world.asc
 * \brief Hello World SIMT sample.
 */

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "utils/debug/asc_printf.h"

// __global__修饰核函数：device侧入口，由host侧通过<<<>>>启动。
__global__ void hello_world()
{
    // 四个内置变量：threadIdx.x当前线程在块内索引，blockIdx.x当前线程块在Grid内索引，
    // blockDim.x每块线程数，gridDim.x Grid内线程块数。
    if (threadIdx.x < 3) {
        // 每个线程块仅前3个线程打印：本示例2个线程块，预期输出2 x 3 = 6行。
        printf("[blockIdx (%u/%u)][threadIdx (%u/%u)]: Hello World!\n", blockIdx.x, gridDim.x, threadIdx.x, blockDim.x);
    }
}

int32_t main(int argc, char const* argv[])
{
    // 初始化ACL运行时并指定设备，NPU侧执行依赖该上下文。
    aclInit(nullptr);
    aclrtSetDevice(0);

    // <<<>>>为核函数调用符，4个执行配置参数依次为：
    //   2：Grid内线程块数（blocks_per_grid）
    //   32：每个线程块的线程数（threads_per_block）
    //   0：每块动态分配的共享内存字节数（dyn_ubuf_size，0表示不动态申请）
    //   nullptr：关联的流（stream），传nullptr表示使用默认流，用于维护异步操作的执行顺序
    hello_world<<<2, 32, 0, nullptr>>>();

    // 核函数为异步下发，需等待设备执行完成后再释放资源，否则输出可能未产生。
    aclrtSynchronizeDevice();
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
