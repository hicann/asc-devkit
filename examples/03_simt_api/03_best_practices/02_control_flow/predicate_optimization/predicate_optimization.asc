/* !
 * \file predicate_optimization.asc
 * \brief SIMT predicate optimization sample comparing early-return branches with predicated straight-line execution
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <limits>
#include <random>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/asc_fp16.h"
#include "simt_api/math_functions.h"

#ifndef SCENARIO_NUM
#define SCENARIO_NUM 1
#endif

#if SCENARIO_NUM < 1 || SCENARIO_NUM > 6
#error "SCENARIO_NUM must be one of 1..6."
#endif

namespace {
#ifdef CYCLE_PROFILE
constexpr int32_t BLOCKS_PER_GRID = 1;
constexpr int32_t THREADS_PER_BLOCK = 32;
#else
constexpr int32_t BLOCKS_PER_GRID = 8;
constexpr int32_t THREADS_PER_BLOCK = 1024;
#endif
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr uint32_t DYN_UBUF_SIZE = 0;
constexpr int32_t DEVICE_ID = 0;
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;
constexpr int32_t NOP_COUNT = 1000;

#if SCENARIO_NUM >= 3
enum class BatchType {
    CLAMPED,
    FULL,
};

#if SCENARIO_NUM == 6
constexpr BatchType BATCH_TYPE = BatchType::FULL;
#else
constexpr BatchType BATCH_TYPE = BatchType::CLAMPED;
#endif
#endif

const char* get_kernel_name(int32_t kernel_kind)
{
    switch (kernel_kind) {
        case 1:
        case 2:
            return "hlog10";
        case 3:
        case 4:
        case 5:
        case 6:
            return "j0f";
        default:
            return "unknown";
    }
}

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
using HostT = uint16_t;
#else
using HostT = float;
#endif
} // namespace

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

#if SCENARIO_NUM == 1
namespace sample {
__aicore__ inline half hlog10(half x)
{
    if (x == static_cast<half>(0.2362060546875f)) {
        return static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        return static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        return static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        return static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        return static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        return static_cast<half>(3.474609375f);
    }
    float x_fp32 = __half2float(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f);
    return __float2half_rn(result_fp32);
}
} // namespace sample

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_early_return_kernel(
    half* input, half* output, volatile uint64_t* cycle, uint64_t total_length)
{
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    half x = input[idx];
    half* output_addr = output + idx;
#ifdef CYCLE_PROFILE
    for (int32_t i = 0; i < NOP_COUNT; i++) {
        asc_nop();
    }
    uint64_t start = clock();
    *output_addr = sample::hlog10(x);
    uint64_t end = clock();
    cycle[idx] = end - start;
#else
    *output_addr = sample::hlog10(x);
#endif
}
#elif SCENARIO_NUM == 2
namespace sample {
__aicore__ inline half hlog10(half x)
{
    float x_fp32 = __half2float(x);
    float result_fp32 = logf(x_fp32) / logf(10.0f);
    half temp = __float2half_rn(result_fp32);
    if (x == static_cast<half>(0.2362060546875f)) {
        temp = static_cast<half>(-0.62646484375f);
    } else if (x == static_cast<half>(0.2490234375f)) {
        temp = static_cast<half>(-0.60400390625f);
    } else if (x == static_cast<half>(3.0703125f)) {
        temp = static_cast<half>(0.487060546875f);
    } else if (x == static_cast<half>(126.0625f)) {
        temp = static_cast<half>(2.099609375f);
    } else if (x == static_cast<half>(11496.0f)) {
        temp = static_cast<half>(4.05859375f);
    } else if (x == static_cast<half>(2976.0f)) {
        temp = static_cast<half>(3.474609375f);
    }
    return temp;
}
} // namespace sample

__global__ __launch_bounds__(THREADS_PER_BLOCK) void hlog10_predicate_kernel(
    half* input, half* output, volatile uint64_t* cycle, uint64_t total_length)
{
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    half x = input[idx];
    half* output_addr = output + idx;
#ifdef CYCLE_PROFILE
    for (int32_t i = 0; i < NOP_COUNT; i++) {
        asc_nop();
    }
    uint64_t start = clock();
    *output_addr = sample::hlog10(x);
    uint64_t end = clock();
    cycle[idx] = end - start;
#else
    *output_addr = sample::hlog10(x);
#endif
}
#elif SCENARIO_NUM == 3
namespace sample {
__aicore__ inline float j0f(float x)
{
    if (isnan(x)) {
        return x;
    }
    float ax = fabsf(x);
    if (isinf(ax)) {
        return 0.0f;
    }
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    return __internal_j0f_huge_range(ax);
}
} // namespace sample

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_early_return_kernel(
    float* input, float* output, volatile uint64_t* cycle, uint64_t total_length)
{
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    float x = input[idx];
    float* output_addr = output + idx;
#ifdef CYCLE_PROFILE
    for (int32_t i = 0; i < NOP_COUNT; i++) {
        asc_nop();
    }
    uint64_t start = clock();
    *output_addr = sample::j0f(x);
    uint64_t end = clock();
    cycle[idx] = end - start;
#else
    *output_addr = sample::j0f(x);
#endif
}
#elif SCENARIO_NUM == 4
namespace sample {
__aicore__ inline float j0f(float x)
{
    float ax = fabsf(x);
    float result = __internal_j0f_huge_range(ax);
    if (ax <= 1.0e13f) {
        result = __internal_j0f_middle_range(ax);
    }
    if (ax <= 8.0f) {
        result = __internal_j0f_less8(ax);
    }
    if (isnan(x)) {
        result = x;
    }
    if (isinf(ax)) {
        result = 0.0f;
    }
    return result;
}
} // namespace sample

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_unified_return_kernel(
    float* input, float* output, volatile uint64_t* cycle, uint64_t total_length)
{
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    float x = input[idx];
    float* output_addr = output + idx;
#ifdef CYCLE_PROFILE
    for (int32_t i = 0; i < NOP_COUNT; i++) {
        asc_nop();
    }
    uint64_t start = clock();
    *output_addr = sample::j0f(x);
    uint64_t end = clock();
    cycle[idx] = end - start;
#else
    *output_addr = sample::j0f(x);
#endif
}
#else
namespace sample {
__aicore__ inline float j0f(float x)
{
    float ax = fabsf(x);
    if (ax <= 8.0f) {
        return __internal_j0f_less8(ax);
    }
    if (ax <= 1.0e13f) {
        return __internal_j0f_middle_range(ax);
    }
    float result = __internal_j0f_huge_range(ax);
    if (isnan(x)) {
        result = x;
    }
    if (isinf(ax)) {
        result = 0.0f;
    }
    return result;
}
} // namespace sample

__global__ __launch_bounds__(THREADS_PER_BLOCK) void j0f_hybrid_return_kernel(
    float* input, float* output, volatile uint64_t* cycle, uint64_t total_length)
{
    uint64_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    if (idx >= total_length) {
        return;
    }
    float x = input[idx];
    float* output_addr = output + idx;
#ifdef CYCLE_PROFILE
    for (int32_t i = 0; i < NOP_COUNT; i++) {
        asc_nop();
    }
    uint64_t start = clock();
    *output_addr = sample::j0f(x);
    uint64_t end = clock();
    cycle[idx] = end - start;
#else
    *output_addr = sample::j0f(x);
#endif
}
#endif

void launch_case_kernel(
    HostT* input_device, HostT* output_device, volatile uint64_t* cycle_device, uint64_t total_length,
    aclrtStream stream)
{
#if SCENARIO_NUM == 1
    hlog10_early_return_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        reinterpret_cast<half*>(input_device), reinterpret_cast<half*>(output_device), cycle_device, total_length);
#elif SCENARIO_NUM == 2
    hlog10_predicate_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        reinterpret_cast<half*>(input_device), reinterpret_cast<half*>(output_device), cycle_device, total_length);
#elif SCENARIO_NUM == 3
    j0f_early_return_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, cycle_device, total_length);
#elif SCENARIO_NUM == 4
    j0f_unified_return_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, cycle_device, total_length);
#else
    j0f_hybrid_return_kernel<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
        input_device, output_device, cycle_device, total_length);
#endif
}

#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
void generate_case_input(std::vector<HostT>& input)
{
    input.resize(TOTAL_THREADS);
    for (int32_t i = 0; i < TOTAL_THREADS; i++) {
        float value = 1.0f + static_cast<float>(i % 4096) * 0.25f;
        input[i] = aclFloatToFloat16(value);
    }
}

void compute_case_golden(const std::vector<HostT>& input, std::vector<HostT>& golden)
{
    golden.resize(input.size());
    for (size_t i = 0; i < input.size(); i++) {
        golden[i] = aclFloatToFloat16(::log10f(aclFloat16ToFloat(input[i])));
    }
}
#else
void generate_case_input(std::vector<HostT>& input)
{
    input.resize(TOTAL_THREADS);
    std::mt19937 rng(42U);
    if (BATCH_TYPE == BatchType::FULL) {
        std::uniform_int_distribution<int32_t> exp_dist(-126, 126);
        std::uniform_real_distribution<float> mant_dist(1.0f, 2.0f);
        std::uniform_int_distribution<int32_t> sign_dist(0, 1);
        for (int32_t i = 0; i < TOTAL_THREADS; i++) {
            if ((i % 32) == 30) {
                input[i] = std::numeric_limits<float>::quiet_NaN();
                continue;
            }
            if ((i % 32) == 31) {
                input[i] = -std::numeric_limits<float>::infinity();
                continue;
            }
            float value = std::ldexp(mant_dist(rng), exp_dist(rng));
            input[i] = (sign_dist(rng) == 0) ? value : -value;
        }
    } else {
        std::uniform_real_distribution<float> value_dist(-1.0e13f, 1.0e13f);
        for (int32_t i = 0; i < TOTAL_THREADS; i++) {
            input[i] = value_dist(rng);
        }
    }
}

void compute_case_golden(const std::vector<HostT>& input, std::vector<HostT>& golden)
{
    golden.resize(input.size());
    for (size_t i = 0; i < input.size(); i++) {
        golden[i] = ::j0f(input[i]);
    }
}
#endif

void prepare_case_data(std::vector<HostT>& input, std::vector<HostT>& golden)
{
    generate_case_input(input);
    compute_case_golden(input, golden);
}

int32_t set_device(int32_t device_id, aclrtStream& stream)
{
    if (check_acl_result(aclInit(nullptr), "aclInit(nullptr)", __LINE__) != SUCCESS) {
        return FAILED;
    }
    if (check_acl_result(aclrtSetDevice(device_id), "aclrtSetDevice(device_id)", __LINE__) != SUCCESS) {
        (void)aclFinalize();
        return FAILED;
    }
    if (check_acl_result(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)", __LINE__) != SUCCESS) {
        (void)aclrtResetDevice(device_id);
        (void)aclFinalize();
        return FAILED;
    }
    return SUCCESS;
}

int32_t reset_device(int32_t device_id, aclrtStream& stream)
{
    CHECK_ACL(aclrtDestroyStream(stream));
    stream = nullptr;
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return SUCCESS;
}

uint32_t verify_result(const std::vector<HostT>& output, const std::vector<HostT>& golden)
{
    if (output.size() != golden.size()) {
        printf("[Failed] Case accuracy verification failed!\n");
        return 1;
    }
#if SCENARIO_NUM == 1 || SCENARIO_NUM == 2
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::fabs(aclFloat16ToFloat(output[i]) - aclFloat16ToFloat(golden[i])) > 1e-2f) {
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            return 1;
        }
    }
#else
    for (size_t i = 0; i < output.size(); ++i) {
        if (std::isnan(golden[i])) {
            if (!std::isnan(output[i])) { // NaN -> NaN
                printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
                return 1;
            }
        } else if (std::fabs(output[i] - golden[i]) > 1e-4f) {
            printf("[Failed] Case accuracy verification failed at element %zu!\n", i);
            return 1;
        }
    }
#endif
    printf("[Success] Case accuracy verification passed.\n");
    return 0;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;

    const uint32_t kernel_kind = static_cast<uint32_t>(SCENARIO_NUM);
    const char* kernel_name = get_kernel_name(static_cast<int32_t>(kernel_kind));
    printf("Running case %u: %s...\n", kernel_kind, kernel_name);
    printf(
        "num_elements = %d, blocks = %d, threads per block = %d\n", TOTAL_THREADS, BLOCKS_PER_GRID, THREADS_PER_BLOCK);

    aclrtStream stream = nullptr;
    int32_t ret = set_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    std::vector<HostT> input;
    std::vector<HostT> golden;
    prepare_case_data(input, golden);

    std::vector<HostT> output(input.size());
    const size_t total_byte_size = input.size() * sizeof(HostT);
    HostT* input_device = nullptr;
    HostT* output_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&input_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&output_device, total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(input_device, total_byte_size, input.data(), total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

#ifdef CYCLE_PROFILE
    volatile uint64_t* cycle_device = nullptr;
    std::vector<uint64_t> cycle_host(input.size(), 0);
    CHECK_ACL(aclrtMalloc((void**)&cycle_device, input.size() * sizeof(uint64_t), ACL_MEM_MALLOC_HUGE_FIRST));
    launch_case_kernel(input_device, output_device, cycle_device, input.size(), stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(output.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
    CHECK_ACL(aclrtMemcpy(
        cycle_host.data(), input.size() * sizeof(uint64_t), (const void*)cycle_device, input.size() * sizeof(uint64_t),
        ACL_MEMCPY_DEVICE_TO_HOST));
    uint64_t max_cycle = 0;
    for (size_t i = 0; i < cycle_host.size(); i++) {
        if (cycle_host[i] > max_cycle) {
            max_cycle = cycle_host[i];
        }
    }
    printf("%s execute cycle : %lu\n", kernel_name, max_cycle);
    CHECK_ACL(aclrtFree((void*)cycle_device));
#else
    launch_case_kernel(input_device, output_device, nullptr, input.size(), stream);
    CHECK_ACL(aclrtSynchronizeStream(stream));
    CHECK_ACL(aclrtMemcpy(output.data(), total_byte_size, output_device, total_byte_size, ACL_MEMCPY_DEVICE_TO_HOST));
#endif

    CHECK_ACL(aclrtFree(input_device));
    CHECK_ACL(aclrtFree(output_device));
    ret = reset_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    return verify_result(output, golden);
}
