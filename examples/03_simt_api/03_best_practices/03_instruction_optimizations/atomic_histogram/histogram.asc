/* !
 * \file histogram.asc
 * \brief SIMT histogram sample comparing GM global and UB block-local atomic targets
 */
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

// 直方图bin数量：统计uint8_t取值0-255的出现频率
constexpr uint32_t HISTOGRAM_BIN_COUNT = 256U;
constexpr uint32_t THREADS_PER_BLOCK = 2048U;
// 固定输入规模，对应64核测试环境下的 64 cores * 2048 threads * 2 bytes
constexpr uint32_t FIXED_INPUT_BYTE_COUNT = 262144U;
constexpr uint32_t FIXED_SEED = 2009U;
constexpr uint32_t CASE_GM_GLOBAL = 0U;
constexpr uint32_t CASE_UB_BLOCK_LOCAL = 1U;
constexpr uint32_t HISTOGRAM_BYTE_SIZE = HISTOGRAM_BIN_COUNT * sizeof(uint32_t);

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

/*
 * Case 0（基线）：全部Block的全部线程对同一份GM直方图做原子累加。
 * 262144次原子更新全部集中在256个GM地址上，竞争范围覆盖全部131072个线程。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void histogram_gm_global(
    uint32_t* histogram, const uint8_t* input, uint32_t byte_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < byte_count; index += stride) {
        asc_atomic_add(&histogram[input[index]], 1U);
    }
}

/*
 * Case 1（优化）：每个Block在UB上维护一份私有直方图，结束时合并到GM。
 * 原子更新总次数与Case 0一致，但原子目标下沉到AIV内的UB，
 * 且每个地址的竞争线程数从131072降到2048。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void histogram_ub_block_local(
    uint32_t* histogram, const uint8_t* input, uint32_t byte_count)
{
    __ubuf__ uint32_t block_histogram[HISTOGRAM_BIN_COUNT];

    // Block内线程协作清零UB直方图
    for (uint32_t bin_index = threadIdx.x; bin_index < HISTOGRAM_BIN_COUNT; bin_index += blockDim.x) {
        block_histogram[bin_index] = 0;
    }
    // 同步保证所有线程在完成清零后才开始原子累加，避免读到未清零的旧值
    asc_syncthreads();

    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < byte_count; index += stride) {
        asc_atomic_add(&block_histogram[input[index]], 1U);
    }
    // 同步保证所有线程完成UB上的原子累加后再合并至GM，避免读取到不完整的计数结果
    asc_syncthreads();

    // 前256个线程各负责一个bin，把Block局部结果原子累加到最终GM直方图
    for (uint32_t bin_index = threadIdx.x; bin_index < HISTOGRAM_BIN_COUNT; bin_index += blockDim.x) {
        asc_atomic_add(histogram + bin_index, block_histogram[bin_index]);
    }
}

void print_usage(const char* program_name)
{
    std::fprintf(stderr, "usage: %s <case_id>\n", program_name);
    std::fprintf(stderr, "  0  GM global histogram (baseline)\n");
    std::fprintf(stderr, "  1  UB block-local histogram\n");
}

// 用std::stoul替代atoi：非法字符串在atoi下会被静默当成0，这里要求整个参数都是合法数字且取值在用例范围内
bool parse_case_id(int32_t argc, char* argv[], uint32_t& case_id)
{
    if (argc != 2) {
        return false;
    }
    // stoul会跳过前导空白，这里要求参数首字符就是数字，整个参数都被消耗完
    const std::string argument(argv[1]);
    if (argument.empty() || argument[0] < '0' || argument[0] > '9') {
        return false;
    }
    try {
        size_t parsed_length = 0;
        const unsigned long value = std::stoul(argument, &parsed_length, 10);
        if (parsed_length != argument.length()) {
            return false;
        }
        if (value != CASE_GM_GLOBAL && value != CASE_UB_BLOCK_LOCAL) {
            return false;
        }
        case_id = (uint32_t)value;
        return true;
    } catch (const std::exception&) {
        return false;
    }
}

void compute_histogram_cpu(std::vector<uint32_t>& histogram_out, const std::vector<uint8_t>& bytes)
{
    histogram_out.assign(HISTOGRAM_BIN_COUNT, 0U);
    for (const uint8_t byte_value : bytes) {
        histogram_out[byte_value]++;
    }
}

void seed_input_bytes(std::vector<uint8_t>& bytes, uint32_t seed)
{
    std::srand((int32_t)seed);
    for (uint8_t& byte_value : bytes) {
        byte_value = (uint8_t)(std::rand() % HISTOGRAM_BIN_COUNT);
    }
}

// 生成固定种子的随机输入，并在CPU上算出标杆直方图
void prepare_host_data(std::vector<uint8_t>& input_host, std::vector<uint32_t>& expected_histogram)
{
    seed_input_bytes(input_host, FIXED_SEED);
    compute_histogram_cpu(expected_histogram, input_host);
}

uint32_t verify_result(const std::vector<uint32_t>& output, const std::vector<uint32_t>& golden)
{
    for (uint32_t bin_index = 0; bin_index < HISTOGRAM_BIN_COUNT; ++bin_index) {
        if (output[bin_index] != golden[bin_index]) {
            std::fprintf(
                stderr, "[Failed] Case accuracy is verification failed at bin %u: device=%u cpu=%u\n", bin_index,
                output[bin_index], golden[bin_index]);
            return 1;
        }
    }
    std::printf("[Success] Case accuracy is verification passed.\n");
    return 0;
}

// msprof采集时GM计数会被replay重复累加，此时用-DSKIP_VALIDATION=ON跳过校验
uint32_t validate_histogram(const std::vector<uint32_t>& actual, const std::vector<uint32_t>& expected)
{
#if SKIP_VALIDATION
    std::printf("Validation skipped\n");
    return 0;
#else
    return verify_result(actual, expected);
#endif
}

// 运行期查询物理Vector Core数量；查询失败或返回值非法时报错退出，不回退到经验值
bool query_aiv_core_num(int32_t device_id, uint32_t& core_num)
{
    int64_t value = 0;
    const aclError ret = aclrtGetDeviceInfo((uint32_t)device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value);
    if (ret != ACL_SUCCESS || value <= 0) {
        std::fprintf(stderr, "failed to query vector core num: ret=%d value=%lld\n", (int32_t)ret, (long long)value);
        return false;
    }
    core_num = static_cast<uint32_t>(value);
    return true;
}

void print_case_info(uint32_t case_id, uint32_t blocks_per_grid)
{
    std::printf(
        "Case %u (%s): %u bytes, %u blocks, %u threads per block\n", case_id,
        case_id == CASE_GM_GLOBAL ? "GM global" : "UB block-local", FIXED_INPUT_BYTE_COUNT, blocks_per_grid,
        THREADS_PER_BLOCK);
}

int32_t main(int32_t argc, char* argv[])
{
    // 1. 输入输出参数校验：命令行只接受一个用例编号，取值必须是0或1
    uint32_t case_id = 0;
    if (!parse_case_id(argc, argv, case_id)) {
        print_usage(argv[0]);
        return EXIT_FAILURE;
    }

    // 2. 数据准备：申请Host缓冲区，生成输入字节流，并计算用于精度比对的CPU golden直方图
    std::vector<uint8_t> input_host(FIXED_INPUT_BYTE_COUNT);
    std::vector<uint32_t> expected_histogram(HISTOGRAM_BIN_COUNT);
    std::vector<uint32_t> actual_histogram(HISTOGRAM_BIN_COUNT);
    prepare_host_data(input_host, expected_histogram);

    // 3. Device侧初始化：初始化ACL、绑定device、创建stream，并查询AIV核数作为Block数量
    const int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint32_t blocks_per_grid = 0;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));
    if (!query_aiv_core_num(device_id, blocks_per_grid)) {
        CHECK_ACL(aclrtDestroyStream(stream));
        CHECK_ACL(aclrtResetDevice(device_id));
        CHECK_ACL(aclFinalize());
        return EXIT_FAILURE;
    }
    print_case_info(case_id, blocks_per_grid);

    // 4. 数据传输（Host to Device）：申请device内存，拷入输入数据，并把GM直方图清零
    uint8_t* input_device = nullptr;
    uint32_t* histogram_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&input_device, FIXED_INPUT_BYTE_COUNT, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&histogram_device, HISTOGRAM_BYTE_SIZE, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, FIXED_INPUT_BYTE_COUNT, input_host.data(), FIXED_INPUT_BYTE_COUNT, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemset(histogram_device, HISTOGRAM_BYTE_SIZE, 0, HISTOGRAM_BYTE_SIZE));

    // 5. Kernel launch：按用例编号选择原子目标在GM还是UB，随后等待stream执行完成
    const uint32_t dynamic_ubuf_size = 0;
    if (case_id == CASE_GM_GLOBAL) {
        histogram_gm_global<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            histogram_device, input_device, FIXED_INPUT_BYTE_COUNT);
    } else {
        histogram_ub_block_local<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            histogram_device, input_device, FIXED_INPUT_BYTE_COUNT);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // 6. 数据回传（Device to Host）与精度校验
    CHECK_ACL(aclrtMemcpy(
        actual_histogram.data(), HISTOGRAM_BYTE_SIZE, histogram_device, HISTOGRAM_BYTE_SIZE,
        ACL_MEMCPY_DEVICE_TO_HOST));
    const uint32_t failed = validate_histogram(actual_histogram, expected_histogram);

    // 7. 资源释放：释放device内存与stream，最后去初始化device（Host缓冲区由vector自动释放）
    CHECK_ACL(aclrtFree(histogram_device));
    CHECK_ACL(aclrtFree(input_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return failed == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
}
