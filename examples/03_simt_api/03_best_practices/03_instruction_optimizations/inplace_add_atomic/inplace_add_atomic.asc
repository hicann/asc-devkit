/* !
 * \file inplace_add_atomic.asc
 * \brief SIMT in-place add sample comparing in-thread accumulation and asc_atomic_add
 */
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"

/*
 * 编译期场景选择：一次编译只包含一个场景，通过cmake -DSCENARIO_NUM=<n>选择。
 *   0  三操作数乘加，基线：a[index] += b[index] * c[index]
 *   1  三操作数乘加，优化：asc_atomic_add(&a[index], b[index] * c[index])
 *   2  两操作数加法，基线：a[index] += b[index]
 *   3  两操作数加法，优化：asc_atomic_add(&a[index], b[index])
 */
#ifndef SCENARIO_NUM
#define SCENARIO_NUM 0
#endif

#if SCENARIO_NUM < 0 || SCENARIO_NUM > 3
#error "SCENARIO_NUM must be one of 0..3."
#endif

#ifndef SKIP_VALIDATION
#define SKIP_VALIDATION 0
#endif

// 场景属性的唯一来源：其余代码一律读取这两个编译期常量，不重复推导SCENARIO_NUM
#if SCENARIO_NUM == 0
constexpr bool SCENARIO_USE_MULADD = true;
constexpr bool SCENARIO_USE_ATOMIC = false;
#define SCENARIO_NAME "muladd plain update"
#elif SCENARIO_NUM == 1
constexpr bool SCENARIO_USE_MULADD = true;
constexpr bool SCENARIO_USE_ATOMIC = true;
#define SCENARIO_NAME "muladd atomic update"
#elif SCENARIO_NUM == 2
constexpr bool SCENARIO_USE_MULADD = false;
constexpr bool SCENARIO_USE_ATOMIC = false;
#define SCENARIO_NAME "add plain update"
#else
constexpr bool SCENARIO_USE_MULADD = false;
constexpr bool SCENARIO_USE_ATOMIC = true;
#define SCENARIO_NAME "add atomic update"
#endif

constexpr uint32_t THREADS_PER_BLOCK = 2048U;
// 固定元素个数2^22：a、b、c三个int32_t数组各16384KB
constexpr uint32_t FIXED_ELEMENT_COUNT = 4194304U;

#define CHECK_ACL(expr)                                                                                 \
    do {                                                                                                \
        auto __ret = (expr);                                                                            \
        int32_t __code = static_cast<int32_t>(__ret);                                                   \
        if (__code != 0) {                                                                              \
            fprintf(stderr, "[ERROR] %s failed at %s:%d, ret=%d\n", #expr, __FILE__, __LINE__, __code); \
        }                                                                                               \
    } while (0)

/*
 * 场景0（基线）：三操作数乘加，线程读出旧值后在寄存器中累加。
 * 各线程以总线程数为固定步长遍历整个数组，每处理一个元素都执行一次乘加：
 * 算出b[i] * c[i]，累加到a[i]的旧值上，写回a[i]。
 * a[i]的旧值必须先从L2读入寄存器才能参与累加，加法在寄存器中完成后写回L2，
 * 每个元素产生3次读、1次写。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_muladd_plain(
    int32_t* a, const int32_t* b, const int32_t* c, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        a[index] += b[index] * c[index];
    }
}

/*
 * 场景1（优化）：三操作数乘加，由原子加在L2完成累加。
 * 各线程只算出b[i] * c[i]（乘法仍由AIV在寄存器中完成），再对a[i]发起一次原子加：
 * 旧值的读出、加法与写回均在L2完成，旧值不再经L2→寄存器→L2往返，
 * 每个元素的读从3次降为2次。
 * 各线程访问互不重叠的地址，不存在同地址竞争，原子性本身并非功能需求。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_muladd_atomic(
    int32_t* a, const int32_t* b, const int32_t* c, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        asc_atomic_add(&a[index], b[index] * c[index]);
    }
}

/*
 * 场景2（基线）：两操作数加法，线程读出旧值后在寄存器中累加。
 * 各线程以总线程数为固定步长遍历整个数组，把b[i]累加到a[i]的旧值上，写回a[i]。
 * a[i]的旧值必须先从L2读入寄存器才能参与累加，加法在寄存器中完成后写回L2，
 * 每个元素产生2次读、1次写。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_add_plain(
    int32_t* a, const int32_t* b, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        a[index] += b[index];
    }
}

/*
 * 场景3（优化）：两操作数加法，由原子加在L2完成累加。
 * 各线程只读出b[i]，再对a[i]发起一次原子加：旧值的读出、加法与写回均在L2完成，
 * 旧值不再经L2→寄存器→L2往返，每个元素的读从2次降为1次。
 * 各线程访问互不重叠的地址，不存在同地址竞争，原子性本身并非功能需求。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void vector_add_atomic(
    int32_t* a, const int32_t* b, uint32_t element_count)
{
    uint32_t index = blockIdx.x * blockDim.x + threadIdx.x;
    const uint32_t stride = gridDim.x * blockDim.x;
    for (; index < element_count; index += stride) {
        asc_atomic_add(&a[index], b[index]);
    }
}

/*
 * 生成输入数据并在CPU上算出标杆结果。
 * 三个数组的取值都是小整数（0~12），int32_t下的乘积与和都不会溢出，
 * 校验可以直接做精确比对。
 */
void prepare_host_data(std::vector<int32_t>& a_host, std::vector<int32_t>& b_host, std::vector<int32_t>& c_host)
{
    for (uint32_t index = 0; index < FIXED_ELEMENT_COUNT; ++index) {
        a_host[index] = (int32_t)(index % 13U);
        b_host[index] = (int32_t)(index % 7U);
        c_host[index] = (int32_t)(index % 11U);
    }
}

// 按编译期场景选择计算公式，在CPU上算出标杆结果
void compute_expected(
    const std::vector<int32_t>& a_host, const std::vector<int32_t>& b_host, const std::vector<int32_t>& c_host,
    std::vector<int32_t>& expected_host)
{
    for (uint32_t index = 0; index < FIXED_ELEMENT_COUNT; ++index) {
        if (SCENARIO_USE_MULADD) {
            expected_host[index] = a_host[index] + b_host[index] * c_host[index];
        } else {
            expected_host[index] = a_host[index] + b_host[index];
        }
    }
}

uint32_t verify_result(const std::vector<int32_t>& output, const std::vector<int32_t>& golden)
{
    for (uint32_t index = 0; index < FIXED_ELEMENT_COUNT; ++index) {
        if (output[index] != golden[index]) {
            std::fprintf(
                stderr, "[Failed] Case accuracy verification failed at element %u: device=%d cpu=%d\n", index,
                output[index], golden[index]);
            return 1;
        }
    }
    std::printf("[Success] Case accuracy verification passed.\n");
    return 0;
}

// msopprof采集时a会被replay重复累加，此时用-DSKIP_VALIDATION=ON跳过校验
uint32_t validate_result(const std::vector<int32_t>& actual, const std::vector<int32_t>& expected)
{
#if SKIP_VALIDATION
    std::printf("Validation skipped\n");
    return 0;
#else
    return verify_result(actual, expected);
#endif
}

// 运行期查询物理Vector Core数量；查询失败或返回值非法时报错退出，不回退到经验值
bool query_aiv_core_num(int32_t device_id, uint32_t& core_num)
{
    int64_t value = 0;
    const aclError ret = aclrtGetDeviceInfo((uint32_t)device_id, ACL_DEV_ATTR_VECTOR_CORE_NUM, &value);
    if (ret != ACL_SUCCESS || value <= 0) {
        std::fprintf(stderr, "failed to query vector core num: ret=%d value=%lld\n", (int32_t)ret, (long long)value);
        return false;
    }
    core_num = static_cast<uint32_t>(value);
    return true;
}

void print_case_info(uint32_t blocks_per_grid)
{
    std::printf(
        "Scenario %u (%s): %u elements, %u blocks, %u threads per block\n", (uint32_t)SCENARIO_NUM, SCENARIO_NAME,
        FIXED_ELEMENT_COUNT, blocks_per_grid, THREADS_PER_BLOCK);
}

int32_t main()
{
    // 1. 数据准备：申请Host缓冲区，生成输入数据，并计算用于精度比对的CPU golden结果
    const size_t buffer_size = (size_t)FIXED_ELEMENT_COUNT * sizeof(int32_t);
    std::vector<int32_t> a_host(FIXED_ELEMENT_COUNT);
    std::vector<int32_t> b_host(FIXED_ELEMENT_COUNT);
    std::vector<int32_t> c_host(FIXED_ELEMENT_COUNT);
    std::vector<int32_t> expected_host(FIXED_ELEMENT_COUNT);
    std::vector<int32_t> actual_host(FIXED_ELEMENT_COUNT);
    prepare_host_data(a_host, b_host, c_host);
    compute_expected(a_host, b_host, c_host, expected_host);

    // 2. Device侧初始化：初始化ACL、绑定device、创建stream，并查询AIV核数作为Block数量
    const int32_t device_id = 0;
    aclrtStream stream = nullptr;
    uint32_t blocks_per_grid = 0;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(device_id));
    CHECK_ACL(aclrtCreateStream(&stream));
    if (!query_aiv_core_num(device_id, blocks_per_grid)) {
        CHECK_ACL(aclrtDestroyStream(stream));
        CHECK_ACL(aclrtResetDevice(device_id));
        CHECK_ACL(aclFinalize());
        return EXIT_FAILURE;
    }
    print_case_info(blocks_per_grid);

    // 3. 数据传输（Host to Device）：申请device内存并拷入a、b两个数组；乘加场景还需拷入c
    int32_t* a_device = nullptr;
    int32_t* b_device = nullptr;
    int32_t* c_device = nullptr;
    CHECK_ACL(aclrtMalloc((void**)&a_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&b_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(a_device, buffer_size, a_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMemcpy(b_device, buffer_size, b_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));
    if (SCENARIO_USE_MULADD) {
        CHECK_ACL(aclrtMalloc((void**)&c_device, buffer_size, ACL_MEM_MALLOC_HUGE_FIRST));
        CHECK_ACL(aclrtMemcpy(c_device, buffer_size, c_host.data(), buffer_size, ACL_MEMCPY_HOST_TO_DEVICE));
    }

    // 4. Kernel launch：按编译期场景选择由线程在寄存器中累加还是由原子加在L2完成累加，随后等待stream执行完成
    const uint32_t dynamic_ubuf_size = 0;
    if (SCENARIO_USE_MULADD) {
        if (SCENARIO_USE_ATOMIC) {
            vector_muladd_atomic<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
                a_device, b_device, c_device, FIXED_ELEMENT_COUNT);
        } else {
            vector_muladd_plain<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
                a_device, b_device, c_device, FIXED_ELEMENT_COUNT);
        }
    } else if (SCENARIO_USE_ATOMIC) {
        vector_add_atomic<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            a_device, b_device, FIXED_ELEMENT_COUNT);
    } else {
        vector_add_plain<<<dim3(blocks_per_grid), dim3(THREADS_PER_BLOCK), dynamic_ubuf_size, stream>>>(
            a_device, b_device, FIXED_ELEMENT_COUNT);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    // 5. 数据回传（Device to Host）与精度校验
    CHECK_ACL(aclrtMemcpy(actual_host.data(), buffer_size, a_device, buffer_size, ACL_MEMCPY_DEVICE_TO_HOST));
    const uint32_t failed = validate_result(actual_host, expected_host);

    // 6. 资源释放：释放device内存与stream，最后去初始化device（Host缓冲区由vector自动释放）
    if (SCENARIO_USE_MULADD) {
        CHECK_ACL(aclrtFree(c_device));
    }
    CHECK_ACL(aclrtFree(b_device));
    CHECK_ACL(aclrtFree(a_device));
    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return failed == 0 ? EXIT_SUCCESS : EXIT_FAILURE;
}
