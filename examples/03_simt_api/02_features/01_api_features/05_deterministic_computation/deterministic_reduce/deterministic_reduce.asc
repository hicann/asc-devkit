/* !
 * \file deterministic_reduce.asc
 * \brief SIMT deterministic computation sample: contrast atomic non-deterministic
 *        float accumulation with two fixed-order deterministic reduction trees
 *        (block halving and warp butterfly, the latter being the faster one).
 *
 * Host golden uses the simplest sequential sum (a + b + c + ...). Each case is
 * run ROUNDS times and every round's ULP error against the golden is recorded:
 * Case 0 shows varying ULP errors (precision non-determinism from scheduling),
 * while Case 1 and Case 2 show a constant ULP error (algorithm-order deviation from the
 * sequential sum, but no non-determinism across rounds).
 */

#include <cstdint>
#include <cinttypes>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>
#include "acl/acl.h"
#include "simt_api/asc_simt.h"

namespace {
constexpr uint32_t BLOCKS_PER_GRID = 4;
constexpr uint32_t THREADS_PER_BLOCK = 2048;
constexpr uint32_t WARP_SIZE = 32;
constexpr uint32_t WARPS_PER_BLOCK = THREADS_PER_BLOCK / WARP_SIZE;
constexpr uint32_t TOTAL_ELEMENTS = BLOCKS_PER_GRID * THREADS_PER_BLOCK; // 8192
constexpr uint32_t ROUNDS = 10; // 每个 Case 固定运行轮数，不可传参
constexpr uint32_t DYN_UBUF_SIZE = WARPS_PER_BLOCK * sizeof(float);
constexpr uint32_t DYN_UBUF_SIZE_HALVING = THREADS_PER_BLOCK * sizeof(float);
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;
constexpr int32_t DEVICE_ID = 0;

// 输入固定公式（顺序敏感设计）：
// - 大数取 1e8 量级并叠加 0.1 与 0.37 的非整数尾，float 表示下必然带舍入尾数，
//   不同分组相加时低位舍入路径不同，是顺序敏感性的主要来源；
// - 小数取 1e-3 量级，单个相对 1e8 量级的部分和（ULP=8）完全被吸收，
//   只有聚团后才会影响低位，聚团方式随顺序变化，进一步放大顺序敏感度。

float generate_input(uint32_t i)
{
    if (i % 64 == 0) {
        float tail = (i % 128 == 0) ? 0.37f : 0.0f;
        return 100000000.0f + 0.1f * static_cast<float>(i / 64) + tail; // 大数，带有非整数尾
    }
    return 0.001f * static_cast<float>((i % 7) + 1); // 小数
}
} // namespace

/* !
 * \brief Case 0：不确定路径。8192 个线程对同一 GM 地址做浮点原子累加。
 *
 * 原子操作保证读改写的原子性，但不保证线程间执行顺序；浮点加法不满足严格
 * 结合律，不同累加顺序产生不同舍入结果，多轮运行结果可能漂移。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void kernel_atomic_accumulate(const float* input, float* output)
{
    uint32_t idx = blockIdx.x * blockDim.x + threadIdx.x;
    asc_atomic_add(output, input[idx]);
}

/* !
 * \brief Case 1：确定路径。业界通用的折半规约实现，配对顺序全部由软件写死。
 *
 * 每个 block 对自己持有的 2048 个元素在动态 UB 暂存区上做折半规约：
 * 每轮活跃线程将自身格位与相距 stride（1024→512→…→1）的格位相加，
 * 活跃线程数与间距同步折半，10 轮后 tid 0 得到本 block 的和；
 * L2 末完成 block 固定序合并：block_sums 写 GM → asc_threadfence →
 *     atomic ticket，最后一个完成的 block 按 blockIdx 升序串行累加。
 *
 * 与 Case 2 蝶形树的对比：蝶形每轮全线程活跃、靠 asc_shfl_down 寄存器交换，
 * 配对跨度是 32 以内的 16→1；折半每轮只有前半线程活跃、靠 UB 暂存区交换，
 * 配对跨度是 1024→1。两棵树的配对顺序都由源代码写死，都满足逐 bit 确定性，
 * 但加法配对不同，属两棵不同的固定归并树，golden 值可能不同。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void kernel_halving_reduce(
    const float* input, float* block_sums, float* output, uint32_t* counter)
{
    extern __ubuf__ float smem[]; // 动态 UB：折半规约暂存区，容量 = blockDim 个 float
    uint32_t tid = threadIdx.x;

    // L1：block 内折半规约。每轮 tid < stride 的线程把 smem[tid] 与
    // smem[tid + stride] 相加写回 smem[tid]，stride 逐轮折半。
    // 同步骨架与协作组折半归约样例一致：写后同步、读后再同步，
    // 保证一轮内先全组写入、再全组读取，读写不相交。
    smem[tid] = input[blockIdx.x * blockDim.x + tid];
    asc_syncthreads();
    for (uint32_t stride = blockDim.x / 2; stride > 0; stride /= 2) {
        if (tid < stride) {
            smem[tid] += smem[tid + stride];
        }
        asc_syncthreads();
    }
    // L2 只由 0 号线程执行。fence 约束该线程写入 block_sums
    if (tid == 0) {
        block_sums[blockIdx.x] = smem[0];
        asc_threadfence();
        uint32_t ticket = asc_atomic_add(counter, 1);
        // L2 后半：最后一个完成的 block 按 blockIdx 升序串行累加全部 block 和。
        // 合并顺序固定为 0→1→2→3：软件写死的固定序，与运行调度无关。
        if (ticket == gridDim.x - 1) {
            float total = 0.0f;
            for (uint32_t b = 0; b < gridDim.x; b++) {
                total += block_sums[b];
            }
            *output = total;
        }
    }
}

/* !
 * \brief warp 内蝶形归约：配对顺序由软件逐轮写死（delta 16→1）。
 *
 * 每轮 lane 与 lane+delta 相加，lane 0 最终得到本 warp 的 32 个值之和。
 * 该配对顺序在源代码中可见、与运行调度无关，是确定性论证的依据。
 */
__aicore__ inline float warp_butterfly_reduce(float val)
{
    val += asc_shfl_down(val, 16, WARP_SIZE);
    val += asc_shfl_down(val, 8, WARP_SIZE);
    val += asc_shfl_down(val, 4, WARP_SIZE);
    val += asc_shfl_down(val, 2, WARP_SIZE);
    val += asc_shfl_down(val, 1, WARP_SIZE);
    return val;
}

/* !
 * \brief Case 2：确定路径。三层归并树，配对顺序全部由软件写死。
 *
 * L1 warp 内蝶形归约（delta 16→1），lane 0 得 warp 部分和；
 * L2 block 内二级蝶形：warp 0/1 分别对两组 32 个 warp 部分和做蝶形归约，
 * 再由 warp 0 合并两组结果，得到 block 和；
 * L3 末完成 block 固定序合并：block_sums 写 GM → asc_threadfence →
 *     atomic ticket，最后一个完成的 block 按 blockIdx 升序串行累加。
 */
__global__ __launch_bounds__(THREADS_PER_BLOCK) void kernel_deterministic_reduce(
    const float* input, float* block_sums, float* output, uint32_t* counter)
{
    extern __ubuf__ float smem[]; // 动态 UB：暂存 64 个 warp 部分和
    uint32_t tid = threadIdx.x;
    uint32_t lane_id = laneid();
    uint32_t warp_id = tid / warpSize;

    // L1：warp 内蝶形归约，配对顺序由软件写死
    float val = warp_butterfly_reduce(input[blockIdx.x * blockDim.x + tid]);
    if (lane_id == 0) {
        smem[warp_id] = val; // 每 warp 一次写
    }

    asc_syncthreads(); // 保证 64 个 warp 部分和全部写入后才进入 L2

    // L2：两个 warp 分别归约两组 warp 部分和，每组最多 32 个元素。
    // 2048 线程对应 64 个 warp，因此不能用单个 width=32 的蝶形覆盖全部部分和。
    if (warp_id < 2) {
        float warp_sum = warp_butterfly_reduce(smem[warp_id * WARP_SIZE + lane_id]);
        if (lane_id == 0) {
            smem[warp_id] = warp_sum;
        }
    }
    asc_syncthreads();

    // L2 第二步：warp 0 对两个分组结果做固定顺序的蝶形归约。
    if (warp_id == 0) {
        float warp_sum = (lane_id < 2) ? smem[lane_id] : 0.0f;
        warp_sum = warp_butterfly_reduce(warp_sum);
        if (lane_id == 0) {
            block_sums[blockIdx.x] = warp_sum;
        }
    }

    // L3 只由 0 号线程执行。fence 约束该线程写入 block_sums
    // 先于 ticket 发布，其他线程不参与此阶段，因此无需块内同步。
    if (tid == 0) {
        asc_threadfence();
        uint32_t ticket = asc_atomic_add(counter, 1);
        // L3：最后一个完成的 block 按 blockIdx 升序串行累加全部 block 和。
        // 合并顺序固定为 0→1→2→3：软件写死的固定序，与运行调度无关。
        if (ticket == gridDim.x - 1) {
            float total = 0.0f;
            for (uint32_t b = 0; b < gridDim.x; b++) {
                total += block_sums[b];
            }
            *output = total;
        }
    }
}

/* !
 * \brief Host golden：最简单的顺序累加（a + b + c + ...）。
 *
 * 顺序累加
 * 分步函数防止编译器将连续加法缩并为 FMA（快数合并），保证 golden 是真正的顺序和。
 */
float step_add(float a, float b)
{
    volatile float va = a;
    volatile float vb = b;
    return va + vb;
}

/* !
 * \brief Host golden 复算：单线程按下标 0→N-1 顺序累加。
 */
float host_golden(const std::vector<float>& input)
{
    float total = 0.0f;
    for (uint32_t i = 0; i < input.size(); i++) {
        total = step_add(total, input[i]);
    }
    return total;
}

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int32_t>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

int32_t parse_args(int32_t argc, char* argv[])
{
    if (argc != 2) {
        printf("[Failed] Invalid input, usage: \"deterministic_reduce <0|1|2>\".\n");
        return FAILED;
    }
    if (strcmp(argv[1], "0") != 0 && strcmp(argv[1], "1") != 0 && strcmp(argv[1], "2") != 0) {
        printf("[Failed] Invalid case, only \"0\" (atomic), \"1\" (halving) or \"2\" (butterfly) is supported.\n");
        return FAILED;
    }
    return SUCCESS;
}

/* !
 * \brief 按 case 编号运行一轮 Device 计算，回读结果。
 *
 * 每轮独立分配、复位 GM 输出与计数器，保证轮间状态不残留，覆盖 STC 边界用例。
 */
int32_t run_case_once(const std::vector<float>& input, const char* case_name, aclrtStream stream, float& output)
{
    int32_t ret = SUCCESS;
    float* input_device = nullptr;
    float* output_device = nullptr;
    float* block_sums_device = nullptr;
    uint32_t* counter_device = nullptr;
    const size_t input_bytes = TOTAL_ELEMENTS * sizeof(float);
    const size_t output_bytes = sizeof(float);
    const size_t block_sums_bytes = BLOCKS_PER_GRID * sizeof(float);

    CHECK_ACL(aclrtMalloc((void**)&input_device, input_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(input_device, input_bytes, input.data(), input_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    CHECK_ACL(aclrtMalloc((void**)&output_device, output_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&block_sums_device, block_sums_bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void**)&counter_device, sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST));

    float init_val = 0.0f;
    CHECK_ACL(aclrtMemcpy(output_device, output_bytes, &init_val, output_bytes, ACL_MEMCPY_HOST_TO_DEVICE));
    uint32_t init_count = 0;
    CHECK_ACL(aclrtMemcpy(counter_device, sizeof(uint32_t), &init_count, sizeof(uint32_t), ACL_MEMCPY_HOST_TO_DEVICE));

    if (strcmp(case_name, "0") == 0) {
        kernel_atomic_accumulate<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, 0, stream>>>(input_device, output_device);
    } else if (strcmp(case_name, "1") == 0) {
        kernel_halving_reduce<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE_HALVING, stream>>>(
            input_device, block_sums_device, output_device, counter_device);
    } else {
        kernel_deterministic_reduce<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, block_sums_device, output_device, counter_device);
    }
    CHECK_ACL(aclrtSynchronizeStream(stream));

    uint8_t* output_host = nullptr;
    CHECK_ACL(aclrtMallocHost((void**)&output_host, output_bytes));
    CHECK_ACL(aclrtMemcpy(output_host, output_bytes, output_device, output_bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    output = *reinterpret_cast<float*>(output_host);
    (void)aclrtFreeHost(output_host);

    const char* err = aclGetRecentErrMsg();
    if (err != nullptr) {
        fprintf(stderr, "%s\n", err);
        ret = FAILED;
    }

    (void)aclrtFree(input_device);
    (void)aclrtFree(output_device);
    (void)aclrtFree(block_sums_device);
    (void)aclrtFree(counter_device);
    return ret;
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t ret = parse_args(argc, argv);
    if (ret != SUCCESS) {
        return ret;
    }
    const char* case_name = argv[1];

    // 固定输入：确定性公式生成，三 Case 与全部轮次共用同一份数据
    std::vector<float> input(TOTAL_ELEMENTS);
    for (uint32_t i = 0; i < TOTAL_ELEMENTS; i++) {
        input[i] = generate_input(i);
    }
    const float golden = host_golden(input);
    printf(
        "Input: %u floats (fixed formula), %u rounds, golden (sequential sum) = %.6f (bits: 0x%08x)\n", TOTAL_ELEMENTS,
        ROUNDS, golden, *reinterpret_cast<const uint32_t*>(&golden));

    aclrtStream stream = nullptr;
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(DEVICE_ID));
    CHECK_ACL(aclrtCreateStream(&stream));

    const char* case_desc[3] = {
        "atomic accumulation, order decided by scheduling", "deterministic reduction, fixed-order block halving",
        "deterministic reduction, fixed-order 3-layer butterfly tree"};
    const int32_t case_idx = atoi(case_name);
    printf(
        "Case %s (%s): %u blocks x %u threads, %u rounds, input = %u floats (fixed formula)\n", case_name,
        case_desc[case_idx], BLOCKS_PER_GRID, THREADS_PER_BLOCK, ROUNDS, TOTAL_ELEMENTS);

    std::vector<float> results(ROUNDS, 0.0f);
    for (uint32_t r = 0; r < ROUNDS; r++) {
        ret = run_case_once(input, case_name, stream, results[r]);
        if (ret != SUCCESS) {
            (void)aclrtDestroyStream(stream);
            (void)aclrtResetDevice(DEVICE_ID);
            (void)aclFinalize();
            return ret;
        }
    }

    CHECK_ACL(aclrtDestroyStream(stream));
    CHECK_ACL(aclrtResetDevice(DEVICE_ID));
    CHECK_ACL(aclFinalize());

    // ROUNDS 轮逐 bit 一致性统计 + 每轮相对顺序 golden 的 ULP 误差
    uint32_t distinct_bits = 0;
    for (uint32_t r = 1; r < ROUNDS; r++) {
        if (memcmp(&results[r], &results[0], sizeof(float)) != 0) {
            distinct_bits++;
        }
    }

    // ULP 误差：以 golden 为基准，把两 float 的位模式按整型差衡量。
    // 同号相邻表示差 1 个 ULP；此处输入为正数且结果同号，直接位模式相减。
    auto ulp_error = [](float value, float ref) -> int64_t {
        const uint32_t vb = *reinterpret_cast<const uint32_t*>(&value);
        const uint32_t rb = *reinterpret_cast<const uint32_t*>(&ref);
        return static_cast<int64_t>(vb) - static_cast<int64_t>(rb);
    };

    printf(
        "\n===== Case %d: %s summary (%u rounds) =====\n", case_idx,
        (case_idx == 0) ?
            "atomic accumulation" :
            ((case_idx == 1) ? "deterministic reduction (halving)" : "deterministic reduction (butterfly)"),
        ROUNDS);
    for (uint32_t r = 0; r < ROUNDS; r++) {
        printf(
            "Round %2u: %.6f (bits: 0x%08x) ULP vs golden: %+" PRId64 "\n", r, results[r],
            *reinterpret_cast<uint32_t*>(&results[r]), static_cast<int64_t>(ulp_error(results[r], golden)));
    }
    printf("Rounds bit-identical to round 0: %u/%u\n", ROUNDS - 1 - distinct_bits, ROUNDS - 1);
    printf("Golden (sequential sum): %.6f (bits: 0x%08x)\n", golden, *reinterpret_cast<const uint32_t*>(&golden));

    if (case_idx == 1 || case_idx == 2) {
        // Case 1、2 判据：ROUNDS 轮逐 bit 一致（无不确定性），ULP 误差相对顺序
        // golden 恒定，允许非零。这是因为两棵归并树与顺序累加的加法配对不同，属固定
        // 的算法序偏差，不是不确定性。
        bool all_same = (distinct_bits == 0);
        bool ulp_constant = true;
        for (uint32_t r = 1; r < ROUNDS; r++) {
            if (ulp_error(results[r], golden) != ulp_error(results[0], golden)) {
                ulp_constant = false;
            }
        }
        const int64_t e0 = ulp_error(results[0], golden);
        if (all_same && ulp_constant) {
            printf(
                "[Success] Deterministic path: all %u rounds bit-identical; ULP error vs sequential golden "
                "is constant (%+" PRId64 "), a fixed algorithm-order deviation without non-determinism.\n",
                ROUNDS, e0);
            return SUCCESS;
        }
        printf(
            "[Failed] Deterministic path verification failed! all_same=%d ulp_constant=%d\n",
            static_cast<int32_t>(all_same), static_cast<int32_t>(ulp_constant));
        return FAILED;
    }

    // Case 0：不判 PASS/FAIL，展示 ULP 误差分布。
    // 误差随轮次变化即精度不确定性实证；调度稳定的运行中误差可能恒定，
    // 此时结论退化为"本轮未复现漂移"，属合法输出。
    if (distinct_bits == 0) {
        printf("Note: no drift observed this run; scheduling happened to be stable. This is a legal output.\n");
    } else {
        printf(
            "Note: %u/%u rounds differ from round 0 due to non-deterministic atomic accumulation order "
            "(ULP errors vary across rounds).\n",
            distinct_bits, ROUNDS - 1);
    }
    return SUCCESS;
}
