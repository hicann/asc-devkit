#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "simt_api/asc_simt.h"
#include "simt_api/cooperative_groups.h"

using namespace cooperative_groups;

namespace {

constexpr int32_t BLOCKS_PER_GRID = 4;
constexpr int32_t THREADS_PER_BLOCK = 1024;
constexpr int32_t TILE_SIZE = 32;
constexpr int32_t TOTAL_THREADS = BLOCKS_PER_GRID * THREADS_PER_BLOCK;
constexpr int32_t WARPS_PER_BLOCK = THREADS_PER_BLOCK / TILE_SIZE;
constexpr uint32_t DYN_UBUF_SIZE = 0;
constexpr int32_t SUCCESS = 0;
constexpr int32_t FAILED = 1;

enum class KernelType {
    GRID_GROUP,   // 跨block归约，workspace在global memory
    THREAD_BLOCK, // block内归约，workspace在shared memory
    BLOCK_TILE,   // warp内归约，再做block内二级归约
};

// 单个用例的配置，由get_scenario_config按命令行参数取得
struct ScenarioConfig {
    KernelType kernel;     // 用例对应的kernel，决定launch哪一个
    int32_t reduce_domain; // 参与归约的线程数，即reduce_sum中的g.size()
    const char* name;      // 用例名
};

ScenarioConfig get_scenario_config(const std::string& case_name)
{
    if (case_name == "0") {
        return {KernelType::GRID_GROUP, TOTAL_THREADS, "cross-block reduction (grid_group)"};
    }
    if (case_name == "1") {
        return {KernelType::THREAD_BLOCK, THREADS_PER_BLOCK, "whole-block reduction (thread_block)"};
    }
    return {KernelType::BLOCK_TILE, TILE_SIZE, "sub-group reduction (thread_block_tile<32>)"};
}

constexpr int32_t DEVICE_ID = 0;
} // namespace

int32_t check_acl_result(aclError ret, const char* expr, int32_t line)
{
    if (ret == ACL_SUCCESS) {
        return SUCCESS;
    }
    const char* msg = aclGetRecentErrMsg();
    fprintf(
        stderr, "Ascend Error: %s:%d code=%d %s \"%s\"\n", __FILE__, line, static_cast<int>(ret),
        (msg != nullptr) ? msg : "no detail", expr);
    return FAILED;
}

#define CHECK_ACL(expr)                                             \
    do {                                                            \
        if (check_acl_result((expr), #expr, __LINE__) != SUCCESS) { \
            return FAILED;                                          \
        }                                                           \
    } while (0)

template <typename PtrT>
__aicore__ inline int32_t reduce_sum(const thread_group& g, PtrT workspace, int32_t val)
{
    const int32_t lane = static_cast<int32_t>(g.thread_rank());
    for (int32_t i = static_cast<int32_t>(g.size()) / 2; i > 0; i /= 2) {
        workspace[lane] = val;
        g.sync();

        if (lane < i) {
            val += workspace[lane + i];
        }
        g.sync();
    }

    return lane == 0 ? val : -1;
}

__global__ void reduce_grid_group(const int32_t* input, int32_t* grid_workspace, int32_t* output, int32_t num_elements)
{
    grid_group grid = this_grid();
    const int32_t global_idx = static_cast<int32_t>(grid.thread_rank());
    volatile int32_t* ws = grid_workspace;
    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;
    const int32_t val = reduce_sum(grid, ws, in_val);
    if (grid.thread_rank() == 0) {
        *output = val;
    }
}

__global__ void reduce_thread_block(const int32_t* input, int32_t* output, int32_t num_elements)
{
    __ubuf__ int32_t ub_workspace[THREADS_PER_BLOCK];
    thread_block block = this_thread_block();
    const int32_t global_idx = static_cast<int32_t>(this_grid().thread_rank());
    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;
    const int32_t val = reduce_sum(block, ub_workspace, in_val);
    if (block.thread_rank() == 0) {
        asc_atomic_add(output, val);
    }
}

__global__ void reduce_block_tile(const int32_t* input, int32_t* output, int32_t num_elements)
{
    __ubuf__ int32_t ub_workspace[THREADS_PER_BLOCK];
    __ubuf__ int32_t ub_partial[WARPS_PER_BLOCK];
    thread_block block = this_thread_block();
    const int32_t global_idx = static_cast<int32_t>(this_grid().thread_rank());
    auto tile = tiled_partition<TILE_SIZE>(block);
    const int32_t offset = static_cast<int32_t>(tile.meta_group_rank()) * TILE_SIZE;
    const int32_t in_val = global_idx < num_elements ? input[global_idx] : 0;
    int32_t val = reduce_sum(tile, ub_workspace + offset, in_val);
    // 每个warp的rank 0将部分和写入ub_partial
    if (tile.thread_rank() == 0) {
        ub_partial[tile.meta_group_rank()] = val;
    }

    block.sync();
    // Warp 0对ub_partial上的32个中间结果做最后的归约
    if (tile.meta_group_rank() == 0) {
        val = reduce_sum(tile, ub_workspace, ub_partial[tile.thread_rank()]);
        if (tile.thread_rank() == 0) {
            asc_atomic_add(output, val);
        }
    }
}

int32_t parse_args(int32_t argc, char* argv[], ScenarioConfig& scenario, int32_t& num_elements)
{
    if (argc != 2 && argc != 3) {
        printf("[Failed] Invalid input, usage: \"cooperative_groups <0|1|2> [num_elements]\".\n");
        return FAILED;
    }

    std::string case_name = argv[1];
    if (case_name != "0" && case_name != "1" && case_name != "2") {
        printf("[Failed] Invalid case name, only \"cooperative_groups 0\", \"1\" or \"2\" is supported.\n");
        return FAILED;
    }

    num_elements = TOTAL_THREADS;
    if (argc == 3) {
        char* end = nullptr;
        const long parsed = std::strtol(argv[2], &end, 10);
        if (end == argv[2] || *end != '\0' || parsed <= 0 || parsed > TOTAL_THREADS) {
            printf("[Failed] Invalid num_elements, expect an integer in [1, %d].\n", TOTAL_THREADS);
            return FAILED;
        }
        num_elements = static_cast<int32_t>(parsed);
    }

    scenario = get_scenario_config(case_name);
    printf("Case %s: %s, reduce domain = %d\n", case_name.c_str(), scenario.name, scenario.reduce_domain);
    printf("num_elements = %d, threads = %d\n", num_elements, TOTAL_THREADS);
    return SUCCESS;
}

int32_t generate_data(int32_t num_elements, std::vector<int32_t>& input, int32_t& golden)
{
    input.resize(num_elements);
    for (int32_t i = 0; i < num_elements; i++) {
        input[i] = i + 1;
    }
    golden = static_cast<int32_t>(num_elements * (num_elements + 1) / 2);
    return SUCCESS;
}

int32_t set_device(int32_t device_id, aclrtStream& stream)
{
    if (check_acl_result(aclInit(nullptr), "aclInit(nullptr)", __LINE__) != SUCCESS) {
        return FAILED;
    }
    if (check_acl_result(aclrtSetDevice(device_id), "aclrtSetDevice(device_id)", __LINE__) != SUCCESS) {
        (void)aclFinalize();
        return FAILED;
    }
    if (check_acl_result(aclrtCreateStream(&stream), "aclrtCreateStream(&stream)", __LINE__) != SUCCESS) {
        (void)aclrtResetDevice(device_id);
        (void)aclFinalize();
        return FAILED;
    }
    return SUCCESS;
}

int32_t release_device_memory(int32_t*& input_device, int32_t*& total_device, int32_t*& workspace_device)
{
    int32_t ret = SUCCESS;

    if (workspace_device != nullptr) {
        ret = check_acl_result(aclrtFree(workspace_device), "aclrtFree(workspace_device)", __LINE__);
        workspace_device = nullptr;
    }
    if (total_device != nullptr) {
        const int32_t free_ret = check_acl_result(aclrtFree(total_device), "aclrtFree(total_device)", __LINE__);
        ret = (ret == SUCCESS) ? free_ret : ret;
        total_device = nullptr;
    }
    if (input_device != nullptr) {
        const int32_t free_ret = check_acl_result(aclrtFree(input_device), "aclrtFree(input_device)", __LINE__);
        ret = (ret == SUCCESS) ? free_ret : ret;
        input_device = nullptr;
    }
    return ret;
}

int32_t prepare_device_data(
    const ScenarioConfig& scenario, const std::vector<int32_t>& input, int32_t*& input_device, int32_t*& total_device,
    int32_t*& workspace_device)
{
    const size_t input_total_byte_size = input.size() * sizeof(int32_t);
    CHECK_ACL(aclrtMalloc((void**)&input_device, input_total_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMemcpy(
        input_device, input_total_byte_size, input.data(), input_total_byte_size, ACL_MEMCPY_HOST_TO_DEVICE));

    CHECK_ACL(aclrtMalloc((void**)&total_device, sizeof(int32_t), ACL_MEM_MALLOC_HUGE_FIRST));
    if (scenario.kernel != KernelType::GRID_GROUP) {
        CHECK_ACL(aclrtMemset(total_device, sizeof(int32_t), 0, sizeof(int32_t)));
    }

    if (scenario.kernel == KernelType::GRID_GROUP) {
        const size_t workspace_byte_size = TOTAL_THREADS * sizeof(int32_t);
        CHECK_ACL(aclrtMalloc((void**)&workspace_device, workspace_byte_size, ACL_MEM_MALLOC_HUGE_FIRST));
    }
    return SUCCESS;
}

int32_t launch_selected_kernel(
    const ScenarioConfig& scenario, int32_t* input_device, int32_t* total_device, int32_t* workspace_device,
    int32_t num_elements, aclrtStream stream)
{
    if (scenario.kernel == KernelType::GRID_GROUP) {
        printf(
            "grid = %d blocks x %d threads, reduce domain = %d, workspace in global memory\n", BLOCKS_PER_GRID,
            THREADS_PER_BLOCK, TOTAL_THREADS);
        reduce_grid_group<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, workspace_device, total_device, num_elements);
    } else if (scenario.kernel == KernelType::THREAD_BLOCK) {
        printf(
            "grid = %d blocks x %d threads, reduce domain = %d per block, workspace in shared memory\n",
            BLOCKS_PER_GRID, THREADS_PER_BLOCK, THREADS_PER_BLOCK);
        reduce_thread_block<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, total_device, num_elements);
    } else {
        printf(
            "grid = %d blocks x %d threads, %d tiles per block, reduce domain = %d, workspace in shared memory\n",
            BLOCKS_PER_GRID, THREADS_PER_BLOCK, WARPS_PER_BLOCK, TILE_SIZE);
        reduce_block_tile<<<BLOCKS_PER_GRID, THREADS_PER_BLOCK, DYN_UBUF_SIZE, stream>>>(
            input_device, total_device, num_elements);
    }

    CHECK_ACL(aclrtSynchronizeStream(stream));
    return SUCCESS;
}

int32_t copy_output_to_host(int32_t* total_device, int32_t& output)
{
    CHECK_ACL(aclrtMemcpy(&output, sizeof(int32_t), total_device, sizeof(int32_t), ACL_MEMCPY_DEVICE_TO_HOST));
    return SUCCESS;
}

int32_t launch_kernel(
    const ScenarioConfig& scenario, const std::vector<int32_t>& input, int32_t num_elements, aclrtStream stream,
    int32_t& output)
{
    int32_t* input_device = nullptr;
    int32_t* total_device = nullptr;
    int32_t* workspace_device = nullptr;

    int32_t ret = prepare_device_data(scenario, input, input_device, total_device, workspace_device);
    if (ret == SUCCESS) {
        ret = launch_selected_kernel(scenario, input_device, total_device, workspace_device, num_elements, stream);
    }
    if (ret == SUCCESS) {
        ret = copy_output_to_host(total_device, output);
    }

    const int32_t release_ret = release_device_memory(input_device, total_device, workspace_device);
    return (ret == SUCCESS) ? release_ret : ret;
}

int32_t reset_device(int32_t device_id, aclrtStream& stream)
{
    CHECK_ACL(aclrtDestroyStream(stream));
    stream = nullptr;
    CHECK_ACL(aclrtResetDevice(device_id));
    CHECK_ACL(aclFinalize());
    return SUCCESS;
}

int32_t verify_result(int32_t output, int32_t golden)
{
    printf("Output: %d\n", output);
    printf("Golden: %d\n", golden);

    if (output == golden) {
        printf("[Success] Case accuracy verification passed.\n");
        return SUCCESS;
    }
    printf("[Failed] Case accuracy verification failed!\n");
    return FAILED;
}

int32_t main(int32_t argc, char* argv[])
{
    ScenarioConfig scenario{};
    int32_t num_elements = TOTAL_THREADS;

    int32_t ret = parse_args(argc, argv, scenario, num_elements);
    if (ret != SUCCESS) {
        return ret;
    }

    std::vector<int32_t> input;
    int32_t golden = 0;
    ret = generate_data(num_elements, input, golden);
    if (ret != SUCCESS) {
        return ret;
    }

    aclrtStream stream = nullptr;
    ret = set_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    int32_t output = 0;
    ret = launch_kernel(scenario, input, num_elements, stream, output);
    if (ret != SUCCESS) {
        (void)reset_device(DEVICE_ID, stream);
        return ret;
    }

    ret = reset_device(DEVICE_ID, stream);
    if (ret != SUCCESS) {
        return ret;
    }

    return verify_result(output, golden);
}
