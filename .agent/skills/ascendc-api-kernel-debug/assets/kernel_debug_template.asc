// Minimal Kernel-side debug snippets. Keep the computation under test unchanged.
#include "kernel_operator.h"
#include "utils/debug/asc_assert.h"
#include "utils/debug/asc_dump.h"
#include "utils/debug/asc_printf.h"
#include "utils/debug/asc_time.h"

__global__ __aicore__ void KernelDebugTemplate(__gm__ half* input, __gm__ half* output)
{
    uint32_t block = AscendC::GetBlockIdx();
    if (block == 0) {
        AscendC::printf("block=%u\\n", block);
        ascendc_assert(input != nullptr, "input is null\\n");
        asc_dump_gm<half>(input, 0x10001, 16);

        uint64_t start = clock();
        // Run the small region under measurement here.
        uint64_t end = clock();
        AscendC::printf("cycles=%llu\\n", end - start);

        // Enable with -DASCENDC_TIME_STAMP_ON when the target mode supports it.
        asc_time_stamp(0x10002);
    }
}

// SIMT/SIMT VF only, and only on a platform supported by the current API docs.
__simt_vf__ __launch_bounds__(1024) inline void TrapOnInvalid(__gm__ float* x)
{
    if (isnan(x[threadIdx.x])) {
        __trap();
    }
}
