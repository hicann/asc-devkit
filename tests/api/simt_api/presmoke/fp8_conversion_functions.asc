/* FP8 conversion APIs are documented for SIMD/SIMT hybrid programming only. */
#include "kernel_operator.h"
#include "simt_api/asc_fp8.h"

__simt_vf__ inline void fp8_conversion_functions_vf(
    __gm__ const float* scalar, __gm__ const float2* float_pair, __gm__ const half2* half_pair,
    __gm__ const hifloat8x2_t* hif8_pair, __gm__ const float8_e4m3x2_t* e4m3_pair,
    __gm__ const float8_e5m2x2_t* e5m2_pair, __gm__ __asc_fp8_storage_t* fp8_storage,
    __gm__ __asc_fp8x2_storage_t* fp8x2_storage, __gm__ hifloat8x2_t* hif8_output, __gm__ float2* float_output,
    __gm__ half2* half_output)
{
    fp8x2_storage[0] = __asc_cvt_float2_to_fp8x2(float_pair[0], __ASC_NOSAT, __ASC_E4M3);
    fp8_storage[0] = __asc_cvt_float_to_fp8(scalar[0], __ASC_NOSAT, __ASC_E4M3);
    float_output[0] = __e4m3x22float2(e4m3_pair[0]);
    float_output[1] = __e5m2x22float2(e5m2_pair[0]);
    hif8_output[0] = __float22hif82_rna(float_pair[0]);
    hif8_output[1] = __float22hif82_rna_sat(float_pair[0]);
    hif8_output[2] = __float22hif82_rh(float_pair[0]);
    hif8_output[3] = __float22hif82_rh_sat(float_pair[0]);
    hif8_output[4] = __half22hif82_rna(half_pair[0]);
    hif8_output[5] = __half22hif82_rna_sat(half_pair[0]);
    hif8_output[6] = __half22hif82_rh(half_pair[0]);
    hif8_output[7] = __half22hif82_rh_sat(half_pair[0]);
    float_output[2] = __hif822float2(hif8_pair[0]);
    half_output[0] = __hif822half2(hif8_pair[0]);
}

__global__ __vector__ void fp8_conversion_functions(
    __gm__ const float* scalar, __gm__ const float2* float_pair, __gm__ const half2* half_pair,
    __gm__ const hifloat8x2_t* hif8_pair, __gm__ const float8_e4m3x2_t* e4m3_pair,
    __gm__ const float8_e5m2x2_t* e5m2_pair, __gm__ __asc_fp8_storage_t* fp8_storage,
    __gm__ __asc_fp8x2_storage_t* fp8x2_storage, __gm__ hifloat8x2_t* hif8_output, __gm__ float2* float_output,
    __gm__ half2* half_output)
{
    asc_vf_call<fp8_conversion_functions_vf>(
        dim3(1), scalar, float_pair, half_pair, hif8_pair, e4m3_pair, e5m2_pair, fp8_storage, fp8x2_storage,
        hif8_output, float_output, half_output);
}
