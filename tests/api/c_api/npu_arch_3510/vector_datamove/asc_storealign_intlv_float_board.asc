#include <cstdint>
#include <iostream>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"

namespace {
constexpr uint32_t INPUT_COUNT = 64;
constexpr uint32_t STORE_COUNT = INPUT_COUNT * 2;
constexpr uint32_t STRIDE = 160;
constexpr uint32_t MODE_COUNT = 7;
constexpr uint32_t OUTPUT_COUNT = STRIDE * MODE_COUNT;
constexpr uint32_t SENTINEL = 0xdeadbeef;

__simd_vf__ inline void store_intlv_float(
    __ubuf__ float* output, __ubuf__ float* input0, __ubuf__ float* input1, uint16_t repeat_count)
{
    vector_float src0;
    vector_float src1;
    asc_loadalign(src0, input0);
    asc_loadalign(src1, input1);
    asc_storealign_intlv(output, src0, src1);
    asc_storealign_intlv(output + STRIDE - 32, src0, src1, static_cast<int32_t>(32));
    for (uint16_t repeat = 0; repeat < repeat_count; ++repeat) {
        addr_reg offset = asc_update_addr_reg_b32(STRIDE);
        asc_storealign_intlv(output + 2 * STRIDE, src0, src1, offset);
    }

    AscendC::Reg::RegTensor<float> basic_src0;
    AscendC::Reg::RegTensor<float> basic_src1;
    AscendC::Reg::MaskReg mask = AscendC::Reg::CreateMask<float>();
    AscendC::Reg::LoadAlign(basic_src0, input0);
    AscendC::Reg::LoadAlign(basic_src1, input1);
    AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_INTLV_B32>(
        output + 4 * STRIDE, basic_src0, basic_src1, mask);
    for (uint16_t repeat = 0; repeat < repeat_count; ++repeat) {
        AscendC::Reg::AddrReg offset = AscendC::Reg::CreateAddrReg<float>(repeat, STRIDE);
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_INTLV_B32>(
            output + 5 * STRIDE, basic_src0, basic_src1, offset, mask);
    }
}

__global__ __vector__ void store_intlv_float_kernel(
    __gm__ uint32_t* output, __gm__ uint32_t* input0, __gm__ uint32_t* input1)
{
    asc_init();
    __ubuf__ uint32_t output_local[OUTPUT_COUNT];
    __ubuf__ uint32_t input0_local[INPUT_COUNT];
    __ubuf__ uint32_t input1_local[INPUT_COUNT];
    asc_copy_gm2ub_align(output_local, output, sizeof(output_local));
    asc_copy_gm2ub_align(input0_local, input0, sizeof(input0_local));
    asc_copy_gm2ub_align(input1_local, input1, sizeof(input1_local));
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_vf_call<store_intlv_float>(
        reinterpret_cast<__ubuf__ float*>(output_local), reinterpret_cast<__ubuf__ float*>(input0_local),
        reinterpret_cast<__ubuf__ float*>(input1_local), static_cast<uint16_t>(2));
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(output, output_local, sizeof(output_local));
    asc_sync();
}
} // namespace

int main()
{
    const uint32_t patterns[] = {0x00000000, 0x80000000, 0x3f800000, 0xbf800000, 0x7f800000, 0xff800000,
                                 0x7fc12345, 0x7f812345, 0xffc54321, 0xff854321, 0x00000001, 0x80000001,
                                 0x007fffff, 0x00800000, 0x7f7fffff, 0xff7fffff};
    std::vector<uint32_t> input0(INPUT_COUNT), input1(INPUT_COUNT), output(OUTPUT_COUNT, SENTINEL);
    for (uint32_t index = 0; index < INPUT_COUNT; ++index) {
        input0[index] = patterns[index % 16];
        input1[index] = patterns[(index + 7) % 16];
    }
    if (aclInit(nullptr) != ACL_SUCCESS || aclrtSetDevice(0) != ACL_SUCCESS) {
        return 1;
    }
    uint32_t* input0_device = nullptr;
    uint32_t* input1_device = nullptr;
    uint32_t* output_device = nullptr;
    bool success = aclrtMalloc(
                       reinterpret_cast<void**>(&input0_device), INPUT_COUNT * sizeof(uint32_t),
                       ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
                   aclrtMalloc(
                       reinterpret_cast<void**>(&input1_device), INPUT_COUNT * sizeof(uint32_t),
                       ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS &&
                   aclrtMalloc(
                       reinterpret_cast<void**>(&output_device), OUTPUT_COUNT * sizeof(uint32_t),
                       ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    if (success) {
        success = aclrtMemcpy(
                      input0_device, input0.size() * sizeof(uint32_t), input0.data(), input0.size() * sizeof(uint32_t),
                      ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS &&
                  aclrtMemcpy(
                      input1_device, input1.size() * sizeof(uint32_t), input1.data(), input1.size() * sizeof(uint32_t),
                      ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS &&
                  aclrtMemcpy(
                      output_device, output.size() * sizeof(uint32_t), output.data(), output.size() * sizeof(uint32_t),
                      ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    }
    if (success) {
        store_intlv_float_kernel<<<1, 0>>>(output_device, input0_device, input1_device);
        success = aclrtSynchronizeDevice() == ACL_SUCCESS;
    }
    if (success) {
        success = aclrtMemcpy(
                      output.data(), output.size() * sizeof(uint32_t), output_device, output.size() * sizeof(uint32_t),
                      ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    }
    for (uint32_t index = 0; index < OUTPUT_COUNT && success; ++index) {
        const uint32_t relative = index % STRIDE;
        const uint32_t expected =
            relative >= STORE_COUNT ? SENTINEL : (relative % 2 == 0 ? input0[relative / 2] : input1[relative / 2]);
        if (output[index] != expected) {
            std::cerr << "Mismatch at " << index << ": " << std::hex << output[index] << " != " << expected << '\n';
            success = false;
        }
    }
    if (input0_device != nullptr) {
        aclrtFree(input0_device);
    }
    if (input1_device != nullptr) {
        aclrtFree(input1_device);
    }
    if (output_device != nullptr) {
        aclrtFree(output_device);
    }
    aclrtResetDevice(0);
    aclFinalize();
    std::cout << (success ? "PASS: C API (3 modes) and basic API (2 modes), bitwise float interleave" : "FAIL") << '\n';
    return success ? 0 : 1;
}
