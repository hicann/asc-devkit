// Compile probe only; requires isolated resource-constant placeholders until 9201 specifications arrive.
#include "kernel_operator.h"
extern "C" __global__ __aicore__ void probe(__gm__ half* x)
{
    AscendC::LocalTensor<half> l1, l0b;
    AscendC::TBuffAddr a{};
    a.logicPos = (uint8_t)AscendC::TPosition::A1;
    l1.SetAddr(a);
    a.logicPos = (uint8_t)AscendC::TPosition::B2;
    l0b.SetAddr(a);
    AscendC::LoadData2DParams p{3, 2, 4, 0, 2, true, 0};
    AscendC::LoadData(l0b, l1, p);
    AscendC::GlobalTensor<half> gm;
    gm.SetGlobalBuffer(x);
    AscendC::LoadData(l1, gm, p, true);
    AscendC::ICachePreLoad(2);
    AscendC::WaitPreTaskEnd<true>();
}
